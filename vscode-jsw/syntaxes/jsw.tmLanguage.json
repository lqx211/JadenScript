{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "JadenScript",
  "scopeName": "source.jsw",
  "patterns": [
    {
      "include": "#directives"
    },
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#includes"
    },
    {
      "include": "#imports"
    },
    {
      "include": "#target"
    },
    {
      "include": "#metadata"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#calls"
    },
    {
      "include": "#namespaces"
    },
    {
      "include": "#variables"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#punctuation"
    }
  ],
  "repository": {
    "directives": {
      "comment": "#enable_feature<name>; and the #ifdef family, which the preprocessor resolves before lexing.",
      "patterns": [
        {
          "comment": "#ifdef NAME / #ifndef NAME / #define NAME",
          "name": "meta.preprocessor.jsw",
          "match": "^(\\s*)(#(?:ifdef|ifndef|define))\\b\\s*([A-Za-z_]\\w*)?",
          "captures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "keyword.other.directive.jsw"
            },
            "3": {
              "name": "entity.name.tag.jsw"
            }
          }
        },
        {
          "comment": "#else / #endif",
          "name": "meta.preprocessor.jsw",
          "match": "^(\\s*)(#(?:else|endif))\\b",
          "captures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "keyword.other.directive.jsw"
            }
          }
        },
        {
          "name": "meta.preprocessor.jsw",
          "begin": "^(\\s*)(#enable_feature)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "keyword.other.directive.jsw"
            }
          },
          "end": ";",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.jsw"
            }
          },
          "patterns": [
            {
              "name": "punctuation.definition.tag.begin.jsw",
              "match": "<"
            },
            {
              "name": "punctuation.definition.tag.end.jsw",
              "match": ">"
            },
            {
              "name": "constant.language.feature.jsw",
              "match": "\\b(?:useTempVariables|commentMetadata|corruptBlockPos|hideObjectNames|namespacedNames|vanillaScratch|doObfuscation|pishiSupport|vmProtect)\\b"
            },
            {
              "name": "entity.name.tag.jsw",
              "match": "[A-Za-z_][A-Za-z0-9_]*"
            }
          ]
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "comment": "A decompiler annotation: the words carry meaning, so they get their own scope.",
          "name": "comment.line.double-slash.jsw",
          "begin": "//",
          "end": "$",
          "patterns": [
            {
              "name": "string.quoted.double.jsw",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "name": "constant.character.escape.jsw",
                  "match": "\\\\."
                }
              ]
            },
            {
              "name": "keyword.control.directive.jsw",
              "match": "(?:\\btemp variables\\b|\\bmain thread\\b|\\breceiver at\\b|\\bunsupported\\b|\\bundefined\\b|\\bproccode\\b|\\bSprite:|\\bcomment\\b|\\bgrouped\\b|\\bmonitor\\b|\\bcallee\\b|\\bStage\\b|\\bhook:|\\bwatch\\b|\\bwarp\\b|\\bat\\b)"
            },
            {
              "comment": "// costume … / // sound …",
              "name": "keyword.other.annotation.jsw",
              "match": "\\b(?:costume|sound)\\b"
            },
            {
              "comment": "centerx= centery= res= rate= samples=",
              "name": "variable.parameter.annotation.jsw",
              "match": "\\b(?:centerx|centery|samples|sample|rate|res)\\b(?=\\s*=)"
            },
            {
              "name": "entity.name.tag.jsw",
              "match": "@[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*"
            },
            {
              "name": "constant.numeric.jsw",
              "match": "\\b\\d+(?:\\.\\d+)?\\b"
            }
          ]
        },
        {
          "name": "comment.block.jsw",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "comment": "f-strings may contain {expression} holes",
          "name": "string.interpolated.jsw",
          "begin": "\\bf(\\\"|')",
          "end": "\\1",
          "patterns": [
            {
              "name": "constant.character.escape.jsw",
              "match": "\\{\\{"
            },
            {
              "name": "constant.character.escape.jsw",
              "match": "\\}\\}"
            },
            {
              "name": "meta.embedded.expression.jsw",
              "begin": "\\{",
              "beginCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.begin.jsw"
                }
              },
              "end": "\\}",
              "endCaptures": {
                "0": {
                  "name": "punctuation.section.embedded.end.jsw"
                }
              },
              "patterns": [
                {
                  "include": "#strings"
                },
                {
                  "include": "#numbers"
                },
                {
                  "include": "#namespaces"
                },
                {
                  "include": "#variables"
                }
              ]
            },
            {
              "name": "constant.character.escape.jsw",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.jsw",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.jsw",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.single.jsw",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.jsw",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "includes": {
      "comment": "include \"display.jsw\" -- a module spliced in before lexing.",
      "patterns": [
        {
          "match": "^(\\s*)(include)\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|\\'(?:[^\\'\\\\]|\\\\.)*\\')",
          "captures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "keyword.control.include.jsw"
            },
            "3": {
              "name": "string.quoted.jsw"
            }
          }
        }
      ]
    },
    "imports": {
      "comment": "import \"assets/lists/notes.jsa\" as notes;",
      "patterns": [
        {
          "match": "\\b(import)\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|\\'(?:[^\\'\\\\]|\\\\.)*\\')(?:\\s+(as)\\s+(\"(?:[^\"\\\\]|\\\\.)*\"|\\'(?:[^\\'\\\\]|\\\\.)*\\'|[A-Za-z_$][\\w$]*))?",
          "captures": {
            "1": {
              "name": "keyword.control.import.jsw"
            },
            "2": {
              "name": "string.quoted.jsw"
            },
            "3": {
              "name": "keyword.control.import.jsw"
            },
            "4": {
              "name": "entity.name.namespace.jsw"
            }
          }
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.import.jsw",
          "match": "\\b(?:import|as)\\b"
        },
        {
          "name": "storage.modifier.jsw",
          "match": "\\b(?:private|public|static|cloud|final)\\b"
        },
        {
          "name": "storage.type.jsw",
          "match": "\\b(?:void)\\b"
        },
        {
          "name": "keyword.control.jsw",
          "match": "\\b(?:continue|default|repeat|return|switch|break|loose|while|call|case|elif|else|for|if)\\b"
        },
        {
          "name": "keyword.operator.word.jsw",
          "match": "\\b(?:and|not|or)\\b"
        },
        {
          "name": "constant.language.jsw",
          "match": "\\b(?:false|null|true|any)\\b"
        },
        {
          "name": "keyword.declaration.jsw",
          "match": "\\b(?:metadata|class|stage)\\b"
        },
        {
          "comment": "Reserved for future versions; flagged so users avoid them.",
          "name": "invalid.illegal.reserved.jsw",
          "match": "(?<!\\.)\\b(?:instanceof|extends|finally|typedef|delete|export|struct|typeof|async|await|catch|const|throw|yield|enum|this|let|new|try|var|do|of)\\b"
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "comment": "class Lyrics(namespace=\"Lyrics\") — the same keys inline.",
          "name": "meta.class-parameters.jsw",
          "begin": "\\b(class)\\s+([A-Za-z_$][\\w$]*)\\s*(\\()",
          "beginCaptures": {
            "1": {
              "name": "keyword.declaration.class.jsw"
            },
            "2": {
              "name": "entity.name.type.class.jsw"
            },
            "3": {
              "name": "punctuation.section.parens.jsw"
            }
          },
          "end": "\\)",
          "endCaptures": {
            "0": {
              "name": "punctuation.section.parens.jsw"
            }
          },
          "patterns": [
            {
              "name": "keyword.other.target-key.jsw",
              "match": "\\b(?:videoTransparency|direction|draggable|namespace|rotation|costume|volume|layer|tempo|video|name|show|size|ns|x|y)\\b(?=\\s*=)"
            },
            {
              "name": "string.quoted.double.jsw",
              "begin": "\"",
              "end": "\""
            },
            {
              "name": "keyword.operator.assignment.jsw",
              "match": "="
            }
          ]
        },
        {
          "comment": "class Name / stage",
          "match": "\\b(class)\\s+([A-Za-z_$][\\w$]*)|\\b(stage)\\b",
          "captures": {
            "1": {
              "name": "keyword.declaration.class.jsw"
            },
            "2": {
              "name": "entity.name.type.class.jsw"
            },
            "3": {
              "name": "keyword.declaration.stage.jsw"
            }
          }
        },
        {
          "comment": "Empty: name=\"Empty\", x=36, y=28, ... - a target declaration.",
          "match": "^(\\s*)([A-Za-z_$][\\w$]*)\\s*(?=:\\s*name=)",
          "captures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "entity.name.type.class.jsw"
            }
          }
        },
        {
          "comment": "public c_en = …; — the declaration names the state.",
          "match": "\\b(public|private|cloud)\\s+(_[A-Za-z0-9_$][\\w$]*)\\s*(?=[=;])",
          "captures": {
            "1": {
              "name": "storage.modifier.jsw"
            },
            "2": {
              "name": "variable.other.temp.jsw"
            }
          }
        },
        {
          "comment": "public b = 0; / cloud score = 0; — the declaration names the state.",
          "match": "\\b(public|private|cloud)\\s+(?!void\\b)([A-Za-z$][\\w$]*)\\s*(?=[=;\\[])",
          "captures": {
            "1": {
              "name": "storage.modifier.jsw"
            },
            "2": {
              "name": "variable.other.readwrite.jsw"
            }
          }
        },
        {
          "comment": "for i in a..b — the inclusive counter form.",
          "match": "\\b(for)\\s+([A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*)\\s+(in)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.jsw"
            },
            "2": {
              "name": "variable.other.loop.jsw"
            },
            "3": {
              "name": "keyword.control.jsw"
            }
          }
        },
        {
          "comment": "void Namespace.name(...) / void name(...)",
          "match": "\\b(void)\\s+([A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)*)",
          "captures": {
            "1": {
              "name": "storage.type.jsw"
            },
            "2": {
              "name": "entity.name.function.jsw"
            }
          }
        }
      ]
    },
    "metadata": {
      "comment": "metadata list Stage.x at 0,0 100x24 hidden; - the mode words and keys are syntax.",
      "patterns": [
        {
          "name": "meta.metadata.jsw",
          "begin": "^(\\s*)(metadata)\\b",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "keyword.declaration.jsw"
            }
          },
          "end": ";|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.jsw"
            }
          },
          "patterns": [
            {
              "comment": "list / large / slider / normal / default",
              "name": "constant.language.monitor-mode.jsw",
              "match": "\\b(?:largeReadout|default|normal|slider|large|list)\\b"
            },
            {
              "comment": "pos / at / hidden / shown / range / watchers",
              "name": "keyword.other.metadata.jsw",
              "match": "\\b(?:continuous|discrete|watchers|hidden|range|shown|max|min|pos|at)\\b"
            },
            {
              "comment": "Stage.Lyrics.zh - the annotated target.",
              "name": "variable.other.member.jsw",
              "match": "\\b[A-Za-z_$][\\w$]*(?:\\.[A-Za-z_$][\\w$]*)+"
            },
            {
              "name": "string.quoted.double.jsw",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "name": "constant.character.escape.jsw",
                  "match": "\\\\."
                }
              ]
            },
            {
              "name": "constant.numeric.jsw",
              "match": "\\b0[xX][0-9a-fA-F]+\\b"
            },
            {
              "name": "constant.numeric.jsw",
              "match": "\\b\\d+(?:\\.\\d+)?(?=[x×])"
            },
            {
              "name": "constant.numeric.jsw",
              "match": "(?<=[x×])\\d+(?:\\.\\d+)?\\b"
            },
            {
              "name": "constant.numeric.jsw",
              "match": "\\b\\d+(?:\\.\\d+)?\\b"
            }
          ]
        }
      ]
    },
    "target": {
      "comment": "stage: costume=0, volume=100, …; and Sprite: name=\"x\", x=0, …;",
      "patterns": [
        {
          "name": "meta.target-declaration.jsw",
          "begin": "^(\\s*)(?:(stage)|([A-Za-z_$][\\w$]*))\\s*(:)(?=\\s*[A-Za-z_$][\\w$]*\\s*=)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.whitespace.leading.jsw"
            },
            "2": {
              "name": "keyword.declaration.stage.jsw"
            },
            "3": {
              "name": "entity.name.type.class.jsw"
            },
            "4": {
              "name": "punctuation.separator.jsw"
            }
          },
          "end": ";|$",
          "endCaptures": {
            "0": {
              "name": "punctuation.terminator.jsw"
            }
          },
          "patterns": [
            {
              "comment": "costume / volume / layer / tempo / video …",
              "name": "keyword.other.target-key.jsw",
              "match": "\\b(?:videoTransparency|direction|draggable|namespace|rotation|costume|volume|layer|tempo|video|name|show|size|ns|x|y)\\b(?=\\s*=)"
            },
            {
              "name": "string.quoted.double.jsw",
              "begin": "\"",
              "end": "\"",
              "patterns": [
                {
                  "name": "constant.character.escape.jsw",
                  "match": "\\\\."
                }
              ]
            },
            {
              "name": "constant.numeric.jsw",
              "match": "\\b\\d+(?:\\.\\d+)?\\b"
            },
            {
              "name": "keyword.operator.assignment.jsw",
              "match": "="
            },
            {
              "name": "punctuation.separator.jsw",
              "match": ","
            }
          ]
        }
      ]
    },
    "variables": {
      "comment": "A temp variable (_x) is a different kind of thing from sprite state.",
      "patterns": [
        {
          "name": "variable.other.temp.jsw",
          "match": "\\b_[A-Za-z0-9_$][\\w$]*\\b"
        },
        {
          "name": "variable.other.object.jsw",
          "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\.)"
        },
        {
          "comment": "A bare identifier: not a call, not a member, but a list name before ``[`` counts.",
          "name": "variable.other.jsw",
          "match": "\\b[A-Za-z_$][\\w$]*\\b(?!\\s*(?:\\(|\\.))"
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.jsw",
          "match": "\\b0[xX][0-9a-fA-F]+\\b"
        },
        {
          "name": "constant.numeric.binary.jsw",
          "match": "\\b0[bB][01]+\\b"
        },
        {
          "name": "constant.numeric.octal.jsw",
          "match": "\\b0[oO][0-7]+\\b"
        },
        {
          "comment": "352x212 — a monitor size, scoped either side of the x.",
          "name": "constant.numeric.jsw",
          "match": "\\b\\d+(?:\\.\\d+)?(?=[x×]\\d)"
        },
        {
          "name": "constant.numeric.jsw",
          "match": "(?<=[x×])\\d+(?:\\.\\d+)?\\b"
        },
        {
          "name": "constant.numeric.jsw",
          "match": "\\b\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?\\b"
        },
        {
          "comment": ".5 — a bare leading dot, also as the end of ``0.05..1``.",
          "name": "constant.numeric.jsw",
          "match": "(?<![\\w])\\.\\d+(?:[eE][+-]?\\d+)?\\b"
        }
      ]
    },
    "calls": {
      "patterns": [
        {
          "comment": "log/warn/error/join/string/block ... - the compiler's builtins.",
          "name": "support.function.builtin.jsw",
          "match": "(?<!\\.)\\b(?:isTurboWarp|breakpoint|isCompiled|startTimer|stopTimer|lengthOf|ceiling|length|string|block|error|float|floor|log10|pow10|acos|asin|atan|ceil|join|menu|sqrt|warn|abs|cos|exp|len|log|sin|tan|ln)\\b(?=\\s*\\()"
        },
        {
          "name": "entity.name.function.call.jsw",
          "match": "\\b[A-Za-z_$][\\w$]*(?=\\s*\\()"
        }
      ]
    },
    "namespaces": {
      "patterns": [
        {
          "comment": "A known extension member: WebSocket.closingCode, Pointerlock.setPointerLock, gtm.load",
          "match": "((\\b(?:AIChatBot|Arduino|Comments|Facemesh|GoogleTeachableMachine|Handpose|JSON|Mem|MoreEvents|ObjectDetection|Pointerlock|Posenet|Ram|Runtime|SpeechRecognition|Temp|Timer|TurboWarp|Util|WebSocket|console|gtm|keySim|microbit))\\s*\\.\\s*)((?:broadcastDataToTargetAndWait|getMyDetectionListItemCount|getNumberOfDetectionsByName|whenDetectionsCountChanged|deleteAllRuntimeVariables|getClassificationInterval|getNameofDetectionByIndex|removeFromMyDetectionList|setClassificationInterval|broadcastToTargetAndWait|getClassificationStatus|setCoordinateReturnType|getMyDetectionListItem|getSavedDetectionCount|saveAndOrderDetections|waitForAnalogThreshold|whenImageLabelDetected|whenSoundLabelDetected|broadcastDataToTarget|changeRuntimeVariable|deleteRuntimeVariable|forEachThreadVariable|runtimeVariableExists|setRGBPredefinedColor|whenAnyObjectDetected|whenPoseLabelDetected|addToMyDetectionList|analogChangeDetected|broadcastDataAndWait|changeThreadVariable|clearMyDetectionList|digitalPinEdgeDetect|getKeypointsDistance|getMinimumConfidence|imageLabelConfidence|isDigitalInputActive|isImageLabelDetected|isSoundLabelDetected|listRuntimeVariables|orderSavedDetections|setMinimumConfidence|setRGBColorFromColor|setVideoTransparency|soundLabelConfidence|threadVariableExists|convertToEnglishNum|getAllItemsArgument|getListOfDetections|isPoseLabelDetected|listThreadVariables|poseLabelConfidence|receivedMessageData|secondaryButtonDown|waitForDigitalInput|closeWithoutReason|currentMillisecond|getMyDetectionList|getRuntimeVariable|isAnythingDetected|isConnectionClosed|jsonArrayRemoveAll|listExistingTimers|setRuntimeVariable|showDetectionBoxes|turnClassification|whenObjectDetected|broadcastToTarget|connectionErrored|exportArduinoCode|getFirmataVersion|getKeypointsAngle|getLastKeyPressed|getRightShoulderX|getRightShoulderY|getThreadVariable|isMouseButtonDown|jsonArrayAnalysis|primaryButtonDown|setDetectionModel|setThreadVariable|whenButtonPressed|activeInputImage|clearMessageLogs|getLeftShoulderX|getLeftShoulderY|isObjectDetected|jsonArrayReverse|ledBlinkAdvanced|middleButtonDown|selectInputImage|setAssistantName|setImageModelUrl|setSoundModelUrl|startRecognition|whenPinConnected|whenValueChanged|closeConnection|closeWithReason|commentReporter|compilerEnabled|getButtonIsDown|getConfidenceOf|isAnalogInRange|isButtonPressed|isPointerLocked|jsonArrayConcat|jsonArrayCreate|jsonArrayDelete|jsonArrayFilter|jsonArrayFromto|jsonArrayInsert|jsonArraySetlen|setLanguageCode|setPoseModelUrl|startResetTimer|stringToBoolean|ternaryOperator|whenStopClicked|whileKeyPressed|beepOnPinForMs|closingMessage|commentBoolean|commentCommand|framerateLimit|getObjectCount|getRightAnkleX|getRightAnkleY|getRightElbowX|getRightElbowY|getRightWristX|getRightWristY|groupCollapsed|jsonArrayItemH|lastKeyPressed|saveDetections|setLookForMode|setPointerLock|setTemperature|whileTrueFalse|broadcastData|buttonPressed|classifyImage|closeWithCode|displaySymbol|everyDuration|getCloneLimit|getConfidence|getImageLabel|getLeftAnkleX|getLeftAnkleY|getLeftElbowX|getLeftElbowY|getLeftWristX|getLeftWristY|getLiveSpeech|getRightKneeX|getRightKneeY|getSoundLabel|isLessOrEqual|isMoreOrEqual|jsonArrayFlat|jsonArrayFrom|jsonArrayJoin|jsonArrayPush|jsonArraySort|jsonVmGetlist|jsonVmSetlist|releaseButton|releaseMiddle|serialDisable|setCloneLimit|setDimensions|setMotorSpeed|startLogTimer|stopBeepForMs|whenKeyAction|whenTrueFalse|cameraActive|clearDisplay|closeMessage|digitalWrite|displayClear|getDimension|getFramerate|getLeftKneeX|getLeftKneeY|getPoseLabel|getRightEarX|getRightEarY|getRightEyeX|getRightEyeY|getRightHipX|getRightHipY|getTiltAngle|getWordCount|getXFromMenu|getYFromMenu|jsonArrayGet|jsonArraySet|jsonHasValue|pressAndWait|readPinSmart|receivedData|regexReplace|releaseMouse|releaseRight|removeTimers|selectCamera|serialEnable|serialStatus|setFramerate|setMaxTokens|setThreshold|setTurboMode|valueOfTimer|Information|changeTimer|clickMiddle|closingCode|concatArray|digitalRead|displayTex