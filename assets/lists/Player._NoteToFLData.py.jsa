["import json", "import sys", "", "def build_fl_data(input_file, output_file=\"FLData.txt\"):", "    notes = []", "    play_ticks = []", "    lengths = []", "    commands = []", "", "    with open(input_file, 'r', encoding='utf-8') as f:", "        for line in f:", "            line = line.strip()", "            if not line:", "                continue", "            try:", "                data = json.loads(line)", "            except:", "                print(f\"\u8df3\u8fc7\u65e0\u6548\u884c: {line}\")", "                continue", "", "            # \u5224\u65ad\uff1a\u6570\u7ec4\u4e14\u957f\u5ea6\u4e3a3\uff0c\u53ef\u80fd\u662f [tick, note, length] \u6216 [1, tick, bpm]", "            if isinstance(data, list) and len(data) == 3:", "                # \u5982\u679c\u7b2c\u4e00\u4e2a\u5143\u7d20\u662f 1\uff0c\u89c6\u4e3a\u547d\u4ee4", "                if data[0] == 1:", "                    commands.append(data)   # \u5df2\u7ecf\u662f [1, tick, bpm]", "                else:", "                    # \u89c6\u4e3a\u97f3\u7b26 [tick, note, length]", "                    tick, note, length = data", "                    play_ticks.append(tick)", "                    notes.append(note)", "                    lengths.append(length)", "            # \u5224\u65ad\uff1a\u5bf9\u8c61\u683c\u5f0f {\"c\":1,\"p\":[tick,bpm]}", "            elif isinstance(data, dict) and data.get(\"c\") == 1 and \"p\" in data:", "                params = data[\"p\"]", "                if isinstance(params, list) and len(params) >= 2:", "                    tick = params[0]", "                    bpm = params[1]", "                    # \u8f6c\u6362\u4e3a\u6570\u7ec4\u683c\u5f0f [1, tick, bpm]", "                    commands.append([1, tick, bpm])", "                else:", "                    print(f\"\u547d\u4ee4\u53c2\u6570\u683c\u5f0f\u9519\u8bef: {data}\")", "            else:", "                print(f\"\u672a\u77e5\u683c\u5f0f: {data}\")", "", "    # \u5199\u5165\u56db\u884c\uff1aNotes, PlayTick, Length, Commands", "    with open(output_file, 'w', encoding='utf-8') as f:", "        f.write(json.dumps(notes, separators=(',', ':')) + '\\n')", "        f.write(json.dumps(play_ticks, separators=(',', ':')) + '\\n')", "        f.write(json.dumps(lengths, separators=(',', ':')) + '\\n')", "        f.write(json.dumps(commands, separators=(',', ':')) + '\\n')", "", "    print(f\"\u5bfc\u51fa\u5b8c\u6210\uff1a{len(notes)} \u4e2a\u97f3\u7b26\uff0c{len(commands)} \u6761\u547d\u4ee4\")", "    print(f\"\u8f93\u51fa\u6587\u4ef6: {output_file} (\u987a\u5e8f: Notes, PlayTick, Length, Commands)\")", "", "if __name__ == \"__main__\":", "    if len(sys.argv) < 2:", "        print(\"\u7528\u6cd5: python build_fl.py <0.txt> [\u8f93\u51fa\u6587\u4ef6]\")", "        sys.exit(1)", "    infile = sys.argv[1]", "    outfile = sys.argv[2] if len(sys.argv) > 2 else \"FLData.txt\"", "    build_fl_data(infile, outfile)", ""]