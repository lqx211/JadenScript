["import mido", "import sys", "import json", "from mido import MidiFile", "from collections import defaultdict, deque", "", "def midi_to_events(midi_path, output_txt, debug=False):", "    mid = MidiFile(midi_path)", "    ppq = mid.ticks_per_beat", "    scale = 16.0 / ppq", "", "    raw_notes = []", "    tempo_events = []", "    pedal_events = []", "", "    for track_idx, track in enumerate(mid.tracks):", "        abs_tick = 0", "        pending = defaultdict(deque)", "        for msg in track:", "            abs_tick += msg.time", "            if msg.type == 'note_on' and msg.velocity > 0:", "                key = (msg.note, msg.channel)", "                pending[key].append(abs_tick)", "            elif msg.type == 'note_off' or (msg.type == 'note_on' and msg.velocity == 0):", "                key = (msg.note, msg.channel)", "                if pending[key]:", "                    start_tick = pending[key].popleft()", "                    end_tick = abs_tick", "                    if end_tick > start_tick:", "                        raw_notes.append((start_tick, end_tick, msg.note, msg.channel, track_idx))", "                    else:", "                        raw_notes.append((start_tick, start_tick+1, msg.note, msg.channel, track_idx))", "            elif msg.type == 'control_change' and msg.control == 64:", "                pedal_events.append((abs_tick, msg.value, track_idx))", "            elif msg.type == 'set_tempo':", "                bpm = 60000000 / msg.tempo", "                tempo_events.append((abs_tick, bpm))", "", "    if not tempo_events:", "        tempo_events.append((0, 120.0))", "", "    # \u7edf\u4e00\u4e3a 5 \u5143\u7ec4: (tick, type, data1, data2, data3)", "    event_queue = []", "    for (start, end, note, ch, tr) in raw_notes:", "        event_queue.append((start, 'note_on', note, ch, tr))", "        event_queue.append((end, 'note_off', note, ch, tr))", "    for (tick, val, tr) in pedal_events:", "        event_queue.append((tick, 'pedal', val, tr, None))", "    for (tick, bpm) in tempo_events:", "        event_queue.append((tick, 'tempo', bpm, None, None))", "", "    event_queue.sort(key=lambda x: x[0])", "", "    sustain = False", "    active_notes = defaultdict(deque)", "    output_events = []", "", "    for item in event_queue:", "        tick = item[0]", "        typ = item[1]", "        if typ == 'note_on':", "            note, ch, tr = item[2], item[3], item[4]", "            key = (note, ch, tr)", "            active_notes[key].append(tick)", "        elif typ == 'note_off':", "            note, ch, tr = item[2], item[3], item[4]", "            key = (note, ch, tr)", "            if not sustain:", "                if active_notes[key]:", "                    start_tick = active_notes[key].popleft()", "                    length = tick - start_tick", "                    if length <= 0:", "                        length = 1", "                    output_events.append((start_tick, 'note', (note, length)))", "        elif typ == 'pedal':", "            val = item[2]", "            was_sustain = sustain", "            sustain = (val >= 64)", "            if not was_sustain and sustain:", "                pass", "            elif was_sustain and not sustain:", "                for key in list(active_notes.keys()):", "                    while active_notes[key]:", "                        start_tick = active_notes[key].popleft()", "                        length = tick - start_tick", "                        if length <= 0:", "                            length = 1", "                        note = key[0]", "                        output_events.append((start_tick, 'note', (note, length)))", "        elif typ == 'tempo':", "            bpm = item[2]", "            output_events.append((tick, 'tempo', bpm))", "", "    if active_notes:", "        max_tick = max([t for t,_,_,_,_ in event_queue]) if event_queue else 0", "        for key in list(active_notes.keys()):", "            while active_notes[key]:", "                start_tick = active_notes[key].popleft()", "                length = max_tick - start_tick", "                if length <= 0:", "                    length = 1", "                note = key[0]", "                output_events.append((start_tick, 'note', (note, length)))", "", "    output_events.sort(key=lambda x: x[0])", "", "    with open(output_txt, 'w', encoding='utf-8') as f:", "        for tick, typ, data in output_events:", "            scaled_tick = int(round(tick * scale))", "            if typ == 'note':", "                note, length_orig = data", "                scaled_length = int(round(length_orig * scale))", "                if scaled_length == 0:", "                    scaled_length = 1", "                f.write(json.dumps([scaled_tick, note, scaled_length]) + '\\n')", "                if debug:", "                    print(f\"DEBUG: {scaled_tick},{note},{scaled_length}\")", "            elif typ == 'tempo':", "                bpm = data", "                scaled_tick = int(round(tick * scale))", "                cmd = {\"c\": 1, \"p\": [scaled_tick, round(bpm, 2)]}", "                f.write(json.dumps(cmd) + '\\n')", "", "    print(f\"\u539f\u59cb\u6709\u6548\u97f3\u7b26\u6570: {len(raw_notes)}\")", "    print(f\"\u5904\u7406\u540e\u8f93\u51fa\u97f3\u7b26\u6570: {len([e for e in output_events if e[1]=='note'])}\")", "    print(f\"\u8f93\u51fa\u6587\u4ef6: {output_txt}\")", "", "if __name__ == \"__main__\":", "    if len(sys.argv) < 2:", "        print(\"Usage: python 0.py <midi_file> [--debug]\")", "        sys.exit(1)", "    midi_file = sys.argv[1]", "    debug = \"--debug\" in sys.argv", "    output_file = \"0.txt\"", "    midi_to_events(midi_file, output_file, debug)", ""]