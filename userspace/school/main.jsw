#enable_feature<commentMetadata>;
#enable_feature<namespacedNames>;

include "cr.jsw";

class model {
    private very_handsome_miss_caleb_wong_model_url = "https://teachablemachine.withgoogle.com/models/rUfcLK4_k";
    private requiredSamples = 20; // How many samples to collect for averaging (20 x 20ms = 0.4s window)
    private requiredConfidence = 0.9; // Least confidence to confirm that the gesture is sure
    private ignored = false;
    private ignore_time = 0;
    private log = [];
    private cu = 0;
    private cl = 0;
    private cr = 0;
    private ck = 0;
    private lu = [];
    private ll = [];
    private lr = [];
    private lk = [];
    private trig = 0;
    private active = 1;
    public void greenFlag() {
        vinit();
        Runtime.setTurboMode(true);
        Runtime.setFramerate(60);
        // The model takes seconds to load and `gtm.load` waits for it, so it
        // runs in its own thread: the game (and the timeout below) must not be
        // held up by a camera that never answers.
        Control.broadcast("gtm load");
        main();
    }
    metadata loadGestures pos 44,44;
    public void loadGestures() { // hook: broadcast gtm load
        init();
    }
    public void vinit(){
        lu.clear();
        ll.clear();
        lr.clear();
        lk.clear();
        trig = 0;
        active = 1;
        ignored = false;
        ignore_time = Sensing.timer();
        log.clear();
    }
    public void main() {
        _t = Sensing.timer()+10;
        Control.waitUntil(gtm.status()=='ready' || gtm.status()=='error' || Sensing.timer()>_t);
        if (gtm.status() == "ready" && gtm.cameraActive()){
            console.log("Model ready!");
        } elif (Sensing.timer() > _t && gtm.status() != "error") {
            console.warn('Still loading the model; gestures start when it is ready.');
        } else {
            // The reason is in lastError(): a refused camera is the common one.
            // Only the gestures are off — the game keeps running, and the arrow
            // keys still work, so nothing here may stop the other scripts.
            console.warn(join('Gestures are off, use the arrow keys: ', gtm.lastError()));
            active = 0;
        }
        while(active){
            trig = 0;
            getConfidence(); // -> trig
            _can = !ignored || Sensing.timer() > ignore_time+0.8; // 800ms cooldown
            if (_can && trig!=0 && trig!=4){
                if (trig==1){
                    controller.mu();
                } elif (trig==2){
                    controller.ml();
                } elif (trig==3){
                    controller.mr();
                }
                ignored = true; // latch only when we acted, so it repeats after the cooldown
                ignore_time = Sensing.timer();
            }
            if (trig==4){ // 'stop' pose releases the latch
                ignored = false;
            }
            Control.wait(0.02); // 20ms per sample, see requiredSamples
        }
    }
    public void init(){
        gtm.load(very_handsome_miss_caleb_wong_model_url); // load the very very handsome miss caleb wong model
        console.info('GTM init success, about to activate camera (may ask for permission)')
        gtm.startCamera();
        console.info('camera init success')
    }
    private void getConfidence(){ // warp
        cu = gtm.confidence('up'); // works great
        cl = gtm.confidence('left'); // something is wrong recognizing left
        cr = gtm.confidence('right'); // works great i guess
        ck = gtm.confidence('stop'); // works great
        lu.append(cu);
        ll.append(cl);
        lr.append(cr);
        lk.append(ck);
        for _i in lu,ll,lr,lk { // New support: for-each over multiple lists (remember warn if its incorrectly used)
            while (_i.length()>requiredSamples){
                _i.delete(1);
            }
        }
        /*  To ensure that it is correct input, all confidence in the list must larger than 0.9
            Confidence values are sampled every 20ms (see Control.wait in main), append to the lists
        */
        _lu_sum = 0;
        _ll_sum = 0;
        _lr_sum = 0;
        _lk_sum = 0;
        _pass = 0;
        for _i in lu {_lu_sum += _i;}
        for _i in ll {_ll_sum += _i;}
        for _i in lr {_lr_sum += _i;}
        for _i in lk {_lk_sum += _i;}
        if (_lu_sum/lu.length()>requiredConfidence && _lu_sum>_ll_sum && _lu_sum>_lr_sum && _lu_sum>_lk_sum){
            _pass = 1;
        } elif (_ll_sum/ll.length()>requiredConfidence && _ll_sum>_lu_sum && _ll_sum>_lr_sum && _ll_sum>_lk_sum){
            _pass = 2;
        } elif (_lr_sum/lr.length()>requiredConfidence && _lr_sum>_lu_sum && _lr_sum>_ll_sum && _lr_sum>_lk_sum){
            _pass = 3;
        } elif (_lk_sum/lk.length()>requiredConfidence && _lk_sum>_lu_sum && _lk_sum>_ll_sum && _lk_sum>_lr_sum){
            _pass = 4;
        }
        trig = _pass;
    }
}

class controller { // cr controller
    public void ml(){
        keySim.press("left arrow");
    }
    public void mr(){
        keySim.press("right arrow");
    }
    public void mu(){
        keySim.press("up arrow");
    }
}
