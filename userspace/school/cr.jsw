    public void whenBackdropChanges() { // hook: backdrop Editor
        Motion.setXY(0, 0);
        if (!"") {
            Control.deleteThisClone();
        }
        CloneID = "Window";
        Control.createClone("_myself_");
        Control.stopOtherScripts();
        while (1) {
            if (FloorData.get(SelectedY) != "" && Operators.contains("SpeedDelay", _CurrentMenu)) {
                Looks.show();
                Looks.switchCostume(join(_CurrentMenu, FloorData.get(SelectedY)));
                if (Sensing.mouseDown()) {
                    if (Sensing.mouseY() < -105 || Sensing.mouseY() > 105 || (Sensing.mouseX() < -155 || Sensing.mouseX() > 155)) {
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _CurrentMenu = 0;
                    }
                }
            } else {
                Looks.hide();
            }
        }
    }

    metadata whenCloned pos -966,2031;
    public void whenCloned() {
        if (CloneID == "Window") {
            CloneID = 0;
            Looks.goToFront();
            while (1) {
                Looks.switchCostume("Cursor");
                if (FloorData.get(SelectedY) != "" && Operators.contains("SpeedDelay", _CurrentMenu)) {
                    Looks.show();
                    if (_CurrentMenu == "Speed") {
                        Position(-10, 10, MovingObjectsData.indexOf(join("#", SelectedY)) + 2);
                    } elif (FloorData.get(SelectedY) == "Road") {
                        Position(0.5, 10, MovingObjectsData.indexOf(join("#", SelectedY)) + 1);
                    } elif (FloorData.get(SelectedY) == "Water") {
                        Position(1.5, 5, MovingObjectsData.indexOf(join("#", SelectedY)) + 1);
                    } else {
                        Position(3, 15, MovingObjectsData.indexOf(join("#", SelectedY)) + 1);
                    }
                } else {
                    Looks.hide();
                }
            }
        } else {
            Looks.goToFront();
            Looks.show();
            Control.wait(0);
            Control.deleteThisClone();
        }
    }

    metadata Position pos -115,2842;
    private void Position(Min, Max, ID) {
        if (Sensing.mouseDown()) {
            if (Sensing.mouseY() < -45 && Sensing.mouseY() > -85 && (Sensing.mouseX() < 95 && Sensing.mouseX() > -95)) {
                Sound.playSound("Click");
                while (Sensing.mouseDown()) {
                    Preprint(Operators.round(MovingObjectsData.get(ID) * 100) / 100, 1, 1, 0);
                    Looks.switchCostume("Cursor");
                    Motion.setXY(Operators.round(-95 + (MovingObjectsData.get(ID) - Min) / (Max - Min) * 190), -65);
                    if (Sensing.mouseX() > 95) {
                        MovingObjectsData.set(ID, Max);
                    } elif (Sensing.mouseX() < -95) {
                        MovingObjectsData.set(ID, Min);
                    } elif (Operators.math("abs", (Sensing.mouseX() + 95) / 190 * (Max - Min) + Min) < 1 && (Min == -10 && Max == 10)) {
                        MovingObjectsData.set(ID, ((Sensing.mouseX() > 0) - 0.5) * 2);
                    } else {
                        MovingObjectsData.set(ID, Operators.round(((Sensing.mouseX() + 95) / 190 * (Max - Min) + Min) * 100) / 100);
                    }
                }
                Sound.playSound("Declick");
            }
        }
        Preprint(Operators.round(MovingObjectsData.get(ID) * 100) / 100, 1, 1, 0);
        Looks.switchCostume("Cursor");
        Motion.setXY(Operators.round(-95 + (MovingObjectsData.get(ID) - Min) / (Max - Min) * 190), -65);
    }

    metadata Preprint pos -153,4293;
    private void Preprint(Value, Size, Progress, Temp) { // warp
        if (Progress < lengthOf(Value) + 1) {
            if (Operators.contains(.1, Operators.letterOf(Progress, Value))) {
                Preprint(Value, Size, Progress + 1, Temp - Size * 1.5);
            } else {
                Preprint(Value, Size, Progress + 1, Temp - Size * 3.5);
            }
        } else {
            Print(Value, Size, 1, Temp, -35);
        }
    }

    metadata Print pos 162,4932;
    private void Print(Value, Size, Progress, X, Y) {
        if (Progress < lengthOf(Value) + 1) {
            Looks.switchCostume(Operators.letterOf(Progress, Value));
            Motion.setXY(Operators.round(X), Y);
            Control.createClone("_myself_");
            if (Operators.contains(.1, Operators.letterOf(Progress, Value))) {
                Print(Value, Size, Progress + 1, X + Size * 3, Y);
            } else {
                Print(Value, Size, Progress + 1, X + Size * 7, Y);
            }
        }
    }
}

