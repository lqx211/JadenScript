                Control.wait(1.5);
                Sound.playSoundUntilDone("OceanTrain");
            } else {
                if ("Space" == Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1)) {
                    Control.wait(1.5);
                    Sound.playSoundUntilDone("Meteorites");
                } else {
                    Sound.playSoundUntilDone("TrainAlert");
                    Sound.playSoundUntilDone(join("Train", Operators.random(1, 2)));
                }
                Control.deleteThisClone();
            }
        } elif (CloneID == "Wood") {
            Sound.playSoundUntilDone(join("Wood", Operators.random(1, 2)));
            Control.deleteThisClone();
        } elif (CloneID == "Jump") {
            Sound.setEffect("PITCH", 0);
            Sound.playSound("Jump");
            if (Operators.random(0, 1) == 1 || _Skin == "Waffles") {
                Sound.setEffect("PITCH", Operators.random(-20, 20));
                Sound.playSoundUntilDone(join("Jump", _Skin));
            }
            Control.deleteThisClone();
        } elif (CloneID == "Lilypads") {
            Sound.playSoundUntilDone("Lilypads");
            Control.deleteThisClone();
        } elif (CloneID == "Gold") {
            if (_Skin == "Mario") {
                Sound.playSoundUntilDone("MarioCoin");
            } else {
                Sound.playSoundUntilDone("Coin");
            }
            Control.deleteThisClone();
        }
    }

    metadata Gold pos -67,2627;
    public void Gold() { // hook: broadcast Gold
        CloneID = "Gold";
        Control.createClone("_myself_");
    }

    metadata Jump pos -148,2920;
    public void Jump() { // hook: broadcast Jump
        if (CloneID == 0) {
            CloneID = "Jump";
            Control.createClone("_myself_");
            CloneID = 0;
            Control.wait(0.1);
            if (_GameStatus == 1) {
                if (FloorData.get(Player___Y - __DELETED_ITEMS) == "Water") {
                    CloneID = "Wood";
                    Control.createClone("_myself_");
                } elif (FloorData.get(Player___Y - __DELETED_ITEMS) == "Lilypads") {
                    CloneID = "Lilypads";
                    Control.createClone("_myself_");
                }
            }
            CloneID = 0;
        }
    }

    metadata CheckTrainComing pos 607,2924;
    private void CheckTrainComing(Start, Speed, Delay, Y) { // warp
        if (Operators.math("abs", (TIMER + 1 + Start * Delay) * Speed) > 0 && Operators.math("abs", (TIMER + 1 + Start * Delay) * Speed) < 37.5) {
            OldStart.set(OldStart.indexOf(join("#", Y)) + 1, Start);
            CloneID = "TrainAlert";
            Control.createClone("_myself_");
        }
    }

    metadata CheckTrain pos 692,3473;
    private void CheckTrain(Progress) { // warp
        if (Progress < Operators.round(ScrollY) + 7) {
            if (FloorData.get(Progress - __DELETED_ITEMS) == "Rails") {
                if (!(OldStart.contains(join("#", Progress)))) {
                    OldStart.add(join("#", Progress));
                    OldStart.add(0);
                }
                if (Operators.round(TIMER / (-1 * MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Progress)) + 1))) < OldStart.get(OldStart.indexOf(join("#", Progress)) + 1)) {
                    CheckTrainComing(Operators.round(TIMER / (-1 * MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Progress)) + 1))), MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Progress)) + 2), MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Progress)) + 1), Progress);
                }
            }
            CheckTrain(Progress + 1);
        }
    }
}

