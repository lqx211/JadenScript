    metadata PrePrint pos 661,2684;
    private void PrePrint(Value, Size, Progress) { // warp
        if (Progress < lengthOf(Value) + 1) {
            if (Operators.contains("1G", Operators.letterOf(Progress, Value))) {
                Temp2 += Size * 7;
            } else {
                Temp2 += Size * 12;
            }
            PrePrint(Value, Size, Progress + 1);
        } else {
            Print(Temp2 / -2, 0, Size, 1, Value);
        }
    }

    metadata Print pos 988,3266;
    private void Print(X, Y, Size, Progress, Value) {
        if (Progress < lengthOf(Value) + 1) {
            Looks.switchCostume(join(Operators.letterOf(Progress, Value), "Yellow"));
            Motion.setXY(X, Y);
            Looks.size = Size * 100;
            Control.createClone("_myself_");
            if (Operators.contains("1G", Operators.letterOf(Progress, Value))) {
                Print(X + Size * 7, Y, Size, Progress + 1, Value);
            } else {
                Print(X + Size * 12, Y, Size, Progress + 1, Value);
            }
        }
    }

