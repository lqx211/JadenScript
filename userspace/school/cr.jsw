    metadata Editor___Remove pos 2356,64;
    public void Editor___Remove(Start, Decalage, Progress) { // proccode Decalage %s %s %s // warp // receiver at 2356,976 "Editor : Remove"
        if (Decalage > 0) {
            if (Progress > Start) {
                if (MovingObjectsData.contains(join("#", Progress - 1))) {
                    MovingObjectsData.set(MovingObjectsData.indexOf(join("#", Progress - 1)), join("#", Progress));
                }
                Editor___Remove(Start, Decalage, Progress - 1);
            }
        } elif (Start + Progress < FloorData.length() + 2) {
            if (MovingObjectsData.contains(join("#", Start + Progress))) {
                MovingObjectsData.set(MovingObjectsData.indexOf(join("#", Start + Progress)), join("#", Start + Progress - 1));
            }
            Editor___Remove(Start, Decalage, Progress + 1);
        }
    }

    metadata AddWater pos 4063,64;
    private void AddWater(Y) { // warp
        if (FloorData.length() < Y) {
            FloorData.add("Water");
            ObjectsData.add("000000000000000");
        } else {
            FloorData.insert(Y, "Water");
            ObjectsData.insert(Y, "000000000000000");
        }
        Editor___Remove(Y, 1, FloorData.length() + 1);
        MovingObjectsData.add(join("#", Y));
        MovingObjectsData.add(2);
        MovingObjectsData.add(5 * (((Y / 2 == Operators.round(Y / 2)) - 0.5) * 2));
        MovingObjectsData.add(1);
    }

    metadata AddRails pos 5075,64;
    private void AddRails(Y) { // warp
        if (FloorData.length() < Y) {
            FloorData.add("Rails");
            ObjectsData.add("000000000000000");
        } else {
            FloorData.insert(Y, "Rails");
            ObjectsData.insert(Y, "000000000000000");
        }
        Editor___Remove(Y, 1, FloorData.length() + 1);
        MovingObjectsData.add(join("#", Y));
        MovingObjectsData.add(Operators.random(5, 10));
        MovingObjectsData.add((Operators.random(0, 1) - 0.5) * 100);
    }

    metadata whenBackdropChanges pos 48,328;
    public void whenBackdropChanges() { // hook: backdrop Loading
        Control.stopOtherScripts();
        Looks.hide();
        Control.deleteThisClone();
    }

    metadata NewLevel pos 985,328;
    private void NewLevel() { // warp
        CoinsData.clear();
        FloorData.clear();
        MovingObjectsData.clear();
        ObjectsData.clear();
        if (_ImportedLevel != "") {
            Control.broadcast("LevelImport");
        } else {
            repeat (10) {
                AddGrass(10);
            }
        }
    }

    metadata whenBackdropChanges pos 448,488;
    public void whenBackdropChanges() { // hook: backdrop CustomGame
        if (!"") {
            Control.deleteThisClone();
        }
        Control.stopOtherScripts();
        NewLevel();
    }

    metadata whenBackdropChanges pos 48,592;
    public void whenBackdropChanges() { // hook: backdrop Editor
        if (!"") {
            Control.deleteThisClone();
        }
        Control.stopOtherScripts();
        NewLevel();
        Looks.show();
        Looks.switchCostume("Base0");
        SelectedY = 11;
        _CurrentMenu = 0;
        while (1) {
            if (_CurrentMenu == 0) {
                Looks.switchCostume("Base0");
                if (Sensing.mouseDown() && Sensing.mouseY() > 120) {
                    if (Sensing.mouseX() < -150) {
                        Looks.switchCostume("Base1");
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _NextBG = "Game";
                        Looks.switchBackdrop("Loading");
                    } elif (Sensing.mouseX() > 175) {
                        Looks.switchCostume("Base3");
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _CurrentMenu = "Import";
                        Control.broadcastAndWait("Editor : ImportPopUp");
                        _CurrentMenu = 0;
                        if (Sensing.answer() != "" && Sensing.answer() != "nothing") {
                            _ImportedLevel = Sensing.answer();
                            _NextBG = "Editor";
                            Looks.switchBackdrop("Loading");
                        }
                    } elif (Sensing.mouseX() > 115) {
                        Looks.switchCostume("Base4");
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _CurrentMenu = "Export";
                        Control.broadcastAndWait("Editor : ExportPopUp");
                        _CurrentMenu = 0;
                    } elif (Sensing.mouseX() > 55) {
                        Looks.switchCostume("Base5");
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _CurrentMenu = "Tutorial";
                        Control.broadcastAndWait("Editor : Tutorial");
                        _CurrentMenu = 0;
                    }
                } elif (Sensing.mouseDown() && (Sensing.mouseY() < -120 && Sensing.mouseX() < -175)) {
                    Looks.switchCostume("Base2");
                    Sound.playSound("Click");
                    Control.waitUntil(!Sensing.mouseDown());
                    Sound.playSound("Declick");
                    _CurrentMenu = "Add";
                }
            } elif (_CurrentMenu == "Add") {
                Looks.switchCostume("Base2");
                if (Sensing.mouseDown()) {
                    if (Sensing.mouseY() < 90 && (Sensing.mouseY() > -120 && Sensing.mouseX() < 130)) {
                        if (Sensing.mouseY() > -15) {
                            if (Sensing.mouseX() > 25) {
                                AddLilypads(SelectedY);
                            } elif (Sensing.mouseX() > -75) {
                                AddWater(SelectedY);
                            } else {
                                AddGrass(SelectedY);
                            }
                        } elif (Sensing.mouseX() > -25) {
                            AddRoad(SelectedY);
                        } else {
                            AddRails(SelectedY);
                        }
                    }
                    Sound.playSound("Click");
                    Control.waitUntil(!Sensing.mouseDown());
                    Sound.playSound("Declick");
                    _CurrentMenu = 0;
                }
            }
        }
    }

    metadata AddRoad pos 4063,824;
    private void AddRoad(Y) { // warp
        if (FloorData.length() < Y) {
            FloorData.add("Road");
            ObjectsData.add("000000000000000");
        } else {
            FloorData.insert(Y, "Road");
            ObjectsData.insert(Y, "000000000000000");
        }
        Editor___Remove(Y, 1, FloorData.length() + 1);
        MovingObjectsData.add(join("#", Y));
        MovingObjectsData.add(2);
        MovingObjectsData.add(5 * ((Operators.random(0, 1) - 0.5) * 2));
        MovingObjectsData.add(Operators.random(1, 6));
    }

    metadata AddLilypads pos 2356,1152;
    private void AddLilypads(Y) { // warp
        if (FloorData.length() < Y) {
            FloorData.add("Lilypads");
            ObjectsData.add("000000070000000");
        } else {
            FloorData.insert(Y, "Lilypads");
            ObjectsData.insert(Y, "000000070000000");
        }
        Editor___Remove(Y, 1, FloorData.length() + 1);
    }

    metadata AddGrass pos 4063,1560;
    private void AddGrass(Y) { // warp
        if (FloorData.length() < Y) {
            FloorData.add("Grass");
            ObjectsData.add("000000000000000");
        } else {
            FloorData.insert(Y, "Grass");
            ObjectsData.insert(Y, "000000000000000");
        }
        Editor___Remove(Y, 1, FloorData.length());
    }
}

