    metadata CheckRoad pos 1622,638;
    private void CheckRoad(Progress) {
        if (Progress < Operators.round(ScrollY) + 7) {
            if (FloorData.get(Progress - __DELETED_ITEMS) == "Road") {
                Sound.setEffect("PITCH", Operators.random(-20, 20));
                Sound.playSoundUntilDone("Klaxon");
                Sound.setEffect("PITCH", 0);
            } else {
                CheckRoad(Progress + 1);
            }
        }
    }

