        OldStart = -1;
        if (CloneID == "Klaxon") {
            while (1) {
                Control.wait(Operators.random(1, 5.0));
                if (!Operators.contains("MarioSpaceOcean", Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1))) {
                    CheckRoad(Operators.round(ScrollY) - 6);
