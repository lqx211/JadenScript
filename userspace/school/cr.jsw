    metadata Tick_Lose pos 6999,881;
    private void Tick_Lose() { // proccode Tick+Lose
        while (!(_GameStatus > 1)) {
            Tick();
            PlayerScroll();
            ScrollY += (Camera___Y - ScrollY) / (FPS / 5);
        }
        if (_GameStatus == 4) {
            if ("Space" == Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1)) {
                Sound.playSound("DieSpace");
            } elif ("Ocean" == Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1)) {
                Sound.playSound("OceanWaterLose");
            } else {
                Sound.playSound("Plouf");
            }
            Player___Z = -0.1;
            while (!(Player___Z < -35 - 300 * Operators.contains("SpaceOcean", Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1)))) {
                Player___Z += (-20 - 25 * Operators.contains("SpaceOcean", Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1))) / (FPS / 4);
                ScrollY += (Player___Y - ScrollY) / (FPS / 5);
                PlayerScroll();
            }
        } elif (_GameStatus == 5) {
            if ("Space" == Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1)) {
                Sound.playSound("DieSpace");
            } else {
                Sound.playSound("Emporté par eau");
            }
            while (!(Operators.math("abs", Player___X + Pxoffset) > 8 && TIMER > TempChrono + 3)) {
                Pxoffset = (TIMER - TEMPTIMER) * MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Player___Y)) + 2);
                WorldShakingX = Operators.random(-5, 5.0);
                WorldShakingY = Operators.random(-5, 5.0);
                ScrollY += (Player___Y - ScrollY) / (FPS / 5);
                PlayerScroll();
            }
            WorldShakingX = 0;
            WorldShakingY = 0;
        } elif (_GameStatus == 3) {
            Sound.playSound("Bonk");
            while (!(Player___X == PxScroll && Player___Y == PyScroll)) {
                _LastKey = "Flat";
                ScrollY += (Player___Y - ScrollY) / (FPS / 5);
                PlayerScroll();
            }
        } elif (_GameStatus == 2) {
            Sound.playSound(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Eagle"));
            TEMPTIMER = TIMER + 0.5 * ("Ocean" == Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1));
            while (!(TIMER - TEMPTIMER > 0.5)) {
                ScrollY += (Player___Y - ScrollY) / (FPS / 5);
                PlayerScroll();
            }
            Player___Y = 0;
            PyScroll = 0;
        } elif (_GameStatus == 6) {
            Sound.playSound("Bonk");
            TEMPTIMER = TIMER;
            Player___Y = 0;
            PyScroll = 0;
            while (!(TIMER - TEMPTIMER > 2)) {
                ScrollY += (TEMPY - ScrollY) / (FPS / 5);
                PlayerScroll();
            }
        } elif (_GameStatus == 7) {
            TEMPTIMER = TIMER;
            while (!(TIMER - TEMPTIMER > 2)) {
                ScrollY += (TEMPY - ScrollY) / (FPS / 5);
                PlayerScroll();
            }
        }
    }

