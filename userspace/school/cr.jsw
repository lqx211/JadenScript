Support: name="Support", x=0, y=0, size=100, direction=90, show=0, costume=1, volume=0, layer=47, rotation="all", draggable=0;
class Support {
    import "assets/3d78638bfbadfce8c40c26d583090dea.svg" as Ad0; // costume centerx=240 centery=180 res=1
    import "assets/53deef9833bd117629d45911f5284f06.svg" as Ad1; // costume centerx=240 centery=180 res=1
    import "assets/da9c453d9d3b87241c8f275538389ade.svg" as Ad2; // costume centerx=240 centery=180 res=1
    import "assets/8ddb466f27e0f5dc1b435df1956feae8.wav" as Click; // sound rate=44100 samples=3097
    import "assets/0e67ae1ac2d530c323984f79928f2a7a.wav" as Declick; // sound rate=44100 samples=2500

    metadata Support_Message pos 120,274;
    public void Support_Message() { // hook: broadcast Support Message
        Looks.hide();
    }

    loose { // at 600,180
        // looks_gotofrontback
                Looks.goToFront();
                Looks.show();
                Looks.switchCostume("Ad0");
                Control.wait(2);
                Looks.switchCostume("Ad1");
                Control.waitUntil(Sensing.mouseDown());
                Sound.playSound("Click");
                Looks.switchCostume("Ad2");
                Control.waitUntil(!Sensing.mouseDown());
                Sound.playSound("Declick");
    }
}

