    metadata Print pos 653,185;
    private void Print(X, Y, Value, Color, Sens, Progress, Size) { // warp
        Looks.size = Size * 100;
        Looks.switchCostume(join(Operators.letterOf(Progress, Value), Color));
        Motion.setXY(X, Y);
        Control.createClone("_myself_");
        if (Sens == 1) {
            if (Progress < lengthOf(Value)) {
                if (Operators.contains("1 ", Operators.letterOf(Progress, Value))) {
                    Print(X + 7 * Size, Y, Value, Color, Sens, Progress + 1, Size);
                } else {
                    Print(X + 12 * Size, Y, Value, Color, Sens, Progress + 1, Size);
                }
            }
        } elif (Progress > 1) {
            if (Operators.contains("1 ", Operators.letterOf(Progress - 1, Value))) {
                Print(X - 7 * Size, Y, Value, Color, Sens, Progress - 1, Size);
            } else {
                Print(X - 12 * Size, Y, Value, Color, Sens, Progress - 1, Size);
            }
        }
    }

