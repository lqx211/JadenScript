    metadata DrawCoin pos 898,-816;
    private void DrawCoin(Y, Progress, Ypro, Grass) { // proccode DrawCoin %s %s %s %b
        Looks.clearGraphicEffects();
        Looks.switchCostume("Coin");
        if (Grass) {
            if (Operators.letterOf(Progress + 8, CoinsData.get(Y - __DELETED_ITEMS)) == 1) {
                Pen.stamp();
            }
        } elif (Progress < 5) {
            Motion.setXY(Progress * 50 + Ypro * 20 + WorldShakingX, Ypro * 40 + Progress * -10 + WorldShakingY);
            if (Operators.letterOf(Progress + 8, CoinsData.get(Y - __DELETED_ITEMS)) == 1) {
                Pen.stamp();
            }
            DrawCoin(Y, Progress + 1, Ypro, "");
        }
    }

    metadata GB pos 14339,-714;
    private void GB(Environment, Prefix) {
        Motion.setXY(0, 0);
        Looks.switchCostume(join(Prefix, Environment));
        Looks.clearGraphicEffects();
        if (Looks.costumeName() == join(Prefix, Environment)) {
            Pen.stamp();
        }
    }

    metadata ColorEffect_ pos -69,-376;
    private void ColorEffect_() { // proccode ColorEffect?
        Looks.clearGraphicEffects();
        if (Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1) == "PacMan") {
            Looks.setEffect("COLOR", TIMER * 10);
        }
    }

    metadata whenBackdropChanges pos 14400,-245;
    public void whenBackdropChanges() { // hook: backdrop Editor
        while (1) {
            Pen.eraseAll();
            GB(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Background");
            Floor(ScrollX - Operators.round(ScrollX) - DisplayX, Operators.round(ScrollY) - ScrollY + DisplayY, Operators.round(ScrollY) + DisplayY, Operators.round(ScrollX) - DisplayX);
            GB(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Foreground");
            Looks.clearGraphicEffects();
        }
    }

    metadata whenBackdropChanges pos 19812,-144;
    public void whenBackdropChanges() { // hook: backdrop Intro
        Control.stopOtherScripts();
        Pen.eraseAll();
    }

    metadata CheckTrainComing pos 15936,0;
    private void CheckTrainComing(Start, Progress, Speed, Delay, Y, Costume, X, CentreWay_) { // proccode CheckTrainComing %s %s %s %s %s %s %s %b
        if (Operators.math("abs", (TIMER + 1 + (Start + Operators.round(Progress)) * Delay) * Speed) > 0 && Operators.math("abs", (TIMER + 1 + (Start + Operators.round(Progress)) * Delay) * Speed) < 37.5) {
            if (Costume == "RailsLightAlert") {
                Looks.switchCostume("RailsLightAlerttrue");
            } else {
                Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), Costume, 1 + (Operators.round((TIMER + 1 + (Start + Operators.round(Progress)) * Delay) * Speed / 25 + 0.5) - Operators.round((TIMER + 1 + (Start + Operators.round(Progress)) * Delay) * Speed / 25))));
            }
        } elif (Costume == "RailsLightAlert") {
            Looks.switchCostume("RailsLightAlertfalse");
        } else {
            Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), Costume, ""));
        }
    }

    metadata DrawPlayer pos 7853,64;
    private void DrawPlayer(Ypro, Y) {
        if (Y == Operators.round(PyScroll)) {
            Looks.clearGraphicEffects();
            Looks.switchCostume(join(_Skin, _LastKey));
            Looks.size = 100 - ((Sensing.mouseDown() || (Sensing.keyPressed("left arrow") || Sensing.keyPressed("right arrow") || (Sensing.keyPressed("down arrow") || Sensing.keyPressed("up arrow")))) && _GameStatus == 1) * 10;
            Motion.setXY((PxScroll + Pxoffset) * 50 + (Ypro + (PyScroll - Operators.round(PyScroll))) * 20 + WorldShakingX, (Ypro + (PyScroll - Operators.round(PyScroll))) * 40 + (PxScroll + Pxoffset) * -10 + (Player___Z * 4 + 50 * ((Operators.math("abs", Player___X - (Player___X - Operators.round(Player___X)) + (PxScroll - (Player___X - Operators.round(Player___X))) - Operators.round(Player___X - (Player___X - Operators.round(Player___X)) + (PxScroll - (Player___X - Operators.round(Player___X))))) + Operators.math("abs", Player___Y - (Player___Y - Operators.round(Player___Y)) + (PyScroll - (Player___Y - Operators.round(Player___Y))) - Operators.round(Player___Y - (Player___Y - Operators.round(Player___Y)) + (PyScroll - (Player___Y - Operators.round(Player___Y)))))) / 2)) + WorldShakingY);
            Pen.stamp();
            Looks.size = 100;
        }
    }

    metadata whenBackdropChanges pos 19796,64;
    public void whenBackdropChanges() { // hook: backdrop Loading
        Control.stopOtherScripts();
        Pen.eraseAll();
    }

    metadata MovingObjects pos 20238,64;
    private void MovingObjects(Progress, Start, Delay, Speed, Y, DisplayedPlayer_, Costume, YReal) { // proccode MovingObjects %s %s %s %s %s %b %s %s
        if (!DisplayedPlayer_ && FloorData.get(YReal - __DELETED_ITEMS) != "Water" && Progress == 0) {
            DrawPlayer(Y, YReal);
            if (FloorData.get(YReal - __DELETED_ITEMS) != "Road") {
                ColorEffect_();
            }
            MovingObjects(Progress, Start, Delay, Speed, Y, !"", Costume, YReal);
        }
        if (FloorData.get(YReal - __DELETED_ITEMS) != "Rails") {
            if (Speed != 0) {
                if (Operators.math("abs", (TIMER + (Start + Progress) * Delay) * Speed) - 10 < 10) {
                    Looks.switchCostume("Empty");
                    Motion.setXY(((TIMER + (Start + Progress) * Delay) * Speed - 10) * 50 + Y * 20 + WorldShakingX, Y * 40 + ((TIMER + (Start + Progress) * Delay) * Speed - 10) * -10 + WorldShakingY);
                    Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), Costume));
                    Pen.stamp();
                    MovingObjects(Progress + Speed / Operators.math("abs", Speed), Start, Delay, Speed, Y, DisplayedPlayer_, Costume, YReal);
                } elif (!DisplayedPlayer_ && FloorData.get(YReal - __DELETED_ITEMS) == "Water") {
                    DrawPlayer(Y, YReal);
                }
            }
        } else {
            Trains(Progress, Start, Delay, Speed, Y);
        }
    }

    metadata Trains pos 26385,64;
    private void Trains(Progress, Start, Delay, Speed, Y) {
        if (Speed != 0) {
            if (Operators.contains("SpaceOcean", Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1))) {
                if (Operators.math("abs", (TIMER + 1.5 + (Start + Progress) * Delay) * (Speed / 2)) < 35) {
                    if (Speed < 0) {
                        DrawTrain((TIMER + 1.5 + (Start + Progress) * Delay) * (Speed / 2) + 4, Y, 0, Speed / Operators.math("abs", Speed), !"");
                    } else {
                        DrawTrain((TIMER + 1.5 + (Start + Progress) * Delay) * (Speed / 2) - 19, Y, 0, Speed / Operators.math("abs", Speed), !"");
                    }
                }
            }
            if (Operators.math("abs", (TIMER + (Start + Progress) * Delay) * Speed) < 35) {
                if (Speed < 0) {
                    DrawTrain((TIMER + (Start + Progress) * Delay) * Speed + 4, Y, 0, Speed / Operators.math("abs", Speed), "");
                } else {
                    DrawTrain((TIMER + (Start + Progress) * Delay) * Speed - 19, Y, 0, Speed / Operators.math("abs", Speed), "");
                }
            }
        }
    }

    metadata whenBackdropChanges pos 14464,74;
    public void whenBackdropChanges() { // hook: backdrop Game
        while (1) {
            Pen.eraseAll();
            GB(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Background");
            Floor(ScrollX - Operators.round(ScrollX) - DisplayX, Operators.round(ScrollY) - ScrollY + DisplayY, Operators.round(ScrollY) + DisplayY, Operators.round(ScrollX) - DisplayX);
            GB(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Foreground");
            Looks.clearGraphicEffects();
        }
    }

    metadata Objects pos 128,84;
    private void Objects(Xpro, Ypro, X, Y) {
        if (FloorData.get(Y - __DELETED_ITEMS) != "") {
            ColorEffect_();
            Looks.switchCostume("Empty");
            if (FloorData.get(Y - __DELETED_ITEMS) == "Grass" || FloorData.get(Y - __DELETED_ITEMS) == "Lilypads") {
                RailsLight("", Y, Ypro, X, "RailsBanner");
                Motion.setXY(Xpro * 50 + Ypro * 20 + WorldShakingX, Ypro * 40 + Xpro * -10 + WorldShakingY);
                DrawCoin(Y, Xpro, Ypro, !"");
                ColorEffect_();
                Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Object", Operators.letterOf(Xpro + 8, ObjectsData.get(Y - __DELETED_ITEMS))));
                Pen.stamp();
                if (X == Operators.round(PxScroll)) {
                    DrawPlayer(Ypro, Y);
                }
                ColorEffect_();
                RailsLight("", Y, Ypro, X, "RailsLight");
                if (Xpro < DisplayX) {
                    Objects(Xpro + 1, Ypro, X + 1, Y);
                }
            } else {
                RailsLight(!"", Y, Ypro, X, "RailsBanner");
                DrawCoin(Y, -4, Ypro, "");
                if (FloorData.get(Y - __DELETED_ITEMS) != "Road") {
                    ColorEffect_();
                } else {
                    Looks.clearGraphicEffects();
                }
                MovingObjects(0, Operators.round(TIMER / (-1 * MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 1))), MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 1), MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 2), Ypro, "", join(Translate_Object___Floor.get(Translate_Object___Floor.indexOf(FloorData.get(Y - __DELETED_ITEMS)) + 1), MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 3), MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 2) / Operators.math("abs", MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 2))), Y);
                ColorEffect_();
                RailsLight(!"", Y, Ypro, X, "RailsLight");
            }
        } elif (Y - __DELETED_ITEMS == FloorData.length() + 1) {
            if (X == Operators.round(PxScroll)) {
                DrawPlayer(Ypro, Y);
            }
            Looks.switchCostume("Empty");
            Motion.setXY(Xpro * 50 + Ypro * 20 + WorldShakingX, Ypro * 40 + Xpro * -10 + WorldShakingY);
            Looks.switchCostume("Finish");
            Pen.stamp();
            ColorEffect_();
            RailsLight("", Y, Ypro, X, "RailsLight");
            if (Xpro < DisplayX) {
                Objects(Xpro + 1, Ypro, X + 1, Y);
            }
        }
    }

    metadata Floor pos 22432,118;
    private void Floor(Xpro, Ypro, Y, X) { // warp
        ColorEffect_();
        Looks.switchCostume("Empty");
        Motion.setXY(Xpro * 50 + Ypro * 20 + WorldShakingX, Ypro * 40 + Xpro * -10 + WorldShakingY);
        if (FloorData.get(Y - __DELETED_ITEMS) == "Grass" || FloorData.get(Y - __DELETED_ITEMS) == "") {
