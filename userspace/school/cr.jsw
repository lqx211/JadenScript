                Looks.switchCostume("BluBG1");
                Sound.playSound("Click");
                Control.waitUntil(!Sensing.mouseDown());
                Sound.playSound("Declick");
                Looks.hide();
                _CurrentMenu = 0;
            }
        }
    }

