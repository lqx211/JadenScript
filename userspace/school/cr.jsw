    metadata whenBackdropChanges pos 8653,64;
    public void whenBackdropChanges() { // hook: backdrop Editor
        Control.stopOtherScripts();
        SelectedY = 11;
        _LastKey = "Down";
        Player___X = 0;
        Player___Y = 10;
        Player___Z = 0;
        ScrollX = 0;
        ScrollY = 10;
        Camera___X = 0;
        Camera___Y = 10;
        PyScroll = 10;
        PxScroll = 0;
        TEMPY = Player___Y;
        Pxoffset = 0;
        WorldShakingX = 0;
        WorldShakingY = 0;
        while (Looks.backdropName() == "Editor") {
            ScrollY += (SelectedY - ScrollY) / (FPS / 5);
            if (Sensing.keyPressed("up arrow")) {
                if (_CurrentMenu == 0) {
                    while (!(!Sensing.keyPressed("up arrow") || Looks.backdropName() != "Editor")) {
                        ScrollY += (SelectedY - ScrollY) / (FPS / 5);
                    }
                    if (SelectedY < FloorData.length() + 1) {
                        SelectedY += 1;
                    }
                }
                while (Sensing.keyPressed("up arrow")) {
                    ScrollY += (SelectedY - ScrollY) / (FPS / 5);
                }
            }
            if (Sensing.keyPressed("down arrow")) {
                if (_CurrentMenu == 0) {
                    while (!(!Sensing.keyPressed("down arrow") || Looks.backdropName() != "Editor")) {
                        ScrollY += (SelectedY - ScrollY) / (FPS / 5);
                    }
                    if (SelectedY > 11) {
                        SelectedY -= 1;
                    }
                }
                while (Sensing.keyPressed("down arrow")) {
                    ScrollY += (SelectedY - ScrollY) / (FPS / 5);
                }
            }
            if (Sensing.mouseDown()) {
                if (_CurrentMenu == 0) {
                    if (0 != Operators.round((Sensing.mouseY() - Sensing.mouseX() / 50 * -10) / 40) && Sensing.mouseX() > -175 && Sensing.mouseX() < 175 && Sensing.mouseY() > -125 && Sensing.mouseY() < 125) {
                        EditorSlide(Sensing.mouseX(), Sensing.mouseY());
                    }
                }
            }
        }
    }

