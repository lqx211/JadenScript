    public void whenCloned() {
        Looks.goToFront();
        if (Operators.contains(CloneID, "Prize")) {
            Motion.setXY(0, 0);
            Looks.switchCostume(CloneID);
            Looks.clearGraphicEffects();
            Looks.size = 100;
            Looks.show();
            Control.waitUntil(_CurrentMenu == "WinAPrize3");
            if (CloneID == "PrizeMachine1") {
                WinACharacter();
                Looks.size = 100;
                while (!(_CurrentMenu == 0)) {
                    Looks.size += "";
                }
            }
            Control.deleteThisClone();
        } elif (Operators.contains(CloneID, "Box")) {
            Motion.setXY(-30, -74);
            Looks.switchCostume("Box1");
            Looks.clearGraphicEffects();
            Looks.size = 100;
            Looks.show();
            Control.waitUntil(_CurrentMenu == "WinAPrize2");
            Sound.playSound("Machine à prix Boxappear");
            while (!(Operators.round(Motion.x) == 33)) {
                Motion.x += (33 - Motion.x) / (FPS / 10);
                Motion.y += (-93 - Motion.y) / (FPS / 10);
            }
            Control.wait(0.5);
            Looks.goToFront();
            while (!(Operators.round(Motion.x) == 0)) {
                Looks.size += "";
                Motion.x += (0 - Motion.x) / (FPS / 5);
                Motion.y += (0 - Motion.y) / (FPS / 5);
            }
            Control.wait(0.5);
            Sound.playSound("Machine a prix New character");
            Looks.switchCostume("BluBG");
            Looks.setEffect("BRIGHTNESS", 100);
            _CurrentMenu = "WinAPrize3";
            repeat (25) {
                Looks.changeEffect("GHOST", 4);
            }
            Control.deleteThisClone();
        } else {
            if (CloneID == 1) {
                Temp = 40;
                Temp2 = 20;
            } elif (CloneID == 2) {
                Temp = 45;
                Temp2 = 45;
            } elif (CloneID == 3) {
                Temp = -25;
                Temp2 = 20;
            } elif (CloneID == 4) {
                Temp = -35;
                Temp2 = 60;
            } elif (CloneID == 5) {
                Temp = 5;
                Temp2 = 5;
            } else {
                Temp = 0;
                Temp2 = 40;
            }
            Motion.setXY(Temp, Temp2);
            Looks.switchCostume(join("Box", Operators.random(1, 4)));
            Looks.clearGraphicEffects();
            Looks.size = 100;
            Looks.show();
            Control.waitUntil(_CurrentMenu == "WinAPrize1");
            repeat (FPS * 4) {
                Motion.setXY(Temp + Operators.random(-3, 3), Temp2 + Operators.random(-3, 3));
            }
            Motion.setXY(Temp, Temp2);
            _CurrentMenu = "WinAPrize2";
            Control.waitUntil(_CurrentMenu == "WinAPrize3");
            Control.deleteThisClone();
        }
    }

    metadata WinACharacter pos -421,231;
    private void WinACharacter() { // warp
        TempChar.clear();
        Temp = 0;
        while (!(Temp == All_Skins.length())) {
            Temp += 1;
            if (!(Owned_Skins.contains(All_Skins.get(Temp)))) {
                TempChar.add(All_Skins.get(Temp));
            }
        }
        Temp = TempChar.get(Operators.random(1, TempChar.length()));
        Owned_Skins.add(Temp);
        Looks.switchCostume(Temp);
    }

    metadata whenBackdropChanges pos -338,1197;
    public void whenBackdropChanges() { // hook: backdrop Game
        if (!"") {
            Control.deleteThisClone();
        }
        Control.stopOtherScripts();
        Control.waitUntil(_GameStatus == 0);
        Looks.hide();
        Control.waitUntil(_GameStatus > 1);
        while (1) {
            Looks.hide();
            Control.waitUntil(_CurrentMenu == "WinAPrize");
            Looks.switchCostume("BluBG0P");
            Looks.show();
            Motion.setXY(0, 0);
            Looks.size = 100;
            SETUP();
            Control.waitUntil(Sensing.mouseDown());
            if (!(Sensing.mouseX() < -150 && Sensing.mouseY() > 130)) {
                Looks.switchCostume("BluBG");
                Control.waitUntil(!Sensing.mouseDown());
                _Gold -= 100;
                Sound.playSoundUntilDone("Machine à prix click");
                Sound.playSound("Machine a prix music");
                Sound.playSound("Machine à prix");
                _CurrentMenu = "WinAPrize1";
                Control.waitUntil(_CurrentMenu == "WinAPrize3");
                Control.waitUntil(Sensing.mouseDown());
                Control.waitUntil(!Sensing.mouseDown());
                _CurrentMenu = 0;
            } else {
                Looks.switchCostume("BluBG1P");
                Sound.playSound("Click");
                Control.waitUntil(!Sensing.mouseDown());
                Sound.playSound("Declick");
                Looks.hide();
                _CurrentMenu = 0;
            }
        }
    }

    metadata SETUP pos 139,1880;
    private void SETUP() { // warp
        CloneID = "PrizeMachine2";
        Control.createClone("_myself_");
        CloneID = 0;
        repeat (6) {
            CloneID += 1;
            Control.createClone("_myself_");
        }
        CloneID = "Box";
        Control.createClone("_myself_");
        CloneID = "PrizeMachine1";
        Control.createClone("_myself_");
    }
}

