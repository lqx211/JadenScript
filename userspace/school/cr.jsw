    import "assets/67e3e4653db6ca6e86791c656bed8ad2.wav" as Mario; // sound rate=44100 samples=3506603
    private CloneID = 0;

    metadata greenFlag pos -121,-1377;
    public void greenFlag() {
        while (1) {
            Sound.playSoundUntilDone(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1));
        }
    }

    metadata greenFlag pos -72,-691;
    public void greenFlag() {
        while (1) {
            if (Looks.backdropName() == "Welcome" || (Looks.backdropName() == "Loading" || Looks.backdropName() == "Intro")) {
                Sound.volume = 0;
                Sound.stopAllSounds();
            } elif (_GameStatus > 1 && _Skin == "Mario") {
                Sound.volume = 0;
            } else {
                Sound.volume = __VOLUME;
            }
        }
    }
}

