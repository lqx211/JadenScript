                Looks.switchCostume("BluBG");
                _CurrentMenu = "FreeGift1";
                Temp = _Gold;
                Control.waitUntil(_CurrentMenu == "FreeGift2");
                Temp3 = 2;
                CloneID = "Score";
                while (!(Sensing.mouseDown())) {
                    Looks.setEffect("GHOST", 0);
                    Temp2 = 0;
                    Temp3 += (5 - Temp3) / (FPS / 5);
                    PrePrint(join(_Gold - Temp, "G"), Temp3, 1);
                    Motion.setXY(0, 0);
                    Looks.switchCostume("BluBG");
                    Looks.setEffect("GHOST", 10);
                    Looks.size = 100;
                }
                while (Sensing.mouseDown()) {
                    Looks.setEffect("GHOST", 0);
                    Temp2 = 0;
                    Temp3 += (5 - Temp3) / (FPS / 5);
                    PrePrint(join(_Gold - Temp, "G"), Temp3, 1);
                    Motion.setXY(0, 0);
                    Looks.switchCostume("BluBG");
                    Looks.setEffect("GHOST", 10);
                    Looks.size = 100;
