TimeScoreCycle: name="TimeScoreCycle", x=36, y=28, size=100, direction=90, show=1, costume=0, volume=100, layer=32, rotation="all", draggable=0;
class TimeScoreCycle {
    import "assets/3339a2953a3bf62bb80e54ff575dbced.svg" as costume1; // costume centerx=0 centery=0 res=1

    metadata greenFlag pos 98,249;
    public void greenFlag() {
        TimeCycle.clear();
        ScoreCycle.clear();
        TimeCycle.add("00");
        TimeCycle.add("00");
        TimeCycle.add("00");
        ScoreCycle.add("00000000");
        while (1) {
            if (Sensing.current("HOUR") < 10) {
                TimeCycle.set(1, join(0, Sensing.current("HOUR")));
            } else {
                TimeCycle.set(1, Sensing.current("HOUR"));
            }
            if (Sensing.current("MINUTE") < 10) {
                TimeCycle.set(2, join(0, Sensing.current("MINUTE")));
            } else {
                TimeCycle.set(2, Sensing.current("MINUTE"));
            }
            if (Sensing.current("SECOND") < 10) {
                TimeCycle.set(3, join(0, Sensing.current("SECOND")));
            } else {
                TimeCycle.set(3, Sensing.current("SECOND"));
            }
            if (_Score < 1e1) {
                ScoreCycle.set(1, join("0000000", _Score));
            } elif (_Score < 1e2) {
                ScoreCycle.set(1, join("000000", _Score));
            } elif (_Score < 1e3) {
                ScoreCycle.set(1, join("00000", _Score));
            } elif (_Score < 1e4) {
                ScoreCycle.set(1, join("0000", _Score));
            } elif (_Score < 1e5) {
                ScoreCycle.set(1, join("000", _Score));
            } elif (_Score < 1e6) {
                ScoreCycle.set(1, join("00", _Score));
            } elif (_Score < 1e7) {
                ScoreCycle.set(1, join(0, _Score));
            } elif (_Score < 1e8) {
                ScoreCycle.set(1, _Score);
            } else {
                ScoreCycle.set(1, 99999999);
            }
        }
    }
}

