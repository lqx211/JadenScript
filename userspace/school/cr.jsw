    public void Editor___Tutorial() { // hook: broadcast Editor : Tutorial
        Looks.show();
        TutoPage = 0;
        Control.createClone("_myself_");
        Looks.switchCostume("BG0");
        Motion.setXY(0, 0);
        Looks.goToFront();
        while (!(Sensing.mouseDown() && (Sensing.mouseX() > 150 && Sensing.mouseY() > 110))) {
            Looks.switchCostume("BG0");
            if (Sensing.mouseDown() && Sensing.mouseY() > 10) {
                if (Sensing.mouseX() < -150) {
                    Looks.switchCostume("BG2");
                    Sound.playSound("Click");
                    Control.waitUntil(!Sensing.mouseDown());
                    Sound.playSound("Declick");
                    call tuto_();
                } elif (Sensing.mouseX() < -90) {
                    Looks.switchCostume("BG3");
                    Sound.playSound("Click");
                    Control.waitUntil(!Sensing.mouseDown());
                    Sound.playSound("Declick");
                    call tuto_();
                }
            }
        }
        Looks.switchCostume("BG1");
        Sound.playSound("Click");
        Control.waitUntil(!Sensing.mouseDown());
        Sound.playSound("Declick");
        Looks.hide();
    }

