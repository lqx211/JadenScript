    import "assets/9be659b4eae24fe9b527458fb95afcdd.png" as BluBG; // costume centerx=480 centery=360 res=2
    import "assets/5579fda71cbb26ec0c20de8e6fbfa1ec.svg" as Logo2; // costume centerx=239.99999999999997 centery=183.43600867678958 res=1
    import "assets/0c3f9b07bf5077c07b3023ec7ad453e2.svg" as Game; // costume centerx=240 centery=180 res=1
    import "assets/ad0d8070b2c8af5a618699372d08d241.svg" as Logo; // costume centerx=240 centery=180 res=1
    import "assets/c14dec1e10c98945ffd5d85742af164a.svg" as Editor; // costume centerx=240 centery=180 res=1
    import "assets/bfbf420cfc055f64534f6b4ad42a4732.svg" as CustomGame; // costume centerx=240 centery=180 res=1
    import "assets/267c0b041f478c65d80028c517c5e6de.svg" as letters; // costume centerx=223.347185 centery=175 res=1
    import "assets/15f896eb56e100474463aba320c3832b.mp3" as PacMan; // sound rate=44100 samples=226304
    private Xbanner = -0.10022595757618546;

    metadata greenFlag pos 48,64;
    public void greenFlag() {
        while (1) {
            Sound.volume = __VOLUME;
        }
    }

    metadata whenCloned pos 1753,64;
    public void whenCloned() {
        Looks.switchCostume("BluBG");
        Looks.size = 100;
        Looks.setEffect("GHOST", 0);
        Looks.show();
        Motion.setXY(0, 0);
        Control.waitUntil(Operators.round(Sensing.of("Xbanner", "Banner")) == 0);
        Control.wait(1);
        Looks.switchBackdrop(_NextBG);
        Sound.playSound(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1));
        repeat (10) {
            Looks.changeEffect("GHOST", 10);
        }
        Control.deleteThisClone();
    }

    metadata whenBackdropChanges pos 48,312;
    public void whenBackdropChanges() { // hook: backdrop Loading
        repeat (_game_database.get(47) + 1000) {
            Control.stopOtherScripts();
            if (!"") {
                Control.deleteThisClone();
            }
            if (First_Game_ == 2) {
                First_Game_ = 0;
                Control.broadcastAndWait("Support Message");
            }
            Control.createClone("_myself_");
            Looks.switchCostume(_NextBG);
            Looks.clearGraphicEffects();
            Xbanner = -10;
            Looks.show();
            Looks.size = 60;
            if (Operators.contains(_NextBG, "Game")) {
                while (!(_GameStatus == 1 && Operators.round(Xbanner) == 0)) {
                    Xbanner += (0 - Xbanner) / 4;
                    Motion.setXY(Xbanner * _game_database.get(48), Xbanner * -10);
                }
            } else {
                while (!(Operators.round(Xbanner * (_game_database.get(36) * 10)) == 0)) {
                    Xbanner += (0 - Xbanner) / 4;
                    Motion.setXY(Xbanner * _game_database.get(48), Xbanner * -10);
                }
                Control.wait(1);
            }
            Xbanner = 0;
            while (!(Xbanner > 9.9)) {
                Xbanner += (Xbanner + 1) / (_game_database.get(36) / 2);
                Motion.setXY(Xbanner * _game_database.get(48), Xbanner * -10);
            }
            Looks.hide();
        }
    }

    metadata greenFlag pos -331,395;
    public void greenFlag() {
        Variables.hideVariable(_RootTriggerClicks);
    }

    metadata whenBackdropChanges pos 48,2096;
    public void whenBackdropChanges() { // hook: backdrop Intro
        Control.stopOtherScripts();
        Motion.setXY(0, 0);
        if (!"") {
            Control.deleteThisClone();
        }
        Looks.size = 100;
        Looks.switchCostume("Logo");
        Looks.show();
        Looks.setEffect("GHOST", _game_database.get(48) * 2);
        repeat (_game_database.get(36)) {
            Looks.changeEffect("GHOST", -10);
        }
        Control.wait(_game_database.get(1));
        repeat (_game_database.get(36)) {
            Looks.changeEffect("GHOST", 10);
        }
        _NextBG = "Game";
        Looks.hide();
    }

    loose { // at 578,857
        "" || (Operators.contains(_NextBG, "Rare") || Operators.contains(_NextBG, "Amns"));
    }

    loose { // at 720,2308
        Operators.random(1, _game_database.get(36));
    }

    loose { // at 762,2471
        // looks_switchcostumeto
                Looks.switchCostume("Logo2");
    }

    loose { // at 842,2768
        // control_if_else
                if (Operators.random(1, _game_database.get(36)) == 1) {
                    if (Operators.random(1, 5) == 1) {
                        _NextBG = "Rare";
                    } else {
                        _NextBG = "Amns";
                    }
                }
    }
}

