            } else {
                Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Train2"));
            }
            Motion.setXY((X + Progress * 4) * 50 + Y * 20 + WorldShakingX, Y * 40 + (X + Progress * 4) * -10 + WorldShakingY);
            Pen.stamp();
            DrawTrain(X, Y, Progress + 1, Sens, Alert_);
