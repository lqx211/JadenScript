    metadata Slide pos 13922,64;
    private void Slide(X, Y) {
        Control.waitUntil(!Sensing.mouseDown());
        if (Operators.math("abs", Sensing.mouseX() - X) <= Operators.math("abs", Sensing.mouseY() - Y)) {
            if (Sensing.mouseY() - Y < 0) {
                if (Player___Y > 5) {
                    Backward();
                }
            } else {
                Forward();
            }
        } elif (Sensing.mouseX() - X < 0) {
            if (Operators.round(Player___X + Pxoffset) > -4) {
                Left();
            }
        } elif (Operators.round(Player___X + Pxoffset) < 4) {
            Right();
        }
    }

    metadata Right pos 15166,64;
    private void Right() {
        _LastKey = "Right";
        if (_GameStatus < 2) {
            _GameStatus = 1;
            if (FloorData.get(Player___Y - __DELETED_ITEMS) == "Grass") {
                if (Operators.letterOf(Operators.round(Player___X + Pxoffset) + 9, ObjectsData.get(Player___Y - __DELETED_ITEMS)) == 0) {
                    Player___X += 1;
                    Control.broadcast("Jump");
                }
            } else {
                Player___X += 1;
                Control.broadcast("Jump");
            }
        }
    }

    metadata CarsCheck pos 16336,64;
    private void CarsCheck(Progress, Delay, Speed, Length, Water_, OnBoard_) { // proccode CarsCheck %s %s %s %s %b %b
        if (Speed != 0) {
            Looks.switchCostume(block("argument_reporter_string_number", "VALUE", "Costume"));
            if (Operators.math("abs", (TIMER + Progress * Delay) * Speed) - 10 < 10) {
                if ((TIMER + Progress * Delay) * Speed - 10 + Speed / Operators.math("abs", Speed) / 2 + (Speed < 0) * (Length / 2) > Player___X + Pxoffset && (TIMER + Progress * Delay) * Speed - 10 + Speed / Operators.math("abs", Speed) / 2 - (Speed > 0) * (Length / 2) < Player___X + Pxoffset) {
                    if (!Water_) {
                        _GameStatus = 3;
                        Control.stopThisScript();
                    } else {
                        Control.stopThisScript();
                    }
                } elif (Water_) {
                    CarsCheck(Progress + Speed / Operators.math("abs", Speed), Delay, Speed, Length, Water_, "");
                }
                CarsCheck(Progress + Speed / Operators.math("abs", Speed), Delay, Speed, Length, Water_, OnBoard_);
            } elif (Water_) {
                _GameStatus = 4;
                Control.stopThisScript();
            }
        }
    }

    metadata CheckTrain pos 19709,64;
    private void CheckTrain(Progress, Delay, Speed, Length) {
        if (Speed != 0) {
            Looks.switchCostume(block("argument_reporter_string_number", "VALUE", "Costume"));
            if (Operators.math("abs", (TIMER + Progress * Delay) * Speed) - 0 < 35) {
                if ((TIMER + Progress * Delay) * Speed - 0 + Speed / Operators.math("abs", Speed) / 2 + (Speed < 0) * (Length - 0.5) > Player___X + Pxoffset) {
                    if ((TIMER + Progress * Delay) * Speed - 0 + Speed / Operators.math("abs", Speed) / 2 - (Speed > 0) * (Length - 0.5) < Player___X + Pxoffset) {
                        _GameStatus = 6;
                    }
                }
            }
        }
    }

