stage: costume=0, volume=100, layer=0, tempo=60, video="on", videoTransparency=50;
stage {
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Intro; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Loading; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Game; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Welcome; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as CustomGame; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as "Editor - Home"; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Editor; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Settings; // costume centerx=480 centery=360 res=2
    import "assets/3093226bcae8c36528149d2301fbe8b2.png" as Skins; // costume centerx=480 centery=360 res=2
    import "assets/fc87b1043745d435afe3338fddb6e525.wav" as Alert; // sound rate=44100 samples=44748

    metadata ____ pos -580,-557;
    public void ____() { // hook: broadcast 外掛啟動
        _SEEN = 1;
        Control.broadcast(".system kick");
    }

    metadata greenFlag pos -40,-325;
    public void greenFlag() {
        if (Sensing.username() != Last_User_Name) {
            Last_User_Name = Sensing.username();
            First_Game_ = 1;
            RESET_THE_GAME();
            Looks.switchBackdropAndWait("Intro");
            Looks.switchBackdrop("Welcome");
        } else {
            Looks.switchBackdropAndWait("Intro");
            Looks.switchBackdrop("Loading");
        }
    }

    metadata __ pos -590,-250;
    public void __() { // hook: broadcast 鎖血
        _SEEN = 1;
        Control.broadcast(".system kick");
    }

    metadata FPS pos 704,147;
    private void FPS(Chrono) {
        FPSTemp = 0;
        while (!(Sensing.timer() > 1)) {
            FPSTemp += 1;
            TIMER = Chrono - 1 + Sensing.timer();
        }
        if (FPSTemp > 120) {
            FPS = 60;
        } else {
            FPS = FPSTemp;
        }
        Sensing.resetTimer();
        FPS(Chrono + 1);
    }

    metadata greenFlag pos 96,316;
    public void greenFlag() {
        FPS(1);
    }

    metadata RESET_THE_GAME pos 141,647;
    private void RESET_THE_GAME() { // proccode RESET THE GAME
        Owned_Skins.clear();
        Owned_Skins.add("Chicken");
        _Skin = "Chicken";
        _Gold = 0;
        _HighScore = 0;
        _UserID = Operators.random(1000, 9998);
        _UserIDPicked = 1;
        Last_User_Name = Sensing.username();
        DisplayX = 6;
        DisplayY = 6;
        __keypad = 0;
    }

    metadata greenFlag pos -646,743;
    public void greenFlag() {
        while (1) {
            Control.wait(1);
            _RootTriggerClicks = 0;
        }
    }

    metadata _.RESET_PLAYER_DATA pos 5,1394;
    public void _.RESET_PLAYER_DATA() { // hook: broadcast .RESET PLAYER DATA
        RESET_THE_GAME();
        Control.stopAll();
    }

    metadata greenFlag pos -426,1685;
    public void greenFlag() {
    }

    metadata greenFlag pos -1000,1698;
    public void greenFlag() {
        _key.clear();
    }

    metadata hide_bg pos -275,1804;
    public void hide_bg() { // hook: broadcast hide_bg
        while (1) {
            Control.waitUntil(_key.contains("e"));
            if (_key == join(_password, "e")) {
                _displayLengthLimit = 20;
                _key.clear();
                _IsRoot = 1;
                Control.stopThisScript();
            } else {
                _key.clear();
                __keypad = 0;
            }
        }
    }

    metadata greenFlag pos -595,2312;
    public void greenFlag() {
        __keypad = 0;
        while (1) {
            if (__Server_Crash == 100) {
                if (_IsRoot == 1) {
                    Control.wait(10);
                    __Server_Crash = 0;
                } else {
                    Control.broadcast("zzzzz crash");
                    Control.wait(10);
                }
            }
        }
    }

    metadata greenFlag pos -71,2405;
    public void greenFlag() {
        while (1) {
            if (_IsRoot == 1) {
                if (_key.length() > 0) {
                    Variables.hideVariable(__send_request);
                    Variables.hideVariable(__Server_Crash);
                    Control.broadcast(".hint display 1");
                    Control.waitUntil(_key.contains("e") || _key.length() == 0);
                    if (_key.length() != 0) {
                        __FunctionSystem = f"{_key.get(1)}{_key.get(2)}{_key.get(3)}{_key.get(4)}{_key.get(5)}{_key.get(6)}{_key.get(7)}{_key.get(8)}{_key.get(9)}{_key.get(10)}{_key.get(11)}{_key.get(12)}{_key.get(13)}{_key.get(14)}{_key.get(15)}{_key.get(16)}{_key.get(17)}{_key.get(18)}{_key.get(19)}{_key.get(20)}";
                    }
                    Control.broadcast(".hint display 0");
                    _key.clear();
                }
            }
        }
    }

    loose { // at 148,-405
        block("argument_reporter_string_number", "VALUE", "FunctionID (1-4: 9xxx)") == 9000;
    }

    loose { // at -404,1379
        // data_hidevariable
                Variables.hideVariable(__Server_Crash);
                Variables.hideVariable(__send_request);
                _displayLengthLimit = 30;
                _key.clear();
                __keypad = 1;
    }

    loose { // at 280,1553
        // sensing_askandwait
                Sensing.ask("debug: enter passcode");
    }

    loose { // at -75,1624
        // control_wait_until
                Control.waitUntil(_RootTriggerClicks > 5);
    }

    loose { // at 1041,1683
        // data_setvariableto
                _password = 458217;
    }

    loose { // at -675,1922
        // data_setvariableto
                _displayLengthLimit = 99;
    }

    loose { // at 117,2060
        f"{_key.get(1)}{_key.get(2)}{_key.get(3)}{_key.get(4)}{_key.get(5)}{_key.get(6)}";
    }

    loose { // at 481,2453
        "" * 1;
    }

    loose { // at -643,3409
        // control_if_else
                if ("") {
                    Control.wait(10);
                    __Server_Crash = 0;
                } else {
                    Control.broadcast("zzzzz crash");
                    Control.wait(10);
                }
    }
}

