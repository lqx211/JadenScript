    metadata whenCloned pos 868,887;
    public void whenCloned() {
        Looks.goToFront();
        Motion.setXY(-240, 35 - 70 * (CloneID == "WinAPrize"));
        Looks.show();
        Looks.switchCostume(join(CloneID, 0));
        Looks.setEffect("GHOST", 100);
        if (CloneID == "WinAPrize") {
            Control.waitUntil(_CurrentMenu == 0 && _Gold > 99 && All_Skins.length() != Owned_Skins.length());
        }
        repeat (9) {
            Looks.changeEffect("GHOST", -10);
        }
        Sound.setEffect("PITCH", (CloneID == "WinAPrize") * 30);
        Sound.playSound("Spawn");
        if (CloneID == "FreeGift") {
            while (1) {
                if (_CurrentMenu == 0) {
                    Looks.show();
                    Motion.x += (240 - Motion.x) / (FPS / 5);
                    if (Sensing.mouseDown() && Sensing.touching("_mouse_")) {
                        Looks.switchCostume(join(CloneID, 1));
                        Sound.setEffect("PITCH", 0);
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _CurrentMenu = CloneID;
                        Looks.hide();
                        Control.waitUntil(_CurrentMenu != CloneID);
                        if (_CurrentMenu != 0) {
                            Control.deleteThisClone();
                        }
                    } else {
                        Looks.switchCostume(join(CloneID, 0));
                    }
                } else {
                    Looks.hide();
                }
            }
        } else {
            while (1) {
                if (_CurrentMenu == 0 && _Gold > 99 && All_Skins.length() != Owned_Skins.length()) {
                    Looks.show();
                    Motion.x += (240 - Motion.x) / (FPS / 5);
                    if (Sensing.mouseDown() && Sensing.touching("_mouse_")) {
                        Looks.switchCostume(join(CloneID, 1));
                        Sound.setEffect("PITCH", 0);
                        Sound.playSound("Click");
                        Control.waitUntil(!Sensing.mouseDown());
                        Sound.playSound("Declick");
                        _CurrentMenu = CloneID;
                        Looks.hide();
                        Control.waitUntil(_CurrentMenu != CloneID);
                    } else {
                        Looks.switchCostume(join(CloneID, 0));
                    }
                } else {
                    Looks.hide();
                }
            }
        }
    }

    loose { // at 1545,3426
        // control_if
                if (_CurrentMenu != 0 && _Gold < 100) {
                    Control.deleteThisClone();
                }
    }
}

