    metadata Execution pos -412,-36;
    private void Execution() {
        if (!"") {
            Control.deleteThisClone();
        }
        Control.stopOtherScripts();
        Looks.hide();
        Control.waitUntil(_GameStatus == 0);
        Control.waitUntil(_GameStatus > 1);
        Sound.playSound(_Skin);
        if (_GameStatus == 4) {
            if ("Space" != Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1)) {
                Looks.setEffect("COLOR", 0);
                Control.wait(0.1);
                Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "WaterLose"));
                Motion.setXY((Player___X + Pxoffset) * 50 + "" * 20, (Player___X + Pxoffset) * -10 + "" * 40);
                repeat (20) {
                    Control.createClone("_myself_");
                    Control.createClone("_myself_");
                }
            }
        } elif (_GameStatus == 2) {
            Looks.setEffect("COLOR", 0);
            if (Operators.contains(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Eagle"), "Eagle")) {
                if (Operators.random(1, 10) == 1) {
                    Looks.switchCostume("CorruptEagle");
                } else {
                    Looks.switchCostume(join(Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1), "Eagle"));
                }
            }
            Motion.setXY((Player___X + Pxoffset) * 50 + 10 * 20, (Player___X + Pxoffset) * -10 + 10 * 40);
            TempTimer = TIMER + 0.5 * ("Ocean" == Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1));
            Looks.show();
            while (!(TIMER - TempTimer > 1)) {
                ColorEffect_();
                Motion.setXY((Player___X + Pxoffset) * 50 + (10 - (TIMER - TempTimer) * 20) * 20, (Player___X + Pxoffset) * -10 + (10 - (TIMER - TempTimer) * 20) * 40);
            }
            Looks.hide();
        } elif (_GameStatus == 7) {
            Control.wait(0.1);
            Looks.switchCostume("ClassicWaterLose");
            Motion.setXY((Player___X + Pxoffset) * 50 + "" * 20, (Player___X + Pxoffset) * -10 + "" * 40);
            repeat (50) {
                Looks.setEffect("COLOR", Operators.random(1, 200));
                Control.createClone("_myself_");
                Control.createClone("_myself_");
            }
        }
    }

    metadata Go pos 1279,838;
    private void Go(X, Y, XS, YS, Z_arg) {
        while (!(Z > Z_arg)) {
            Motion.x += (Operators.round(X * 50 + Y * 20) - Motion.x) / (FPS / 5);
            Motion.y += (Z + Operators.round(X * -10 + Y * 40) - Motion.y) / (FPS / 5);
            Z += Z * (1.5 / (FPS / 60));
        }
        while (!(Operators.round(Z * 100) == 0)) {
            Motion.x += (Operators.round(X * 50 + Y * 20) - Motion.x) / (FPS / 5);
            Motion.y += (Z + Operators.round(X * -10 + Y * 40) - Motion.y) / (FPS / 5);
            Z += (0 - Z) / (10 / (FPS / 60));
        }
        repeat (10) {
            Looks.changeEffect("GHOST", 10);
        }
        Control.deleteThisClone();
    }

    metadata ColorEffect_ pos 113,889;
    private void ColorEffect_() { // proccode ColorEffect?
        Looks.clearGraphicEffects();
        if (Characters_environments.get(Characters_environments.indexOf(join("#", _Skin)) + 1) == "PacMan") {
            Looks.setEffect("COLOR", TIMER * 10);
        }
    }

    loose { // at 950,-194
        ScrollY - Player___Y;
    }

    loose { // at 1357,393
        Operators.round(Motion.x) == Operators.round(block("argument_reporter_string_number", "VALUE", "X") * 50 + block("argument_reporter_string_number", "VALUE", "Y") * 20);
    }
}

