    metadata CameraControl pos 5760,297;
    private void CameraControl() {
        while (!(_GameStatus > 1)) {
            TempChrono = TIMER;
            Control.wait(0);
            if (_GameStatus == 1) {
                if (Player___Y > Camera___Y) {
                    Camera___Y = Player___Y;
                } else {
                    Camera___Y += (TIMER - TempChrono) / 1.5;
                }
                if (Camera___Y - Player___Y > 5) {
                    _GameStatus = 2;
                }
                if (Operators.math("abs", Operators.round(Player___X + Pxoffset)) > 4) {
                    _GameStatus = 5;
                }
            }
        }
    }

    metadata KeyboardControl pos 10079,324;
    private void KeyboardControl() {
        SelectedY = 0;
        _LastKey = "Down";
        _Score = 0;
        _GameStatus = 0;
        Player___X = 0;
        Player___Y = 10;
        Player___Z = 0;
        ScrollX = 0;
        ScrollY = 10;
        Camera___X = 0;
        Camera___Y = 10;
        PyScroll = 10;
        PxScroll = 0;
        TEMPY = Player___Y;
        Pxoffset = 0;
        WorldShakingX = 0;
        WorldShakingY = 0;
        while (!(_GameStatus > 1)) {
            if (Sensing.keyPressed("up arrow")) {
                Control.waitUntil(!Sensing.keyPressed("up arrow"));
                if (_GameStatus <= 1) {
                    Forward();
                }
            }
            if (Sensing.keyPressed("down arrow")) {
                Control.waitUntil(!Sensing.keyPressed("down arrow"));
                if (Player___Y > 5) {
                    if (_GameStatus <= 1) {
                        Backward();
                    }
                }
            }
            if (Sensing.keyPressed("right arrow")) {
                Control.waitUntil(!Sensing.keyPressed("right arrow"));
                if (Operators.round(Player___X + Pxoffset) < 4) {
                    if (_GameStatus <= 1) {
                        Right();
                    }
                }
            }
            if (Sensing.keyPressed("left arrow")) {
                Control.waitUntil(!Sensing.keyPressed("left arrow"));
                if (Operators.round(Player___X + Pxoffset) > -4) {
                    if (_GameStatus <= 1) {
                        Left();
                    }
                }
            }
        }
    }

