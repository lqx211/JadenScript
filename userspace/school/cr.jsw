    metadata whenBackdropChanges pos -243,543;
    public void whenBackdropChanges() { // hook: backdrop Editor
        if (!"") {
            Control.deleteThisClone();
        }
        Control.stopOtherScripts();
        while (1) {
            if (FloorData.get(SelectedY) == "") {
                Looks.hide();
            } else {
                Looks.show();
            }
            Looks.switchCostume(join(FloorData.get(SelectedY), 0));
            if (_CurrentMenu == 0) {
                if (FloorData.get(SelectedY) == "Grass") {
                    if (Sensing.mouseDown()) {
                        if (Sensing.mouseX() > 175 && Sensing.mouseY() < -75) {
                            if (Sensing.mouseY() < -125) {
                                Looks.switchCostume("Grass1");
                                Sound.playSound("Click");
                                Control.waitUntil(!Sensing.mouseDown());
                                Sound.playSound("Declick");
                                Remove(SelectedY);
                            }
                        } else {
                            ClickGrassLilypads(Operators.round((Sensing.mouseY() - Sensing.mouseX() / 50 * -10) / 40), Operators.round(Sensing.mouseX() / 50));
                            Control.waitUntil(!Sensing.mouseDown());
                        }
                    }
                } elif (FloorData.get(SelectedY) == "Lilypads") {
                    if (Sensing.mouseDown()) {
                        if (Sensing.mouseX() > 175 && Sensing.mouseY() < -75) {
                            if (Sensing.mouseY() < -125) {
                                Looks.switchCostume("Lilypads1");
                                Sound.playSound("Click");
                                Control.waitUntil(!Sensing.mouseDown());
                                Sound.playSound("Declick");
                                Remove(SelectedY);
                            }
                        } else {
                            ClickGrassLilypads(Operators.round((Sensing.mouseY() - Sensing.mouseX() / 50 * -10) / 40), Operators.round(Sensing.mouseX() / 50));
                            Control.waitUntil(!Sensing.mouseDown());
                        }
                    }
                } elif (FloorData.get(SelectedY) == "Road") {
                    if (Sensing.mouseDown() && Sensing.mouseX() > 175) {
                        if (Sensing.mouseY() < -125) {
                            Looks.switchCostume("Road1");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            Remove(SelectedY);
                        } elif (Sensing.mouseY() < -75) {
                            Looks.switchCostume("Road2");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            _CurrentMenu = "Delay";
                        } elif (Sensing.mouseY() < -25) {
                            Looks.switchCostume("Road3");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            _CurrentMenu = "Speed";
                        } elif (Sensing.mouseY() < 25) {
                            Looks.switchCostume("Road4");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            SwitchType(SelectedY, 6);
                        }
                    }
                } elif (FloorData.get(SelectedY) == "Water") {
                    if (Sensing.mouseDown() && Sensing.mouseX() > 175) {
                        if (Sensing.mouseY() < -125) {
                            Looks.switchCostume("Water1");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            Remove(SelectedY);
                        } elif (Sensing.mouseY() < -75) {
                            Looks.switchCostume("Water2");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            _CurrentMenu = "Delay";
                        } elif (Sensing.mouseY() < -25) {
                            Looks.switchCostume("Water3");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            _CurrentMenu = "Speed";
                        } elif (Sensing.mouseY() < 25) {
                            Looks.switchCostume("Water4");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            SwitchType(SelectedY, 3);
                        }
                    }
                } elif (FloorData.get(SelectedY) == "Rails") {
                    if (Sensing.mouseDown() && Sensing.mouseX() > 175) {
                        if (Sensing.mouseY() < -125) {
                            Looks.switchCostume("Rails1");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            Remove(SelectedY);
                        } elif (Sensing.mouseY() < -75) {
                            Looks.switchCostume("Rails2");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            _CurrentMenu = "Delay";
                        } elif (Sensing.mouseY() < -25) {
                            Looks.switchCostume("Rails3");
                            Sound.playSound("Click");
                            Control.waitUntil(!Sensing.mouseDown());
                            Sound.playSound("Declick");
                            if (MovingObjectsData.contains(join("#", SelectedY))) {
                                MovingObjectsData.set(MovingObjectsData.indexOf(join("#", SelectedY)) + 2, MovingObjectsData.get(MovingObjectsData.indexOf(join("#", SelectedY)) + 2) * -1);
                            }
                        }
                    }
                }
            }
        }
    }

    metadata Remove pos 793,853;
    private void Remove(Y) { // warp
        FloorData.delete(Y);
        ObjectsData.delete(Y);
        if (MovingObjectsData.contains(join("#", Y))) {
            while (!(Operators.contains(MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 1), "#") || MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 1) == "")) {
                MovingObjectsData.delete(MovingObjectsData.indexOf(join("#", Y)) + 1);
            }
            MovingObjectsData.delete(MovingObjectsData.indexOf(join("#", Y)));
        }
        Control.broadcast("Editor : Remove");
    }

    metadata SwitchType pos 953,1920;
    private void SwitchType(Y, Limit) {
        if (MovingObjectsData.contains(join("#", Y))) {
            if (MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 3) == Limit) {
                MovingObjectsData.set(MovingObjectsData.indexOf(join("#", Y)) + 3, 1);
            } else {
                MovingObjectsData.set(MovingObjectsData.indexOf(join("#", Y)) + 3, MovingObjectsData.get(MovingObjectsData.indexOf(join("#", Y)) + 3) + 1);
            }
        }
    }

    metadata ClickGrassLilypads pos 747,2762;
    private void ClickGrassLilypads(Y, X) { // warp
        if (0 == Y) {
            if (X > -5 && X < 5 && X != 0) {
                if (FloorData.get(SelectedY) == "Grass") {
                    if (Operators.letterOf(X + 8, ObjectsData.get(SelectedY)) == 6) {
                        ObjectsData.set(SelectedY, ObjectsData.get(SelectedY) - 6 * Operators.math("10 ^", 15 - (X + 8)));
                    } else {
                        ObjectsData.set(SelectedY, ObjectsData.get(SelectedY) + Operators.math("10 ^", 15 - (X + 8)));
                    }
                } elif (FloorData.get(SelectedY) == "Lilypads") {
                    if (Operators.letterOf(X + 8, ObjectsData.get(SelectedY)) == 9) {
                        ObjectsData.set(SelectedY, ObjectsData.get(SelectedY) - 9 * Operators.math("10 ^", 15 - (X + 8)));
                    } elif (Operators.letterOf(X + 8, ObjectsData.get(SelectedY)) == 0) {
                        ObjectsData.set(SelectedY, ObjectsData.get(SelectedY) + 7 * Operators.math("10 ^", 15 - (X + 8)));
                    } else {
                        ObjectsData.set(SelectedY, ObjectsData.get(SelectedY) + Operators.math("10 ^", 15 - (X + 8)));
                    }
                }
                while (!(lengthOf(ObjectsData.get(SelectedY)) == 15)) {
                    ObjectsData.set(SelectedY, join(0, ObjectsData.get(SelectedY)));
                }
            }
        }
    }
}

