/*
 * display — the video card.
 *
 * The card itself is memory: the text plane at 0xB_8000 is 80 x 25 cells of
 * (character, attribute), which the CPU writes like any other memory. This
 * sprite turns those cells into pixels, and it is the only sprite allowed to
 * touch the pen.
 *
 * One pen dot is one stage pixel. The pen is size 1 and every dot sits on a
 * pixel *centre*, so a glyph is its bitmap and nothing else. Painting is
 * incremental: the CPU marks a cell dirty and this loop redraws a few per
 * frame, so a scrolling console costs a line, not a screen.
 *
 * A text attribute is `paper * 16 + ink`, the way a VGA card stores it, so
 * white on blue is 0x1F and light grey paper with black text is 0x70.
 */

public X.dispEga = [0, 170, 43520, 43690, 11141120, 11141290, 11162880, 11184810,
    5592405, 5592575, 5635925, 5636095, 16733525, 16733695, 16777045, 16777215];
/* 2^0 .. 2^32: the glyph painter needs the first nine, and the bit
 * instructions in the CPU need the rest. */
public X.pow2 = [1, 2, 4, 8, 16, 32, 64, 128, 256, 512, 1024, 2048, 4096, 8192,
    16384, 32768, 65536, 131072, 262144, 524288, 1048576, 2097152, 4194304,
    8388608, 16777216, 33554432, 67108864, 134217728, 268435456, 536870912,
    1073741824, 2147483648, 4294967296];
public X.dispPen = -1;

import "assets/lists/font.jsa" as font;

class Display {
    /* The costume the stage measurement uses: two by two, opaque, so the fence
     * has something with a real bounding box to hold back. */
    import "assets/frame.svg" as Frame;

    public void displayStart() { // hook: green flag
        Looks.hide();
        dispMeasure();
        while (1) {
            if (X.dispReq == 1) {
                X.dispBooted = 0;
                dispBoot();
                X.dispReq = 0;
                X.dispAck = 1;
            }
            paintSome();
            Control.wait(0);
        }
    }

    /* How big is the stage? There is no block for it, and this project does not
     * import an extension that would answer: the sprite measures it instead.
     *
     * Go to infinity with the 2 x 2 costume every sprite starts with, and read
     * back where the VM put it. Scratch fences the sprite to the stage, so the
     * number that comes back is half the stage minus half the costume -- one
     * pixel each way. TurboWarp's compiler lets the infinity through, so the
     * position comes back unchanged and the sprite walks out to the edge a
     * pixel at a time instead. Either way the answer decides how many cells fit
     * and where the screen sits: a bigger stage gets the screen in the middle
     * of it, a smaller one gets it in the corner with the firmware printing
     * less. */
    private void dispMeasure() { // warp
        Looks.switchCostume("Frame");
        Looks.size = 100;
        Motion.setXY(1 / 0, 1 / 0);
        _w = Motion.x;
        _h = Motion.y;
        if (_w > 10000 || _h > 10000) {
            /* TurboWarp kept the infinity, so the fence never ran: walk the
             * sprite out to the edge instead. It has to be on stage for the
             * edge to be something to touch, and the walk is bounded, because
             * a loop that never ends in warp mode is a frozen project. */
            _w = 0;
            _h = 0;
            Looks.show();
            Motion.setXY(0, 0);
            _n = 0;
            while (!Sensing.touching("_edge_") && _n < 4000) {
                Motion.x += 1;
                _n += 1;
            }
            if (Sensing.touching("_edge_")) {
                _w = Motion.x * 2;              // the centre is on the edge
            }
            Motion.setXY(0, 0);
            _n = 0;
            while (!Sensing.touching("_edge_") && _n < 4000) {
                Motion.y += 1;
                _n += 1;
            }
            if (Sensing.touching("_edge_")) {
                _h = Motion.y * 2;
            }
            Looks.hide();
        } else {
            _w = _w * 2 + 2;                    // the fence held half of it back
            _h = _h * 2 + 2;
        }
        if (_w < 320) { _w = X.stageW; }        // no answer worth having
        if (_h < 240) { _h = X.stageH; }
        Motion.setXY(0, 0);
        /* The fence gives up half a costume on some VMs and not on others, so
         * the answer is worth a pixel either way: snap it to the cell grid
         * before anything is drawn on it. */
        _cols = Operators.math("round", _w / X.dispCellW);
        _rows = Operators.math("round", _h / X.dispCellH);
        if (_cols < 1) { _cols = X.dispCols; }
        if (_rows < 1) { _rows = X.dispRows; }
        _w = _cols * X.dispCellW;
        _h = _rows * X.dispCellH;
        X.stageW = _w;
        X.stageH = _h;
        X.dispViewCols = _cols;
        X.dispViewRows = _rows;
        if (X.dispViewCols > X.dispCols) { X.dispViewCols = X.dispCols; }
        if (X.dispViewRows > X.dispRows) { X.dispViewRows = X.dispRows; }
        X.dispOffX = (_w - X.dispCols * X.dispCellW) / 2;
        X.dispOffY = (_h - X.dispRows * X.dispCellH) / 2;
        if (X.dispOffX < 0) { X.dispOffX = 0; }
        if (X.dispOffY < 0) { X.dispOffY = 0; }
    }

    /* One frame of painting, under warp so a full screen is one frame's work
     * rather than sixty. The loop that calls this one is not warp: see the note
     * in i386.jsw about `wait 0` inside a warp procedure. */

    private void dispBoot() { // warp
        Pen.setPenSize(1);
        clearScreen();
        _i = 1;
        while (_i <= X.dispCols * X.dispRows) {
            X.textDirty.set(_i, 1);
            X.textDrawn.set(_i, -1);
            _i += 1;
        }
        X.textN = X.dispCols * X.dispRows;
        X.textScan = 1;
        X.dispPen = 0;
        X.dispBooted = 1;
    }

    /* Black, one pen stroke per row: with the pen at 1 the capsules cover
     * exactly the pixels the stroke passes through. */
    private void clearScreen() { // warp
        Pen.eraseAll();
        Pen.setPenColor(0);
        _y = X.stageH / 2;
        while (_y > 0 - X.stageH / 2) {
            _y -= 1;
            Motion.setXY(0 - X.stageW / 2, _y);
            Pen.penDown();
            Motion.setXY(X.stageW / 2 - 1, _y);
            Pen.penUp();
        }
        _i = 1;
        while (_i <= X.dispCols * X.dispRows) {
            X.textDrawn.set(_i, -1);
            _i += 1;
        }
    }

    /*
     * A dot at stage x lights image column x + 320, and stage y lights image
     * row 239 - y, so pixel centres sit on integer stage coordinates. A dot has
     * to *move*: pen-down on a point and straight back up stamps nothing in
     * TurboWarp's compiled runtime, so every dot is a hundredth of a unit long
     * and its round cap covers exactly the one pixel it starts on.
     */
    private void pixel(ix, iy, hex) { // warp
        if (hex != X.dispPen) {
            Pen.setPenColor(hex);
            X.dispPen = hex;
        }
        _px = ix + X.dispOffX - X.stageW / 2;
        _py = X.stageH / 2 - 1 - iy - X.dispOffY;
        Motion.setXY(_px, _py);
        Pen.penDown();
        Motion.setXY(_px + 0.01, _py);
        Pen.penUp();
        X.dispDots += 1;
    }

    private void pixelRun(ix, iy, len, hex) { // warp
        if (hex != X.dispPen) {
            Pen.setPenColor(hex);
            X.dispPen = hex;
        }
        _px = ix + X.dispOffX - X.stageW / 2;
        _py = X.stageH / 2 - 1 - iy - X.dispOffY;
        Motion.setXY(_px, _py);
        Pen.penDown();
        Motion.setXY(_px + len - 1, _py);
        Pen.penUp();
        X.dispDots += len;
    }

    private void paintSome() { // warp
        if (X.dispBooted < 1) {
            return;
        }
        /* No "nothing to do" shortcut: `textN` is a hint, and a hint that is
         * wrong stops the card for ever. Scanning a few hundred cells is one
         * list read each, which is cheaper than a screen that never finishes. */
        X.dispPainted = 0;
        /* A time budget, not a cell count. The pen costs about 1.5 ms a cell,
         * so eight cells is the whole frame and the CPU gets nothing: the
         * machine was running at 15,000 instructions a second instead of
         * 1,700,000. Four milliseconds a frame paints a few cells and leaves
         * the rest of the frame to the guest. */
        _t0 = Sensing.timer();
        _s = 0;
        while (_s < 400) {
            if (Sensing.timer() - _t0 > 0.004) {
                return;
            }
            _cell = X.textScan;
            /* A dirty flag is bookkeeping; the plane is the truth. Repaint
             * whenever the drawn copy differs, because a flag that went
             * missing would leave a cell wrong for ever. */
            _word = X.text.get(Operators.math("floor", (_cell - 1) / 2) + 1) + 0;
            _now = _word % 65536;
            if ((_cell - 1) % 2 == 1) {
                _now = Operators.math("floor", _word / 65536) % 65536;
            }
            _dirty = 0;
            if (X.textDirty.get(_cell) == 1) {
                _dirty = 1;
            }
            if (_dirty == 1 || X.textDrawn.get(_cell) != _now) {
                if (_dirty == 1) {
                    X.textDirty.set(_cell, 0);
                    if (X.textN > 0) {
                        X.textN -= 1;
                    }
                }
                paintCell(_cell - 1);
                X.dispPainted += 1;
            }
            _cell += 1;
            if (_cell > X.dispCols * X.dispRows) {
                _cell = 1;
            }
            X.textScan = _cell;
            _s += 1;
        }
    }

    /* One cell: the paper first, then the glyph's set bits, a run at a time. */
    private void paintCell(index) { // warp
        _col = index % X.dispCols;
        _row = Operators.math("floor", index / X.dispCols);
        _x0 = _col * X.dispCellW;
        _y0 = _row * X.dispCellH;
        // the plane is memory, not one item a cell: cell n is two bytes at
        // 2n, so it is the low or the high half of word n / 2
        _word = X.text.get(Operators.math("floor", index / 2) + 1) + 0;
        _cell = _word % 65536;
        if (index % 2 == 1) {
            _cell = Operators.math("floor", _word / 65536) % 65536;
        }
        _ch = _cell % 256;
        _at = Operators.math("floor", _cell / 256) % 256;
        _inkNo = _at % 16;
        _papNo = Operators.math("floor", _at / 16) % 16;
        _ink = X.dispEga.get(_inkNo + 1) + 0;
        _pap = X.dispEga.get(_papNo + 1) + 0;
        _now = _ch + _at * 256;
        if (X.textDrawn.get(index + 1) == _now) {
            return;
        }
        // The font table is stored bottom row first: item 1 of a glyph is its
        // *last* row. So row `_g` belongs at `y0 + height - _g`, which puts the
        // The table is stored bottom row first, so the pixel row at height
        // `r` above the bottom is its entry `r`. A sixteen-pixel cell holds
        // fifteen rows of glyph, and the missing one is covered by repeating
        // the top row -- otherwise every vertical rule would have a one-pixel
        // gap where one cell meets the next, which is what made the borders
        // look broken.
        _g = 0;
        while (_g < X.dispCellH) {
            _e = X.dispCellH - 1 - _g;
            if (_e > X.dispGlyphH - 1) {
                _e = X.dispGlyphH - 1;
            }
            _bits = font.get(_ch * X.dispGlyphH + _e) + 0;
            _y = _y0 + _g;
            pixelRun(_x0, _y, X.dispCellW, _pap);
            if (_bits > 0) {
                _b = 0;
                _runStart = -1;
                while (_b < 8) {
                    // bit 7 is the leftmost pixel, so the shift counts down
                    _on = Operators.math("floor", _bits / X.pow2.get(X.dispGlyphW - _b)) % 2;
                    if (_on == 1 && _runStart < 0) {
                        _runStart = _b;
                    }
                    if (_on == 0 && _runStart >= 0) {
                        pixelRun(_x0 + _runStart, _y, _b - _runStart, _ink);
                        _runStart = -1;
                    }
                    _b += 1;
                }
                if (_runStart >= 0) {
                    /* VGA's ninth column: the box-drawing characters repeat
                     * their last pixel so that lines join across cells. Without
                     * it every horizontal rule would have a one-pixel gap. */
                    _len = X.dispGlyphW - _runStart;
                    if (_ch >= 0xC0 && _ch <= 0xDF) {
                        _len += X.dispCellW - X.dispGlyphW;
                    }
                    pixelRun(_x0 + _runStart, _y, _len, _ink);
                }
            }
            _g += 1;
        }
        /* Only now, with the pixels on the canvas: warp yields inside a long
         * batch, and a cell marked drawn before its last stroke would be a
         * hole that never fills. */
        X.textDrawn.set(index + 1, _now);
    }
}
