 * sequence reads out with `fnstsw` and `sahf`. */
    private void fpCompare(left, right) { // warp
        fpC0 = 0;
        fpC2 = 0;
        fpC3 = 0;
        if (left != left) { fpC0 = 1; fpC2 = 1; fpC3 = 1; return; }
        if (right != right) { fpC0 = 1; fpC2 = 1; fpC3 = 1; return; }
        if (left < right) { fpC0 = 1; return; }
        if (left == right) { fpC3 = 1; }
    }
 /* ---- powers of two, and what they are for -------------------------
   *
   * `FPOW2[k]` is 2^(k - 1074): every power of two a double can name, from
 * the smallest denormal to the largest finite. Built by halving and then
 * doubling one, so every entry is exact and identical to the table the
 * Python model builds. */
    private void fpTable() { // warp
        if (X.fpow2.length() > 0) { return; }
        _ftV = 1;
        _ftI = 0;
        while (_ftI < 1074) {
            _ftV = _ftV / 2;
            _ftI += 1;
        }
        _ftI = 0;
        while (_ftI < 2098) {
            X.fpow2.add(_ftV);
            _ftV = _ftV * 2;
            _ftI += 1;
        }
    }

    private void fpPow2(e) { // warp
        _fpK = e + 1074;
        if (_fpK < 0) { v = 0; return; }
        if (_fpK > 2097) { fpInf(); return; }
        v = X.fpow2.get(_fpK + 1);
    }
 /* floor(log2(value)), by bisecting the table: a logarithm is not reliable
 * at a boundary, and this is eleven comparisons either way. */
    private void fpExpOf(value) { // warp
        _feLo = 0;
        _feHi = 2097;
        while (_feLo < _feHi) {
            _feMid = Operators.math("floor", (_feLo + _feHi + 1) / 2);
            if (X.fpow2.get(_feMid + 1) <= value) {
                _feLo = _feMid;
            } else {
                _feHi = _feMid - 1;
            }
        }
        v = _feLo - 1074;
    }
