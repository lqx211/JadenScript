        _fSign = 0;
        _fV = value;
        if (_fV < 0) {
            _fSign = 128;
            _fV = 0 - _fV;
        }
        if (_fV != _fV) { fpStore(at, 4, 192 * 65536 + 255 * 16777216); return; }
        fpInf();
        _fInf = v;
        if (_fV == _fInf) { fpStore(at, 4, 128 * 65536 + (127 + _fSign) * 16777216); return; }
        if (_fV == 0) { fpStore(at, 4, _fSign * 16777216); return; }
        fpExpOf(_fV);
        _fExp = v;
        if (_fExp > 127) { fpStore(at, 4, 128 * 65536 + (127 + _fSign) * 16777216); return; }
        if (_fExp < -126) {
            fpPow2(-149);
            _fMant = Operators.math("floor", _fV / v + 0.5);
            fpStore(at, 4, _fMant % 256 + Operators.math("floor", _fMant / 256) % 256 * 256 + Operators.math("floor", _fMant / 65536) * 65536 + _fSign * 16777216);
            return;
