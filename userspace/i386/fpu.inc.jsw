    }
 /* ---- the three formats --------------------------------------------
   *
   * m32fp and m64fp are IEEE binary32 and binary64; m80fp is binary80, with
 * an explicit integer bit. Decoding reads the fields out with `%` and
 * `floor` and multiplies by a power of two; encoding bisects the table for
 * the exponent and then scales the fraction into whole bits. */
    private void fpF32At(at) { // warp
        fpLoad(at, 4);
        _fb0 = v % 256;
        _fb1 = Operators.math("floor", v / 256) % 256;
        _fb2 = Operators.math("floor", v / 65536) % 256;
        _fb3 = Operators.math("floor", v / 16777216) % 256;
        _fSign = 1;
        if (_fb3 >= 128) { _fSign = -1; }
        _fExp = (_fb3 % 128) * 2 + Operators.math("floor", _fb2 / 128);
        _fMant = (_fb2 % 128) * 65536 + _fb1 * 256 + _fb0;
        if (_fExp >= 255) {
            if (_fMant > 0) { fpNan(); return; }
            fpInf();
            v = _fSign * v;
            return;
        }
        if (_fExp == 0) {
            fpPow2(-149);
            v = _fSign * _fMant * v;
            return;
        }
        fpPow2(_fExp - 127);
        v = _fSign * (1 + _fMant / 8388608) * v;
    }

