        _fExp = v;
        if (_fExp > 1023) {
            fpWord2(at, 0, 2146435072 + (_fSign / 128) * 2147483648);
            return;
        }
        if (_fExp < -1022) {                                   // denormal
            fpPow2(-1074);
            _fMant = _fV / v;
            fpWord2(at, _fMant % 4294967296,
                    Operators.math("floor", _fMant / 4294967296) % 1048576
