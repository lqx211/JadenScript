        _fb0 = v;
        fpByte(at + 1);
        _fb1 = v;
        fpByte(at + 2);
        _fb2 = v;
        fpByte(at + 3);
        _fb3 = v;
        fpByte(at + 4);
        _fb4 = v;
        fpByte(at + 5);
        _fb5 = v;
        fpByte(at + 6);
        _fb6 = v;
        fpByte(at + 7);
        _fb7 = v;
        _fSign = 1;
        if (_fb7 >= 128) { _fSign = -1; }
