 * has to be written, because the pieces are exact and the whole is not. */
    private void fpWord2(at, low, high) { // warp
        fpStore(at, 4, low);
        fpStore(at + 4, 4, high);
    }

    private void fpStore(at, n, value) { // warp
        _fsI = 0;
        _fsV = value;
        while (_fsI < n) {
            wrb(at + _fsI, _fsV % 256);
            _fsV = Operators.math("floor", _fsV / 256);
            _fsI += 1;
