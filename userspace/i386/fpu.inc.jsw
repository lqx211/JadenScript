        _flI = 0;
        _flV = 0;
        _flScale = 1;
        while (_flI < n) {
            rdb(at + _flI);
            _flV = _flV + v * _flScale;
            _flScale = _flScale * 256;
            _flI += 1;
        }
        v = _flV;
    }

    private void fpByte(at) { // warp
        rdb(at);
    }
