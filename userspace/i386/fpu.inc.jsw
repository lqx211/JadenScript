        _fb2 = v;
        fpByte(at + 3);
        _fb3 = v;
        fpByte(at + 4);
        _fb4 = v;
        fpByte(at + 5);
        _fb5 = v;
        fpByte(at + 6);
        _fb6 = v;
        fpByte(at + 7);
