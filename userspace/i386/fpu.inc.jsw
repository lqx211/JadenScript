/* ---- the x87 ------------------------------------------------------------
 * An 80387 with eight registers, its control word, its status word and the
 * three memory formats -- a body include of `class Cpu`, because the registers
 * belong to a core and the decode belongs to its instruction loop.
 *
 * The registers hold Scratch numbers, which *are* IEEE doubles. An 8087
 * register is eighty bits, so this is a 387 with a fifty-two-bit fraction and
 * an explicit integer bit of one; that is stated rather than hidden, and it is
 * what makes every operation exactly what `tools/i386_ref.py` computes, because
 * both do double arithmetic on the same values in the same order. The extra
 * eleven bits a real chip keeps are the price of a machine whose registers are
 * numbers.
 *
 * The raw patterns are only needed where memory is: `fld`/`fst` of m32fp,
 * m64fp and m80fp, and `fnsave`. Those are built from powers of two -- which are
 * exactly representable, so multiplying and dividing by them is exact -- and
 * from `floor`, because this language has no bitwise operators. The table is
 * `X.fpow2`, every power of two a double can name, built once at the first
 * escape and shared by every core. */

private fpSt = [0, 0, 0, 0, 0, 0, 0, 0];
private fpEmpty = [1, 1, 1, 1, 1, 1, 1, 1];
private fpTop = 0;                      // which slot st(0) is: `st(i)` rotates
private fpCw = 0x037F;                  // round to nearest, every exception masked
private fpC0 = 0;
private fpC1 = 0;
private fpC2 = 0;
private fpC3 = 0;
private fpSf = 0;                       // a stack fault happened
private fpEs = 0;                       // ... and is summarised in the status word
private fpIp = 0;                       // what a save remembers
 /* ---- the values a language without an infinity needs ---------------
   *
   * There is no literal for either, and `1 / 0` is what JavaScript -- and so
 * Scratch -- answers, so it is computed rather than spelled. The divisor is
 * a variable, not a literal, because a compiler is entitled to fold a
 * constant division and this one would raise. */
    private void fpInf() { // warp
        _fz = 0;
        v = 1 / _fz;
    }

    private void fpNan() { // warp
        _fz = 0;
        _fn = 1 / _fz;
        v = _fn - _fn;
    }
 /* ---- the register stack --------------------------------------------
   *
   * `st(i)` is a rotation, not an offset: a push moves the *name* of the top,
 * which is why every access works the slot out again. */
    private void fpSlot(i) { // warp
        v = (fpTop + i) % 8;
    }

    private void fpGet(i) { // warp
        fpSlot(i);
        v = fpSt.get(v + 1);
    }

    private void fpPut(i, value) { // warp
        fpSlot(i);
        fpSt.set(v + 1, value);
        fpEmpty.set(v + 1, 0);
    }

    private void fpIsEmpty(i) { // warp
        fpSlot(i);
        v = fpEmpty.get(v + 1);
    }

    private void fpPush(value) { // warp
        fpTop = (fpTop + 7) % 8;
        if (fpEmpty.get(fpTop + 1) == 0) {
            fpSf = 1;                   // over the top: the stack fault the
            fpEs = 1;                   // chip reports instead of faulting
            fpC1 = 1;
        }
        fpSt.set(fpTop + 1, value);
        fpEmpty.set(fpTop + 1, 0);
    }

    private void fpPop() { // warp
        _fpV = fpSt.get(fpTop + 1);
        if (fpEmpty.get(fpTop + 1) == 1) {
            fpSf = 1;
            fpEs = 1;
            fpC1 = 1;
            fpNan();
            _fpV = v;
        }
        fpEmpty.set(fpTop + 1, 1);
        fpTop = (fpTop + 1) % 8;
        v = _fpV;
    }

    private void fpDrop(i) { // warp
        fpSlot(i);
        fpEmpty.set(v + 1, 1);
        if (i == 0) { fpTop = (fpTop + 1) % 8; }
    }

    private void fpStatus() { // warp
        v = fpTop * 2048 + fpC3 * 16384 + fpC2 * 1024 + fpC1 * 512 + fpC0 * 256 + fpSf * 64 + fpEs * 128;
    }

    private void fpRoundMode() { // warp
        v = Operators.math("floor", fpCw / 1024) % 4;
    }
