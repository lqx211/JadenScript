        fpPow2(_fExp);
        _fMant = Operators.math("floor", (_fV / v - 1) * 8388608 + 0.5);
        if (_fMant >= 8388608) {
            _fMant = 0;
            _fExp += 1;
            if (_fExp > 127) { fpStore(at, 4, 128 * 65536 + (127 + _fSign) * 16777216); return; }
        }
        _fExp += 127;
        fpStore(at, 4, _fMant % 256 + Operators.math("floor", _fMant / 256) % 256 * 256 + ((_fExp % 2) * 128 + Operators.math("floor", _fMant / 65536)) * 65536 + (_fSign + Operators.math("floor", _fExp / 2)) * 16777216);
    }

    private void fpF64At(at) { // warp /* Eight bytes cannot go through `fpLoad`: a number that big is past * the fifty-three bits a Scratch number holds exactly, so the fields * are taken apart a byte at a time and each piece is exact on its own. */
