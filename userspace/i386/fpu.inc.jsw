            if (_fReg <= 3) {
                fpCondition(_fReg);
                if (v == 0) {
                    fpGet(_fRm);
                    fpPut(0, v);
                }
                return;
            }
            if (_fReg == 5 || _fReg == 6) {                     // fucomi / fcomi
                fpGet(0);
                _fL = v;
                fpGet(_fRm);
                fpCompare(_fL, v);
                fpSetFlags();
                return;
            }
            fpReserved();
            return;
        }
        if (_fOp == 220) {                                     // DC /* `fadd st(i), st(0)`: the destination is the *other* register, * and the /digit is read in the swapped order here. */
            if (_fReg == 2 || _fReg == 3) { fpReserved(); return; }
            fpGet(_fRm);
            _fL = v;
            fpGet(0);
            _fR = v;
            fpSwapKind(_fReg);
            fpBinop(v, _fL, _fR);
            fpPut(_fRm, v);
            return;
        }
        if (_fOp == 221) {                                     // DD
            if (_fReg == 0) { fpDrop(_fRm); return; }           // ffree
            if (_fReg == 2) {                                   // fst st(i): D0+i
                fpGet(0);
                _fL = v;
                fpPut(_fRm, _fL);
                return;
            }
            if (_fReg == 3) {                                   // fstp st(i): D8+i
                fpGet(0);
                _fL = v;
                fpPut(_fRm, _fL);
                fpDrop(0);
                return;
            }
            if (_fReg == 4 && _fRm == 0) {                      // fnstsw ax
                fpStatus();
                putReg16(0, v);
                return;
            }
            if (_fReg == 5 || _fReg == 6) {                     // fucom / fucomp
                fpGet(0);
                _fL = v;
                fpGet(_fRm);
                fpCompare(_fL, v);
                if (_fReg == 6) { fpDrop(0); }
                return;
            }
            fpReserved();
            return;
        }
        if (_fOp == 222) {                                     // DE
            if (_fReg == 3 && _fRm == 1) {                      // DE D9: fcompp
                fpGet(0);
                _fL = v;
                fpGet(1);
                fpCompare(_fL, v);
                fpDrop(0);
                fpDrop(0);
                return;
            }
            if (_fReg == 5 && _fRm == 1) {                      // DE E9: fucompp
                fpGet(0);
                _fL = v;
                fpGet(1);
                fpCompare(_fL, v);
                fpDrop(0);
                fpDrop(0);
                return;
            }
            if (_fReg == 2 || _fReg == 3) { fpReserved(); return; }
            fpGet(_fRm);
            _fL = v;
            fpGet(0);
            _fR = v;
            fpSwapKind(_fReg);
            fpBinop(v, _fL, _fR);
            fpPut(_fRm, v);
            fpDrop(0);                                          // the P forms pop
            return;
        }
        if (_fOp == 223) {                                     // DF
            if (_fReg == 4 && _fRm == 0) {                      // df e0: fnstsw ax
                fpStatus();
                putReg16(0, v);
                return;
            }
            if (_fReg == 5 || _fReg == 6) {                     // fucomip / fcomip
                fpGet(0);
                _fL = v;
                fpGet(_fRm);
                fpCompare(_fL, v);
                fpDrop(0);
                fpSetFlags();
                return;
            }
            fpReserved();
            return;
        }
    }
 /* The condition a `fcmov` reads: 0 = below (C0), 1 = equal (C3),
 * 2 = below or equal, 3 = unordered (C2). `fcmovn` inverts it. */
    private void fpCondition(which) { // warp
        _fcV = 0;
        if (which == 0 && fpC0 == 1) { _fcV = 1; }
        if (which == 1 && fpC3 == 1) { _fcV = 1; }
        if (which == 2 && (fpC0 == 1 || fpC3 == 1)) { _fcV = 1; }
        if (which == 3 && fpC2 == 1) { _fcV = 1; }
        v = _fcV;
    }

    private void fpConstant(rm) { // warp
        if (rm == 0) { fpPush(1); return; }                    // fld1
        if (rm == 1) { fpPush(3.321928094887362); return; }     // fldl2t
        if (rm == 2) { fpPush(1.4426950408889634); return; }    // fldl2e
        if (rm == 3) { fpPush(3.141592653589793); return; }     // fldpi
        if (rm == 4) { fpPush(0.3010299956639812); return; }    // fldlg2
        if (rm == 5) { fpPush(0.6931471805599453); return; }    // fldln2
        fpPush(0);                                             // fldz
    }

    private void fpD9Unary(rm) { // warp
        if (rm == 0) {                                          // fchs
            fpGet(0);
            fpPut(0, 0 - v);
            return;
        }
        if (rm == 1) {                                          // fabs
            fpGet(0);
            _fL = v;
            if (_fL < 0) { _fL = 0 - _fL; }
            fpPut(0, _fL);
            return;
        }
        if (rm == 4) {                                          // ftst
            fpGet(0);
            fpCompare(v, 0);
            return;
        }
        if (rm == 5) {                                          // fxam
            fpC1 = 0;
            fpC0 = 0;
            fpC2 = 0;
            fpC3 = 0;
            fpIsEmpty(0);
            if (v == 1) {
                fpC3 = 1;
                fpC1 = 1;
                return;
            }
            fpGet(0);
            _fL = v;
            if (_fL < 0) { fpC0 = 1; }
            if (_fL == 0) { fpC3 = 1; return; }
            fpInf();
            if (_fL == v || _fL == 0 - v) {
                fpC2 = 1;
                fpC3 = 1;
                return;
            }
            if (_fL != _fL) { fpC3 = 1; }
            return;
        }
        fpReserved();
    }

    private void fpTranscendental(rm) { // warp
        if (rm == 6) { fpTop = (fpTop + 1) % 8; return; }        // fdecstp
        if (rm == 7) { fpTop = (fpTop + 7) % 8; return; }        // fincstp
        fpGet(0);
        _fL = v;
        if (rm == 0) {                                          // f2xm1
            fpPut(0, Operators.math("e ^", _fL * 0.6931471805599453) - 1);
            return;
        }
        if (rm == 1) {                                          // fyl2x
            fpGet(1);
            _fR = v;
            fpPop();
            _fLog = Operators.math("ln", v);
            if (_fLog != _fLog) { fpNan(); fpPut(0, v); return; }
            fpPut(0, _fR * _fLog / 0.6931471805599453);
            return;
        }
        if (rm == 2) {                                          // fptan
            _fTan = _fL * 0;
            if (_fL != _fL) {
                fpNan();
                return;
            }
            fpPut(0, Operators.math("tan", _fL));
            fpPush(1);
            return;
        }
        if (rm == 3) {                                          // fpatan
            fpGet(1);
            _fR = v;
            fpPop();
            _fAtan = Operators.math("atan", v / _fR);
            if (_fR < 0) {
                if (v >= 0) { _fAtan = _fAtan + 3.141592653589793; } else { _fAtan = _fAtan - 3.141592653589793; }
            }
            fpPut(0, _fAtan);
            return;
        }
        if (rm == 4) {                                          // fxtract /* st(0) = the exponent, and the significand is pushed on top of it: * two separate writes, because the push moves the top. */
            fpGet(0);
            _fL = v;
            if (_fL == 0 || _fL != _fL) {
                fpPut(0, _fL);
                fpPush(_fL);
                return;
            }
            _fA = _fL;
            if (_fA < 0) { _fA = 0 - _fA; }
            fpExpOf(_fA);
            _fX = v;
            fpPow2(_fX);
            _fM = _fL / v;
            fpPut(0, _fX);
            fpPush(_fM);
            return;
        }
        if (rm == 5) {                                          // fprem1
            fpGet(1);
            _fR = v;
            fpGet(0);
            fpRemainder(v, _fR);
            fpPut(0, v);
            return;
        }
        fpReserved();
    }
 /* The remainder with the *dividend's* sign -- which is what `fprem` means
 * and what `%` does not do here. */
    private void fpRemainder(left, right) { // warp
        if (right == 0 || right != right || left != left) { fpNan(); return; }
        _frL = left;
        if (_frL < 0) { _frL = 0 - _frL; }
        _frR = right;
        if (_frR < 0) { _frR = 0 - _frR; }
        _frV = _frL % _frR;
        if (left < 0) { _frV = 0 - _frV; }
        v = _frV;
    }

    private void fpD9Misc(rm) { // warp
        /* `D9 F8`-`D9 FF`: the second half of the one-argument page, indexed
         * from zero -- `fdecstp` above is index 6 of the *other* half, which is
         * `D9 F6`. Reading these as the low nibble of the byte is the mistake
         * this table invites. */
        if (rm == 0) {                                          // fprem
            fpGet(1);
            _fR = v;
            fpGet(0);
            fpRemainder(v, _fR);
            fpPut(0, v);
            return;
        }
        if (rm == 1) {                                          // fyl2xp1
            fpGet(1);
            _fR = v;
            fpPut(0, _fR * Operators.math("ln", _fL + 1) / 0.6931471805599453);
            return;
        }
        if (rm == 2) {                                          // fsqrt
            fpGet(0);
            if (v < 0) {
                fpC0 = 1;
                fpC2 = 1;
                fpC3 = 1;
                fpNan();
                fpPut(0, v);
                return;
            }
            fpPut(0, Operators.math("sqrt", v));
            return;
        }
        if (rm == 3) {                                          // fsincos
            fpGet(0);
            _fL = v;
            fpPut(0, Operators.math("cos", _fL));
            fpPush(Operators.math("sin", _fL));
            return;
        }
        if (rm == 4) {                                          // frndint
            fpGet(0);
            fpToInt(v, 8);
            fpPut(0, v);
            return;
        }
        if (rm == 5) {                                          // fscale
            fpGet(1);
            _fR = Operators.math("floor", v);
            fpGet(0);
            _fL = v;
            fpPow2(_fR);
            fpPut(0, _fL * v);
            return;
        }
        if (rm == 6) {                                          // fsin
            fpGet(0);
            fpPut(0, Operators.math("sin", v));
            return;
        }
        if (rm == 7) {                                          // fcos
            fpGet(0);
            fpPut(0, Operators.math("cos", v));
            return;
        }
        fpReserved();
    }


    private void fpMemForm(address) { // warp
        _fAddr = address;
        if (_fOp == 216) {                                      // D8: m32fp
            fpF32At(_fAddr);
            fpArithMemory(v);
            return;
        }
        if (_fOp == 217) {                                      // D9
            if (_fReg == 0) {
                fpF32At(_fAddr);
                fpPush(v);
                return;
            }
            if (_fReg == 2 || _fReg == 3) {
                fpGet(0);
                fpF32To(_fAddr, v);
                if (_fReg == 3) { fpDrop(0); }
                return;
            }
            if (_fReg == 5) {
                fpLoad(_fAddr, 2);
                fpCw = v;
                return;
            }
            if (_fReg == 7) { fpStore(_fAddr, 2, fpCw); return; }
            if (_fReg == 4) { fpEnvLoad(_fAddr); return; }
            if (_fReg == 6) { fpEnvSave(_fAddr); return; }
            fpReserved();
            return;
        }
        if (_fOp == 218) {                                      // DA: m32int
            fpSignedAt(_fAddr, 4);
            fpArithMemory(v);
            return;
        }
        if (_fOp == 219) {                                      // DB
            if (_fReg == 0) {
                fpSignedAt(_fAddr, 4);
                fpPush(v);
                return;
            }
            if (_fReg == 2 || _fReg == 3) {
                fpGet(0);
                fpToInt(v, 4);
                fpStore(_fAddr, 4, v % 4294967296);
                if (_fReg == 3) { fpDrop(0); }
                return;
            }
            if (_fReg == 5) {
                fpF80At(_fAddr);
                fpPush(v);
                return;
            }
            if (_fReg == 7) {
                fpGet(0);
                fpF80To(_fAddr, v);
                fpDrop(0);
                return;
            }
            fpReserved();
            return;
        }
        if (_fOp == 220) {                                      // DC: m64fp
            fpF64At(_fAddr);
            _fR = v;
            fpGet(0);
            _fL = v;
            fpSwapKind(_fReg);
            if (_fReg == 2 || _fReg == 3) {
                fpCompare(_fL, _fR);
                if (_fReg == 3) { fpDrop(0); }
                return;
            }
            fpBinop(v, _fL, _fR);
            fpPut(0, v);
            return;
        }
        if (_fOp == 221) {                                      // DD
            if (_fReg == 0) {
                fpF64At(_fAddr);
                fpPush(v);
                return;
            }
            if (_fReg == 2 || _fReg == 3) {
                fpGet(0);
                fpF64To(_fAddr, v);
                if (_fReg == 3) { fpDrop(0); }
                return;
            }
            if (_fReg == 4) { fpRestore(_fAddr); return; }
            if (_fReg == 6) { fpSave(_fAddr); return; }
            if (_fReg == 7) {
                fpStatus();
                fpStore(_fAddr, 2, v);
                return;
            }
            fpReserved();
            return;
        }
        if (_fOp == 222) {                                      // DE: m16int
            fpSignedAt(_fAddr, 2);
            fpArithMemory(v);
            return;
        }
        if (_fOp == 223) {                                      // DF
            if (_fReg == 0) {
                fpSignedAt(_fAddr, 2);
                fpPush(v);
                return;
            }
            if (_fReg == 2 || _fReg == 3) {
                fpGet(0);
                fpToInt(v, 2);
                fpStore(_fAddr, 2, v % 65536);
                if (_fReg == 3) { fpDrop(0); }
                return;
            }
            if (_fReg == 4) {                                   // fbld
                /* Eighteen packed digits, most significant last, with the sign
                 * in the top nibble of the tenth byte. */
                _fVal = 0;
                _fI = 8;
                while (_fI >= 0) {
                    fpByte(_fAddr + _fI);
                    _fB = v;
                    _fVal = _fVal * 100 + Operators.math("floor", _fB / 16) * 10 + _fB % 16;
                    _fI = _fI - 1;
                }
                fpByte(_fAddr + 9);
                if (Operators.math("floor", v / 16) % 16 == 13) { _fVal = 0 - _fVal; }
                fpPush(_fVal);
                return;
            }
            if (_fReg == 6) {                                   // fbstp
                fpGet(0);
                _fNeg = 0;
                if (v < 0) { _fNeg = 208; }
                fpToInt(v, 8);
                _fVal = v;
                if (_fVal < 0) { _fVal = 0 - _fVal; }
                _fI = 0;
                while (_fI < 9) {
                    _fA2 = Operators.math("floor", _fVal / 10) % 10;
                    _fB2 = _fVal % 10;
                    fpStore(_fAddr + _fI, 1, _fA2 * 16 + _fB2);
                    _fVal = Operators.math("floor", _fVal / 100);
                    _fI += 1;
                }
                fpStore(_fAddr + 9, 1, _fNeg);
                fpDrop(0);
                return;
            }
            if (_fReg == 5) {
                fpLoad(_fAddr, 4);
                _fLo = v;
                fpLoad(_fAddr + 4, 4);
                _fHi = v;
                _fV = _fHi * 4294967296 + _fLo;
                if (_fHi >= 2147483648) { _fV = _fV - 18446744073709551616; }
                fpPush(_fV);
                return;
            }
            if (_fReg == 7) {                                   // fistp qword
                fpGet(0);
                _fNeg = 0;
                if (v < 0) { _fNeg = 1; }
                fpToInt(v, 8);
                _fV = v;
                if (_fV < 0) { _fV = 0 - _fV; }
                _fLo = _fV % 4294967296;
                _fHi = Operators.math("floor", _fV / 4294967296);
                if (_fNeg == 1) {
                    /* Two's complement, done on the halves: the whole
                     * sixty-four-bit negation is not a number this can hold. */
                    if (_fLo == 0) {
                        _fHi = 4294967296 - _fHi;
                    } else {
                        _fHi = 4294967295 - _fHi;
                        _fLo = 4294967296 - _fLo;
                    }
                    _fHi = _fHi % 4294967296;
                }
                fpStore(_fAddr, 4, _fLo);
                fpStore(_fAddr + 4, 4, _fHi);
                fpDrop(0);
                return;
            }
            fpReserved();
            return;
        }
    }
 /* The §/digit arithmetic a memory operand takes: `fsub` and `fsubr` are
 * the two that a table like this gets wrong, and the top of the stack is
 * the destination in every case. */
    private void fpArithMemory(right) { // warp
        if (_fReg == 2) {
            fpGet(0);
            fpCompare(v, right);
            return;
        }
        if (_fReg == 3) {
            fpGet(0);
            fpCompare(v, right);
            fpDrop(0);
            return;
        }
        fpGet(0);
        fpBinop(_fReg, v, right);
        fpPut(0, v);
    }
 /* ---- the environment, which is where a save begins ------------------- */
    private void fpEnvSave(at) { // warp
        /* `fnstenv`: fourteen bytes with a sixteen-bit operand size and
         * twenty-eight with a thirty-two. Every field is one operand-size slot
         * wide, which is the whole difference between the two forms. */
        _fkStep = 2;
        if (dsz == 4) { _fkStep = 4; }
        fpStatus();
        _fkStatus = v;
        fpTag();
        _fkTag = v;
        fpStore(at, 2, fpCw);
        fpStore(at + _fkStep, 2, _fkStatus);
        fpStore(at + _fkStep * 2, 2, _fkTag);
        fpStore(at + _fkStep * 3, _fkStep, fpIp);
        fpStore(at + _fkStep * 4, 2, 61440);
        fpStore(at + _fkStep * 5, _fkStep, 0);
        fpStore(at + _fkStep * 6, 2, 0);
    }

    private void fpEnvLoad(at) { // warp
        _fkStep = 2;
        if (dsz == 4) { _fkStep = 4; }
        fpLoad(at, 2);
        fpCw = v;
        fpLoad(at + _fkStep, 2);
        _fkStatus = v;
        fpTop = Operators.math("floor", _fkStatus / 2048) % 8;
        fpC3 = Operators.math("floor", _fkStatus / 16384) % 2;
        fpC2 = Operators.math("floor", _fkStatus / 1024) % 2;
        fpC1 = Operators.math("floor", _fkStatus / 512) % 2;
        fpC0 = Operators.math("floor", _fkStatus / 256) % 2;
        fpSf = Operators.math("floor", _fkStatus / 64) % 2;
        fpEs = Operators.math("floor", _fkStatus / 128) % 2;
    }

    /* `fnsave` and `frstor`: the environment followed by the eight registers
     * in extended precision, which is the only way a program can hand the whole
     * FPU state to memory and get it back. `fnsave` leaves the chip as it comes
     * out of the factory, which is why a save does not have to be paired with a
     * `finit`. */
    private void fpSave(at) { // warp
        fpEnvSave(at);
        fpLoad(at + _fkStep * 2, 2);
        _fkTag = v;
        _fkBase = at + _fkStep * 7;
        _fkI = 0;
        while (_fkI < 8) {
            if (Operators.math("floor", _fkTag / X.pow2.get(_fkI * 2 + 1)) % 4 == 3) {
                fpF80To(_fkBase + _fkI * 10, 0);
            } else {
                fpGet(_fkI);
                fpF80To(_fkBase + _fkI * 10, v);
            }
            _fkI += 1;
        }
        fpInit();                                   // `fnsave` re-initialises
    }

    private void fpRestore(at) { // warp
        fpEnvLoad(at);
        fpLoad(at + _fkStep * 2, 2);
        _fkTag = v;
        _fkBase = at + _fkStep * 7;
        _fkI = 0;
        while (_fkI < 8) {
            if (Operators.math("floor", _fkTag / X.pow2.get(_fkI * 2 + 1)) % 4 == 3) {
                fpSlot(_fkI);
                fpSt.set(v + 1, 0);
                fpEmpty.set(v + 1, 1);
            } else {
                /* The image names the registers from st(0) outwards, and the
                 * top came back with the status word, so index i is st(i). */
                fpF80At(_fkBase + _fkI * 10);
                fpPut(_fkI, v);
            }
            _fkI += 1;
        }
    }

    /* A form the table does not implement: the same interrupt 7 the machine
     * raised before it had an FPU at all, and what the Python model raises. */
    private void fpReserved() { // warp
        interrupt(7);
    }
