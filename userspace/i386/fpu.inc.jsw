        _fInf = v;
        if (_fV == _fInf) {
            fpWord2(at, 0, 2146435072 + (_fSign / 128) * 2147483648);
            return;
        }
        if (_fV == 0) { fpWord2(at, 0, (_fSign / 128) * 2147483648); return; }
