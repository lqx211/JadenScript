#enable_feature<commentMetadata>;
// JadenScript demo — exercises every construct the v0 compiler lowers.
// Sprite: player (0,0) size=100 direction=90 show=1

class player { // Sprite: player (0,0) size=100 direction=90 show=1
    public void greenFlag() {
        public Player.score = 0;
        public Player.high = 0;
        Piano.notes.clear();
        Pen.eraseAll();
        Pen.setPenSize(3);
        Motion.x = -200;
        Motion.y = 0;
        for (i=1, i<=10, i++){
            Piano.notes.add(i*10);
        }
        log("ready: "+string(Player.score));
    }

    private void log(msg){
        Looks.say(msg);
    }

    public void Player.tick(){
        Player.score++;
        if (Player.score>Player.high){
            Player.high = Player.score;
        } elif (Player.score == 0){
            Player.score = 1;
        } else {
            Player.score += 0;
        }
        while (Player.score < 5){
            Player.score++;
        }
        switch (Player.score){
            case 1:
                Player.score = 2;
                break;
            case 2:
                Player.score = 3;
                break;
            case _:
                Player.score = 0;
        }
        Pen.setPenColor(Player.score % 16777216);
        Pen.penDown();
        Motion.x += 4;
        Motion.y += (4) if (Player.score>2) else (-4);
        Pen.penUp();
    }

    public void Events.keyPressed(k) { // hook: when [space] key pressed
        call Player.reset();
    }

    public void Player.reset(){
        public Player.score = 0;
        Music.playNote(60, 0.5);
        Control.wait(0.1);
    }

    public void whenCloned(){
        private id = Player.score;
        if (id > 3){
            return;
        }
        Player.score += 1;
    }
}
