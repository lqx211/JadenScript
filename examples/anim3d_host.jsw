        if (_q == 1) { _x = 0 - 1; _y = 0 - 1; _z = 0 - 1; }
        if (_q == 2) { _x = 0 - 1; _z = 0 - 1; }
        if (_q == 3) { _y = 0 - 1; }
        if (_q == 4) { _z = 0 - 1; }
        if (_q == 5) { _x = 0 - 1; _z = 0 - 1; }
        if (_q == 6) { _x = 0 - 1; }
        _x1 = _x * _c1 + _z * _s1;
        _z1 = _z * _c1 - _x * _s1;
        _y1 = _y * _c2 - _z1 * _s2;
        _z2 = _z1 * _c2 + _y * _s2;
