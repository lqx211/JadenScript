/* ---- frame gate ------------------------------------------------------ */
public D3.lastTick = -1;      // the tick this frame was drawn for
public D3.tickAt = 0;         // when that tick landed, in timer seconds
public D3.lastFrac = 0;       // sub-tick position of the last drawn frame
public D3.lastDraw = -1;      // wall clock of the last redraw, in seconds
public D3.frameInterval = 0.0166; // 1/60 — the backend budget, not the VM rate
public D3.drawn = 0;          // frames actually re-stroked

/* ---- easing ---------------------------------------------------------- */
public D3.ease = 0;           // shared result slot: procedures cannot return
public D3.easeLinear = 0;
public D3.easeInQuad = 1;
public D3.easeOutQuad = 2;
public D3.easeInOutQuad = 3;
public D3.easeInCubic = 4;
public D3.easeOutCubic = 5;
public D3.easeInOutCubic = 6;
public D3.easeInExpo = 7;
public D3.easeOutExpo = 8;
public D3.easeInOutSine = 9;
public D3.easeOutBack = 10;
public D3.easeOutElastic = 11;

/*
 * Test clock. Inside NotePlayer this comes from the player's own tick engine
 * (`Ticker` in NP4.26 advances `Tick.tick` once per beat subdivision), so delete
 * this block and the `public Tick.tick` above when embedding — the renderer only
 * reads the variable, it never advances it.
 */
D3: name="D3", x=0, y=0, size=100, direction=90, show=0, costume=0, volume=100, layer=1, rotation="all", draggable=0, namespace="D3";
class D3 {
    private yaw = 0;
    private pitch = 0;
    public D3.pos = [];
    public D3.idx = [];
    public D3.proj = [];

    public void greenFlag() { // hook: green flag
        Looks.hide();
        prepare();
        // startTick offsets the clock, so a review can begin at any shot
        D3.showOrigin = Tick.tick - D3.startTick;
        Motion.setXY(0, 0);
        D3.lastTick = -1;
        D3.lastDraw = -1;
        D3.drawn = 0;
        while (1) {
            frame();
        }
    }

    /* ------------------------------------------------------------------ */
    /* frame                                                              */
    /* ------------------------------------------------------------------ */

    private void frame() { // warp
        if (D3.active == 0) {
            return;
        }
        // `Tick.tick` is whole beats of the sequencer: at 34.6664 ticks a second
        // it only moves 35 times, while the pen is asked to draw 60 times. That
        // is 25 redundant frames a second and visible judder on anything that
        // slides. So the tick is the *music* clock and the picture runs on
        // `showTick`, which is that tick plus how far the wall clock has moved
        // into the next one. Nothing downstream has to know: `shotAt`,
        // `applyKeys` and the motifs all take a fractional tick already.
        _now = Tick.tick;
        _clock = Sensing.timer();
        if (_now != D3.lastTick) {
            D3.lastTick = _now;
            D3.tickAt = _clock;
        }
        // Never more than ~60 redraws a second, even though Turbo Mode calls
        // this 180 times. A 60 FPS frame lands only ~16.7 ms after the last one,
        // so compare against a slightly looser budget than 1/60 or timer jitter
        // eats every second pose.
        if (_clock - D3.lastDraw < D3.frameInterval * 0.9) {
            return;
        }
        D3.lastDraw = _clock;

        // How far into the current tick we are, 0 just after it landed and
        // just under 1 before the next one. Clamped because a host that pauses
        // its sequencer would otherwise run the fraction away to infinity.
        _frac = (_clock - D3.tickAt) * D3.tickRate;
        if (_frac < 0) {
            _frac = 0;
        }
        if (_frac > 0.999) {
            _frac = 0.999;
        }
        // A stopped sequencer leaves the fraction pinned at its ceiling, so the
        // pose stops changing. Drawing it sixty times a second anyway is pure
        // waste; one frame at the ceiling is enough until the next tick lands.
        if (_frac > 0.99 && D3.lastFrac > 0.99) {
            return;
        }
        D3.lastFrac = _frac;

        // The show is relative to when it started, so it looks the same whether
        // it runs standalone or inside a player whose clock is already at 2159.
        // A player reset moves the clock backwards: re-origin instead of
        // rendering a wild jump.
        if (_now - D3.showOrigin < 0) {
            D3.showOrigin = _now - D3.startTick;
        }
        D3.showTick = _now - D3.showOrigin + _frac;
        if (D3.holdTick >= 0) {
            D3.showTick = D3.holdTick;
        }
        if (D3.showTick > D3.totalTicks) {
            return;
        }
        // stopTick closes the window a review plays, so the frame after it holds
        // whatever was drawn last instead of running on into the next show
        if (D3.stopTick >= 0 && D3.showTick > D3.stopTick) {
            return;
        }
        // the beat follows the song clock, not the show position, so a pinned
        // frame still blinks in time; the fraction keeps the pulses smooth
        beatClock(_now + _frac);

        shotAt(D3.showTick);
        if (D3.shotId == 16) {
            _lit = 0;
            if (D3.beatPhase < 0.5) {
                _lit = 1;
            }
            seg(D3.showTick - D3.shotT0, 2, 16);
            _a1 = floor(D3.ease * 40);
            seg(D3.showTick - D3.shotT0, 16, 26);
            _a2 = floor(D3.ease * 40);
            _sig = _lit * 10000 + _a1 * 100 + _a2;
            if (_sig == D3.sig) {
                return;
            }
            D3.sig = _sig;
        }
        D3.shotP = (D3.showTick - D3.shotT0) / (D3.shotT1 - D3.shotT0);
        applyKeys(D3.showTick);

        // The transition is a collapse: the outgoing shot shrinks to a point
        // over the last `fade` ticks, the incoming one grows out of it over the
        // first `fade`. One scene is drawn per frame, never two.
        D3.wScale = 1;
        if (D3.fade > 0) {
            if (D3.showTick >= D3.shotT1 - D3.fade) {
                _q = (D3.showTick - (D3.shotT1 - D3.fade)) / D3.fade;
                easeBy(0, _q);
                D3.wScale = 1 - D3.ease * 0.92;
            } else {
                if (D3.showTick < D3.shotT0 + D3.fade) {
                    _q = (D3.showTick - D3.shotT0) / D3.fade;
                    easeBy(0, _q);
                    D3.wScale = 0.08 + D3.ease * 0.92;
                }
            }
        }
        if (D3.wScale < 0.02) {
            D3.wScale = 0.02;
        }

        D3.hud = 0;
        sectionAt(D3.showTick);
        drawScene(D3.shotId, D3.showTick, D3.shotParam);
        // the film's `overlays()` caption is drawn over every shot that has one
        if (D3.shotCaption != "") {
            D3.hud = 1;
        }
        render();
        if (D3.hud == 1) {
            drawHud(D3.shotId, D3.showTick);
        }
        D3.drawn += 1;
        // The pen layer is project-wide, so anything that has to sit on top of
        // the scene has to be drawn again here. A host opts in by listening for
        // this broadcast; with nobody listening it costs nothing but the send.
        if (D3.onFrame == 1) {
            call D3.afterFrame();
        }
    }

    /* Beat position and the two decaying pulses, straight off the tick. */
    private void beatClock(t) { // warp
        D3.beatPhase = (t % D3.ticksPerBeat) / D3.ticksPerBeat;
        D3.barPhase = (t % D3.ticksPerBar) / D3.ticksPerBar;
        D3.pulseBeat = exp((0 - D3.beatPhase) * 5);
        D3.pulseBar = exp((0 - D3.barPhase) * 3.2);
    }

    /* ------------------------------------------------------------------ */
    /* shot timeline                                                       */
    /* ------------------------------------------------------------------ */

    /*
     * The shot whose window contains t. Shots are sorted by start tick; each one
     * ends where the next begins and the last ends at `totalTicks`.
     */
    private void shotAt(t) { // warp
        _n = D3.shots.length() / D3.shotStride;
        D3.shotIndex = 1;
        if (_n < 1) {
            D3.shotId = 1;
            D3.shotT0 = 0;
            D3.shotT1 = D3.totalTicks;
            D3.fade = 0;
            D3.shotCaption = "";
            return;
        }
        _i = 1;
        _best = 1;
        while (_i <= _n) {
            if (t >= D3.shots.get((_i - 1) * D3.shotStride + 1)) {
                _best = _i;
            }
            _i += 1;
        }
        D3.shotIndex = _best;
        D3.shotId = D3.shots.get((_best - 1) * D3.shotStride + 2);
        D3.fade = D3.shots.get((_best - 1) * D3.shotStride + 3);
        D3.shotParam = D3.shots.get((_best - 1) * D3.shotStride + 4);
        D3.shotCaption = D3.shots.get((_best - 1) * D3.shotStride + 5);
        D3.shotT0 = D3.shots.get((_best - 1) * D3.shotStride + 1);
        if (_best < _n) {
            D3.shotT1 = D3.shots.get(_best * D3.shotStride + 1);
        } else {
            D3.shotT1 = D3.totalTicks;
        }
        if (D3.shotT1 <= D3.shotT0) {
            D3.shotT1 = D3.shotT0 + 1;
        }
        // A fade may never eat more than a quarter of its own shot: at nine
        // ticks in and nine out, a twenty-tick shot would never reach full size
        // and the fast sections would read as one long collapse.
        if (D3.fade > (D3.shotT1 - D3.shotT0) / 4) {
            D3.fade = (D3.shotT1 - D3.shotT0) / 4;
        }
    }

    /* ------------------------------------------------------------------ */
    /* keyframes                                                           */
    /* ------------------------------------------------------------------ */

    /*
     * Key rows are `tick, yaw, pitch, dist, easeId`. Find the row the clock is
     * in and how far it has crossed the gap to the next one; a clock before the
     * first key holds it, a clock past the last one holds that.
     */
    private void kfAt(t) { // warp
        _n = D3.keys.length() / D3.keyStride;
        D3.kfRow = 1;
        D3.kfK = 0;
        if (_n < 2) {
            return;
        }
        _i = 1;
        while (_i < _n) {
            _ta = D3.keys.get((_i - 1) * D3.keyStride + 1);
            _tb = D3.keys.get(_i * D3.keyStride + 1);
            if (t < _tb) {
                if (t <= _ta) {
                    D3.kfRow = _i;
                    D3.kfK = 0;
                } else {
                    D3.kfRow = _i;
                    D3.kfK = (t - _ta) / (_tb - _ta);
                }
                return;
            }
            _i += 1;
        }
        D3.kfRow = _n - 1;
        D3.kfK = 1;
    }

    private void applyKeys(t) { // warp
        if (D3.keys.length() < D3.keyStride) {
            return;
        }
        kfAt(t);
        _a = (D3.kfRow - 1) * D3.keyStride + 1;
        _b = D3.kfRow * D3.keyStride + 1;
        // The ease id lives on the destination key: the shape belongs to the
        // move you are making, not the one you came from.
        easeBy(D3.keys.get(_b + 4), D3.kfK);
        D3.camYaw = D3.keys.get(_a + 1) + (D3.keys.get(_b + 1) - D3.keys.get(_a + 1)) * D3.ease;
        D3.camPitch = D3.keys.get(_a + 2) + (D3.keys.get(_b + 2) - D3.keys.get(_a + 2)) * D3.ease;
        D3.camDist = D3.keys.get(_a + 3) + (D3.keys.get(_b + 3) - D3.keys.get(_a + 3)) * D3.ease;
    }

    /* ------------------------------------------------------------------ */
    /* easing                                                              */
    /* ------------------------------------------------------------------ */

    /*
     * A Scratch custom block cannot return a value (E0051), so every easing
     * writes the shared `ease` slot. Read it immediately after the call.
     * `case _` is linear, so an unknown id degrades to a straight line instead
     * of a wrong curve.
     */
    public void easeBy(id, p) { // warp
        _e = p;
        if (_e < 0) {
            _e = 0;
        }
        if (_e > 1) {
            _e = 1;
        }
        switch (id) {
            case 1 { D3.ease = _e * _e; }
            case 2 { D3.ease = 1 - (1 - _e) * (1 - _e); }
            case 3 {
                if (_e < 0.5) {
                    D3.ease = 2 * _e * _e;
                } else {
                    D3.ease = 1 - (2 - 2 * _e) * (2 - 2 * _e) / 2;
                }
            }
            case 4 { D3.ease = _e * _e * _e; }
            case 5 { D3.ease = 1 - (1 - _e) * (1 - _e) * (1 - _e); }
            case 6 {
                if (_e < 0.5) {
                    D3.ease = 4 * _e * _e * _e;
                } else {
                    D3.ease = 1 - (2 - 2 * _e) * (2 - 2 * _e) * (2 - 2 * _e) / 2;
                }
            }
            case 7 {
                if (_e == 0) {
                    D3.ease = 0;
                } else {
                    D3.ease = exp((10 * _e - 10) * 0.6931472);
                }
            }
            case 8 {
                if (_e == 1) {
                    D3.ease = 1;
                } else {
                    D3.ease = 1 - exp(0 - 10 * _e * 0.6931472);
                }
            }
            case 9 { D3.ease = (1 - cos(_e * 180)) / 2; }
            case 10 { easeBack(_e); }
            case 11 { easeElastic(_e); }
            case _ { D3.ease = _e; }
        }
    }

    /* outBack and outElastic have no scratch variables of their own to reuse. */
    private void easeBack(p) { // warp
        _x = p - 1;
        D3.ease = 1 + 2.70158 * _x * _x * _x + 1.70158 * _x * _x;
    }

    private void easeElastic(p) { // warp
        if (p == 0) {
            D3.ease = 0;
        } else {
            if (p == 1) {
                D3.ease = 1;
            } else {
                D3.ease = 1 + sin((10 * p - 0.75) * 120) * exp(0 - 10 * p * 0.6931472);
            }
        }
    }

    /* Stable pseudo-random in [0,1) for an integer key — the same key, same value. */
    public void hash01(n) { // warp
        D3.ease = (n * 12.9898 + 78.233);
        D3.ease = (sin(D3.ease) * 43758.5453) % 1;
        if (D3.ease < 0) {
            D3.ease = D3.ease + 1;
        }
    }

    /* ------------------------------------------------------------------ */
    /* scenes                                                              */
    /* ------------------------------------------------------------------ */

    /*
     * One motif per scene id. `par` is the shot's own knob: the same motif ten
     * ways instead of one shape for the whole film.
     */
    private void drawScene(id, t, par) { // warp
        _v = 1;
        _e = 1;
        D3.nv = 0;
        D3.ne = 0;
        D3.shotParam = par;
        switch (id) {
            case 1 { buildGrid(t); }
            case 2 { buildTunnel(t); }
            case 3 { buildWave(t); }
            case 4 { buildCube(t); }
            case 5 { buildStars(t, par); }
            case 6 { buildSphere(t, par); }
            case 7 { buildRings(t, par); }
            case 8 { buildNetwork(t, par); }
            case 9 { buildGlyphs(t, par); }
            case 10 { buildHelix(t, par); }
            case 11 { buildCurve(t, par); }
            case 12 { buildShards(t, par); }
            case 13 { buildLattice(t, par); }
            case 14 { buildDial(t, par); }
            case 15 { buildArrow(t, par); }
            case 16 { buildCursor(t, par); }
            case 17 { buildTrace(t, par); }
            case 18 { buildCurrent(t, par); }
            case 19 { buildTrails(t, par); }
            case 20 { buildTrailsTop(t, par); }
            case _ { buildPoly(t); }
        }
    }

    /* Append one vertex; `nv` counts them so edges can name the last two. */
    public void v3(x, y, z) { // warp
        D3.pos.set(_v, x);
        D3.pos.set(_v + 1, y);
        D3.pos.set(_v + 2, z);
        _v += 3;
        D3.nv += 1;
    }

    public void e2(a, b) { // warp
        D3.idx.set(_e, a);
        D3.idx.set(_e + 1, b);
        _e += 2;
        D3.ne += 1;
    }

    /* An icosahedron: twelve vertices, thirty edges, breathing. */
    private void buildPoly(t) { // warp
        D3.penColor = "#7fd1ff";
        D3.penSize = 2;
        view(1, 0, 0, 0.25, 0);
        _r = 1 + 0.14 * D3.pulseBeat;
        _g = (1 + sqrt(5)) / 2 * _r * 0.62;
        v3(0 - _r * 0.62, _g, 0); v3(_r * 0.62, _g, 0);
        v3(0 - _r * 0.62, 0 - _g, 0); v3(_r * 0.62, 0 - _g, 0);
        v3(0, 0 - _r * 0.62, _g); v3(0, _r * 0.62, _g);
        v3(0, 0 - _r * 0.62, 0 - _g); v3(0, _r * 0.62, 0 - _g);
        v3(_g, 0, 0 - _r * 0.62); v3(_g, 0, _r * 0.62);
        v3(0 - _g, 0, 0 - _r * 0.62); v3(0 - _g, 0, _r * 0.62);
        e2(1, 2); e2(1, 6); e2(1, 8); e2(1, 11); e2(1, 12);
        e2(2, 6); e2(2, 8); e2(2, 9); e2(2, 10);
        e2(3, 4); e2(3, 5); e2(3, 7); e2(3, 11); e2(3, 12);
        e2(4, 5); e2(4, 7); e2(4, 9); e2(4, 10);
        e2(5, 6); e2(5, 10); e2(5, 12);
        e2(6, 10); e2(6, 12);
        e2(7, 8); e2(7, 9); e2(7, 11);
        e2(8, 9); e2(8, 11);
        e2(9, 10); e2(11, 12);
    }

    /*
     * A floor plane running away from the camera: lines across it, lines along
     * it, and a few posts so the plane reads as having height.
     */
    private void buildGrid(t) { // warp
        D3.penColor = "#59e0a8";
        D3.penSize = 2;
        view(0, 22, 2.5, 3, 0);
        _cols = 7;
        _rows = 5;
        _z0 = 0 - (t * 0.06 + D3.pulseBar * 0.6) % 2;
        _i = 0;
        while (_i < _rows) {
            _z = _z0 + _i * 2.5 + 1;
            v3(0 - 9, 0 - 2, _z); v3(9, 0 - 2, _z); e2(D3.nv - 1, D3.nv);
            _i += 1;
        }
        _j = 0;
        while (_j < _cols) {
            _x = 0 - 9 + _j * 3;
