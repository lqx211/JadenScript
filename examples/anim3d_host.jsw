#enable_feature<useTempVariables>;

/*
 * A stand-in for NP4.26: it owns `Tick.tick` and advances it from a stage clock,
 * exactly like the player's `Ticker()`. `anim3d/core.jsw` is spliced in on top of
 * it by `make anim3d-embed`, so this file is the regression check for the
 * embedding path — a duplicate `Tick.tick`, a leftover test clock or a nuked
 * stage script all show up here first.
 */

public Tick.tick = 0;
public Tick.wait = 4;

stage {
    public void greenFlag() { // hook: green flag
        while (1) {
            Tick.tick += 1;
            Control.wait(1 / 180);
        }
    }
}

// >>> anim3d BEGIN — generated by tools/embed_anim3d.py from anim3d/core.jsw
/*
 * anim3d — a pen-only 3D renderer with a shot timeline.
 *
 * Modelled on how wem_example drives a frame: the picture is a pure function of
 * the song clock, a shot list decides which scene is on screen, keyframes drive
 * the camera, and easing shapes the gaps between keys. Nothing here counts
 * frames or relies on how often the VM happens to run.
 *
 * The clock is `Tick.tick`, the same variable NP4.26's `Ticker()` advances once
 * per beat subdivision. 16 ticks per beat (Tick.wait = 4) and 64 per bar.
 *
 *   D3.pos   x,y,z,x,y,z,...        model space, rebuilt by the scene each frame
 *   D3.idx   a,b, a,b, ...          1-based vertex indices, static per scene
 *   D3.proj  sx,sy,depth,flag,...   per-frame projection buffer
 *
 * A scene only has to fill `D3.pos` and `D3.idx`; `render()` projects once and
 * strokes every edge. Add a scene by writing a `buildX(t)` builder and a `case`
 * in `drawScene`.
 */

/* ---- clock ---------------------------------------------------------- */

public D3.ticksPerBeat = 16;
public D3.ticksPerBar = 64;
public D3.beatPhase = 0;      // 0..1 inside the current beat
public D3.barPhase = 0;       // 0..1 inside the current bar
public D3.pulseBeat = 0;      // 1 on the beat, decaying until the next one
public D3.pulseBar = 0;

/* ---- show ------------------------------------------------------------ */
/*
 * The running order, lifted from the example film's own timeline: which scene
 * is on screen and from which tick. `tools/gen_anim3d_show.py` writes the block
 * below from `wem_example/data/timing.json`; the motifs it names live further
 * down in `drawScene`.
 *
 * A shot row is `startTick, motifId, fadeTicks, param`. A key row is
 * `tick, yaw, pitch, dist, easeId`.
 */
public D3.showOrigin = 0;     // the tick the show started at
public D3.showTick = 0;       // Tick.tick - showOrigin, in ticks

/*
 * Linux.jsw's terminal font, decoded: 95 ASCII glyphs, each 8 px wide and 15
 * rows tall, one row per entry as an 8-bit mask with the leftmost pixel in bit
 * 7. Row 0 is the baseline row of the cell, row 14 the top. The glyphs were
 * rasterised by emulating `drawGlyph` in Linux.jsw, which walks the
 * run-length strings in assets/lists/font.jsa down each column.
 */
public D3.cellW = 8;
public D3.cellH = 15;
/* The 95 printable ASCII characters, in the order of the glyph table. */
public D3.glyphChars = " !\"#$%&'()*+,-./0123456789:;<=>?@ABCDEFGHIJKLMNOPQRSTUVWXYZ[\\]^_`abcdefghijklmnopqrstuvwxyz{|}~";
