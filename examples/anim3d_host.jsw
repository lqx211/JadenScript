        switch (_m) {
            case 1 { D3.penColor = "#59e0a8"; }
            case 2 { D3.penColor = "#ffb454"; }
            case 3 { D3.penColor = "#c78bff"; }
            case 4 { D3.penColor = "#ff7f9e"; }
            case 5 { D3.penColor = "#e6e6e6"; }
            case _ { D3.penColor = "#7fd1ff"; }
        }
        D3.penSize = 2;
    }

    /* ------------------------------------------------------------------ */
    /* motifs                                                              */
