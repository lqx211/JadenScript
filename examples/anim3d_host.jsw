    /* ------------------------------------------------------------------ */
    /* text                                                                */
    /* ------------------------------------------------------------------ */

    /*
     * A glyph row is three bits; emit one segment per run of set cells. `plot`
     * decides where the segment goes: the world buffer during a scene, the pen
     * directly during the read-out pass.
     */
    private void plot(x1, y1, x2, y2) { // warp
        if (D3.space == 1) {
            Motion.setXY(x1, y1);
            Pen.penDown();
            Motion.setXY(x2, y2);
            Pen.penUp();
        } else {
            v3(x1, y1, 0);
            v3(x2, y2, 0);
            e2(D3.nv - 1, D3.nv);
        }
    }

    /*
     * A line of text at the pen, in the terminal's own geometry: 8 px per
     * cell, 15 rows tall, the top row sitting on `y`. `up` picks the upper or
     * the lower case glyph for letters; Scratch compares strings without case,
     * so a glyph cannot work that out for itself.
     */
    public void textAt(str, x, y, sc, up) { // warp
        _sc = sc * D3.textScale;
        _n = lengthOf(str);
        _i = 1;
        while (_i <= _n) {
            cellGlyph(Operators.letterOf(_i, str), x + (_i - 1) * D3.cellW * _sc, y, _sc, up);
            _i += 1;
        }
    }

    /* A segment in the floor plane: the board is drawn at y = 0. */
    private void plotXZ(x1, z1, x2, z2) { // warp
        v3(x1, 0, z1);
        v3(x2, 0, z2);
        e2(D3.nv - 1, D3.nv);
    }

    /* Bit `c` of an eight-bit row, most significant first. */
    private void bitAt(bits, c) { // warp
        D3.bit = 0;
        if (c == 0) { D3.bit = floor(bits / 128) % 2; }
        if (c == 1) { D3.bit = floor(bits / 64) % 2; }
        if (c == 2) { D3.bit = floor(bits / 32) % 2; }
        if (c == 3) { D3.bit = floor(bits / 16) % 2; }
        if (c == 4) { D3.bit = floor(bits / 8) % 2; }
        if (c == 5) { D3.bit = floor(bits / 4) % 2; }
        if (c == 6) { D3.bit = floor(bits / 2) % 2; }
        if (c == 7) { D3.bit = bits % 2; }
    }

    /* One glyph of the terminal font at (x, y): the top row sits on y. */
    private void cellGlyph(ch, x, y, sc, up) { // warp
        _idx = 0;
        _k = 1;
        while (_k <= 95) {
            if (Operators.letterOf(_k, D3.glyphChars) == ch) {
                if (_idx < 1) {
                    _idx = _k;
                }
            }
            _k += 1;
        }
        if (_idx < 1) {
            return;
        }
        // the scan stops on the upper case twin of a letter, so step to the
        // lower case glyph, 32 entries on, when that is what was asked for
        if (up == 0 && _idx >= 34 && _idx <= 59) {
            _idx += 32;
        }
        _base = (_idx - 1) * D3.cellH;
        if (_base + D3.cellH > D3.gfont.length()) {
            return;
        }
        _row = 0;
        while (_row < D3.cellH) {
            _bits = D3.gfont.get(_base + _row + 1);
            if (_bits > 0) {
                _y0 = y - (D3.cellH - 1 - _row) * sc;
                _run = -1;
                _c = 0;
                while (_c < D3.cellW) {
                    bitAt(_bits, _c);
                    if (D3.bit == 1) {
                        if (_run < 0) {
                            _run = _c;
                        }
                    } else {
                        if (_run >= 0) {
                            plot(x + _run * sc, _y0, x + _c * sc, _y0);
                            _run = -1;
                        }
                    }
                    _c += 1;
                }
                if (_run >= 0) {
                    plot(x + _run * sc, _y0, x + D3.cellW * sc, _y0);
                }
            }
            _row += 1;
        }
    }

    /* How far t has got from a to b, clamped: the typing progress. */
    private void seg(t, a, b) { // warp
        D3.ease = (t - a) / (b - a);
        if (D3.ease < 0) { D3.ease = 0; }
        if (D3.ease > 1) { D3.ease = 1; }
    }

    /* Which song section the clock is in, from the table the generator wrote. */
    private void sectionAt(t) { // warp
        _n = D3.sections.length() / 2;
        D3.sectionNo = 1;
        _i = 1;
        while (_i <= _n) {
            if (t >= D3.sections.get((_i - 1) * 2 + 1)) {
                D3.sectionNo = _i;
            }
            _i += 1;
        }
        D3.sectionName = "";
        _s = 1;
        _k = 0;
        _len = lengthOf(D3.sectionNames);
        while (_s <= _len) {
            _ch = Operators.letterOf(_s, D3.sectionNames);
            if (_ch == " ") {
                _k += 1;
            } else {
                if (_k == D3.sectionNo - 1) {
                    D3.sectionName = join(D3.sectionName, _ch);
                }
            }
            _s += 1;
        }
    }

    /* The n-th source line, cut off where the typing has reached. */
    private void typeLine(line, k) { // warp
        _src = D3.code.get(line);
        _cut = floor(k * lengthOf(_src));
        if (_cut < 0) { _cut = 0; }
        D3.typed = "";
        _i = 1;
        while (_i <= _cut) {
            D3.typed = join(D3.typed, Operators.letterOf(_i, _src));
            _i += 1;
        }
    }

    public void pad2(n) { // warp
        D3.out2 = "0" + n;
        if (n >= 10) { D3.out2 = "" + n; }
        if (n < 10) { D3.out2 = join("0", n); }
    }

    /*
     * The read-out, drawn straight to the pen after the scene, so it does not
     * move with the camera. Three rows in the top right, like the film's HUD.
     */
    private void drawHud(id, t) { // warp
        D3.space = 1;
        Pen.setPenSize(1);
        if (D3.beatPhase < 0.5) {
            Pen.setPenColorToColor("#e8f2ff");
        } else {
            Pen.setPenColorToColor("#6d7d8f");
        }
        // The film stamps `overlays(ctx, K, {br})` over the scene in almost
        // every shot; the caption is right-aligned along the bottom edge.
        if (D3.shotCaption != "") {
            Pen.setPenColorToColor("#7f8b99");
            textAt(D3.shotCaption, 232 - lengthOf(D3.shotCaption) * D3.cellW * D3.textScale, 0 - 172, 1, 0);
            Pen.setPenColorToColor("#e8f2ff");
        }
        switch (id) {
            case 17 {
                pad2(floor(D3.hops));
                textAt(D3.sectionName, 150, 168, 1, 1);
                textAt("NET  VCC", 150, 152, 1, 1);
                textAt(join("HOP  ", D3.out2), 150, 136, 1, 1);
                textAt(join("COPPER ", D3.copper), 150, 120, 1, 1);
            }
            case 18 {
                textAt(D3.sectionName, 150, 168, 1, 1);
                textAt(join("PULSES ", D3.pulses), 150, 152, 1, 1);
                textAt("V  1.70 U/S", 150, 136, 1, 1);
            }
            case 16 {
                // `cursor` in 01_intro.js draws exactly one thing: cursorQuad()
                // filled white, then `overlays(frame: 0)` and `look(vignette
                // .55, grain)`. CUR is cx 960 cy 540 w 50.4 h 8.4 design px, so
                // the block is 12.6 x 2.1 stage px at 0.25. blinkOn() lights it
                // for the first half of every beat and nothing else is on
                // screen - the code it types belongs to the next shot, not here.
                if (D3.beatPhase < 0.5) {
                    // the film blooms this bar hard (glow 18, bloom 1.05); a
                    // wider dim stroke under a bright core is the pen's version
                    Pen.setPenSize(7);
                    Pen.setPenColorToColor("#4a5a7a");
                    Motion.setXY(0 - 6.3, 0);
                    Pen.penDown();
                    Motion.setXY(6.3, 0);
                    Pen.penUp();
                    Pen.setPenSize(3);
                    Pen.setPenColorToColor("#dbe6ff");
                    Motion.setXY(0 - 6.3, 0);
                    Pen.penDown();
                    Motion.setXY(6.3, 0);
                    Pen.penUp();
                }
                Pen.setPenSize(1);
            }
        }
        D3.space = 0;
    }

    /* ------------------------------------------------------------------ */
    /* the film's first three shots                                        */
    /* ------------------------------------------------------------------ */

    /*
     * Shot 1 — `cursor`. A black frame with a solid block blinking on the beat:
     * lit for the first half of every beat, dark for the second. Everything here
     * is read-out space, so the motif itself draws nothing.
     */
    private void buildCursor(t, par) { // warp
        view(0, 0, 0, 0.5, 0.12);
        tint(62 + par);
        D3.hud = 1;
        D3.space = 1;
        D3.space = 0;
    }

    /*
     * `traceState` from the film: hops is a continuous count of sixteenths,
     * integer steps with an outExpo snap inside each one (`1 - 2^-10x` with x
     * reaching 1 at 0.6 of the sixteenth).
     */
    private void hopsAt(t) { // warp
        _x = (t - D3.shotT0) / (D3.ticksPerBeat / 4);
        _f = floor(_x);
        _fr = _x - _f;
        if (_fr > 0.6) { _fr = 0.6; }
        _e = 1 - exp(0 - 6.93147 * (_fr / 0.6));
        D3.hops = 0;
        if (_x > 0) {
            D3.hops = _f + _e;
        }
    }

    /* Growth of the board: one hop per sixteenth, eased fast inside each one. */
    private void traceClock(t) { // warp
        // one hop per sixteenth note, not per beat
        _x = (t - D3.shotT0) / (D3.ticksPerBeat / 4);
        _f = floor(_x);
        _frac = _x - _f;
        D3.hops = 0;
        if (_x > 0) {
            D3.hops = _f + 1 - exp(0 - _frac / 0.6 * 4);
        }
        D3.ring = 0;
        if (_x > 0) {
            D3.ring = (D3.hops - 1) / 2;
        }
        if (D3.ring < 0) { D3.ring = 0; }
        if (D3.ring > 1) { D3.ring = 1; }
    }

    /*
     * One lane of the board: a right-angled run of three segments in the floor
     * plane, drawn only as far as the hop count has reached.
     */
    private void lane(i, hops, width, bright) { // warp
        hashSeed(i, 1);
        _a = D3.seed * 360;
        hashSeed(i, 2);
        _r = 1.1 + D3.seed * 1.9;
        _p0x = 0;
        _p0z = 0;
        _p1x = cos(_a) * _r;
        _p1z = sin(_a) * _r;
        hashSeed(i, 3);
        _b = _a + 90 * (1 + D3.seed);
        hashSeed(i, 4);
        _l2 = 0.8 + D3.seed * 1.4;
        _p2x = _p1x + cos(_b) * _l2;
        _p2z = _p1z + sin(_b) * _l2;
        hashSeed(i, 5);
        _c = _b + 90 * (2 * D3.seed - 1);
        hashSeed(i, 6);
        _l3 = 0.6 + D3.seed * 1.2;
        _p3x = _p2x + cos(_c) * _l3;
        _p3z = _p2z + sin(_c) * _l3;

        _l1 = _r;
        _d = (hops - (i - 1) * 0.55) * 0.95;
        if (_d <= 0) {
            return;
        }
        Pen.setPenSize(width);
        Pen.setPenColorToColor("#8fd9c6");
        if (bright < 1) {
            Pen.setPenColorToColor("#4f8f86");
        }
        _rem = _d;
        if (_rem > _l1) {
            plot(_p0x, 0 - _p0z, _p1x, 0 - _p1z);
            _rem -= _l1;
            if (_rem > _l2) {
                plot(_p1x, 0 - _p1z, _p2x, 0 - _p2z);
                _rem -= _l2;
                if (_rem > _l3) {
                    plot(_p2x, 0 - _p2z, _p3x, 0 - _p3z);
                    via(_p3x, _p3z, i);
                } else {
                    _k = _rem / _l3;
                    plot(_p2x, 0 - _p2z, _p2x + (_p3x - _p2x) * _k, 0 - (_p2z + (_p3z - _p2z) * _k));
                }
            } else {
                _k = _rem / _l2;
                plot(_p1x, 0 - _p1z, _p1x + (_p2x - _p1x) * _k, 0 - (_p1z + (_p2z - _p1z) * _k));
            }
        } else {
            _k = _rem / _l1;
            plot(_p0x, 0 - _p0z, _p1x * _k, 0 - _p1z * _k);
        }
    }

    /* A via: a small diamond ring at a bend, once the head has passed it. */
    private void via(x, z, i) { // warp
        Pen.setPenSize(1);
        Pen.setPenColorToColor("#e8c46a");
        _r = 0.09;
        plot(x - _r, 0 - z, x + _r, 0 - z);
    }

    /* A hashed 0..1 from two integers, without disturbing D3.ease's caller. */
    private void hashSeed(i, k) { // warp
        hash01(i * 41 + k * 7);
        D3.seed = D3.ease;
    }

    /*
     * Shot 2 — `trace`. Straight down on the floor: the via grid, the board
     * growing hop by hop, and the power ring closing over it.
     */
    /*
     * Shot 2 `trace`, transcribed from `01_intro.js`. The camera is an
     * orthographic plan view rising from h0 = CUR3.w * 1080 / CUR.w = 3.4286
     * world units to 4.1 across the shot; the board is a fixed set of Manhattan
     * lanes that grow one STEP per sixteenth with an outExpo snap inside each.
     */
    private void buildTrace(t, par) { // warp
        view(0, 0, 0, 0.5, 0.12);
        tint(1);
        D3.hud = 1;
        D3.ortho = 1;

        // 1080 design px per world unit at a camera height of h, in stage px.
        _q = (t - D3.shotT0) / (D3.shotT1 - D3.shotT0);
        if (_q < 0) { _q = 0; }
        if (_q > 1) { _q = 1; }
        easeBy(9, _q);
        _h = 3.4286 + (4.1 - 3.4286) * D3.ease;
        D3.orthoScale = 270 / _h;

        hopsAt(t);

        // The via field: a 0.1 lattice in the film. Sampled at 0.22 here and
        // pushed through the vertex buffer as zero-length edges - drawing dots
        // straight to the pen happens before render(), which erases the stage,
        // so they would be both invisible and a half-second of wasted work.
        _gz = 0 - 2.2;
        while (_gz <= 2.2) {
            _gx = 0 - 2.2;
            while (_gx <= 2.2) {
                if (_gx * _gx + _gz * _gz < 4.84) {
                    // a zero-length edge inks nothing, so each dot is a 1 px dash
                    plotXZ(_gx, _gz, _gx + 0.015, _gz);
                }
                _gx += 0.22;
            }
            _gz += 0.22;
        }

        // The lanes, drawn up to the length the clock has reached.
        Pen.setPenSize(2);
        Pen.setPenColorToColor(D3.penColor);
        _i = 1;
        _k = 1;
        while (_i <= D3.nlanes) {
            _t0 = D3.net.get(_k);
            _np = D3.net.get(_k + 2);
            _drawn = (D3.hops - _t0) * D3.netStep;
            if (_drawn > 0) {
                _a = _k + 3;
                _px = D3.net.get(_a);
                _pz = D3.net.get(_a + 1);
                _s = 1;
                while (_s < _np) {
                    _qx = D3.net.get(_a + _s * 2);
                    _qz = D3.net.get(_a + _s * 2 + 1);
                    _dx = _qx - _px;
                    _dz = _qz - _pz;
                    _seg = sqrt(_dx * _dx + _dz * _dz);
                    if (_seg > 0) {
                        if (_drawn >= _seg) {
                            plotXZ(_px, _pz, _qx, _qz);
                            _drawn -= _seg;
                        } else {
                            _f = _drawn / _seg;
                            plotXZ(_px, _pz, _px + _dx * _f, _pz + _dz * _f);
                            _drawn = 0;
                        }
                    }
                    _px = _qx;
                    _pz = _qz;
                    _s += 1;
                }
            }
            _k += 3 + _np * 2;
            _i += 1;
        }

        // Vias: a small cross at each spur end.
        Pen.setPenSize(2);
        Pen.setPenColorToColor("#e8c46a");
        _i = 1;
        _k = 1;
        while (_i <= D3.nvias) {
            _vx = D3.vias.get(_k);
            _vz = D3.vias.get(_k + 1);
            _vr = D3.vias.get(_k + 2);
            plotXZ(_vx - _vr, _vz, _vx + _vr, _vz);
            plotXZ(_vx, _vz - _vr, _vx, _vz + _vr);
            _k += 3;
            _i += 1;
        }

        // The 3D cursor: CUR3 is 0.16 wide, 0.028 tall, sitting on the floor.
        Pen.setPenSize(2);
        Pen.setPenColorToColor("#ffffff");
        plotXZ(0 - 0.08, 0, 0.08, 0);
        plotXZ(0 - 0.01, 0 - 0.014, 0.01, 0.014);
        Pen.setPenSize(1);
    }

    /*
     * Shot 3 — `current`. The same board from a low perspective camera with
     * current running outwards along every drawn lane.
     */
    private void buildCurrent(t, par) { // warp
        view(0, 26, 1.2, 0.6, 0.12);
        tint(66 + par);
        D3.hud = 1;
        traceClock(t);
        _i = 0;
        while (_i < 16) {
            hash01(_i * 19 + 7);
            _x = (D3.ease - 0.5) * 5.2;
            hash01(_i * 31 + 11);
            _z = (D3.ease - 0.5) * 5.2;
            Pen.setPenSize(1);
            Pen.setPenColorToColor("#5f6f7a");
            plot(_x - 0.04, 0 - _z, _x + 0.04, 0 - _z);
            _i += 1;
        }
        _i = 1;
        while (_i <= 10) {
            lane(_i, D3.hops, 2, 1);
            _i += 1;
        }
        // current: pulses at a fixed spacing along each lane, phase-shifted per
        // lane so they never march in step
        D3.pulses = 0;
        Pen.setPenSize(3);
        Pen.setPenColorToColor("#ffd27f");
        _i = 1;
        while (_i <= 6) {
            _d = (D3.hops - (_i - 1) * 0.55) * 0.95;
            if (_d > 0.3) {
                _ph = (t * 0.49 + _i * 0.137) % 0.26;
                _s = _ph;
                while (_s < _d) {
                    _fx = cos(_i * 61) * _s;
                    _fz = sin(_i * 61) * _s;
                    plot(_fx, 0 - _fz - 0.07, _fx, 0 - _fz);
                    D3.pulses += 1;
                    _s += 0.26;
                }
            }
            _i += 1;
        }
    }

    /* ------------------------------------------------------------------ */
    /* projection + stroke                                                 */
    /* ------------------------------------------------------------------ */

    /*
     * Project every vertex once, then stroke every edge from that buffer, so a
     * shared corner is transformed once instead of once per edge.
     */
    /*
     * `trails` / `trailsTop` — pre1, over "To A.D to B.C".
     *
     * The film (src/ch/pre1/sky.js) turns the whole star dome by
     * `th1 = -(2026 - year) * .00118`, and `yearAt()` rewinds on a log clock,
     * so the sky runs one way and keeps speeding up; `trailsTop` then looks
     * straight up the pole and rolls the camera the other way. A dome costs
     * thousands of points, so the pen version keeps the idea and drops the
     * sphere: one flat ring facing the viewer with a band of particles running
     * round it, which is the part the eye actually reads.
     */
    private void viewFlat() { // warp
        // render() scales the orbit yaw by 0.12 and the pitch by 0.35; `view`'s
        // damp already cancels the yaw, and nothing cancels the pitch, so undo
        // it here or the ring turns into an ellipse as the keyframes move.
        view(0, 0, 0, 0.3, 0.12);
        D3.basePitch = 0 - D3.camPitch * 0.35;
    }

    /* The ring plus `D3.trailN` tangent dashes, all turned by `spin`. */
    private void trailRing(spin) { // warp
        _trR = D3.trailPx * D3.camDist / D3.camFocal;
        _trR = _trR * (1 + D3.pulseBeat * 0.035);
        // The band sits just inside the ring: on the ring itself the two are the
        // same colour and the particles disappear into the line.
        _trB = _trR * D3.trailBand;
        // 200 particles on a 76 px band sit ~2.4 px apart, so a dash any longer
        // than about 1.5 px merges its neighbours and the band reads as a blur.
        _trDash = _trB * 0.02;
        _trSeg = D3.trailSeg;
        _trI = 0;
        while (_trI < _trSeg) {
            _trA = _trI * 360 / _trSeg;
            v3(cos(_trA) * _trR, sin(_trA) * _trR, 0);
            _trI += 1;
        }
        _trI = 0;
        while (_trI < _trSeg) {
            e2(D3.nv - _trSeg + _trI + 1, D3.nv - _trSeg + ((_trI + 1) % _trSeg) + 1);
            _trI += 1;
        }
        // Each particle is a dash along the tangent, so it reads as travelling
        // instead of as a stationary dot. `z` puts it in front of the ring.
        _trN = D3.trailN;
        _trI = 0;
        while (_trI < _trN) {
            _trA = _trI * 360 / _trN + spin;
            _trX = sin(_trA) * _trDash;
            _trY = cos(_trA) * _trDash;
            v3(cos(_trA) * _trB - _trX, sin(_trA) * _trB - _trY, 0.02);
            v3(cos(_trA) * _trB + _trX, sin(_trA) * _trB + _trY, 0.02);
            e2(D3.nv - 1, D3.nv);
            _trI += 1;
        }
    }

    /* Before B.C: the band runs one way, accelerating with the year rewind. */
    private void buildTrails(t, par) { // warp
        viewFlat();
        tint(par + 24);
        trailRing(0 - D3.trailTurns * 360 * (D3.shotP ** 1.6));
    }

    /* On "B.C": pick up that angle, then run the other way and accelerate. */
    private void buildTrailsTop(t, par) { // warp
        viewFlat();
        tint(par + 24);
        trailRing(0 - D3.trailTurns * 360 + D3.trailTurns * 360 * 1.5 * (D3.shotP ** 2));
    }

    private void render() { // warp
        // Orbit scenes sit near the origin, so the camera may swing right
        // around them. Fly-through scenes run away along +Z, where a full turn
        // would put most of the geometry behind the camera: they only get a
        // gentle sway instead.
        _oy = 0.12;
        _op = 0.35;
        if (D3.orbit == 1) {
            _oy = 1;
            _op = 1;
        }
        _ey = D3.camYaw * _oy + D3.baseYaw;
        _ep = D3.camPitch * _op + D3.basePitch;
        _cy = cos(_ey); _sy = sin(_ey);
        _cp = cos(_ep); _sp = sin(_ep);
        _cr = cos(D3.camRoll); _sr = sin(D3.camRoll);
        _shx = D3.shake * sin(D3.showTick * 37.7);
        _shy = D3.shake * sin(D3.showTick * 61.3);

        _i = 1;
        _k = 1;
        _p = 1;
        while (_i <= D3.nv) {
            _x = D3.pos.get((_i - 1) * 3 + 1);
            _y = D3.pos.get((_i - 1) * 3 + 2);
            _z = D3.pos.get((_i - 1) * 3 + 3);

            _x1 = _x * _cy + _z * _sy;
            _z1 = _z * _cy - _x * _sy;
            _y1 = _y * _cp + _z1 * _sp;
            _z2 = _z1 * _cp - _y * _sp;
            _rx = _x1 * _cr - _y1 * _sr;
            _ry = _x1 * _sr + _y1 * _cr;

            if (D3.ortho == 1) {
                // An orthographic camera looking straight down: no perspective
                // divide at all, so world units map straight to stage pixels.
                D3.proj.set((_i - 1) * 4 + 1, _x * D3.orthoScale);
                D3.proj.set((_i - 1) * 4 + 2, 0 - _z * D3.orthoScale);
                D3.proj.set((_i - 1) * 4 + 3, 1);
                D3.proj.set((_i - 1) * 4 + 4, 1);
            } else {
            _depth = _z2 + D3.camDist + D3.viewBias;
            if (_depth < D3.nearZ) {
                D3.proj.set((_i - 1) * 4 + 1, 0);
                D3.proj.set((_i - 1) * 4 + 2, 0);
                D3.proj.set((_i - 1) * 4 + 3, _depth);
                D3.proj.set((_i - 1) * 4 + 4, 0);
            } else {
                _s = D3.camFocal * D3.wScale / _depth;
                // _sx/_sy are the screen point. Do not reuse those names for
                // anything the loop needs next time round: they started life as
                // sin(yaw) and sin(pitch), and writing the screen y over the
                // yaw sine fed a pixel coordinate back into the rotation, which
                // turned every scene after its second vertex into spaghetti.
                _px = _rx * _s + _shx;
                _py = _ry * _s + _shy;
                // A vertex just past the near plane divides by almost nothing
                // and lands thousands of pixels away; its edge would streak
                // right across the stage, so drop it instead.
                if (_px > D3.clipR || _px < 0 - D3.clipR || _py > D3.clipR || _py < 0 - D3.clipR) {
                    D3.proj.set((_i - 1) * 4 + 1, 0);
                    D3.proj.set((_i - 1) * 4 + 2, 0);
                    D3.proj.set((_i - 1) * 4 + 3, _depth);
                    D3.proj.set((_i - 1) * 4 + 4, 0);
                } else {
                    D3.proj.set((_i - 1) * 4 + 1, _px);
                    D3.proj.set((_i - 1) * 4 + 2, _py);
                    D3.proj.set((_i - 1) * 4 + 3, _depth);
                    D3.proj.set((_i - 1) * 4 + 4, 1);
                }
            }
            }
            _i += 1;
            _k += 3;
            _p += 4;
        }
        Pen.eraseAll();
        // The film sits on near-black everywhere, so it is painted under every
        // shot: fourteen thick strokes cover the stage and nothing has to fight
        // with the host's sprites or its backdrop.
        Pen.setPenSize(30);
        Pen.setPenColorToColor("#05070a");
        _by = 0 - 180;
        while (_by <= 180) {
            Motion.setXY(0 - 240, _by);
            Pen.penDown();
            Motion.setXY(240, _by);
            Pen.penUp();
            _by += 26;
        }
        Pen.setPenSize(D3.penSize);
        Pen.setPenColorToColor(D3.penColor);

        _j = 1;
        _a = 1;
        while (_j <= D3.ne) {
            _ia = (D3.idx.get(_a) - 1) * 4 + 1;
            _ib = (D3.idx.get(_a + 1) - 1) * 4 + 1;
            if (D3.proj.get(_ia + 3) == 1) {
                if (D3.proj.get(_ib + 3) == 1) {
                    Motion.setXY(D3.proj.get(_ia), D3.proj.get(_ia + 1));
                    Pen.penDown();
                    Motion.setXY(D3.proj.get(_ib), D3.proj.get(_ib + 1));
                    Pen.penUp();
                }
            }
            _j += 1;
            _a += 2;
        }
        Motion.setXY(0, 0);
    }

    /* ------------------------------------------------------------------ */
    /* buffers                                                             */
    /* ------------------------------------------------------------------ */

    /*
     * ``replace item`` never appends: ``set`` on an empty list is a no-op and
     * every read then answers "". Every buffer has to reach its final length
     * before the first frame writes into it.
     */
    public void prepare() { // warp
        D3.pos.clear();
        D3.idx.clear();
        D3.proj.clear();
        _need = D3.maxVerts * 3;
        while (D3.pos.length() < _need) {
            D3.pos.add(0);
        }
        _need = D3.maxEdges * 2;
        while (D3.idx.length() < _need) {
            D3.idx.add(0);
        }
        _need = D3.maxVerts * 4;
        while (D3.proj.length() < _need) {
            D3.proj.add(0);
        }
    }
}
// <<< anim3d END
