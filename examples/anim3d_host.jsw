        e2(5, 6); e2(6, 7); e2(7, 8); e2(8, 5);
        e2(1, 5); e2(2, 6); e2(3, 7); e2(4, 8);
        pivot(t * 2.2, t * 1.4, 0.7 + 0.12 * D3.pulseBeat);
        corner(); corner(); corner(); corner();
        corner(); corner(); corner(); corner();
