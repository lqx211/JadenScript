/* ---- shot ------------------------------------------------------------ */
public D3.shotStride = 5;
public D3.keyStride = 5;
public D3.shotIndex = 1;
public D3.shotId = 1;
public D3.shotParam = 0;
public D3.shotCaption = "";   // the film's bottom-right overlay text
public D3.shotT0 = 0;
public D3.shotT1 = 1;
public D3.shotP = 0;          // 0..1 through the current shot
public D3.fade = 0;           // ticks spent collapsing into / out of a cut

/* ---- camera ---------------------------------------------------------- */
public D3.kfRow = 1;          // index of the key the clock is in
public D3.kfK = 0;            // 0..1 across the gap to the next key
public D3.camYaw = 20;
public D3.camPitch = 18;
public D3.camRoll = 0;
public D3.camDist = 5.2;
// The film renders a 1920 x 1080 canvas; a Scratch stage is 480 x 360, so one
// design pixel is a quarter of a stage pixel. The focal length is the film's
// 330 design px scaled by that 0.25. It was left at 330, which projected every
// scene four times too large - the geometry spent most of its life off the edge
// of the stage, which is what "lines floating everywhere" was.
public D3.camFocal = 82.5;

/* ---- trails motif (pre1 "To A.D to B.C") ---------------------------- */
public D3.trailN = 200;      // particles running round the ring
public D3.trailSeg = 72;     // ring segments; 360/seg degrees apart
public D3.trailPx = 95;      // ring radius in stage pixels, camera-independent
public D3.trailTurns = 2.4;  // turns the band makes over one shot
public D3.trailBand = 0.80;   // particle radius as a fraction of the ring
public D3.shake = 0;
public D3.orbit = 1;          // 1 = turn around the origin, 0 = fly along +Z
public D3.active = 1;         // 0 stops the renderer and leaves the pen alone
public D3.onFrame = 0;        // 1 broadcasts D3.afterFrame once per rendered frame
public D3.baseYaw = 0;        // per-scene view offset, on top of the keyframes
public D3.basePitch = 0;
public D3.viewBias = 0;       // per-scene camera pull-back
public D3.ortho = 0;          // 1 = project flat, `orthoScale` stage px per world unit
public D3.orthoScale = 0;
public D3.nearZ = 0.25;       // clip anything closer than this, in world units
public D3.clipR = 900;        // drop vertices projected further out than this, in px
public D3.wScale = 1;         // global projection scale (transitions, punch-ins)

/* ---- output ---------------------------------------------------------- */
public D3.penColor = "#7fd1ff";
public D3.penSize = 2;
public D3.space = 0;       // 0 draws into the world buffer, 1 straight to the pen
public D3.bit = 0;         // result slot for bitAt, like D3.ease for easings
public D3.hud = 0;         // 1 asks drawHud for a read-out after the strokes
public D3.lit = 0;         // the beat blink, shared by the cursor motif
public D3.hops = 0;        // how many sixteenths of the net have been laid
public D3.ring = 0;        // 0..1, how far the power ring has closed
public D3.copper = 0;      // total drawn copper length, for the read-out
public D3.pulses = 0;      // live current pulses, for the read-out
public D3.out2 = "00";     // zero-padded counter, for the read-out
public D3.seed = 0;        // result slot for hashSeed
public D3.sectionName = "INTRO";  // the song section the show is in
public D3.sectionNo = 1;
public D3.sig = -1;        // what the last static frame drew, so it can be skipped
public D3.textScale = 0.5; // multiplier on every read-out glyph, for size
public D3.holdTick = -1;   // >= 0 pins the show on one tick, for review
public D3.startTick = 0;   // first tick of the show; set before the green flag
public D3.stopTick = -1;   // last tick to draw, -1 for the whole show
public D3.typed = "";      // the source line, typed as far as the clock has reached

/*
 * A few real lines from this very file. The film types its own source on screen;
 * so does this one — the read-out is not decoration, it is the program.
 */
public D3.code = [
    "public D3.shots = [",
    "if (_now == lastTick)",
    "    return;",
    "drawScene(shotId)",
    "render();",
    "D3.drawn += 1;"
];
/*
 * The board from `buildNetwork()` in `src/ch/intro/trace.js`, transcribed: four
 * Manhattan arms, two of them bus runs with a parallel pair either side, each
 * with two spurs that end in a via. A lane is `t0, width, count` followed by
 * `count` x/z pairs; `t0` is the sixteenth it starts on and `STEP` world units
 * are laid down per sixteenth. Vias are `x, z, radius`.
 */
public D3.netStep = 0.17;
public D3.nlanes = 16;
public D3.net = [
    0.0, 3.2, 4, 0.13, 0, 0.62, 0, 0.82, 0.2, 1.5, 0.2, 3.382,
    1.8, 3, 0.635, -0.053, 0.832, 0.146, 1.5, 0.145, 3.382, 1.8, 3, 0.605,
    0.053, 0.808, 0.254, 1.5, 0.255, 5.226, 1.6, 3, 0.99, 0.2, 1.09, 0.3,
    1.09, 0.38, 6.626, 1.6, 3, 1.228, 0.2, 1.328, 0.1, 1.328, 0.02, 0.0,
    3.2, 4, -0.13, 0, -0.55, 0, -0.8, -0.25, -1.5, -0.25, 2.971, 1.8,
    3, -0.569, 0.052, -0.814, -0.197, -1.5, -0.195, 2.971, 1.8, 3, -0.531, -0.052,
    -0.786, -0.303, -1.5, -0.305, 5.236, 1.6, 3, -0.975, -0.25, -1.075, -0.35, -1.075,
    -0.43, 6.677, 1.6, 3, -1.22, -0.25, -1.32, -0.15, -1.32, -0.07, 1.588, 3.2,
    4, 0.4, 0, 0.4, -0.5, 0.65, -0.75, 0.65, -1.5, 7.342, 1.6, 3,
    0.65, -0.938, 0.75, -1.038, 0.83, -1.038, 8.886, 1.6, 3, 0.65, -1.2, 0.55,
    -1.3, 0.47, -1.3, 1.471, 3.2, 4, -0.38, 0, -0.38, 0.45, -0.62, 0.69,
    -0.62, 1.5, 6.959, 1.6, 3, -0.62, 0.892, -0.72, 0.992, -0.8, 0.992, 8.627,
