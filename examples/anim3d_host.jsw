        // up edge-on for a third of the film and draw almost nothing.
        D3.baseYaw = 0 - D3.camYaw * damp;
        D3.basePitch = pit;
        D3.viewBias = bias;
        D3.nearZ = nz;
        D3.ortho = 0;
    }

    /* Six hues, rotated by the shot so one motif is never one colour all film. */
    private void tint(k) { // warp
