            Variables.showVaraible(Player.beats2);
            Variables.showVariable(Player.doSetCustomInitValues);
            Variables.showVariable(Player.disableMultiInstr);
            Variables.showVariable(Player.updatePiano);
            Lists.showList(Player.FLData);
            Lists.showList(Player.PresetFLName);
        } else {
            Variables.hideVariable(Player.baseSpeed);
            Variables.hideVariable(Player.maxnotes);
            Variables.hideVariable(Tick.wait);
            Variables.hideVariable(Player.maxPing);
            Variables.hideVariable(Player.midiSpeed);
            Variables.hideVariable(Player.metronome);
            Variables.hideVariable(Tick.freeze);
            Variables.hideVariable(Player.playDelay);
            Variables.hideVaraible(Player.beats2);
            Variables.hideVariable(Player.doSetCustomInitValues);
            Variables.hideVariable(Player.disableMultiInstr);
            Variables.hideVariable(Player.updatePiano);
            Lists.hideList(Player.FLData);
            Lists.hideList(Player.PresetFLName);
        }
    }
    private void Ticker(){
        if (!Tick.freeze){
            public Tick.tick++;
            Player.TickBuffer.append(Timer.getTimer("Player.timer"));
            Player.tickerEvent();
        }
        call Player.updateDebugMenu();
        Music.restForBeats(1/(2**Tick.wait));
    }
    public void Events.keyPressed(k){ // grouped
        switch(k){ 
            case "p": // hook: when [p] key pressed
                Player.panic();
                Piano.recalc();
                break;
            case "r": // hook: when [r] key pressed
                call Player.main();
                break;
            case "h": // hook: when [h] key pressed
                Player.help();
                break;
            case "l": // hook: when [l] key pressed
                Sensing.ask("Enter Preset ID");
                private pi = Sensing.answer;
                Sensing.ask("Load PresetFL["+string(pi)+"]; Name:\""+string(Player.PresetFLName.get(pi))+"\"; Confirm? [y]");
                if (Sensing.answer == "y"){
                    loadFLPreset(pi);
                }
                break;
            case "o": // hook: when [o] key pressed
                public Player.dispOptions = !Player.dispOptions;
                break;
            case 'space': // hook: when [space] key pressed
                public Player.freeze = !Player.freeze;
                break;
            case 'c': // hook: when [c] key pressed
                Player.clear();
                call Player.main();
                break;
            case _:
                break;
        }
        Control.waitUntil(Sensing.isKeyPressed("any")); // placeholder to make pseudocode logic looks correct
    }
    public void Player.enableReverseTicking(){
        public Tick.enableReverseTicking = 1;
    }
    public void Player.disableReverseTicking(){
        public Tick.enableReverseTicking = 0;
    }
    private void reverseBeats(b){
        // Not adjusting beats, will increase missed notes...
        Player.enableReverseTicking();
        public Tick.tick += b*-15;
        public Player.notes = -1;
        Player.disableReverseTicking();
    }
    private void reverseTicks(t){
        // Extremely buggy- will increase missed notes
        Player.enableReverseTicking();
        public Tick.tick += Ticks*-1;
        public Player.notes = -1;
        Player.disableReverseTicking();
    }
    private void customizedMain(StartTick,StopNID,StartNID,LPresetID,initBaseSpd,delayEffect_b,beats2,maxNotes,maxPing){
        public Tick.freeze = 1;
        public Player.endValue = 0; // stop Player
        LoadFLPreset(LPresetID);
        ImportFL();
        public Player.doSetCustomInitValues = true;
        public Player.customEndValue = StopNID;
        public Player.customStartTick = StartTick;
        public Player.customStartNoteID = StartNID;
        public Player.BaseSpeed = initBaseSpd;
        public Player.playDelay = delayEffect_b;
        public Player.beats2 = beats2;
        public Player.maxNotes = maxNotes;
        public Player.maxPing = maxPing;
        public Player.metronome = 0;
        call Player.main();
        sleep(500);
        public Player.doSetCustomInitValues = false;
        public Tick.freeze = 0;
    }
    private void importFL(){
        logStatic("GCl:"+Sensing.timer+" ImportFL NotesData...");
        Player.NotesData.importArray(Player.FLData.get(1));
        logStatic("GCl:"+Sensing.timer+" ImportFL NotesPlayTick...");
        Player.NotesPlayTick.importArray(Player.FLData.get(2));
        logStatic("GCl:"+Sensing.timer+" ImportFL NotesLength...");
        Player.NotesLength.importArray(Player.FLData.get(3));
        logStatic("GCl:"+Sensing.timer+" ImportFL NotesCommand...");
        Player.NotesCommand.importArray(Player.FLData.get(4));
        Player.NotesChannel.clear(); // delete all of [Player.NotesChannel]
        if (Player.FLData.length()>5)){
            logStatic("GCl:"+Sensing.timer+" ImportFL NotesChannel...");
            Player.NotesChannel.importArray(Player.FLData.get(5));
        }
        if (Player.FLData.length()>6){
            logStatic("GCl:"+Sensing.timer+" ImportFL NotesInstr...");
            Player.NotesInstr.importArray(Player.FLData.get(6));
        }
        logStatic("ImportFL OK");
    }
    public void Player.playCustomPreset_a(){
        public Player.endValue = 0; // stop Player
        loadFLPreset(17);
        importFL();
        public Player.doSetCustomInitValues = 1;
        public Player.customEndValue = 100000;
        public Player.customStartTick = 64*220.75;
        public Player.customStartNoteID = 95255;
        public Tick.freeze = 1;
        public Player.metronome = 0;
        call Player.main();
        Control.wait(.5);
        public Player.doSetCustomInitValues = 0;
        public Tick.freeze = 0;
    }
    private void exportFL(){
        Player.FLData.clear();
        Player.FLData.append(Player.NotesData.exportArray());
        Player.FLData.append(Player.NotesPlayTick.exportArray());
        Player.FLData.append(Player.NotesLength.exportArray());
        Player.FLData.append(Player.NotesCommand.exportArray());
        Player.FLData.append(Player.NotesChannel.exportArray());
        Player.FLData.append(Player.NotesInstr.exportArray());
        logStatic("ExportFL OK");
        public Player.totalNotes = Player.NotesData.length();
    }
    
    private void createNote(t,n,l){
        Player.Notes.add("["+string(t)+","+string(n)+","+string(l)+"]");
    }
    private void createNoteGroup(st,pt,n,pl){ // StartTick, PerTick, Notes, PerLength
        private cng0 = Util.ruleReplace("["+string(Notes)+"]","\x20",","); // replace [] using the rule [] with []
        private cng1 = Player.NotesExport.exportArray();
        private cng2 = JSON.concatArray(cng0,cng1);
        logStatic(cng0);
        logStatic(cng1);
        logStatic(cng2);
        Player.NotesExport.importArray(cng2);
        for (i=1; i<=n.length(); i++){ // for i in (length of [Player.NotesExport]), i start from 1
            createNote(st+(pt*i),Player.NotesExport.get(i),pl);
        }
    }
    public void Player.tickerEvent(){
        if (Player.updatePiano>0){
            Piano.draw();
        }
    }
    public void beforeProjectsSaves(){ // header block of extensions: hook
        logStatic("Attempt to save project");
    }
    public void afterProjectSaves(){ // header block of extensions: hook
        logStatic("Saved project as NotePlayer4,"+string(Player.version));
        public Player.version++;
    }
    public void Player.updateDebugMenu(){
        Player._Debug.set(
            1,
            "T:"+string(Tick.tick)+"/"+string(Player.NotesPlayTick.get(Player.NotesPlayTick.length())-1)+"\x20"+\
            "N:"+string(Player.notes)+"/"+string(Player.totalNotes)+"\x20"+\
            "L:"+string(Player.loops)+"\x20"+\
            "NPS:"+string(Player.NPSBuffer.length())+"\x20"+\
            "MTPS:"+string((Operators.round((1/((60/Player.midiSpeed)*(1/(2**Tick.wait))))*100))/100)
        );
        Player._Debug.set(
            2,
            "Spd:"+string(Player.midiSpeed)+"x"+string(Operators.round(1000*Player.baseSpeed*(2**(Tick.wait-4)))/1000)+"\x20"+\
            "P:"+string(Player.pcmd)+"\x20"+\
            "B:"+string(Operators.round(((Player.beats-1)/Player.beats2)+1.25-.5))+"."+string((Player.beats%Player.beats2)+1)+"\x20"+\
            "Sk:"+string(Player.skips)+"\x20"+\
            "HNPS:"+string(Player.highestNPS)+"\x20"+\
            "PTPS:"+string((Operators.round((1/((60/(Player.midiSpeed*Player.baseSpeed))*(1/(2**Tick.wait))))*100))/100)+"\x20"+\
            "Cl:"+string(Timer.getTimer("Player.timer"))+"\x20"+\
            "Polyphony:"+string(Player.instances)
        );
        Player._Debug.set(3,"NotePlayer4,"+string(Player.version)+" by GitHub/lqx211,bili_uid:3546654972053873 All rights reserved");
    }
    private void realtimeTPSFix(){
        private Player.mtps = 1/((60/Player.midiSpeed)*(1/(2**Tick.wait)));
        private Player.ptps = 1/((60/(Player.midiSpeed*Player.baseSpeed))*(1/(2**Tick.wait)));
        private Player.atps = Player.TickBuffer.length();
        if (Player.mtps/Player.atps>4 || Player.mtps/Player.atps<1){
            public Player.baseSpeed = 1.035/(2**(Tick.wait-4));
        } else {
            public Player.baseSpeed = Player.mtps/Player.atps;
        }
    }
    private void exportND(idx){
        public Player.sbar = "BP 1/3 (ND) "+Operators.round((Player.tmpA/Player.Notes.length())*1000)/10+"%";
        private i = idx;
        if (JSON.isArray(Player.Notes.get(i))){
            Player.NotesData.add(Player.Notes.get(i).get(2));
        } else {
            private json = Player.Notes.get(i);
            private command = Player.Notes.get(i).get("c");
            private parameters = Player.Notes.get(i).get("p");
            if (command == 1){
                private startTick = parameters.get(1);
                private tempo = parameters.get(2);
                if (1){ // Comment block: core
                    // Comment: wait nahhh, it changes basespeed during load, not during play
                    Player.NotesCommand.add("[1,"+startTick*1+","+tempo*1+"]");
                    public Player.midiSpeed = tempo;
                }
            Player.NotesData.add(0);
            }
        }
    }
    public void Player.panic(){
        logStatic("GCl:"+Sensing.timer+" CALL Player.panic");
        Music.stopAll();
        Playr.instances = 0;
        return;
    }
    public void Player.help(){
        Looks.say("[L]LoadPreset [Space]PlayPause [R]Reset [C]HardReset [P]Panic [O]Options [D]Info [H]Help");
    }
    public void greenFlag() {
        call Player.main();
        Player.help();
    }
    public void Player.main(){
        console.endLogTimer("Player.timer");
        console.clear();
        logStatic("GCl:"+Sensing.timer+" CALL Player.main");
        public Player.sbar2 = "main";
        public Player.instances = 0;
        if (Player.useFL<50){
            buildPlayer();
        } else {
            importFL();
        }
        call Player.checkIfDisp();
        call Tick.reset();
        Player.NotesActive.set(nd,(
            (1) if (Player.updatePiano || !Player.NotesChannel.length() ) else (1+nc%16)
        ));
        Music.setInstr((
            (ni) if (ni*(!Piano.disableMultiInstr)) else (
                (1) if (!Player.disableMultiInstr) else (Player.disableMultiInstr)
            )
        ));
        Player.panic();
        Player.start();
    }
    public void Player.timerCheck(){
        while(1){
            if (Player.NPSBuffer.length()>Player.highestNPS){
                public Player.highestNPS = Player.NPSBuffer.length();
            }
            while(Timer.getTimer("Player.timer")>Player.NPSBuffer.get(1)+1){
                Player.NPSBuffer.remove(1);
            }
            while(Timer.getTimer("Player.timer")>Player.TickBuffer.get(1)+1){
                Player.TickBuffer.remove(1);
            }
        }
    }
    public void Player.clear(){
        Player.Notes.clear();
        Player.NotesExport.clear();
        Player.NotesLength.clear();
        Player.NotesPlayTick.clear();
        Player.NotesChannel.clear();
        Player.NotesInstr.clear();
    }
    public void Tick.reset(){
        public Tick.tick = -64;
        public Tick.active = 1;
        Player.panic();
        while(Tick.active){
            Ticker();
        }
    }
