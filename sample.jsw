    private void Ticker(){
        if (!Tick.freeze){
            public Tick.tick++;
            Player.TickBuffer.append(Timer.getTimer("Player.timer"));
            Player.tickerEvent();
        }
        call Player.updateDebugMenu();
        Music.restForBeats(1/(2**Tick.wait));
    }
    */
    private void moveTick(ticks){
        for (i=1; i<ticks; i++){
            Ticker();
        }
    }
    private void skipTick(ticks){
        public Tick.tick += ticks;
    }
    private void logStatic(L){
        twrpConsole.log(L);
        console.log(L);
    }
    private void logInfo(L){
        twrpConsole.info(L);
        console.info(L);
    }
    private void logDebug(L){
        twrpConsole.debug(L);
        console.debug(L);
    }
    private void logWarn(L){
        twrpConsole.warn(L);
        console.warn(L);
        if (Player.breakOnWarning){
            twrpConsole.breakpoint();
        }
    }
    private void logError(L){
        twrpConsole.error(L);
        console.error(L);
        if (Player.breakOnError){
            twrpConsole.breakpoint();
        }
    }
    private void loadFLPreset(FLPresetID){
        Player.FLData.importArray(Player.PresetFL.get(FLPresetID));
        public Player.guessedFLIdx = FLPresetID;
    }
    private void removeFLPreset(FLPresetID){
        Player.PresetFL.remove(FLPresetID);
        Player.PresetFLName.remove(FLPresetID);
    }
    private void saveFLPreset(FLPresetID){
        Player.PresetFL.set(FLPresetID,Player.FLData.exportArray());
        Player.PresetFLName.set(FLPresetID,Player.guessedFL);
    }
    private void replaceFLPreset(FLPresetID){
        Player.PresetFL.set(FLPresetID,Player.FLData.exportArray());
    }
}

