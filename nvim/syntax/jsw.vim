syn case match
syn sync fromstart

" Vim resolves a tie by "defined last wins", so the generic tokens come
" first and every specialised rule after them.
syn match jswIdentifier /\<[A-Za-z_$][A-Za-z0-9_$]*\>/

" -- numbers -----------------------------------------------------
syn match jswNumber /\<0[xX][0-9a-fA-F_]\+\>/
syn match jswNumber /\<0[bB][01_]\+\>/
syn match jswNumber /\<0[oO][0-7_]\+\>/
syn match jswNumber /\<[0-9][0-9_]*\%(\.[0-9][0-9_]*\)\=\%([eE][-+]\=[0-9]\+\)\=\>/
syn match jswNumber /\%(\<[0-9][0-9_]*\)\@<=\.[0-9][0-9_]*\>/

" -- operators (before the regions, so ``//`` is a comment) ---------
syn match jswOperator /\V**\|..\|==\|!=\|<=\|>=\|&&\|||\|+=\|-=\|*=\|\/=\|%=\|++\|--\|+\|-\|*\|\/\|%\|<\|>\|=\|!/
syn match jswDelimiter /[(){}\[\];,]/

" -- comments and strings ----------------------------------------
syn match jswAnnotationWord /\%(\<receiver\ at\>\|\<main\ thread\>\|\<proccode\>\|\<monitor\>\|\<comment\>\|\<grouped\>\|\<watch\>\|\<Sprite:\|\<warp\>\|\<Stage:\|\<hook:\|\<at\>\)/ contained
syn region jswComment start="//" end="$" contains=jswAnnotationWord,jswTodo
syn region jswComment start="/\*" end="\*/" contains=jswAnnotationWord,jswTodo
syn keyword jswTodo contained TODO FIXME XXX BUG

syn match jswEscape /\\./ contained
syn region jswFString start=/\v<[fF]"/ skip=/\\./ end=/"/ contains=jswHole,jswEscape
syn region jswFString start=/\v<[fF]'/ skip=/\\./ end=/'/ contains=jswHole,jswEscape
syn match jswHole /{[^}]*}/ contained contains=jswIdentifier,jswNumber,jswString,jswTemp,jswBuiltin,jswNamespace
syn region jswString start=/"/ skip=/\\./ end=/"/ contains=jswEscape,jswHole
syn region jswChar start=/'/ skip=/\\./ end=/'/ contains=jswEscape

" -- directives --------------------------------------------------
syn match jswDirective /^\s*#\h\w*/
syn region jswFeature matchgroup=jswDirective start=/#enable_feature</ end=/>/ oneline

" -- metadata lines: ``stage:``, ``Sprite:``, ``Name: name="..."`` -
syn region jswMetadataLine matchgroup=jswDeclaration start=/^\s*metadata\>/ end=/;/ oneline contains=jswMetadata,jswTarget,jswTargetKey,jswString,jswChar,jswNumber,jswComment,jswIdentifier,jswNamespace,jswFunctionCall
syn keyword jswMetadata contained at default hidden large list max min normal pos range shown slider watchers
syn match jswTarget /^\s*\h\w*\ze:.\{-}\<name=/
syn match jswTargetKey /[(:,]\s*\zs\h\w*\ze=[^=]/

