NpGraphical: name="NpGraphical", x=59, y=-45, size=100, direction=90, show=0, costume=0, volume=100, layer=4, rotation="all", draggable=0;
class NpGraphical {
    import "assets/2e1144f4fc6f9399ae5739b9412068e4.svg" as costume1; // costume centerx=2 centery=-0.5 res=1
    // temp variables (lmsTempVars2 thread variables)
    private _x;

    metadata RGB pos 1339,-1140;
    private void RGB(r, g, b) {
        Tick.freeze = 1;
        Piano.counter0 = 0;
        Comments.commentC("comment") {
            Piano.counter0 += b * 65536;
            Piano.counter0 += g * 256;
            Piano.counter0 += r;
        }
        Piano.activergb.add(Piano.counter0);
        Tick.freeze = 0;
    }

    metadata Piano.recalc pos 1539,-540;
    public void Piano.recalc() { // hook: broadcast Piano.recalc
        Pen.eraseAll();
        Piano.bkmod.clear();
        Piano.bks.clear();
        Piano.wks.clear();
        Player.NotesActive.clear();
        Piano.bkmod.add(1);
        Piano.bkmod.add(3);
        Piano.bkmod.add(6);
        Piano.bkmod.add(8);
        Piano.bkmod.add(10);
        repeat (128) {
            Player.NotesActive.add(0);
        }
        for (Piano.counter0=1, Piano.counter0<=128, Piano.counter0++) {
            _x = Piano.counter0 - 1;
            if (Piano.bkmod.contains(_x % 12)) {
                Piano.bks.add(_x);
            } else {
                Piano.wks.add(_x);
            }
        }
    }

    metadata graphical.prop pos 460,-420;
    public void graphical.prop() { // hook: broadcast graphical.prop
        _.getProp = "Piano drawer.";
        Comments.commentCommand("NotePlayer4,18");
    }

    metadata Piano.draw pos -540,-380;
    public void Piano.draw() { // warp // receiver at 140,-419
        Pen.eraseAll();
        Pen.setPenSize(3);
        Comments.commentC("White keys finally") {
            Motion.setXY(-239, -45);
            for (Piano.counter0=1, Piano.counter0<=Piano.wks.length(), Piano.counter0++) {
                Motion.x += 4;
                Pen.setPenColor(Piano.activergb.get(Player.NotesActive.get(Piano.wks.get(Piano.counter0)) + 1) % 16777216);
                Pen.penDown();
                Motion.y += -14;
                Motion.y += 14;
                Pen.penUp();
            }
        }
        Comments.commentC("Then draw black keys") {
            Motion.setXY(-237, -45);
            for (Piano.counter0=1, Piano.counter0<=Piano.bks.length(), Piano.counter0++) {
                Motion.x += 4 + (Piano.bks.get(Piano.counter0 - 1) + 3 == Piano.bks.get(Piano.counter0)) * 4;
                Pen.setPenColor((Piano.activergb.get(Player.NotesActive.get(Piano.bks.get(Piano.counter0)) + 1)) if (Player.NotesActive.get(Piano.bks.get(Piano.counter0)) > 0) else (4210752 + ""));
                Pen.penDown();
                Motion.y += -10;
                Motion.y += 10;
                Pen.penUp();
            }
        }
        Control.broadcast("Graph.draw");
    }

    loose { // at 860,-500
        // procedures_call
                Piano.draw();
    }
}

NpConsole: name="NpConsole", x=0, y=0, size=100, direction=90, show=1, costume=0, volume=100, layer=3, rotation="all", draggable=0;
class NpConsole {
    import "assets/5adf038af4cd6319154b5601237092fa.svg" as costume1; // costume centerx=0 centery=0 res=1
    // temp variables (lmsTempVars2 thread variables)
    private _console_i;
    private _console_r;
    private _console_t1;
    private _console_t2;
    private _console_t3;

    metadata PConsole.init pos 299,1659;
    public void PConsole.init() { // hook: broadcast PConsole.init
        PConsole.keyEvent = 0;
    }

    metadata PConsole.detectKeyEvent pos 620,1659;
    public void PConsole.detectKeyEvent() { // hook: broadcast PConsole.detectKeyEvent
        while (1) {
            if (Sensing.keyPressed("up arrow")) {
                PConsole.keyEvent = 1;
                Control.waitUntil(!Sensing.keyPressed("up arrow"));
            }
            if (Sensing.keyPressed("down arrow")) {
                PConsole.keyEvent = 3;
                Control.waitUntil(!Sensing.keyPressed("down arrow"));
            }
            if (Sensing.keyPressed("left arrow")) {
                PConsole.keyEvent = 2;
                Control.waitUntil(!Sensing.keyPressed("left arrow"));
            }
            if (Sensing.keyPressed("right arrow")) {
                PConsole.keyEvent = 4;
                Control.waitUntil(!Sensing.keyPressed("right arrow"));
            }
            if (Sensing.keyPressed("enter")) {
                PConsole.keyEvent = 5;
                Control.waitUntil(!Sensing.keyPressed("enter"));
            }
            PConsole.keyEvent = 0;
        }
    }

    loose { // at 299,380
        // data_setvariableto
                Tick.wait = 4;
    }

    loose { // at 300,499
        // data_setvariableto
                Tick.wait = 16;
    }

    loose { // at 299,620
        // procedures_call
                log("Begin test: Actual TPS");
                Temp.setRuntimeVariable("_console_r", "[]");
                log("ActualTPS,BaseSpeed,MIDISpeed,CalcOrigTPS,CalculatedTPS");
                Temp.forEachThreadVariable("_console_i", 10) {
                    Sensing.resetTimer();
                    Temp.setRuntimeVariable("_console_t1", Tick.tick);
                    Control.waitUntil(Sensing.timer() > .999);
                    Temp.setRuntimeVariable("_console_t2", Tick.tick);
                    Temp.setRuntimeVariable("_console_r", JSON.arrayPush(Temp.getRuntimeVariable("_console_t2") - Temp.getRuntimeVariable("_console_t1"), Temp.getRuntimeVariable("_console_r")));
                    log(f"[{_console_i}] {JSON.arrayGet(-1, Temp.getRuntimeVariable("_console_r"))}, {Player.baseSpeed}, {Player.midiSpeed}, {Operators.round(1 / (60 / Player.midiSpeed * (1 / 2 ** Tick.wait)) * 100) * .01}, {Operators.round(1 / (60 / Music.tempo() * (1 / 2 ** Tick.wait)) * 100) * .01}");
                }
                Temp.setRuntimeVariable("_console_t3", 0);
                Temp.forEachThreadVariable("_console_i", 10) {
                    Temp.changeRuntimeVariable("_console_t3", JSON.arrayGet(_console_i, Temp.getRuntimeVariable("_console_r")));
                }
                Temp.setRuntimeVariable("_console_t3", Temp.getRuntimeVariable("_console_t3") / 10);
                log(join(join("Tick.wait:", Tick.wait), join(" ActualTPS:", Temp.getRuntimeVariable("_console_t3"))));
    }

    loose { // at 980,779
        f"{JSON.arrayGet(-1, Temp.getRuntimeVariable("_console_r"))} midiS: origtps:{Operators.round(1 / (60 / Player.midiSpeed * (1 / 2 ** Tick.wait)) * 100) * .01}";
    }

