    private _id;
    private _lb;
    private _nc;
    private _nd;
    private _ni;
    private _nl;
    private _npt;
    private _nv;
    private _playtime;
    private _v_;

    metadata whenCloned pos -99,700;
    public void whenCloned() {
        _id = Player.id;
        Player.instances += 1;
        Player.triggers += 1;
        Player.id = 0;
        if (Player.instances + 1 > Player.maxnotes) {
            Player.instances -= 1;
            Control.deleteThisClone();
        }
        _nd = Player.NotesData.get(_id);
        _npt = Player.NotesPlayTick.get(_id);
        _nl = Player.NotesLength.get(_id);
        _nc = Player.NotesChannel.get(_id);
        _ni = Player.NotesInstr.get(_id);
        _nv = ((100) if (Player.NotesVol.get(_id) * 1 == 0) else (Player.NotesVol.get(_id))) * .78125;
        _playtime = _nl / 64 + Player.playDelay;
        _lb = Player.beats;
        if (!Player.NotesData.get(_id)) {
            Player.instances -= 1;
            Control.deleteThisClone();
        }
        Player.NotesActive.set(_nd, (1) if (Player.updatePiano == 1 || Comments.commentReporter("!= 0", !Util.stringToBoolean(Player.NotesChannel.length()))) else (1 + _nc % 16));
        if (!Player.muteChannel.get(1 + _nc % 16)) {
            Sound.volume = _nv;
            Sound.setEffect("PITCH", synth.vsl6.pitchs.get(_nd));
            Sound.playSound(join("6LA", join(_nd, "L")));
        }
        Music.restForBeats((16) if (_playtime > 16) else (_playtime));
        Control.waitUntil(Tick.tick % Player.synthBeatRestLevel == 0);
        Player.NotesActive.set(_nd, 0);
        if (Player.NPSBuffer.length() > 1500) {
            Player.instances -= 1;
            Control.deleteThisClone();
        } elif (Player.NPSBuffer.length() > 1000) {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.200;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
            Player.instances -= 1;
            Control.deleteThisClone();
        } elif (Player.NPSBuffer.length() > 500) {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.114;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
            Player.instances -= 1;
            Control.deleteThisClone();
        } elif (Player.NPSBuffer.length() > 200) {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.067;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
        } elif (Player.NPSBuffer.length() > 100) {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.035;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
        } elif (Player.NPSBuffer.length() > 50) {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.020;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
        } elif (Player.NPSBuffer.length() > 25) {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.013;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
        } else {
            _v_ = 1;
            while (!(Sound.volume < 1 || Player.NPSBuffer.length() > 500)) {
                _v_ -= 0.008;
                Sound.volume = _nv * _v_;
                Control.wait(.001);
            }
        }
        Player.instances -= 1;
        Control.deleteThisClone();
    }

    metadata Player.panic pos 779,700;
    public void Player.panic() { // hook: broadcast Player.panic
        Sound.stopAllSounds();
        Control.deleteThisClone();
    }

    metadata Synth.vsl6.prop pos 780,900;
    public void Synth.vsl6.prop() { // hook: broadcast Synth.vsl6.prop
        _.getProp = "6LA Left Channel extracted from VSL D-274 V2.1";
        Comments.commentCommand("NotePlayer4,20");
    }

    loose { // at 1500,900
        // sound_seteffectto
                Sound.setEffect("PITCH", 0);
    }

    loose { // at -700,1939
        // data_deletealloflist
                synth.vsl6.pitchs.clear();
                synth.vsl6.sounds.clear();
                Synth.counter = 21;
                while (Synth.counter < 109) {
                    synth.vsl6.sounds.add(Synth.counter);
                    Synth.counter += 1;
                }
                repeat (128) {
                    synth.vsl6.pitchs.add(0);
                }
    }
