    metadata CreateNoteGroup_StartTick_ pos 4076,1405;
    private void CreateNoteGroup_StartTick_(StartTick, PerTick, Notes, PerLength) { // proccode CreateNoteGroup StartTick: %s PerTick: %s Notes: %s PerLength: %s
        Temp.setRuntimeVariable("_CreateNoteGroup_0", Util.ruleReplace(join("[", join(Notes, "]")), " ", ","));
        Temp.setRuntimeVariable("_CreateNoteGroup_1", JSON.json_vm_getlist("Player.NotesExport"));
        Temp.setRuntimeVariable("_CreateNoteGroup_2", JSON.concatArray(Temp.getRuntimeVariable("_CreateNoteGroup_0"), Temp.getRuntimeVariable("_CreateNoteGroup_1")));
        log(Temp.getRuntimeVariable("_CreateNoteGroup_0"));
        log(Temp.getRuntimeVariable("_CreateNoteGroup_1"));
        log(Temp.getRuntimeVariable("_CreateNoteGroup_2"));
        JSON.json_vm_setlist("Player.NotesExport", Temp.getRuntimeVariable("_CreateNoteGroup_2"));
        Temp.forEachThreadVariable("_i", Player.NotesExport.length()) {
            CreateNote_Tick_(StartTick + PerTick * _i, Player.NotesExport.get(_i), PerLength);
        }
    }

    metadata ImportFL pos 4580,1460;
    private void ImportFL() {
        Control.broadcastAndWait("Player.reset");
        LogInternalDebug_Direct("ImportFL NotesData...");
        JSON.json_vm_setlist("Player.NotesData", Player.FLData.get(1));
        Control.wait(.02);
        LogInternalDebug_Direct("ImportFL NotesPlayTick...");
        JSON.json_vm_setlist("Player.NotesPlayTick", Player.FLData.get(2));
        Control.wait(.02);
        LogInternalDebug_Direct("ImportFL NotesLength...");
        JSON.json_vm_setlist("Player.NotesLength", Player.FLData.get(3));
        Control.wait(.02);
        LogInternalDebug_Direct("ImportFL NotesCommand...");
        JSON.json_vm_setlist("Player.NotesCommand", Player.FLData.get(4));
        Player.NotesChannel.clear();
        Control.wait(.02);
        if (Player.FLData.length() > 5) {
            LogInternalDebug_Direct("ImportFL NotesChannel...");
            JSON.json_vm_setlist("Player.NotesChannel", Player.FLData.get(5));
        }
        Control.wait(.02);
        if (Player.FLData.length() > 6) {
            LogInternalDebug_Direct("ImportFL NotesInstr...");
            JSON.json_vm_setlist("Player.NotesInstr", Player.FLData.get(6));
        }
        Control.wait(.02);
        if (Player.FLData.length() > 6) {
            LogInternalDebug_Direct("ImportFL NotesVol...");
            JSON.json_vm_setlist("Player.NotesVol", Player.FLData.get(7));
        }
        Player._Debug.set(3, join(join("GCl:", Sensing.timer()), join(" ", "ImportFL OK")));
        Control.wait(.1);
    }

    metadata RealtimeTPSFix pos 6619,1460;
    private void RealtimeTPSFix() {
        Comments.commentC("RealtimeTPSFix: main") {
            Temp.setRuntimeVariable("_Player_mtps", 1 / (60 / Player.midiSpeed * (1 / 2 ** Tick.wait)));
            Temp.setRuntimeVariable("_Player_ptps", 1 / (60 / (Player.midiSpeed * Player.baseSpeed) * (1 / 2 ** Tick.wait)));
            Temp.setRuntimeVariable("_Player_atps", Player.TickBuffer.length());
            if (Temp.getRuntimeVariable("_Player_mtps") / Temp.getRuntimeVariable("_Player_atps") > 4 || Temp.getRuntimeVariable("_Player_mtps") / Temp.getRuntimeVariable("_Player_atps") < 1) {
                Player.baseSpeed = 1.035 / 2 ** (Tick.wait - 4);
            } else {
                Player.baseSpeed = Temp.getRuntimeVariable("_Player_mtps") / Temp.getRuntimeVariable("_Player_atps");
            }
        }
    }

    metadata Player.WSDebug pos 9179,1460;
    public void Player.WSDebug() { // hook: broadcast Player.WSDebug
        if (WebSocket.isConnected() && Player._enableWS == 1) {
            _JSON = JSON.json_new("Object");
            _JSON = JSON.set("type", "debugm", _JSON);
            _JSON = JSON.set("debug0", f"T:{Tick.tick}/{Player.NotesPlayTick.get(Player.NotesPlayTick.length() - 1)} N:{Player.notes}/{Player.totalNotes} L:{Player.loops} NPS:{Player.NPSBuffer.length()} ATPS:{Player.TickBuffer.length()} MTPS:{Operators.round(1 / (60 / Player.midiSpeed * (1 / 2 ** Tick.wait)) * 1000) / 1000}", _JSON);
            _JSON = JSON.set("debug1", f"Spd:{Player.midiSpeed}x{Operators.round(Player.baseSpeed * 2 ** (Tick.wait - 4) * 1e3) / 1e3} P:{Player.pcmd} B:{Operators.round((Player.beats - 1) / Player.beats2 + 1.25 - .5)}.{Player.beats % Player.beats2 + 1} Sk:{Player.skips} HNPS:{Player.highestNPS} PTPS:{Operators.round(1 / (60 / (Player.midiSpeed * Player.baseSpeed) * (1 / 2 ** Tick.wait)) * 1e3) / 1e3} Cl:{Operators.round(Timer.getTimer("Player.timer") * 100) / 100} Polyphony:{Player.instances}", _JSON);
            _JSON = JSON.set("debug2", (join("NotePlayer4,", join(Player.version, " by GitHub/lqx211,bili_uid:3546654972053873 All rights reserved"))) if (Player.debugCustomDisp == "") else (Player.debugCustomDisp), _JSON);
            _JSON = JSON.set("GCl", Sensing.timer(), _JSON);
            _JSON = JSON.set("Cl", Timer.getTimer("Player.timer"), _JSON);
            _JSON = JSON.set("active_notes", JSON.json_vm_getlist("Player.NotesActive"), _JSON);
            WebSocket.sendMessage(_JSON);
        } elif (Sensing.timer() > Piano.WSDebugTimeout + 5 && Player._enableWS == 1) {
            WebSocket.newInstance("ws://127.0.0.1:65432");
            Piano.WSDebugTimeout = Sensing.timer();
        }
    }

    metadata EnsureModulesExist pos 5820,1619;
    private void EnsureModulesExist() {
        for (Synth.counter=1, Synth.counter<=_.modules.length(), Synth.counter++) {
            _.getProp = "None";
            Control.broadcastAndWait(join(_.modules.get(Synth.counter), ".prop"));
            if (_.getProp == "None") {
                LogError(join("CRITICAL: Missing ", join(_.modules.get(Synth.counter), ".sprite3")));
                Player._Debug.set(3, f"GCl:{Sensing.timer()} CRITICAL: Missing {_.modules.get(Synth.counter)}.sprite3");
                Player.debugCustomDisp = 0;
                _isCriticalError = 1;
                Sound.playSound("Warn");
                Control.wait(1);
                Control.stopThisScript();
            }
        }
    }

