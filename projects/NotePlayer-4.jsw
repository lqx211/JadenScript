}

NpGraph: name="NpGraph", x=165, y=0, size=100, direction=90, show=1, costume=0, volume=100, layer=10, rotation="all", draggable=0;
class NpGraph {
    import "assets/5adf038af4cd6319154b5601237092fa.svg" as "造型1"; // costume centerx=0 centery=0 res=1
    // temp variables (lmsTempVars2 thread variables)
    private _c;
    private _c_bottom;
    private _c_px;
    private _c_py;
    private _c_top;
    private _c_val;
    private _g;
    private _i;
    private _length;
    private _n;
    private _npt;
    private _s;
    private _static;

    metadata greenFlag pos 1339,-1619;
    public void greenFlag() {
        Pen.eraseAll();
        Graph.v1.clear();
        Graph.v2.clear();
    }

    metadata Graph.doGraph pos 379,-1420;
    private void Graph.doGraph() { // warp
        Graph.force_min = 0;
        Graph.force_max = 80;
        Graph.dpoint_y = 161;
        Graph.dpoint_x = -134;
        Graph.dsize_x = 50;
        Graph.dsize_y = 65;
        Graph.dspace = 1;
        Graph.lmax = 300;
        Graph.lockGraph = 0;
        Graph.cmm_v1();
        Pen.penUp();
        Comments.commentC("Graph border") {
            Pen.setPenColor("#118aa7");
            Motion.setXY(Graph.dpoint_x + Graph.v1.length(), 0);
            Motion.x = Graph.dpoint_x;
            Pen.penDown();
            Motion.y = Graph.dsize_y;
            Pen.penUp();
        }
        Comments.commentC("ATPS") {
            Graph.v1.add(Player.TickBuffer.length());
            while (Graph.v1.length() > Graph.lmax) {
                Graph.v1.delete(1);
            }
            Comments.commentCommand("当前点的Y = c_top - ( (c_val - Graph.min) / (Graph.max - Graph.min) * Graph.dsize_y )");
            Pen.setPenColor(join("#", "ffff80"));
            Temp.forEachThreadVariable("_g", Graph.v1.length()) {
                if (Graph.lockGraph == 1) {
                    Graph.min = Graph.force_min;
                    Graph.max = Graph.force_max;
                }
                _c_val = Graph.v1.get(_g);
                _c_top = Graph.dpoint_y;
                _c_bottom = Graph.dpoint_y - Graph.dsize_y;
                _c_px = Graph.dpoint_x + (_g - 1) * Graph.dspace;
                _c_py = (_c_val - Graph.min) / (Graph.max - Graph.min) * Graph.dsize_y;
                Motion.setXY(_c_px, _c_py);
                if (_g == 1) {
                    Pen.penDown();
                }
            }
            Pen.penUp();
        }
        Comments.commentC("MTPS") {
