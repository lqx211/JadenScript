        _npt = Player.NotesPlayTick.get(_id);
        _nl = Player.NotesLength.get(_id);
        _nc = Player.NotesChannel.get(_id);
        _playtime = _nl / 64 + Player.playDelay;
        if (!Player.NotesData.get(_id)) {
            Player.instances -= 1;
            Control.deleteThisClone();
        }
        Player.NotesActive.set(_nd, (1) if (Player.updatePiano == 1 || Comments.commentReporter("!= 0", !Util.stringToBoolean(Player.NotesChannel.length()))) else (1 + _nc % 16));
        if (Comments.commentReporter("Is drum set?", _ni % 40 > 21)) {
            Music.playDrum(Comments.commentReporter("Range from 1 to 18.", _ni % 40 - 21), (16) if (_playtime > 16) else (_playtime));
        } else {
            if (!Player.muteChannel.get(1 + _nc % 16)) {
                Music.setInstr(Player.InstrReassign.get((_ni) if (Util.stringToBoolean(_ni * !Util.stringToBoolean(Piano.disableMultiInstr))) else ((1) if (Piano.disableMultiInstr == 0) else (Piano.disableMultiInstr))));
                Music.playNote(_nd, (16) if (_playtime > 16) else (_playtime));
            }
            Player.NotesActive.set(_nd, 0);
