metadata note Stage at 50,516 457x539: "# Python3 MIDI档案转Notes类 (*.mid -> 0.txt)\nmport os\ntry: import mido\nexcept:\n os.system(\"pip install mido\")\n os.system(\"pip3 install mido\")\n os.system(\".venv/bin/pip install mido\")\n os.system(\".venv\\\\bin\\\\pip.exe install mido\")\n import mido\n# 如果出现报错，可以使用pip install <模块名称>\n# 安装所需模块。\nimport mido\nimport sys\nimport json\nfrom mido import MidiFile\nfrom collections import defaultdict, deque\n\ndef midi_to_events(midi_path, output_txt, debug=False):\n    mid = MidiFile(midi_path)\n    ppq = mid.ticks_per_beat\n    scale = 16.0 / ppq\n\n    raw_notes = []\n    tempo_events = []\n    pedal_events = []\n\n    for track_idx, track in enumerate(mid.tracks):\n        abs_tick = 0\n        pending = defaultdict(deque)\n        for msg in track:\n            abs_tick += msg.time\n            if msg.type == 'note_on' and msg.velocity > 0:\n                key = (msg.note, msg.channel)\n                pending[key].append(abs_tick)\n            elif msg.type == 'note_off' or (msg.type == 'note_on' and msg.velocity == 0):\n                key = (msg.note, msg.channel)\n                if pending[key]:\n                    start_tick = pending[key].popleft()\n                    end_tick = abs_tick\n                    if end_tick > start_tick:\n                        raw_notes.append((start_tick, end_tick, msg.note, msg.channel, track_idx))\n                    else:\n                        raw_notes.append((start_tick, start_tick+1, msg.note, msg.channel, track_idx))\n            elif msg.type == 'control_change' and msg.control == 64:\n                pedal_events.append((abs_tick, msg.value, track_idx))\n            elif msg.type == 'set_tempo':\n                bpm = 60000000 / msg.tempo\n                tempo_events.append((abs_tick, bpm))\n\n    if not tempo_events:\n        tempo_events.append((0, 120.0))\n\n    # 统一为 5 元组: (tick, type, data1, data2, data3)\n    event_queue = []\n    for (start, end, note, ch, tr) in raw_notes:\n        event_queue.append((start, 'note_on', note, ch, tr))\n        event_queue.append((end, 'note_off', note, ch, tr))\n    for (tick, val, tr) in pedal_events:\n        event_queue.append((tick, 'pedal', val, tr, None))\n    for (tick, bpm) in tempo_events:\n        event_queue.append((tick, 'tempo', bpm, None, None))\n\n    event_queue.sort(key=lambda x: x[0])\n\n    sustain = False\n    active_notes = defaultdict(deque)\n    output_events = []\n\n    for item in event_queue:\n        tick = item[0]\n        typ = item[1]\n        if typ == 'note_on':\n            note, ch, tr = item[2], item[3], item[4]\n            key = (note, ch, tr)\n            active_notes[key].append(tick)\n        elif typ == 'note_off':\n            note, ch, tr = item[2], item[3], item[4]\n            key = (note, ch, tr)\n            if not sustain:\n                if active_notes[key]:\n                    start_tick = active_notes[key].popleft()\n                    length = tick - start_tick\n                    if length <= 0:\n                        length = 1\n                    output_events.append((start_tick, 'note', (note, length)))\n        elif typ == 'pedal':\n            val = item[2]\n            was_sustain = sustain\n            sustain = (val >= 64)\n            if not was_sustain and sustain:\n                pass\n            elif was_sustain and not sustain:\n                for key in list(active_notes.keys()):\n                    while active_notes[key]:\n                        start_tick = active_notes[key].popleft()\n                        length = tick - start_tick\n                        if length <= 0:\n                            length = 1\n                        note = key[0]\n                        output_events.append((start_tick, 'note', (note, length)))\n        elif typ == 'tempo':\n            bpm = item[2]\n            output_events.append((tick, 'tempo', bpm))\n\n    if active_notes:\n        max_tick = max([t for t,_,_,_,_ in event_queue]) if event_queue else 0\n        for key in list(active_notes.keys()):\n            while active_notes[key]:\n                start_tick = active_notes[key].popleft()\n                length = max_tick - start_tick\n                if length <= 0:\n                    length = 1\n                note = key[0]\n                output_events.append((start_tick, 'note', (note, length)))\n\n    output_events.sort(key=lambda x: x[0])\n\n    with open(output_txt, 'w', encoding='utf-8') as f:\n        for tick, typ, data in output_events:\n            scaled_tick = int(round(tick * scale))\n            if typ == 'note':\n                note, length_orig = data\n                scaled_length = int(round(length_orig * scale))\n                if scaled_length == 0:\n                    scaled_length = 1\n                f.write(json.dumps([scaled_tick, note, scaled_length]) + '\\n')\n                if debug:\n                    print(f\"DEBUG: {scaled_tick},{note},{scaled_length}\")\n            elif typ == 'tempo':\n                bpm = data\n                scaled_tick = int(round(tick * scale))\n                cmd = {\"c\": 1, \"p\": [scaled_tick, round(bpm, 2)]}\n                f.write(json.dumps(cmd) + '\\n')\n\n    print(f\"原始有效音符数: {len(raw_notes)}\")\n    print(f\"处理后输出音符数: {len([e for e in output_events if e[1]=='note'])}\")\n    print(f\"输出文件: {output_txt}\")\n\nif __name__ == \"__main__\":\n    if len(sys.argv) < 2:\n        print(\"Usage: python 0.py <midi_file> [--debug]\")\n        sys.exit(1)\n    midi_file = sys.argv[1]\n    debug = \"--debug\" in sys.argv\n    output_file = \"0.txt\"\n    midi_to_events(midi_file, output_file, debug)";
metadata note Stage at 512,516 474x540: "# Python3 Notes类转FLData类 (*.txt -> FLData.txt)\nimport json\nimport sys\n\ndef build_fl_data(input_file, output_file=\"FLData.txt\"):\n    notes = []\n    play_ticks = []\n    lengths = []\n    commands = []\n\n    with open(input_file, 'r', encoding='utf-8') as f:\n        for line in f:\n            line = line.strip()\n            if not line:\n                continue\n            try:\n                data = json.loads(line)\n            except:\n                print(f\"跳过无效行: {line}\")\n                continue\n\n            # 判断：数组且长度为3，可能是 [tick, note, length] 或 [1, tick, bpm]\n            if isinstance(data, list) and len(data) == 3:\n                # 如果第一个元素是 1，视为命令\n                if data[0] == 1:\n                    commands.append(data)   # 已经是 [1, tick, bpm]\n                else:\n                    # 视为音符 [tick, note, length]\n                    tick, note, length = data\n                    play_ticks.append(tick)\n                    notes.append(note)\n                    lengths.append(length)\n            # 判断：对象格式 {\"c\":1,\"p\":[tick,bpm]}\n            elif isinstance(data, dict) and data.get(\"c\") == 1 and \"p\" in data:\n                params = data[\"p\"]\n                if isinstance(params, list) and len(params) >= 2:\n                    tick = params[0]\n                    bpm = params[1]\n                    # 转换为数组格式 [1, tick, bpm]\n                    commands.append([1, tick, bpm])\n                else:\n                    print(f\"命令参数格式错误: {data}\")\n            else:\n                print(f\"未知格式: {data}\")\n\n    # 写入四行：Notes, PlayTick, Length, Commands\n    with open(output_file, 'w', encoding='utf-8') as f:\n        f.write(json.dumps(notes, separators=(',', ':')) + '\\n')\n        f.write(json.dumps(play_ticks, separators=(',', ':')) + '\\n')\n        f.write(json.dumps(lengths, separators=(',', ':')) + '\\n')\n        f.write(json.dumps(commands, separators=(',', ':')) + '\\n')\n\n    print(f\"导出完成：{len(notes)} 个音符，{len(commands)} 条命令\")\n    print(f\"输出文件: {output_file} (顺序: Notes, PlayTick, Length, Commands)\")\n\nif __name__ == \"__main__\":\n    if len(sys.argv) < 2:\n        print(\"Usage: python build_fl.py <0.txt> [output file]\")\n        sys.exit(1)\n    infile = sys.argv[1]\n    outfile = sys.argv[2] if len(sys.argv) > 2 else \"FLData.txt\"\n    build_fl_data(infile, outfile)";
metadata note NpCore at 7103,2125 1142x1356: "-> Debug information explained in Player._Debug\nT(Current Tick):[Current Tick]/[Total Ticks]\nN:[Current note ID]/[Total notes]\nL:[Loops of main thread]\nNPS:[Note per seconds]\nTPS:[Tick per seconds]\nCl:[Player thread active time]\nSnds:[Current playing sounds and active instances]\nSpd:[MIDI Speed BPM]x[Player multiplier speed]\nP:[Current FastLoad command line number]\nB:[Measures].[Beat]\nSk:[Missed notes]\nHNPS:[Max note per second recorded during this play]\nATPS:[Current tick per second (same as TPS)]\nMTPS:[]\n\n-> Userspace options\nPlayer.updatePiano: Draw piano (2=multicolor, 1=single color, 0=no animation)\nPlayer.doSetCustomInitValues: Start player with custom start values\nPlayer.enableReverseTicking: Makes reverse ticking possible\nTick.freeze: Stop ticking, will pause player.\nPlayer.midiSpeed: Player internal playing speed in BPM format. You should not touch that.\nPlayer.beats2: How many beats in a measure. Used in beats counter Player._Debug[1]\nPlayer.playDelay: Delay effects for playing notes. Do not enable this in Black MIDI that will cause too much instances and lags\nPlayer.metronome: Do play metronome sounds.\nPlayer.maxPing: Maximum timeout allowed for every note. Timeout notes will be skipped and logged as ERROR.\nPlayer.baseSpeed: Speed multiplier for entire player. 1.035 is recommended in my environment.\nTick.wait: Tick system speed level, default 4. Each tick stays for 1/(2**Tick.wait) beats approx.\nPlayer.maxnotes: Maximum notes per second allowed. Notes that exceed the limit will be skipped and logged as ERROR.\n-> Advanced options\nPlayer.beatReady: Ticks before metronome system starts.\nPlayer.breakOnError: Pause and raise BREAK event to system when ERROR raised from anywhere.\nPlayer.breakOnWarning: Pause and raise BREAK event to system when WARN raised from anywhere.\nPlayer.customStartTick: Where player start playing when Player.doSetCustomInitValues=1.\nPlayer.customStartNoteID: Where player start playing when Player.doSetCustomInitValues=1 in NotesData.\nPlayer.customEndValue: The tick number where player stop playing when Player.doSetCustomInitValues=1\n-> More advanced options and values\nPlayer.endValue: Current player last tick number. Player will stop when tick counter reaches it.\nPlayer.highestNPS: Highest Notes per second recorded during play.\nPlayer.loops: Total loops in Player.start during play.\nPlayer.triggers: Note triggers in Player.start during play.\nPlayer.useFL: Use Fast Load feature when >=50. It will load and calculate the Notes list if using the legacy mode.\nPlayer.totalNotes: Sum of notes during current play.\nPlayer.nps: Current Note per second calculating in ancient way. Please use Player.NPSBuffer.length() instead.\nPlayer.skips: Skipped notes during play from timeout or reaching maximum NPS.\nTick.active: Ticking main switch. Setting to 0 will terminate the ticking process.\nTick.tick: Current player tick.\n\n-> Lists\nPlayer.FLData: Fast Load database (Normal length: 5)\nPlayer.PresetFLName: Names of built-ins songs. Press L or use LoadFLPreset()+ImportFL() to load one of them\nPiano.bkmod: Where stores the mod values of black keys in piano.\nPiano.bks: Where stores black key locations.\nPiano.wks: Where stores white key locations.\nPlayer._Debug: Debug menu during play.\nPlayer_MIDIConv.py: Internal script that convert MIDI to NotePlayer readable Notes file.\nPlayer_NoteToFLData.py: Internal script that convert Notes to FastLoad database.\nPlayer.Notes: The notes file import area.\nPlayer.Preset: All built-in presets in Notes format.\nPlayer.PresetFL: All built-in presets in FLData format.\nPlayer.PresetFLName: Song names of Player.PresetFL\nPlayer.TickBuffer: Tick counter. Get Tick per second by Player.TickBuffer.length()\n\nLast update: NotePlayer4,5 -- Wed Jul 8 2026 17:48:45\n";
metadata note NpCore at 4241,-511 206.8519287109375x156.25927734375: "Core: Modified NotePlayer4,26\nworld.execute(me)";
metadata note NpGraphical at 201,-790 499x318: "\n\nblack_keys = []\nfor note in range(0, 128):\n    if note % 12 in [1, 3, 6, 8, 10]:\n        black_keys.append(note)\n\nprint(black_keys)";
metadata note NpGraphical at 516,951 1240x600: "// Pseudocode of sprite piano\n// NotePlayer4,0\n\nprivate function Draw(RunWithoutScreenRefresh){\n  Pen.eraseAll();\n  Pen.setPenSize(3);\n  piano.setPos(-239,-45);\n  for Piano.counter0 in Piano.wks.length(){\n   piano.changeX(4);\n   Pen.setPenColor(13816530+(2895150*(Player.NotesActive.get(Piano.wks.get(Piano.counter0)))));\n   Pen.penDown();\n   piano.changeY(-14);\n   piano.changeY(14);\n   Pen.penUp();\n  }\n  piano.setPos(-237,-45);\n  for Piano.counter0 in Piano.bks.length(){\n   piano.changeX(4+(4*(Piano.bks.get(Piano.counter0-1)+3==Piano.bks.get(Piano.counter0))));\n   Pen.setPenColor(7500402+(9211278*(Player.NotesActive.get(Piano.wks.get(Piano.counter0)))));\n   Pen.penDown();\n   piano.changeY(-10);\n   piano.changeY(10);\n   Pen.penUp();\n}\n\npublic function Piano.draw(){\n if(RuntimeOptions.turboMode){\n  Pen.eraseAll();\n  Pen.setPenSize(3);\n  piano.setPos(-239,-45);\n  for Piano.counter0 in Piano.wks.length(){\n   piano.changeX(4);\n   Pen.setPenColor(13816530+(2895150*(Player.NotesActive.get(Piano.wks.get(Piano.counter0)))));\n   Pen.penDown();\n   piano.changeY(-14);\n   piano.changeY(14);\n   Pen.penUp();\n  }\n  piano.setPos(-237,-45);\n  for Piano.counter0 in Piano.bks.length(){\n   piano.changeX(4+(4*(Piano.bks.get(Piano.counter0-1)+3==Piano.bks.get(Piano.counter0))));\n   Pen.setPenColor(7500402+(9211278*(Player.NotesActive.get(Piano.wks.get(Piano.counter0)))));\n   Pen.penDown();\n   piano.changeY(-10);\n   piano.changeY(10);\n   Pen.penUp();\n  }\n } else {\n  Draw(); // Private function: Run without screen refresh\n}";
metadata note NpGraphical at 2218.6814559653953,-402.2222222222214 598.5184326171875x776.2962951660156: "r";
metadata note NpPseudocode at 102,53 891x828: "// NotePlayer4,12\n// by GitHub @lqx211, Bilibili UID 3546654972053873\n// Licensed under the GPL-3.0 License\n// All rights reserved\n\n// Definition: call: do not wait for the called function to finish\n// This is not actual JavaScript code.\n// You need to convert to Scratch blocks by yourself.\n\n/*\n-> Debug information explained in Player._Debug\nT(Current Tick):[Current Tick]/[Total Ticks]\nN:[Current note ID]/[Total notes]\nL:[Loops of main thread]\nNPS:[Note per seconds]\nTPS:[Tick per seconds]\nCl:[Player thread active time]\nSnds:[Current playing sounds and active instances]\nSpd:[MIDI Speed BPM]x[Player multiplier speed]\nP:[Current FastLoad command line number]\nB:[Measures].[Beat]\nSk:[Missed notes]\nHNPS:[Max note per second recorded during this play]\nATPS:[Current tick per second (same as TPS)]\nMTPS:[]\n\n-> Userspace options\nPlayer.updatePiano: Draw piano (2=multicolor, 1=single color, 0=no animation)\nPlayer.doSetCustomInitValues: Start player with custom start values\nPlayer.enableReverseTicking: Makes reverse ticking possible\nTick.freeze: Stop ticking, will pause player.\nPlayer.midiSpeed: Player internal playing speed in BPM format. You should not touch that.\nPlayer.beats2: How many beats in a measure. Used in beats counter Player._Debug[1]\nPlayer.playDelay: Delay effects for playing notes. Do not enable this in Black MIDI that will cause too much instances and lags\nPlayer.metronome: Do play metronome sounds.\nPlayer.maxPing: Maximum timeout allowed for every note. Timeout notes will be skipped and logged as ERROR.\nPlayer.baseSpeed: Speed multiplier for entire player. 1.035 is recommended in my environment.\nTick.wait: Tick system speed level, default 4. Each tick stays for 1/(2**Tick.wait) beats approx.\nPlayer.maxnotes: Maximum notes per second allowed. Notes that exceed the limit will be skipped and logged as ERROR.\n-> Advanced options\nPlayer.beatReady: Ticks before metronome system starts.\nPlayer.breakOnError: Pause and raise BREAK event to system when ERROR raised from anywhere.\nPlayer.breakOnWarning: Pause and raise BREAK event to system when WARN raised from anywhere.\nPlayer.customStartTick: Where player start playing when Player.doSetCustomInitValues=1.\nPlayer.customStartNoteID: Where player start playing when Player.doSetCustomInitValues=1 in NotesData.\nPlayer.customEndValue: The tick number where player stop playing when Player.doSetCustomInitValues=1\n-> More advanced options and values\nPlayer.endValue: Current player last tick number. Player will stop when tick counter reaches it.\nPlayer.highestNPS: Highest Notes per second recorded during play.\nPlayer.loops: Total loops in Player.start during play.\nPlayer.triggers: Note triggers in Player.start during play.\nPlayer.useFL: Use Fast Load feature when >=50. It will load and calculate the Notes list if using the legacy mode.\nPlayer.totalNotes: Sum of notes during current play.\nPlayer.nps: Current Note per second calculating in ancient way. Please use Player.NPSBuffer.length() instead.\nPlayer.skips: Skipped notes during play from timeout or reaching maximum NPS.\nTick.active: Ticking main switch. Setting to 0 will terminate the ticking process.\nTick.tick: Current player tick.\n\n-> Lists\nPlayer.FLData: Fast Load database (Normal length: 5)\nPlayer.PresetFLName: Names of built-ins songs. Press L or use LoadFLPreset()+ImportFL() to load one of them\nPiano.bkmod: Where stores the mod values of black keys in piano.\nPiano.bks: Where stores black key locations.\nPiano.wks: Where stores white key locations.\nPlayer._Debug: Debug menu during play.\nPlayer_MIDIConv.py: Internal script that convert MIDI to NotePlayer readable Notes file.\nPlayer_NoteToFLData.py: Internal script that convert Notes to FastLoad database.\nPlayer.Notes: The notes file import area.\nPlayer.Preset: All built-in presets in Notes format.\nPlayer.PresetFL: All built-in presets in FLData format.\nPlayer.PresetFLName: Song names of Player.PresetFL\nPlayer.TickBuffer: Tick counter. Get Tick per second by Player.TickBuffer.length()\n\nLast update: NotePlayer4,5 -- Wed Jul 8 2026 17:48:45\n\n*/\n\nclass graphical { // Sprite: graphical (0,0) size=100 direction=90 show=0\n    private void RGB(r,g,b){\n        public Tick.freeze = 1;\n        public Piano.counter0 = 0;\n        public Piano.counter0 += b*65536;\n        public Piano.counter0 += g*256;\n        public Piano.counter0 += r*1;\n        Piano.activergb.add(Piano.counter0);\n        public Tick.freeze = 0;\n    }\n    public void Piano.recalc(){\n        Pen.eraseAll();\n        Piano.bkmod.clear();\n        Piano.bks.clear();\n        Piano.wks.clear();\n        Piano.NotesActive.clear();\n        for (i=1, i<=128, i++){\n            Player.NotesActive.add(0);\n        }\n        for (Piano.counter0=1, Piano.counter0<=128, Piano.counter0++){\n            private x = Piano.counter0-1;\n            if (Piano.bkmod.contains(x%12)){\n                Piano.bks.add(x);\n            } else {\n                Piano.wks.add(x);\n            }\n        }\n    }\n    public void Piano.draw(){\n        Pen.eraseAll();\n        Pen.setPenSize(3);\n        // White key\n        Motion.x = -239;\n        Motion.y = -45;\n        for (Piano.counter0=1, Piano.counter0<=52, Piano.counter0++){\n            Motion.x += 4;\n            Pen.setPenColor(Piano.activergb.get(1+Player.NotesActive.get(Piano.wks.get(Piano.counter0)))%16777216);\n            Pen.penDown();\n            Motion.y -= 14;\n            Motion.y += 14;\n            Pen.penUp();\n        }\n        // Black key\n        Motion.x = -237;\n        Motion.y = -45;\n        for (Piano.counter0=1, Piano.counter0<=52, Piano.counter0++){\n            Motion.x += 4+((Piano.bks.get(Piano.counter0-1)+3==Piano.bks.get(Piano.counter0)*4);\n            Pen.setPenColor(\n                (Piano.activergb.get(1+Player.NotesActive.get(Piano.wks.get(Piano.counter0)))%16777216)\n                if (Player.NotesActive.get(Piano.bks.get(Piano.counter0))>0) else\n                (4210752)\n            );\n            Pen.penDown();\n            Motion.y -= 10;\n            Motion.y += 10;\n            Pen.penUp();\n        }\n    }\n}\nclass synth { // Sprite: synth (0,0) size=100 direction=90 show=0\n    public void whenCloned(){\n        private id = Player.id;\n        public Player.instances++;\n        public Player.triggers++;\n        public Player.id = 0;\n        if (Player.instances+1>Player.maxnotes){\n            Player.instances--;\n            return;\n        }\n        private nd = Player.Notes.get(id);\n        private npt = Player.NotesPlayTick.get(id);\n        private nl = Player.NotesLength.get(id);\n        private nc = Player.NotesChannel.get(id);\n        private ni = Player.NotesInstr.get(id);\n        private playtime = (nl/64)+Player.playDelay;\n        Player.NotesActive.replace(nd,(\n            (1) if (Player.updatePiano || !Player.NotesChannel.length() ) else (1+nc%16)\n        ));\n        Music.setInstr((\n            (ni) if (ni*(!Piano.disableMultiInstr)) else (\n                (1) if (!Player.disableMultiInstr) else (Player.disableMultiInstr)\n            )\n        ));\n        Music.playNote(nd,(\n            (16) if (playtime>16) else (playtime)\n        ));\n        Player.NotesActive.set(nd,0);\n        Player.instances--;\n        return;\n    }\n    public void Player.panic(){\n        Music.stopAll();\n        Player.NotesActive.clear();\n    }\n}\n\n\nclass core { // Sprite: core (-196,121) size=100 direction=90 show=1\n    public void Player.start(){ // main thread\n        public Player.sbar2 = \"Player.start\";\n        public Player.loggerL = 0;\n        public Tick.active = 1;\n        console.endLogTimer(\"Player.timer\");\n        logStatic(\"==[ New Player Instance at GCl:\"+string(Sensing.timer)+\" ]========\");\n        logStatic(\"NotePlayer4,\"+string(Player.version)+\" by GitHub/lqx211, All rights reserved\");\n        public Player.totalNotes = Player.NotesData.length();\n        // Call some functions\n        Piano.recalc(); // initialize piano drawings\n        Piano.draw(); // now draw piano\n        // Display song name if equipe";
metadata note NpPseudocode at 98,889 460x546: "播放onlymyrailgun时的数据\n\nPlayer.triggers: 2574\nTick.tick: 2269\nTick.freeze: 0\nPlayer.notes: 2574\nTempvar.a: 4955\nPlayer.id: 0\nPlayer.instances: 0\nPlayer.maxnotes: 65536\nTempvar.b: 2574\nPlayer.bufferNote: 1\nPlayer.skips: 0\nPlayer.loops: 4843\nPlayer.baseSpeed: 1.035\nPlayer.midiSpeed: 143\nTick.wait: 4\nPlayer.sbar: \"T:2269/8700 N:2574/10933 L:4843 NPS:46 Cl:130.6 Snds:0\"\nPlayer.metronome: 1\nPlayer.useFL: 53\nPlayer.npsCounter: 2574\nPlayer.nps: 0\nPlayer.totalNotes: 10933\nPlayer.pcmd: 2\nPlayer.sbar2: \"Spd:143x1.03 P:2 B:36.2 Sk:0\"\nPlayer.maxPing: 1\nPlayer.dispOptions: 1\nfreeze: 1\nPlayer.beats: 141\nPlayer.beats2: 4\nPlayer.beatPreTick: 0\nPlayer.highestNPS: 84\nTick.enableReverseTicking: 0\nNotes:[]\nNotesExport:[]\nNotesLength:[...]\nNotesPlayTick:[...]\nNotesData:[...]\nNPSBuffer:[129.661\n129.662\n129.663\n129.663\n129.663\n129.663\n129.663\n129.768\n129.768\n129.876\n129.877\n129.877\n129.877\n129.877\n129.877\n129.877\n129.877\n129.877\n129.877\n129.983\n129.984\n130.088\n130.088\n130.088\n130.088\n130.088\n130.192\n130.192\n130.3\n130.3\n130.3\n130.3\n130.3\n130.403\n130.404\n130.509\n130.509\n130.509\n130.509\n130.509\n130.509\n130.509\n130.617\n130.617\n130.617\n130.617]\nPreset:[...]\nFLData:[...]\nNotesCommand:[[1,0,143]]\nPresetFL:[...]\n_MIDIConv.py:[...]\n_NoteToFLData.py:[...]\nPresetFLName:[别酱\nCry for me (v1)\n鸟之诗\nRush E\n稻香(非完整)\nB站入站曲(非完整)\nLuvLetter(非完整)\nCustom Song 1\nField of Hopes and Dreams\nAnimenz: God Knows\nOnly My Railgun\n英雄主义\nonlymyraligun_blackmidi\nunknown3]";
metadata note NpPseudocode at 565,887 437x616: "> Metronome System Pseudocode Update\n----------\nfunction commentBlock(comment){\n return 1;\n}\n\nfunction Player.start(){\n public Player.sbar2 = ...;\n ...\n public Player.highestNPS = 0;\n private lt2 = Tick.tick-1;\n public Player.beats = 0;\n while(1){\n  private lt = Tick.tick;\n  Player.loops += 1;\n  ...\n  if (Player.notes > NotesData.length()){ this.stopScript(); }\n  if (commentBlock(\"Metronome Tick Count System\")){\n   if (Tick.tick > lt2+15 ){\n    private lt2 = Tick.tick;\n    private mtcsok = 1;\n    Player.beats += 1\n   }\n  }\n  if (commentBlock(\"Metronome Sound Play System\")){\n   if ( Player.metronome && mtcsok ){\n    if ( Player.beats % Player.beats2 == 0 ){\n     Sound.playSound(\"MetronomeEffect2\");\n    } else {\n     Sound.playSound(\"MetronomeEffect1\");\n    }\n   }\n  }\n  private mtcsok = 0;\n  if ( NotesCommand.get(Player.pcmd).get(1) == 1 ){\n   ...\n  }\n  ...\n }\n}";
metadata note NpPseudocode at 1210,50 524x537: "FUNCTIONS+SPRITES\nLast update: NotePlayer3,18\n\n全部函数\n\n// class: Sprite\nclass main(){ // NotePlayer3.main\n private function BuildPlayer(){}; 早过时了，都没pcmd\n private function CreateNote(Tick,Note,Length){};\n private function CreateNoteGroup(StartTick,PerTick,Notes,PerLength){};\n private function ExportFL(){};\n private function ExportND(Index){};\n private function ImportFL(){};\n private function LoadFLPreset(PresetID){};\n private function MoveTick(Ticks){};\n private function RealtimeTPSFix(){};\n private function RemoveFLPreset(PresetID){};\n private function ReverseBeats(Beats){};\n private function SaveFLPreset(PresetName){};\n private function SkipTick(Ticks){};\n private function Ticker(){};\n}\nclass pseudocode(){};\nclass console(){};\nfunction PConsole.detectKeyEvent(){};\nfunction PConsole.init(){};\nfunction Player.checkIfDisp(){};\nfunction Player.clear(){};\nfunction Player.disableReverseTicking(){};\nfunction Player.enableReverseTicking(){};\nfunction Player.help(){};\nfunction Player.main(){};\nfunction Player.panic(){};\nfunction Player.start(){};\nfunction Player.timerCheck(){};\nfunction Player.updateDebugMenu(){};\nfunction Tick.reset(){};";
metadata note NpPseudocode at 998,698 595x757: "//关于Metronome系统的进化史\n//最后一次更新 NP3.21\n\nNP3.15-NP3.21 Player.start -> while(1) -> commentBlock(\"Metronome Sound Play System\"):\nif (Player.metronome==1 && mtcsok){\n if (Player.beats%Player.beats2==0){\n  playSound(\"MetronomeEffect2\");\n } else {\n  playSound(\"MetronomeEffect1\");\n }\n}\n\n\nNP3.13-NP3.14 Player.start -> while(1) -> commentBlock(\"Metronome Sound Play System\"):\nif (Player.metronome==1 && mtcsok){\n if( Player.beats%Player.beats2==0){\n  Player.metronomeSoundA();\n }else{\n  Player.metronomeSoundB();\n }\n}\n\nNP1.1-NP3.12 Player.start -> while(1) -> commentBlock(\"Metronome Sound Play System\"):\nFunction does not exist\n\n---\n\nNP3.18-NP3.21 Player.start -> while(1) -> commentBlock(\"Metronome Tick Count System\"):\nif (Tick.tick > lt2+Player.beatReady+15){\n private lt2 = Tick.tick - Player.beatReady;\n private mtcsok = 1;\n Player.beats++\n}\n\nNP3.13-NP3.17 Player.start -> while(1) -> commentBlock(\"Metronome Tick Count System\"):\nif (Tick.tick > lt2+15){\n private lt2 = Tick.tick;\n private mtcsok = 1;\n Player.beats++\n}\n\nNP1.1-NP3.12 Player.start -> while(1) -> commentBlock(\"Metronome Tick Count System\"):\nFunction does not exist";
metadata note NpPseudocode at 1001,51 205x628: "BLOCK COUNTS\n\nNP1,0  -> 73\nNP1,4  -> 334\nNP1,10 -> 496\nNP2,6  -> 478\nNP2,16 -> 564\nNP2,17 -> 566\nNP3,2  -> 559\nNP3,6  -> 561\nNP3,10 -> 560\nNP3,13 -> 617\nNP3,14 -> 632\nNP3,15 -> 612\nNP3,16 -> 676\nNP3,17 -> 927\nNP3,18 -> 1059\nNP3,20 -> 1008\nNP3,23 -> 1093\nNP3,24 -> 1258\nNP3,25 -> 1267\nNP3,26 -> 1269\nNP3,28 -> 1288\nNP3,29 -> 1343\nNP4,5 -> 1567\nNP4,19 -> 3006\nNP4,24 -> 3708\nNP4,26 -> 4046";
metadata note NpPseudocode at 1739,46 780x611: "Custom loader pseudocode\n\nprivate void customizedMain(StartTick,StopNID,StartNID,LPresetID,initBaseSpd,delayEffect_b,beats2,maxNotes,maxPing){\n    public Tick.freeze = 1;\n    public Player.endValue = 0; // stop Player\n    LoadFLPreset(LPresetID);\n    ImportFL();\n    public Player.doSetCustomInitValues = true;\n    public Player.customEndValue = StopNID;\n    public Player.customStartTick = StartTick;\n    public Player.customStartNoteID = StartNID;\n    public Player.BaseSpeed = initBaseSpd;\n    public Player.playDelay = delayEffect_b;\n    public Player.beats2 = beats2;\n    public Player.maxNotes = maxNotes;\n    public Player.maxPing = maxPing;\n    public Player.metronome = 0;\n    call Player.main();\n    sleep(500);\n    public Player.doSetCustomInitValues = false;\n    public Tick.freeze = 0;\n}";
metadata note NpPseudocode at 97,1442 466x552: "WebSocket debug server:\n\nDEFAULT IP ADDRESS: 127.0.0.1:65432\n\n# NotePlayer4,19+ WebSocket debug interface\nimport sys, json, time\ntry:\n import asyncio\n import websockets\nexcept ModuleNotFoundError:\n print(\"\\033[93mInstalling asyncio and websockets, please wait...\\033[0m\")\n import os;os.system(\"pip install asyncio websockets\")\n os.system(\"pip3 install asyncio websockets\")\n import asyncio\n import websockets\nlogfile = open(\"wsdebug.log\", \"a\")\nlogfile2 = open(\"wsdebug2.log\", \"a\")\nlogfile_internal = open(\"wsmain.log\",\"a\")\nlf_internal = []\nln=0\nph=''\n\nasync def echo(websocket):\n  try:\n    global ln, lf_internal, logfile, logfile2, ph\n    async for message in websocket:\n        # traslate message to JSON Object\n        j = json.loads(message) # so its already a JSON Object lol\n        logfile_internal.write(f\"{time.time():.6f}\\t{j}\\n\")\n        match j[\"type\"]:\n            case \"debugm\":\n                debug0 = j[\"debug0\"]\n                debug1 = j[\"debug1\"]\n                debug2 = j[\"debug2\"]\n                gclock = j[\"GCl\"]\n                clock = j[\"Cl\"]\n                # Move to screen (0,0)\n                ph=str(debug0)+\"\\n\"+str(debug1)+\"\\n\"+str(debug2)+\"\\n\"\n            case \"log.static\":\n                me=j[\"message\"]\n                logfile.write(me+\"\\n\")\n                logfile.flush()\n                lf_internal.append(f\"{ln}\\t\\033[92m{me}\\033[0m\")\n                ln+=1\n            case \"log.warn\":\n                me=j[\"message\"]\n                logfile.write(me+\"\\n\")\n                logfile.flush()\n                lf_internal.append(f\"{ln}\\t\\033[93m{me}\\033[0m\")\n                ln+=1\n            case \"log.error\":\n                me=j[\"message\"]\n                logfile.write(me+\"\\n\")\n                logfile.flush()\n                lf_internal.append(f\"{ln}\\t\\033[91m{me}\\033[0m\")\n                ln+=1\n            case \"log.info\":\n                me=j[\"message\"]\n                logfile.write(me+\"\\n\")\n                logfile.flush()\n                lf_internal.append(f\"{ln}\\t\\033[94m{me}\\033[0m\")\n                ln+=1\n            case \"log.debug\":\n                me=j[\"message\"]\n                logfile2.write(me+\"\\n\")\n                logfile2.flush()\n                # no lf_internal append for debug logs\n            case _:\n                pass\n        sys.stdout.write(\"\\033[H\\033[J\")  # Clear screen\n        # Now draw active_notes (List)\n        active_notes = j.get(\"active_notes\", [])\n        if len(active_notes)<128:\n            logfile_internal.write(\"WARN: ACTIVE NOTE LENGTH (\"+str(len(active_notes))+\") < 128, padding with zeros.\\n\")\n            logfile_internal.flush()\n            active_notes += [0]*(128-len(active_notes))\n        else:\n            active_notes = [bool(int(x)) for x in active_notes[:128]]  # Ensure it's a list of bools\n        # Active notes: [0]*128 by default\n        an0 = an1 = an2 = an3 = \"\"\n        for i in range(32): # int = bool :)\n            if active_notes[i]:an0+=\"\\033[91m*\\033[0m\"\n            else:an0+=\"*\"\n        for i in range(32,64):\n            if active_notes[i]:an1+=\"\\033[91m*\\033[0m\"\n            else:an1+=\"*\"\n        for i in range(64,96):\n            if active_notes[i]:an2+=\"\\033[91m*\\033[0m\"\n            else:an2+=\"*\"\n        for i in range(96,128):\n            if active_notes[i]:an3+=\"\\033[91m*\\033[0m\"\n            else:an3+=\"*\"\n        if True:\n            sys.stdout.write(\"----- NotePlayer4,19+ WebSocket Debug\\n\")\n            sys.stdout.write(ph) # debug info\n            sys.stdout.write(\"----- Active Notes --------------------\\n\")\n            sys.stdout.write(an0+\"\\n\"+an1+\"\\n\"+an2+\"\\n\"+an3+\"\\n\")\n            sys.stdout.write(\"----- Logs ----------------------------\\n\")\n            # Now tail 10 lines of logfile\n            tailed = lf_internal[-25:]\n            for line in tailed:\n                sys.stdout.write(line+\"\\n\")\n        sys.stdout.flush()\n            \n\n        \n        #print(f\"收到: {message}\")\n        await websocket.send(f\"OK {time.time_ns()}\") # Echo back the current time\n  except:\n    pass\nasync def main():\n    async with websockets.serve(echo,\"127.0.0.1\",65432,max_size=50*1024*1024,ping_interval=20,ping_timeout=60):\n        print(\"WebSocket service ok ws://127.0.0.1:65432\")\n        await asyncio.Future()\nif __name__ == \"__main__\":\n    try:\n        asyncio.run(main())\n    except KeyboardInterrupt:\n        print(\"\\nStopping service.\")\n    finally:\n        logfile.close()\n        logfile2.close()\n        logfile_internal.close()";
