    metadata AutoAdjustPms pos 10059,-579;
    private void AutoAdjustPms() { // warp
        Player.playDelay = 1 / Operators.math("log", ((0) if (Player.NPSBuffer.length() < 2) else (Player.NPSBuffer.length())) / 1) / 15;
        if (Player.lastTimeoutTick > 48) {
            Tick.wait = -2;
        } elif (Player.lastTimeoutTick > 32) {
            Tick.wait = -1;
        } elif (Player.lastTimeoutTick > 24) {
            Tick.wait = 0;
        } elif (Player.lastTimeoutTick > 16) {
            Tick.wait = 1;
        } elif (Player.lastTimeoutTick > 8) {
            Tick.wait = 2;
        } elif (Player.lastTimeoutTick > 4) {
            Tick.wait = 3;
        } else {
            Tick.wait = 4;
        }
    }

    metadata Player.timerCheck pos 4700,-500;
    public void Player.timerCheck() { // hook: broadcast Player.timerCheck
        while (1) {
            while (Timer.getTimer("Player.timer") > Player.TickBuffer.get(1) + 1) {
                Player.TickBuffer.delete(1);
            }
        }
    }

    metadata ExportND_Index_ pos 6619,-500;
    private void ExportND_Index_(i_arg) { // proccode ExportND Index: %s // warp
        Player.debugCustomDisp = join("BP 1/6 (ND) ", join(Operators.round(Player.tmpA / Player.Notes.length() * 1000) / 10, "%"));
        _i = i_arg;
        if (JSON.isArray(JSON.arrayGet(_i, JSON.json_vm_getlist("Player.Notes")))) {
            Player.NotesData.add(JSON.arrayGet(2, JSON.arrayGet(_i, JSON.json_vm_getlist("Player.Notes"))));
        } else {
            _json = JSON.arrayGet(_i, JSON.json_vm_getlist("Player.Notes"));
            _command = JSON.get("c", JSON.arrayGet(_i, JSON.json_vm_getlist("Player.Notes")));
            _parameters = JSON.get("p", JSON.arrayGet(_i, JSON.json_vm_getlist("Player.Notes")));
            if (_command == 1) {
                _startTick = JSON.arrayGet(1, _parameters);
                _tempo = JSON.arrayGet(2, _parameters);
                Comments.commentC("core") {
                    Comments.commentCommand("wait nahhh, it changes basespeed during load, not during play");
                    Player.NotesCommand.add(f"[{1},{_startTick * 1},{_tempo * 1}]");
                    Player.midiSpeed = _tempo;
                }
                Comments.commentC("make sure somethings there");
            }
            Player.NotesData.add(0);
        }
    }

    metadata Player_main__Custom_Init_Value__StartTick_ pos 8059,-500;
    private void Player_main__Custom_Init_Value__StartTick_(StartTick, StopNoteID, StartNID, LPresetID, initBaseSpd, delayEffect_b, b2, mN, mP) { // proccode Player.main (Custom Init Value) StartTick: %s StopNID: %s StartNID: %s LPresetID: %s baseSpeed: %s playDelayEffect_beats: %s beats2: %s maxNotes: %s maxPing: %s
        Tick.freeze = 1;
        Player.endValue = Comments.commentReporter("stop player", 0);
        LoadFLPreset_ID_(LPresetID);
        ImportFL();
        Player.doSetCustomInitValues = 1;
        Player.customEndValue = StopNoteID;
        Player.customStartTick = Comments.commentReporter(64 * 220.75, StartTick);
        Player.customStartNoteID = StartNID;
        Player.baseSpeed = initBaseSpd;
        Player.playDelay = delayEffect_b;
        Player.beats2 = b2;
        Player.maxnotes = mN;
        Player.maxPing = mP;
        Player.metronome = 0;
        Control.broadcast("Player.main");
        Control.wait(.5);
        Player.beats += 2;
        Player.doSetCustomInitValues = 0;
        Tick.freeze = 0;
    }

