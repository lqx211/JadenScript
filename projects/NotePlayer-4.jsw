    metadata CreateNote_Tick_ pos 4700,939;
    private void CreateNote_Tick_(Tick, Note, Length) { // proccode CreateNote Tick: %s Note: %s Length: %s
        Player.sbar2 = f"CreateNote T:{Tick} N:{Note} L:{Length}";
        Player.Notes.add(f"[{Tick},{Note},{Length}]");
    }

    metadata Player.updateDebugMenu pos 8059,939;
    public void Player.updateDebugMenu() { // hook: broadcast Player.updateDebugMenu
        Player._Debug.set(1, f"T:{Tick.tick}/{Player.NotesPlayTick.get(Player.NotesPlayTick.length() - 1)} N:{Player.notes}/{Player.totalNotes} L:{Player.loops} NPS:{Player.NPSBuffer.length()} ATPS:{Player.TickBuffer.length()} MTPS:{Operators.round(1 / (60 / Player.midiSpeed * (1 / 2 ** Tick.wait)) * 1e2) / 1e2}");
        Player._Debug.set(2, f"Spd:{Player.midiSpeed}x{Operators.round(Player.baseSpeed * 2 ** (Tick.wait - 4) * 1e3) / 1e3} P:{Player.pcmd} B:{Operators.round((Player.beats - 1) / Player.beats2 + 1.25 - .5)}.{Player.beats % Player.beats2 + 1} Sk:{Player.skips} HNPS:{Player.highestNPS} PTPS:{Operators.round(1 / (60 / (Player.midiSpeed * Player.baseSpeed) * (1 / 2 ** Tick.wait)) * 1e2) / 1e2} Cl:{Operators.round(Timer.getTimer("Player.timer") * 10) / 10} Polyphony:{Player.instances}");
        Player._Debug.set(3, (Lyrics.c_en) if (Player.debugCustomDisp == "") else (Player.debugCustomDisp));
        Comments.commentCommand("HNPS: Highest NPS appeared");
        Comments.commentCommand("MTPS: MIDI Tick per second (midiSpeed)");
        Comments.commentCommand("PTPS: Player preferred tick per second (midiSpeed*baseSpeed)");
        Comments.commentCommand("ATPS: Actual tick per second (TickBuffer.length)");
        Comments.commentCommand("Sk: timeout notes that skipped playing");
        Comments.commentCommand("B: Beats, shown as measure.beat");
        Comments.commentCommand("P: Player command triggers (for example tempo change events)");
        Comments.commentCommand("Spd: Playing speed (midiSpeed,baseSpeed)");
        Comments.commentCommand("T: Current tick (Tick.tick)");
        Comments.commentCommand("N: Current note (Player.triggers)");
        Comments.commentCommand("L: Player total loops (Player.loops)");
        Comments.commentCommand("NPS: Notes per second (NPSBuffer.length)");
        Comments.commentCommand("TPS: Actual tick per second (Same as ATPS)");
        Comments.commentCommand("Cl: Player time (timer:Player.timer)");
        Comments.commentCommand("Snds: Active note-play instances");
    }

    metadata ReplaceFLPreset_ID_ pos 5820,980;
    private void ReplaceFLPreset_ID_(FLPresetID) { // proccode ReplaceFLPreset ID: %s
        Player.PresetFL.set(FLPresetID, JSON.json_vm_getlist("Player.FLData"));
    }

    metadata onSave pos 5819,1219;
