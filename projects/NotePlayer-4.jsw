    metadata Player.panic pos 5820,-499;
    public void Player.panic() { // hook: broadcast Player.panic
        LogStatic(join("GCl:", join(Sensing.timer(), " CALL Player.panic")));
        Sound.stopAllSounds();
        Player.instances = 0;
        Control.deleteThisClone();
    }

    metadata Player.main pos 3980,-339;
    public void Player.main() { // hook: broadcast Player.main
        LogInternalDebug_Direct("Player.main");
        LogStatic(join("GCl:", join(Sensing.timer(), " CALL Player.main")));
        LogInternalDebug_Direct("Attempt to connect to debug WebSocket ws://127.0.0.1:65432");
        if (Player._enableWS == 1) {
            WebSocket.newInstance("ws://127.0.0.1:65432");
        }
        _isCriticalError = 0;
        Player.debugCustomDisp = "";
        Piano.WSDebugTimeout = -114514;
        Player.instances = 0;
        Player.endValue = 0;
        EnsureModulesExist();
        stopTimer("Player.timer");
        console.clear();
        if (_isCriticalError == 1) {
            Control.stopThisScript();
        }
        if (Player.playMode < 50) {
            BuildPlayer();
        } else {
            ImportFL();
        }
        Control.broadcast("Player.checkIfDisp");
        Control.broadcast("Tick.reset");
        Control.broadcastAndWait("Player.panic");
        Control.broadcast("Player.start");
        while (!(Tick.active == 0)) {
            _lt = Tick.tick;
            if (Sensing.touching("_mouse_") && Sensing.mouseDown()) {
                Looks.switchCostume("true");
            } else {
                Looks.switchCostume(join("F", Player.notes % 12));
            }
            Control.waitUntil(Tick.tick > _lt);
        }
    }

    metadata core.prop pos 6139,-339;
    public void core.prop() { // hook: broadcast core.prop
        _.getProp = "Core of NotePlayer.";
        Comments.commentCommand("NotePlayer4,20");
    }

    metadata Player.timerCheck pos 4699,-180;
    public void Player.timerCheck() { // hook: broadcast Player.timerCheck
        while (1) {
            if (Player.NPSBuffer.length() > Player.highestNPS) {
                Player.highestNPS = Player.NPSBuffer.length();
            }
            while (Timer.getTimer("Player.timer") > Player.NPSBuffer.get(1) + 1) {
                Player.NPSBuffer.delete(1);
            }
        }
    }

