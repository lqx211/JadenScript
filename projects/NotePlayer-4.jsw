            Temp.forEachThreadVariable("_i", Player.Notes.length()) {
                Control.broadcast("Player.updateDebugMenu");
                Player.debugCustomDisp = join("BP 5/6 (NI) ", join(Operators.round(_i / Player.Notes.length() * 1000) / 10, "%"));
                if (JSON.isArray(JSON.arrayGet(_i, JSON.json_vm_getlist("Player.Notes")))) {
