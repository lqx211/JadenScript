    metadata Ticker pos 4700,380;
    private void Ticker() {
        if (Tick.freeze == 0) {
            Tick.tick += 1;
            Player.TickBuffer.insert("last", Timer.getTimer("Player.timer"));
            Control.broadcastAndWait("Player.WSDebug");
            Control.broadcastAndWait("Player.tickerEvent");
        }
        Control.broadcastAndWait("Player.updateDebugMenu");
        Music.restForBeats(1 / 2 ** Tick.wait);
    }

    metadata Events.keyPressed pos 5419,459;
    public void Events.keyPressed(k) { // hook: when [r] key pressed
        Control.broadcast("Player.main");
    }

    metadata Tick.reset pos 4379,499;
    public void Tick.reset() { // hook: broadcast Tick.reset
        Tick.tick = -64;
        Tick.active = 1;
        Control.broadcastAndWait("Player.panic");
        while (Tick.active == 1) {
            Ticker();
        }
    }

    metadata Player.toggleDisp pos 5779,499;
    public void Player.toggleDisp() { // hook: broadcast Player.toggleDisp
        if (Player.dispOptions == 0) {
            Player.dispOptions = 1;
            Player.baseSpeed = Player.baseSpeed / 1.22;
        } else {
            Player.dispOptions = 0;
            Player.baseSpeed = Player.baseSpeed * 1.22;
        }
    }

    metadata Player.tickerEvent pos 5139,540;
    public void Player.tickerEvent() { // hook: broadcast Player.tickerEvent
        if (Player.updatePiano > 0) {
            Piano.draw();
        }
        AutoAdjustPms();
    }

    metadata Events.keyPressed pos 8059,540;
    public void Events.keyPressed(k) { // hook: when [l] key pressed
        Sensing.ask("Enter Preset ID");
        _pi = Sensing.answer();
        Sensing.ask(f"Load PresetFL[{_pi}]; Name:\"{Player.PresetFLName.get(_pi)}\";        Confirm? [y]");
        if (Sensing.answer() == "y") {
            LoadFLPreset_ID_(_pi);
        }
    }

    metadata Player.checkIfDisp pos 5420,620;
    public void Player.checkIfDisp() { // hook: broadcast Player.checkIfDisp
        while (1) {
            if (Player.dispOptions == 1) {
                Variables.showVariable(Player.baseSpeed);
                Variables.showVariable(Player.maxnotes);
                Variables.showVariable(Player.playMode);
                Variables.showVariable(Tick.wait);
                Variables.showVariable(Player.maxPing);
                Variables.showVariable(Player.midiSpeed);
                Variables.showVariable(Player.metronome);
                Variables.showVariable(Tick.freeze);
                Variables.showVariable(Player.playDelay);
                Variables.showVariable(Player.beats2);
                Variables.showVariable(Player.doRepeat);
                Variables.showVariable(Player.synthBeatRestLevel);
                Variables.showVariable(Piano.disableMultiInstr);
                Variables.showVariable(Player.updatePiano);
                Lists.showList(Player.FLData);
                Lists.showList(Player.PresetFLName);
                Lists.showList(Player._Debug);
            } else {
                Variables.hideVariable(Player.baseSpeed);
                Variables.hideVariable(Player.maxnotes);
                Variables.hideVariable(Tick.wait);
                Variables.hideVariable(Player.doRepeat);
                Variables.hideVariable(Player.maxPing);
                Variables.hideVariable(Player.midiSpeed);
                Variables.hideVariable(Player.playDelay);
                Variables.hideVariable(Tick.freeze);
                Variables.hideVariable(Player.metronome);
                Variables.hideVariable(Player.beats2);
                Variables.hideVariable(Player.synthBeatRestLevel);
                Variables.hideVariable(Player.playMode);
                Variables.hideVariable(Piano.disableMultiInstr);
                Variables.hideVariable(Player.updatePiano);
                Lists.hideList(Player.FLData);
                Lists.hideList(Player.PresetFLName);
                Lists.hideList(Player._Debug);
            }
        }
    }

