    metadata Piano.adjustSynthMode pos 7020,5140;
    public void Piano.adjustSynthMode() { // hook: broadcast Piano.adjustSynthMode
        _lsm = Player.synthMode;
        if (Player.synthMode + 1 > Synth.modes.length()) {
            Player.synthMode = 1;
        } else {
            Player.synthMode += 1;
        }
        if (Temp.getRuntimeVariable("_core_adjustSynthMode_isFailback") == 0) {
            Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" Set synth core: ", Synth.modes.get(Player.synthMode)));
        }
        LogStatic(join(join("GCl:", Sensing.timer()), join(" Set synth core: ", Synth.modes.get(Player.synthMode))));
        _.getProp = "None";
        Control.broadcastAndWait(join(Synth.modes.get(Player.synthMode), ".prop"));
        if (_.getProp == "None") {
            if (Temp.getRuntimeVariable("_core_adjustSynthMode_isFailback") == 0) {
                Sound.volume = 100;
                Sound.playSound("Warn");
                Player.debugCustomDisp = f"GCl:{Sensing.timer()} Missing synth module {Synth.modes.get(Player.synthMode)}";
            }
            Player.loggerL += 1;
            LogError(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} {Synth.modes.get(Player.synthMode)} does not exist");
            if (Temp.getRuntimeVariable("_core_adjustSynthMode_isFailback") == 0) {
                Control.wait(1);
                Player.debugCustomDisp = f"GCl:{Sensing.timer()} Press \"see inside\" and upload sprite \"{Synth.modes.get(Player.synthMode)}.sprite3\"";
                Control.wait(1);
                LogWarning(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} Finding another synth module...");
            }
            Player.loggerL += 1;
            AdjustSynthMode_isFailback_(1);
            Control.stopThisScript();
        } else {
            Control.wait(1);
            Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" Synth Prop: ", _.getProp));
        }
        Control.wait(2);
        Player.debugCustomDisp = "";
    }

