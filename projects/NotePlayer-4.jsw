    metadata Player.start pos 5859,2420;
    public void Player.start() { // hook: broadcast Player.start
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "Player.start"));
        Player.loggerL = 0;
        Tick.active = 1;
        stopTimer("Player.timer");
        LogStatic(join(join("==[ New Player Instance at GCl:", Sensing.timer()), " ]========"));
        LogStatic(join("NotePlayer4,", join(Player.version, " by GitHub @lqx211, All rights reserved")));
        Player.totalNotes = Player.NotesData.length();
        Comments.commentCommand("The buffer system is going to kill me :(");
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "Piano.recalc ..."));
        Comments.commentC("Call some functions") {
            Control.broadcastAndWait("Piano.recalc");
            Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "Piano.draw ..."));
            Piano.draw();
        }
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "DSN ..."));
        Comments.commentC("Display song name if equiped item from PresetFL[n]") {
            if (Comments.commentBoolean("Load from FastLoad database?", Player.playMode > 49)) {
                LogStatic(f"May loaded from FastLoad database, Guessed Idx:{Player.guessedFLIdx} Name:\"{Player.PresetFLName.get(Player.guessedFLIdx)}\"");
            } else {
                LogStatic("Not loading from FastLoad database.");
            }
        }
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "DSD ..."));
        Comments.commentC("Display song details") {
            LogStatic("----- Details");
            LogStatic(join("Total notes: ", join(Player.totalNotes, " notes")));
            LogStatic(join("Player note rate limit: ", join(Player.maxnotes, " notes per second")));
            LogStatic(join("Player note timeout limit: ", join(Player.maxPing, " ticks")));
            LogStatic(join("Selected synth module: ", Synth.modes.get(Player.synthMode)));
        }
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "CCM ..."));
        Comments.commentC("Check for configuration mistakes") {
            Comments.commentCommand(Comments.commentBoolean("Hey, you can't even run this project without TurboWarp", block("argument_reporter_boolean", "VALUE", "is TurboWarp?")));
            if (!block("argument_reporter_boolean", "VALUE", "is compiled?")) {
                LogWarning("You are executing code without the compiled flag. This may affect performace.");
            }
            if (!Runtime.turboMode()) {
                LogWarning("Turbo mode is disabled. This will make player unstable and cause extreme lags.");
            }
            if (Runtime.framerateLimit() < 60) {
                LogWarning("Framerate limit is less than 60. This may affect player performance.");
            }
            if (Runtime.cloneLimit() != "Infinity") {
                LogWarning(join("Clone limit is finite.", "This may cause playing issues in black MIDIs."));
            }
            LogStatic(f"[Env] Turbo:{(1) if (Runtime.turboMode()) else (0)} FramerateLimit:{Runtime.framerateLimit()} InfiniteClone:{(1) if (Runtime.cloneLimit() == "Infinity") else (0)}");
            LogStatic(f"[Env] Window x:{Runtime.stageWidth()} y:{Runtime.stageWidth()} online:{(1) if (Sensing.isOnline()) else (0)} volume:{Sound.volume * .01}");
            LogStatic(f"[Twrp] compiled:{(1) if (block("argument_reporter_boolean", "VALUE", "is compiled?")) else (0)} isTwrp:{(1) if (block("argument_reporter_boolean", "VALUE", "is TurboWarp?")) else (0)}");
        }
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "Start clock"));
        LogStatic("----- Player clock started");
        Player.NPSBuffer.clear();
        Player.TickBuffer.clear();
        Control.broadcast("Player.timerCheck");
        Player.timerCreated = 0;
        Tick.wait = 4;
        Player.loops = 0;
        Player.skips = 0;
        Player.triggers = 0;
        Player.totalAlmostTimeouts = 0;
        Player.notes = 0;
        Player.npsCounter = 0;
        Player.lastTimeoutTick = 0;
        Player.nps = 0;
        Player.pcmd = 1;
        Player.highestNPS = 0;
        _lt2 = Tick.tick + -1;
        _isInitialDialogClosed = 0;
        Player.beats = -4;
        Player.endValue = Player.NotesData.length();
        Comments.commentC("Preset: START") {
            if (Player.doSetCustomInitValues == 1) {
                Player.endValue = Player.customEndValue;
                Player.notes = Player.customStartNoteID;
                Tick.tick = Player.customStartTick;
            }
        }
        Comments.commentC("Other functions and scripts") {
            LogStatic(join(join("GCl:", Sensing.timer()), " initialize lyrics system"));
            Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "Initialize lyrics system"));
            Control.broadcastAndWait("Lyrics.init");
            Control.broadcast("Lyrics.start");
        }
        LogStatic(join(join("GCl:", Sensing.timer()), " Player.start init success"));
        Player.debugCustomDisp = join(join("GCl:", Sensing.timer()), join(" ", "Player.start init success"));
        Control.wait(.1);
        LogStatic(join(join("GCl:", Sensing.timer()), " world.execute(me) with NP4,26b core."));
        Player.debugCustomDisp = "world.execute(me) with NP4,26b core by GitHub @lqx211, all rights reserved";
        while (1) {
            _lt = Tick.tick;
            Player.loops += 1;
            Music.setTempo(Player.midiSpeed * Player.baseSpeed);
            if (Player.notes - 1 > Player.endValue && Tick.enableReverseTicking == 0) {
                if (Player.doRepeat == 0) {
                    LogStatic("----- Player stopping");
                    Player.debugCustomDisp = "Player stopping";
                    stopTimer("Player.timer");
                    Tick.active = 0;
                    Control.stopThisScript();
                } else {
                    LogStatic("----- Player repeat");
                    Player.debugCustomDisp = "Player repeating";
                    stopTimer("Player.timer");
                    Tick.active = 0;
                    Control.wait(1);
                    Control.broadcastAndWait("Player.main");
                    Control.stopThisScript();
                }
            }
            Comments.commentC("Start timer on time") {
                if (Tick.tick > -1 && Player.timerCreated == 0) {
                    Player.timerCreated = 1;
                    Timer.startTimer("Player.timer");
                    startTimer("Player.timer");
                }
            }
            Comments.commentC("Debug logs and test scripts") {
                LogDebug(join(Player._Debug.get(1), join(" ", Player._Debug.get(2))));
                if (Tick.tick > 0 && _isInitialDialogClosed == 0) {
                    Player.debugCustomDisp = "";
                    _isInitialDialogClosed = 1;
                }
            }
            Comments.commentC("Metronome Tick Count System") {
                if (Tick.tick > _lt2 + Player.beatReady + 15) {
                    _lt2 = Tick.tick - Player.beatReady;
                    _mtcsok = 1;
                    Player.beats += 1;
                }
            }
            Comments.commentC("Metronome Sound Play System") {
                if (Player.metronome == 1 && _mtcsok == 1) {
                    if (Player.beats % Player.beats2 == 0) {
                        Sound.playSound("MetronomeEffect2");
                    } else {
                        Sound.playSound("MetronomeEffect1 ");
                    }
                }
            }
            _mtcsok = 0;
            Comments.commentC("PCmd") {
                Comments.commentCommand("PCmd(1): PCmd, Tick, midiSpeed");
                Comments.commentCommand("PCmd(2): PCmd, Tick, tickWait(Tick.wait)");
                Comments.commentCommand("PCmd(3): PCmd, Tick, beatsPerMeasure(Player.beats2)");
                if (JSON.arrayGet(1, Player.NotesCommand.get(Player.pcmd)) == 1) {
                    if (Tick.tick > JSON.arrayGet(2, Player.NotesCommand.get(Player.pcmd)) || Tick.tick == JSON.arrayGet(2, Player.NotesCommand.get(Player.pcmd))) {
                        Player.loggerL += 1;
                        Player.midiSpeed = JSON.arrayGet(3, Player.NotesCommand.get(Player.pcmd));
                        LogStatic(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} P:{Player.pcmd} midiSpeed={Player.midiSpeed}");
                        Player.pcmd += 1;
                    }
                } elif (JSON.arrayGet(1, Player.NotesCommand.get(Player.pcmd)) == 2) {
                    if (Tick.tick > JSON.arrayGet(2, Player.NotesCommand.get(Player.pcmd)) || Tick.tick == JSON.arrayGet(2, Player.NotesCommand.get(Player.pcmd))) {
                        Tick.wait = JSON.arrayGet(3, Player.NotesCommand.get(Player.pcmd));
                        Player.loggerL += 1;
                        LogStatic(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} tick.wait={Tick.wait}");
                    }
                } elif (JSON.arrayGet(1, Player.NotesCommand.get(Player.pcmd)) == 3) {
                    Player.loggerL += 1;
                    if (Tick.tick > JSON.arrayGet(2, Player.NotesCommand.get(Player.pcmd)) || Tick.tick == JSON.arrayGet(2, Player.NotesCommand.get(Player.pcmd))) {
                        Player.beats2 = JSON.arrayGet(3, Player.NotesCommand.get(Player.pcmd));
                    }
                    LogStatic(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick}beats2={Player.beats2}");
                } else {
                    Comments.commentCommand("nothing");
                }
            }
            Comments.commentC("Check for lags") {
                Temp.setRuntimeVariable("_Player_ptps", 1 / (60 / (Player.midiSpeed * Player.baseSpeed) * (1 / 2 ** Tick.wait)));
                Temp.setRuntimeVariable("_Player_atps", Player.TickBuffer.length());
                if (Temp.getRuntimeVariable("_Player_ptps") / Temp.getRuntimeVariable("_Player_atps") > 2 && Tick.tick > 0 && Timer.getTimer("Player.timer") > Temp.getRuntimeVariable("_Player_lastLaggyLog") + 2) {
                    Temp.setRuntimeVariable("_Player_lastLaggyLog", Timer.getTimer("Player.timer"));
                    Player.loggerL += 1;
                    LogWarning(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} Player is laggy (Low ATPS)");
                }
            }
            if (Comments.commentBoolean("Timeout", Tick.tick > Player.NotesPlayTick.get(Player.notes + 1) + Player.maxPing && Tick.tick - (Player.NotesPlayTick.get(Player.notes + 1) + 1) != Tick.tick - 1)) {
                Player.skips += 1;
                Player.notes += 1;
                Player.loggerL += 1;
                LogError(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} Note timeout for {Player.maxPing} ticks");
            } elif (Comments.commentBoolean("Too many notes", Player.NPSBuffer.length() == Player.maxnotes || Player.NPSBuffer.length() > Player.maxnotes)) {
                Player.skips += 1;
                Player.notes += 1;
                Player.loggerL += 1;
                LogError(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} Reached note rate limit");
            }
            if (Comments.commentReporter("Suitable", Tick.tick > Player.NotesPlayTick.get(Player.notes) || Tick.tick == Player.NotesPlayTick.get(Player.notes))) {
                if (Comments.commentBoolean("Timeout (1t)", Tick.tick > Player.NotesPlayTick.get(Player.notes + 1) + 1)) {
                    Player.loggerL += 1;
                    Player.totalAlmostTimeouts += 1;
                    Player.lastTimeoutTick = Tick.tick - (Player.NotesPlayTick.get(Player.notes + 1) + 1);
                    LogWarning(f"{Player.loggerL}/GCl:{Sensing.timer()} Cl:{Timer.getTimer("Player.timer")} T:{Tick.tick} Note almost timeout: {Tick.tick - (Player.NotesPlayTick.get(Player.notes + 1) + 1)} ticks");
                }
                Player.id = Player.notes - 0;
                Player.notes += 1;
                Player.npsCounter += 1;
                Player.tmpB = Player.notes;
                Player.NPSBuffer.add(Timer.getTimer("Player.timer"));
                Control.createClone(Synth.modes.get(Player.synthMode));
            } else {
                Control.waitUntil(Tick.tick > _lt || Tick.enableReverseTicking == 1);
                if (Tick.enableReverseTicking == 1) {
                    _lt = 0;
                }
            }
        }
    }

