    metadata ReverseTicks_Ticks_ pos 6140,300;
    private void ReverseTicks_Ticks_(Ticks) { // proccode ReverseTicks Ticks: %s
        Comments.commentCommand("Extremely buggy, will increase missed notes");
        Control.broadcastAndWait("Player.enableReverseTicking");
        Tick.tick += Ticks * -1;
        Player.notes = -1;
        Control.broadcastAndWait("Player.disableReverseTicking");
    }

