    private void Escaped_Key_Event(terminator, argument) { // proccode Escaped Key Event %s %s // warp
        Terminal.inputBuffer.add(27);
        Terminal.inputBuffer.add(91);
        for (i=1, i<=Operators.length(argument), i++) {
            Terminal.inputBuffer.add(Operators.letterOf(i, argument) + 48);
        }
        Terminal.inputBuffer.add(terminator);
    }

