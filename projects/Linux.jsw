stage: costume=0, volume=100, layer=0, tempo=60, video="on", videoTransparency=50;
stage {
    import "assets/2cad5629a7f5460b9df1aae292b686bb.svg" as ""; // costume centerx=703.2254347370629 centery=554.9999999999998 res=1

    

    metadata Stage.startFrameCounter pos 539,64;
    public void Stage.startFrameCounter() { // hook: broadcast Stage.startFrameCounter
        while (1) {
            Global.frameIndex += 1;
        }
    }

    metadata greenFlag pos 107,94;
    public void greenFlag() {
        Global.frameIndex = 0;
        Control.broadcast("Stage.startFrameCounter");
        if (block("argument_reporter_boolean", "VALUE", "is compiled?")) {
            Global.detectScreenSize();
        } else {
            Global.stageWidth = 480;
            Global.stageHeight = 360;
        }
        Terminal.reset();
        Control.broadcast("Terminal.run");
        RISCV.powerOn();
        call RISCV.run();
    }
}

