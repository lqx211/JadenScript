    private void temporal_lerp_state_(edit_state, bool_state, min, max, speed) { // at 1957,1681 // proccode temporal lerp state: %s following bool: %s limits (0-1): %s %s speed: %s
        if (game states values.get(bool_state)) {
            if (game states values.get(edit_state) != max) {
                if (game states values.get(edit_state) > max) {
                    game states values.set(edit_state, game states values.get(edit_state) - dt * speed);
                    if (game states values.get(edit_state) < max) {
                        game states values.set(edit_state, max);
                    }
                } else {
                    game states values.set(edit_state, game states values.get(edit_state) + dt * speed);
                    if (game states values.get(edit_state) > max) {
                        game states values.set(edit_state, max);
                    }
                }
            }
        } elif (game states values.get(edit_state) != min) {
            if (game states values.get(edit_state) > min) {
                game states values.set(edit_state, game states values.get(edit_state) - dt * speed);
                if (game states values.get(edit_state) < min) {
                    game states values.set(edit_state, min);
                }
            } else {
                game states values.set(edit_state, game states values.get(edit_state) + dt * speed);
                if (game states values.get(edit_state) > min) {
                    game states values.set(edit_state, min);
                }
            }
        }
    }

