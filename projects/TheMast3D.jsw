    }

    private void add_bounding_box(name, viz, x1, y1, z1, x2, y2, z2) { // at 3852,2422 // proccode add bounding box %s %s | %s %s %s %s %s %s
        __("name, viz (will be modified dynamically)");
        bounding boxes.add(name);
        bounding boxes.add(viz == 1);
        __("-xyz, +xyz");
        bounding boxes.add(x1);
        bounding boxes.add(y1);
        bounding boxes.add(z1);
        bounding boxes.add(x2);
        bounding boxes.add(y2);
        bounding boxes.add(z2);
        __("8: x,y,z,radius");
        bounding boxes.add((x2 + x1) / 2);
        bounding boxes.add((y2 + y1) / 2);
        bounding boxes.add((z2 + z1) / 2);
        bounding boxes.add(Operators.math("sqrt", 0.5 * ((x2 - x1) * (x2 - x1)) + (0.5 * ((y2 - y1) * (y2 - y1)) + 0.5 * ((z2 - z1) * (z2 - z1)))));
        bounding boxes.add("_tri start");
        bounding boxes.add("_tri repeat");
        bounding boxes.add("_vert start");
        bounding boxes.add("_vert repeat");
    }

    private void BB(i, val) { // at 3134,2429
        if (val < bounds_temp.get(i)) {
            bounds_temp.set(i, val);
        } elif (val > bounds_temp.get(i + 3)) {
            bounds_temp.set(i + 3, val);
        }
    }

    private void load_BB_start_(i_start, i_end, name) { // at 2556,2510 // proccode load BB start: %s end: %s subname: %s // warp
        if (i_end > f.length()) {
            warn(join("i end too high: ", i_end));
            return;
        }
        __("find bounds of verts -xyz,+xyz");
        __("this is inefficient");
        bounds_temp.clear();
        bounds_temp.add(1 / "");
        bounds_temp.add(1 / "");
        bounds_temp.add(1 / "");
        bounds_temp.add(-1 / "");
        bounds_temp.add(-1 / "");
        bounds_temp.add(-1 / "");
        line_index = i_start;
        repeat ((i_end - i_start) / 10) {
            BB(1, 1 * v_x.get(f.get(line_index + 1)));
            BB(2, -1 * v_z.get(f.get(line_index + 1)));
            BB(3, 1 * v_y.get(f.get(line_index + 1)));
            BB(1, 1 * v_x.get(f.get(line_index + 4)));
            BB(2, -1 * v_z.get(f.get(line_index + 4)));
            BB(3, 1 * v_y.get(f.get(line_index + 4)));
            BB(1, 1 * v_x.get(f.get(line_index + 7)));
            BB(2, -1 * v_z.get(f.get(line_index + 7)));
            BB(3, 1 * v_y.get(f.get(line_index + 7)));
            line_index += 10;
        }
        __("put data into bounding boxes list");
        add_bounding_box(name, 1, bounds_temp.get(1), bounds_temp.get(2), bounds_temp.get(3), bounds_temp.get(4), bounds_temp.get(5), bounds_temp.get(6));
    }

    private void set_bounding_box_range() { // at 944,3213 // proccode set bounding box range // warp
        i = 0;
        repeat (bounding boxes.length() / 16) {
            temp1 = tris_directory.indexOf(bounding boxes.get(i + 1));
            bounding boxes.set(i + 13, tris_directory.get(1 + temp1));
            bounding boxes.set(i + 14, (tris_directory.get(3 + temp1) - tris_directory.get(1 + temp1)) / 14);
            bounding boxes.set(i + 15, verts_directory.get(1 + temp1));
            bounding boxes.set(i + 16, (verts_directory.get(3 + temp1) - verts_directory.get(1 + temp1)) / 3);
            i += 16;
        }
    }

    private void FL_LS(x1, y1, z1, x2, y2, z2) { // at 1474,3841 // proccode FL LS %s %s %s , %s %s %s // warp
        boundary_index = boundaries.indexOf(f"{x1}{y1}{z1}{x2}{y2}{z2}");
        if (boundary_index > 0) {
            boundaries.set(1 + boundary_index, 1 + boundaries.get(1 + boundary_index));
        } else {
            boundary_index = boundaries.indexOf(f"{x2}{y2}{z2}{x1}{y1}{z1}");
            if (boundary_index > 0) {
                boundaries.set(1 + boundary_index, 1 + boundaries.get(1 + boundary_index));
            } else {
                boundaries.add(f"{x1}{y1}{z1}{x2}{y2}{z2}");
                boundaries.add(1);
                boundaries.add(x1);
                boundaries.add(y1);
                if (z1 > z2) {
                    boundaries.add(z1 + 1);
                } else {
                    boundaries.add(z1 - 1);
                }
                boundaries.add(x2);
                boundaries.add(y2);
                if (z1 > z2) {
                    boundaries.add(z2 - 1);
                } else {
                    boundaries.add(z2 + 1);
                }
                __("bounding circle");
                boundaries.add((x1 + x2) / 2);
                boundaries.add((y1 + y2) / 2);
                boundaries.add(3 * wall_dist + Operators.math("sqrt", 0.25 * ((x1 - x2) * (x1 - x2)) + 0.25 * ((y1 - y2) * (y1 - y2))));
                boundaries.add(boundaries.get("last") * boundaries.get("last"));
            }
        }
    }

    private void generate_boundary_line_segments() { // at -584,4458 // proccode generate boundary line segments // warp
        boundaries.clear();
        i = 2;
        repeat (floor tris.length() / 14) {
            FL_LS(floor tris.get(1 + i), floor tris.get(2 + i), floor tris.get(3 + i), floor tris.get(4 + i), floor tris.get(5 + i), floor tris.get(6 + i));
            FL_LS(floor tris.get(4 + i), floor tris.get(5 + i), floor tris.get(6 + i), floor tris.get(7 + i), floor tris.get(8 + i), floor tris.get(9 + i));
            FL_LS(floor tris.get(7 + i), floor tris.get(8 + i), floor tris.get(9 + i), floor tris.get(1 + i), floor tris.get(2 + i), floor tris.get(3 + i));
            i += 14;
        }
        i = 1;
        repeat (boundaries.length() / 12) {
            if (boundaries.get(1 + i) > 1) {
                repeat (12) {
                    boundaries.delete(i);
                }
            } else {
                i += 12;
            }
        }
    }

