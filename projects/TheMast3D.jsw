    private void load_region_geometry_from_obj_file(region_name) { // at -562,1331 // proccode load region geometry from obj file %s // warp
        __("THIS IS WHERE THE REGION GEOMETRY IS LOADED");
        __("[region name],[fl/vz/dy],[room or object name(if not fl)],[bbox (if vz)]");
        verts.clear();
        seen_vertex_indices.clear();
        tris.clear();
        floor tris.clear();
        verts extra data.clear();
        bounding boxes.clear();
        tris_directory.clear();
        verts_directory.clear();
        __("detect if saves break");
        limits.clear();
        limits.add(1 / "");
        limits.add(-1 / "");
        limits.add("" / "");
        limits.add("" + "");
        __("iterate over directory to find geo to load");
        i = 0;
        repeat (obj_directory.length() / 4) {
            if (Operators.contains(obj_directory.get(i + 2), region_name)) {
                split_line(obj_directory.get(i + 2), ",");
                __("actually make sure the region name is correct:");
                if (region_name == split_line.get(1)) {
                    if (__dev == 1) {
                        if ("") {
                            log(obj_directory.get(i + 2));
                        }
                    }
                    if (split_line.get(2) == "FL") {
                        load_FL_start_(obj_directory.get(i + 4), obj_directory.get(4 + i + 4));
                    } elif (split_line.get(2) == "VZ") {
                        if (split_line.get(4) == "BB") {
                            load_BB_start_(obj_directory.get(i + 4), obj_directory.get(4 + i + 4), split_line.get(3));
                        } else {
                            load_VZ_start_(obj_directory.get(i + 4), obj_directory.get(4 + i + 4), 0, split_line.get(3));
                            if (split_line.get(3) == "") {
                                __("main room (no subname) will always be visible");
                                add_bounding_box("", 1, -1 / "", -1 / "", -1 / "", 1 / "", 1 / "", 1 / "");
                            }
                        }
                    } elif (split_line.get(2) == "DY") {
                        load_VZ_start_(obj_directory.get(i + 4), obj_directory.get(4 + i + 4), 1, split_line.get(3));
                        add_bounding_box(split_line.get(3), 1, -1 / "", -1 / "", -1 / "", 1 / "", 1 / "", 1 / "");
                    } else {
                        warn("unknown geometry");
                    }
                }
            }
            i += 4;
        }
        __("just in case (for objects with no subname)");
        tris_directory.add("");
        tris_directory.add(tris.length());
        verts_directory.add("");
        verts_directory.add(verts.length());
