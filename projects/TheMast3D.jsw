    private void LS_intersection__(p1x, p1y, p2x, p2y, p3x, p3y, p4x, p4y) { // at 4009,2026 // proccode LS intersection | %s %s %s %s | %s %s %s %s // warp
        d = (p1x - p2x) * (p3y - p4y) - (p1y - p2y) * (p3x - p4x);
        if (d == 0) {
            x = "";
            y = "";
        } else {
            u = (p1x - p3x) * (p1y - p2y) - (p1y - p3y) * (p1x - p2x);
            if (u > 0 && u < d) {
                v = (p1x - p3x) * (p3y - p4y) - (p1y - p3y) * (p3x - p4x);
                if (v > 0 && v < d) {
                    x = p3x + u / d * (p4x - p3x);
                    y = p3y + u / d * (p4y - p3y);
                } else {
                    x = "";
                    y = "";
                }
