    public void greenFlag() { // at 298,-114
        if (reset_game_ == 1) {
            region = "pod";
            Control.broadcastAndWait("reset all");
            __("reset flag here");
            reset_game_ = 0;
            Control.stopAll();
        }
        last_time = Sensing.daysSince2000();
        Looks.switchCostume("icon");
        reset_vars();
        Control.broadcast("! initalise");
        check_reload();
        last_time = 0;
        while (1) {
            if (scanning_in_progress_ == 0) {
                _3D__This_Frame = (_3D__This_Frame + 1) % 256;
                dt = 86400 * (Sensing.daysSince2000() - last_time);
                FPS = Operators.round(1 / dt);
                if (dt > 20 * target_dt) {
                    dt = 20 * target_dt;
                }
                last_time = Sensing.daysSince2000();
                f = 1 / Operators.math("tan", FOV / 2);
                Pen.eraseAll();
                Control.broadcast("movement");
                Control.broadcast("update camera data");
                Control.broadcast("update dynamic geometry");
                Control.broadcast("constrain camera");
                Control.broadcast("handle bounding boxes");
                Control.broadcast("project verts");
                Control.broadcast("render sky");
                Control.broadcast("render world");
                Control.broadcast("render tags");
                Control.broadcast("draw bars overlay");
                Control.broadcast("render document");
                Control.broadcast("render document text");
                Control.broadcast("draw text");
                Control.broadcast("draw overlay");
            }
        }
    }

