    public void scan_full_res_textures() { // at 5225,1311 // hook: broadcast scan full-res textures
        __("run the image scanner for all the costumes");
        __("parameters are hard-coded here");
        loading_info_2 = "DO NOT TOUCH THE GAME OR CHANGE WINDOW,";
        loading_info_3 = "DOING SO MAY CORRUPT THE DATA!";
        scanning_in_progress_ = 1;
        Variables.showVariable(loading_info_1);
        Variables.showVariable(loading_info_2);
        Variables.showVariable(loading_info_3);
        chunk_count = 22 + 1;
        compressed_image = "";
        for (i=1, i<=chunk_count, i++) {
            Pen.eraseAll();
            draw_progress_bar(i - 1, chunk_count);
            loading_info_1 = join(join("Scanning images... (", Operators.round(100 * ((i - 1) / chunk_count))), "%). Please wait.");
            scan_costume(join("data", i - 1), 460, 340);
            Control.wait(0);
            save_img_data_chunk();
            if (scan_sum != scan_checksums.get(i)) {
                log(join(join(scan_sum, ", "), scan_checksums.get(i)));
                data_corrupt();
            }
        }
        scanning_in_progress_ = 0;
        Variables.hideVariable(loading_info_1);
        Variables.hideVariable(loading_info_2);
        Variables.hideVariable(loading_info_3);
        scanner__img.clear();
        separate_compressed_textures_from_string_(compressed_image);
        compressed_image = "";
        Control.wait(0);
        Control.broadcast("start game");
    }

    public void load_half_res_textures() { // at 4540,1320 // hook: broadcast load half-res textures
        __("copy from SMALL TEXTURES list");
        copy_low_res_textures();
        Control.wait(0);
        Control.broadcast("start game");
    }

    public void scanner__finished() { // at 8951,1401 // hook: broadcast scanner: finished
        Pen.eraseAll();
        Looks.switchCostume("icon");
        Motion.setXY(0, 0);
    }

    private void copy_low_res_textures() { // at 4538,1634 // proccode copy low res textures // warp
        compressed textures.clear();
        for (i=1, i<=SMALL_TEXTURES.length(), i++) {
            compressed textures.add(SMALL_TEXTURES.get(i));
        }
    }

    private void save_img_data_chunk() { // at 6386,1995 // proccode save img data chunk // warp
        scan_sum = 0;
        __("2 chars per px");
        for (idx=1, idx<=scanner__img.length(), idx++) {
            col = scanner__img.get(idx);
            binary = bin_lookup_5.get(1 + Operators.math("floor", Operators.math("floor", col / 65536) / 8));
            binary = join(binary, bin_lookup_5.get(1 + Operators.math("floor", Operators.math("floor", col / 256 % 256) / 8)));
            binary = join(binary, bin_lookup_4.get(1 + Operators.math("floor", col % 256 / 16)));
            scan_sum += join("0b", binary);
            char = ascii_lookup.get(1 + Operators.math("floor", join("0b", binary) / 128));
            if (char == "") {
                data_corrupt();
            }
            compressed_image = join(compressed_image, char);
            char = ascii_lookup.get(1 + join("0b", binary) % 128);
            if (char == "") {
                data_corrupt();
            }
            compressed_image = join(compressed_image, char);
        }
    }

