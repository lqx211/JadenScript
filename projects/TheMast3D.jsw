    private void separate_compressed_textures_from_string_(data) { // at 5609,-5 // proccode separate compressed textures from string: %s // warp
        __("takes a list of items separated by spaces and adds them to the compressed textures list");
        str = "";
        compressed textures.clear();
        for (i=1, i<=Operators.length(data), i++) {
            if (Operators.letterOf(i, data) == " ") {
                compressed textures.add(str);
                str = "";
            } else {
                str = join(str, Operators.letterOf(i, data));
            }
        }
        if (Operators.length(str) > 0) {
            compressed textures.add(str);
            str = "";
        }
    }

    public void __initalise() { // at 4553,21 // hook: broadcast ! initalise
        Looks.hide();
        Looks.switchCostume("icon");
        scanning_in_progress_ = 0;
        Variables.hideVariable(loading_info_1);
        Variables.hideVariable(loading_info_2);
        Variables.hideVariable(loading_info_3);
    }

    private void scanner__edge_case() { // at 8530,158 // proccode scanner: edge case // warp
        offB = -16;
        repeat (4) {
            offG = -8;
            repeat (4) {
                offR = -8;
                repeat (4) {
                    if (!((offR == 0 || offR == 8) && ((offG == 0 || offG == 8) && (offB == 0 || offB == 16)))) {
                        if (0 /* sensing_touchingcolor */) {
                            scanner__img.set(idx, mul * (col + 65536 * offR + (256 * offG + offB)));
                            scanner__cache.add(65536 * offR + (256 * offG + offB));
                            return;
                        }
                    }
                    offR += 8;
                }
                offG += 8;
            }
            offB += 16;
        }
    }

    public void custom_texture_loader() { // at 6157,193 // hook: broadcast custom texture loader
        Sensing.ask("");
        if (Operators.length(Sensing.answer()) > 10) {
            separate_compressed_textures_from_string_(Sensing.answer());
            if (viewed_document == "custom textures") {
                Control.broadcast("start game");
            }
        }
        viewed_document = "";
    }

    public void reset_all() { // at 4564,464 // hook: broadcast reset all
        str = "";
        compressed_image = "";
        scanner__img.clear();
        scanner__cache.clear();
        if (reset_game_ != 1) {
            __("when the player resets the game they shouldn't lose their textures");
            compressed textures.clear();
        }
        scanning_in_progress_ = 0;
        Variables.hideVariable(loading_info_1);
        Variables.hideVariable(loading_info_2);
        Variables.hideVariable(loading_info_3);
        Looks.switchCostume("icon");
    }

    private void data_corrupt() { // at 7164,1057 // proccode data corrupt
        log("data corruption");
        loading_info_1 = "DATA CORRUPTION DETECTED... PROJECT STOPPED";
        loading_info_2 = "Press the green flag to retry.";
        loading_info_3 = "";
        Variables.hideVariable(loading_info_3);
        Pen.eraseAll();
        // unsupported stop: other scripts in sprite
        Sound.playSoundUntilDone("653813__eilassfx__error");
        Control.stopAll();
    }

    private void scan_costume(name, width, height) { // at 6645,1212 // proccode scan costume %s size %s %s
        Motion.setXY(0, 0);
        Looks.switchCostume(name);
        Looks.size = 100;
        // unsupported block: looks_cleargraphiceffects
        Pen.stamp();
        Control.createClone("_myself_");
        Control.wait(0);
        // unsupported block: looks_gotofrontback
        scan_with_bounds_(width / -2, height / -2, width / 2, height / 2, 1);
    }

