    private void _return_x__return_y____LS_repulsion___PT_(x, y, x1, y1, x2, y2, radius) { // at 4912,503 // proccode (return x)(return y) = LS repulsion | PT: %s %s LS: %s %s %s %s radius: %s
        len = Operators.math("sqrt", (x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
        h = ((x2 - x1) * (x - x1) + (y - y1) * (y2 - y1)) / (len * len);
        if (h < 0) {
            dist_to_line = Operators.math("sqrt", (x - x1) * (x - x1) + (y - y1) * (y - y1));
            if (dist_to_line < radius) {
                return_x = x1 + (x - x1) * (radius / dist_to_line);
                return_y = y1 + (y - y1) * (radius / dist_to_line);
            } else {
                return_x = x;
                return_y = y;
            }
        } elif (h > 1) {
            dist_to_line = Operators.math("sqrt", (x - x2) * (x - x2) + (y - y2) * (y - y2));
            if (dist_to_line < radius) {
                return_x = x2 + (x - x2) * (radius / dist_to_line);
                return_y = y2 + (y - y2) * (radius / dist_to_line);
            } else {
                return_x = x;
                return_y = y;
            }
        } else {
            dist_to_line = ((x2 - x1) * (y1 - y) - (x1 - x) * (y2 - y1)) / len;
            if (Operators.math("abs", dist_to_line) < radius) {
                if (dist_to_line < 0) {
                    return_x = x - (y1 - y2) / len * (Operators.math("abs", dist_to_line) - radius);
                    return_y = y - (x2 - x1) / len * (Operators.math("abs", dist_to_line) - radius);
                } else {
                    return_x = x + (y1 - y2) / len * (Operators.math("abs", dist_to_line) - radius);
                    return_y = y + (x2 - x1) / len * (Operators.math("abs", dist_to_line) - radius);
                }
            } else {
                return_x = x;
                return_y = y;
            }
        }
    }

