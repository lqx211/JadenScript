    private void _OVERWRITE__clean_WORLD_obj() { // at 6763,-128 // proccode [OVERWRITE] clean WORLD.obj // warp
        __("script cleans up the list so it is smaller");
        log(Operators.length(WORLD_obj));
        __("used as a cache:");
        v_x.clear();
        v_y.clear();
        vt_u.clear();
        vt_v.clear();
        vn_x.clear();
        vn_y.clear();
        for (line_index=1, line_index<=WORLD_obj.length(), line_index++) {
            split_line(WORLD_obj.get(line_index), " ");
            if (split_line.get(1) == "v") {
                WORLD_obj.set(line_index, f"v {Operators.round(split_line.get(2) * 10000) / 10000} {Operators.round(split_line.get(3) * 10000) / 10000} {Operators.round(split_line.get(4) * 10000) / 10000}");
                v_x.add(WORLD_obj.get(line_index));
            } elif (split_line.get(1) == "vt") {
                WORLD_obj.set(line_index, join(join(join("vt ", Operators.round(split_line.get(2) * 1000) / 1000), " "), Operators.round(split_line.get(3) * 1000) / 1000));
                vt_u.add(WORLD_obj.get(line_index));
            } elif (split_line.get(1) == "vn") {
                WORLD_obj.set(line_index, f"vn {Operators.round(split_line.get(2) * 10000) / 10000} {Operators.round(split_line.get(3) * 10000) / 10000} {Operators.round(split_line.get(4) * 10000) / 10000}");
                vn_x.add(WORLD_obj.get(line_index));
            } elif (split_line.get(1) == "o") {
                dynamic_ = Operators.round(Operators.contains(WORLD_obj.get(line_index), ",DY"));
                if ("") {
                    log("stop");
                    return;
                }
            }
        }
        log(Operators.length(WORLD_obj));  // logged twice in the original project
        if (!"") {
            v_x.clear();
            vt_u.clear();
            vn_x.clear();
        }
    }

