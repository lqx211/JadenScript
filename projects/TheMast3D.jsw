    private void controls() { // at -280,-495
        movement_speed = 12;
        if (keymap options.get(__controls__run_) == "Shift (turbowarp only)") {
            if (Sensing.keyPressed("shift")) {
                movement_speed = 20;
            }
        } elif (keymap options.get(__controls__run_) == "Control (turbowarp only)") {
            if (Sensing.keyPressed("control")) {
                movement_speed = 20;
            }
        } elif (keymap options.get(__controls__run_) == "Space") {
            if (Sensing.keyPressed("space")) {
                movement_speed = 20;
            }
        } elif (keymap options.get(__controls__run_) == "Click") {
            if (Sensing.mouseDown()) {
                movement_speed = 20;
            }
        }
        if (keymap options.get(__controls__move_) == "WASD") {
            vec_x = Sensing.keyPressed("d") - Sensing.keyPressed("a");
            vec_y = Sensing.keyPressed("w") - Sensing.keyPressed("s");
        } elif (keymap options.get(__controls__move_) == "Arrow Keys") {
            vec_x = Sensing.keyPressed("right arrow") - Sensing.keyPressed("left arrow");
            vec_y = Sensing.keyPressed("up arrow") - Sensing.keyPressed("down arrow");
        } else {
            vec_x = 0;
            vec_y = 0;
        }
        vec_len = Operators.math("sqrt", vec_x * vec_x + vec_y * vec_y);
        vec_x = vec_x / vec_len;
        vec_y = vec_y / vec_len;
    }

    private void get_floor_height(x, y, z) { // at 2023,-374 // proccode get floor height %s %s %s // warp
        check_inside_triangle(x, y, floor tris.get(1 + last_tri_index), floor tris.get(2 + last_tri_index), floor tris.get(4 + last_tri_index), floor tris.get(5 + last_tri_index), floor tris.get(7 + last_tri_index), floor tris.get(8 + last_tri_index));
        if (a1 + (a2 + a3) < at + tri_threshold) {
            tri_z = floor tris.get(3 + last_tri_index) - (floor tris.get(10 + last_tri_index) * (x - floor tris.get(1 + last_tri_index)) + floor tris.get(11 + last_tri_index) * (y - floor tris.get(2 + last_tri_index))) / floor tris.get(12 + last_tri_index);
            if (Operators.math("abs", z - tri_z) < max_vertical_displacement) {
                closest_tri_z = tri_z;
