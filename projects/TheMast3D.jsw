    private resolution_options = [20, "1", "2", "3", "4", "5", "6", "9", 12, 15];

    public void render_document() { // at 574,507 // hook: broadcast render document
        if (viewed_document != "") {
            Pen.setPenSize(1200);
            Pen.setPenColor("#000000");
            Pen.setPenColorParamTo("", 30);
            dot(0, 0);
            Looks.switchCostume("blank");
            if (viewed_document == "view drill archive") {
                Looks.switchCostume(join("dv", Operators.math("floor", drill_archive_frame)));
                drill_archive_frame += dt;
                if (drill_archive_frame > 12) {
                    drill_archive_frame = 1;
                }
            } else {
                Looks.switchCostume(viewed_document);
            }
            Pen.stamp();
            Looks.size = 50;
            hovered_texture_choice = "";
            if (viewed_document == "load textures") {
                // unsupported block: looks_seteffectto
                Looks.switchCostume("preview half res");
                Motion.y = 40;
                Pen.stamp();
                Looks.switchCostume("select texture");
                if (Sensing.touching("_mouse_")) {
                    hovered_texture_choice = "half";
                    Pen.stamp();
                }
                Looks.switchCostume("preview full res");
                Motion.y += -105;
                Pen.stamp();
                Looks.switchCostume("select texture");
                if (Sensing.touching("_mouse_")) {
                    if (block("argument_reporter_boolean", "VALUE", "is TurboWarp?")) {
                        hovered_texture_choice = "full";
                    } else {
                        Looks.switchCostume("select texture disabled");
                    }
                    Pen.stamp();
                }
                Looks.switchCostume("select texture2");
                Motion.y += -105;
                if (Sensing.touching("_mouse_")) {
                    if (block("argument_reporter_boolean", "VALUE", "is TurboWarp?")) {
                        hovered_texture_choice = "custom";
                    } else {
                        Looks.switchCostume("select texture2 disabled");
                    }
                    Pen.stamp();
                }
                // unsupported block: looks_cleargraphiceffects
            }
            if (viewed_document == "view welcome message") {
                Motion.y = -136;
                Pen.setPenColor("#7d7d7d");
                Pen.setPenSize(4);
                dot(30, -136);
                dot(70, -136);
                dot(150, -136);
                dot(0, -136);
                dot(10, -136);
                dot(20, -136);
                Pen.setPenColor("#7d7d7d");
                Pen.setPenSize(2);
                Motion.x = 0;
                Pen.penDown();
                Motion.x += 150;
                Pen.penUp();
                Pen.setPenColor("#ffffff");
                Pen.setPenSize(8);
                dot(150 * ((look_sensitivity - 0.25) / 3.75), -136);
            }
            Looks.switchCostume("icon");
            Looks.size = 100;
        }
    }

