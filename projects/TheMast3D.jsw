    private void check_passcode() { // at 2958,1508 // proccode check passcode
        if (passcode_panel == 8023) {
            Sound.playSound("door unlock");
            set_game_state("facility passcode correct", 1);
            viewed_document = "";
            Control.broadcast("load tags");
        } else {
            Sound.playSound("ui btn err 1");
        }
        passcode_panel = "";
