    private void move_camera(speed, x, y, z) { // at 4238,-302 // proccode move camera %s vec %s %s %s
        vec_len = Operators.math("sqrt", x * x + (y * y + z * z));
        cam_x += dt * speed * (x / vec_len);
        cam_y += dt * speed * (y / vec_len);
        cam_z += dt * speed * (z / vec_len);
    }

