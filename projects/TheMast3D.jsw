        __local_sfx_data.add(y);
        __local_sfx_data.add(z);
        __local_sfx_data.add(loop_mode);
        __("6-10");
        __local_sfx_data.add(range);
        __local_sfx_data.add(vol);
        __local_sfx_data.add(pan_);
        __local_sfx_data.add(len);
        __local_sfx_data.add(0);
        __(11);
        __local_sfx_data.add(1);
        __("CREATE CLONE");
        Control.createClone("_myself_");
        if (loop_mode == "double") {
            __("CREATE DELAY CLONE");
            __local_sfx_data.set(10, len / 2);
            Control.createClone("_myself_");
        }
        __local_sfx_data.clear();
    }

