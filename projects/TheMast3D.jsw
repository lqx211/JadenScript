    public void Events.keyPressed(k) { // at -1885,-243 // hook: when [enter] key pressed
        if (keymap options.get(__controls__trigger_) == "Enter") {
            Control.broadcastAndWait("trigger");
            Control.waitUntil(!Sensing.keyPressed("enter"));
        }
    }

    private void _dist____distance_to(x1, y1, z1) { // at 2912,-194 // proccode (dist) = distance to %s %s %s
        dist = Operators.math("sqrt", x1 * x1 + y1 * y1 + z1 * z1);
    }

