    public void stage_clicked() { // at 1263,2263 // hook: broadcast stage clicked
        if (viewed_document == "stairs passcode panel") {
            __("buttons are 30px exactly");
            if (Operators.math("abs", Sensing.mouseX()) < 45 && Operators.math("abs", Sensing.mouseY() + 45) < 60) {
                if (Sensing.mouseY() > -15) {
                    if (Sensing.mouseX() < -15) {
                        type(7);
                    } elif (Sensing.mouseX() < 15) {
                        type(8);
                    } else {
                        type(9);
                    }
                } elif (Sensing.mouseY() > -45) {
                    if (Sensing.mouseX() < -15) {
                        type(4);
                    } elif (Sensing.mouseX() < 15) {
                        type(5);
                    } else {
                        type(6);
                    }
                } elif (Sensing.mouseY() > -75) {
                    if (Sensing.mouseX() < -15) {
                        type(1);
                    } elif (Sensing.mouseX() < 15) {
                        type(2);
                    } else {
                        type(3);
                    }
                } elif (Sensing.mouseX() < -15) {
                    type(0);
                } else {
                    check_passcode();
                }
            }
        }
    }

