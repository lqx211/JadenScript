    private void handle_tags() { // at 1273,27 // proccode handle tags // warp
        tag_i = "";
        min_tag_dist = 0.3;
        on_screen_tag_txt = "";
        targeted_tag = "";
        i = 0;
        repeat (tags.length() / 11) {
            _dist____distance_to(tags.get(i + 2) - cam_x, tags.get(i + 3) - cam_y, tags.get(i + 4) - cam_z);
            if (dist < tags.get(i + 8)) {
                _return____dot_product_3D(tags.get(i + 2) - cam_x, tags.get(i + 3) - cam_y, tags.get(i + 4) - cam_z, tags.get(i + 5), tags.get(i + 6), tags.get(i + 7));
                if (return < 0) {
                    project(tags.get(i + 2), tags.get(i + 3), tags.get(i + 4));
                    if (vert_z > 0.2) {
                        if (min_tag_dist > Operators.math("sqrt", vert_x * vert_x + vert_y * vert_y) && dist < 1.5) {
                            if (tag_i != "") {
                                draw_tag_icon_at(240 * tag_prev_vert_x, 240 * tag_prev_vert_y, "ghost", tags.get(tag_i + 1));
                            }
                            min_tag_dist = Operators.math("sqrt", vert_x * vert_x + vert_y * vert_y);
                            tag_i = i;
                            tag_prev_vert_x = vert_x;
                            tag_prev_vert_y = vert_y;
                        } else {
                            draw_tag_icon_at(240 * vert_x, 240 * vert_y, "ghost", tags.get(i + 1));
                        }
                    }
                }
            }
            i += 11;
        }
        if (tag_i != "") {
            draw_tag_icon_at(240 * tag_prev_vert_x, 240 * tag_prev_vert_y, "targeted", tags.get(tag_i + 1));
            targeted_tag = tag_i;
            on_screen_tag_x = 15 + 240 * tag_prev_vert_x;
            on_screen_tag_y = -2 + 240 * tag_prev_vert_y;
            if (tags.get(tag_i + 1) == "document" || tags.get(tag_i + 1) == "function") {
                on_screen_tag_txt = join(join(join("[ ", keymap options.get(__controls__trigger_)), " ]~"), tags.get(tag_i + 10));
            } else {
                on_screen_tag_txt = tags.get(tag_i + 10);
            }
        }
    }

