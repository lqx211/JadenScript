class overlay { // Sprite: overlay (0,0) size=100 direction=90 show=0 costume=0 volume=100 layer=18 rotation=all draggable=0
    import "assets/e42431a0b41af15ec991eb82316b50a7.svg" as black; // costume centerx=267 centery=197 res=1
    private temp2 = 16;
    private temp1 = 0;
    private bars_phase = "0";

    public void __initalise() { // at 848,556 // hook: broadcast ! initalise
        black_overlay = 0;
        bars_phase = 0;
    }

    public void draw_overlay() { // at -225,562 // hook: broadcast draw overlay
        Looks.hide();
        Motion.setXY(0, 0);
        Pen.setPenColor("#000000");
        Pen.setPenSize(1200);
        Looks.switchCostume("black");
        if (region == "start_off") {
            temp2 = game states.indexOf("play wake up animation");
            if (game states values.get(temp2) != "") {
                bars_phase = 1;
                if ("awaken" == game states values.get(temp2)) {
                    Pen.setPenColorParamTo("", 50 * game states values.get(game states.indexOf("wake up t")));
                    Pen.penDown();
                    Pen.penUp();
                } elif ("lying" == game states values.get(temp2)) {
                    Pen.setPenColorParamTo("", 50 + 100 * game states values.get(game states.indexOf("wake up t")));
                    Pen.penDown();
                    Pen.penUp();
                }
            }
        } elif (region == "landing_pad_night") {
            if (game states values.get(game states.indexOf("play ending animation"))) {
                bars_phase = 1;
            }
        }
        if (black_overlay > 0) {
            Motion.setXY(0, 0);
            // unsupported block: looks_seteffectto
            Looks.show();
            black_overlay += dt * -3;
        }
    }

    public void reset_all() { // at 194,573 // hook: broadcast reset all
        Looks.hide();
    }

    public void show_end_screen() { // at 286,677 // hook: broadcast show end screen
        Looks.hide();
        Control.stopAll();
    }

    public void draw_bars_overlay() { // at 612,762 // hook: broadcast draw bars overlay
        if (bars_phase > 0) {
            draw_bars(bars_phase);
            bars_phase -= 5 * dt;
        } else {
            bars_phase = 0;
        }
    }

    private void draw_bars(t) { // at 1439,831 // proccode draw bars %s // warp
        Pen.setPenColor("#000000");
        Pen.setPenSize(100);
        Motion.setXY(-500, 180 + 51 - 45 * t);
        Pen.penDown();
        Motion.x = 500;
        Pen.penUp();
        Motion.setXY(-500, -180 - 51 + 45 * t);
        Pen.penDown();
        Motion.x = 500;
        Pen.penUp();
    }

    public void show_black_overlay() { // at 753,1812 // hook: broadcast show black overlay
        black_overlay = 1;
        // unsupported block: looks_seteffectto
        Looks.show();
    }

}

