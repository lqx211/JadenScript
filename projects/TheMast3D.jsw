    private void _return____dot_product_3D(x1, y1, z1, x2, y2, z2) { // at 2890,-407 // proccode (return) = dot product 3D %s %s %s / %s %s %s
        return = x1 * x2 + y1 * y2 + z1 * z2;
    }

    public void __initalise() { // at 437,-288 // hook: broadcast ! initalise
        Looks.switchCostume("blank");
        Looks.size = 1 / "";
        Looks.switchCostume("icon");
