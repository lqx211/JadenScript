    private void type(num) { // at 2122,1510
        if (viewed_document == "stairs passcode panel") {
            if (Operators.length(passcode_panel) < 4) {
                passcode_panel = join(passcode_panel, num);
            }
            Sound.playSound("btn press");
        } else {
            msg_i = messages.indexOf(join("resolution = ", DISPLAY__Resolution));
            if (msg_i > 0) {
                messages.delete(msg_i);
                messages.delete(msg_i);
            }
            DISPLAY__Resolution = resolution_options.get(num + 1);
            messages.add(join("resolution = ", DISPLAY__Resolution));
            messages.add(5);
        }
    }

