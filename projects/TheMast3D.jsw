                return;
            }
        }
        __("iterate over every triangle to find the floor");
        closest_tri_z = 1000;
        i = 2;
        repeat (floor tris.length() / 14) {
            check_inside_triangle(x, y, floor tris.get(1 + i), floor tris.get(2 + i), floor tris.get(4 + i), floor tris.get(5 + i), floor tris.get(7 + i), floor tris.get(8 + i));
