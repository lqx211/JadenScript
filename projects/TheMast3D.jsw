            } else {
                Motion.y += -30;
                if (0 /* sensing_distanceto */ < 8) {
                    cycle_key_choices(__controls__look_, -1);
                    __controls__look_ = return;
                } else {
                    Motion.y += -30;
                    if (0 /* sensing_distanceto */ < 8) {
                        cycle_key_choices(__controls__trigger_, -1);
                        __controls__trigger_ = return;
                    } else {
                        Motion.y += -30;
                        if (0 /* sensing_distanceto */ < 8) {
                            cycle_key_choices(__controls__run_, -1);
                            __controls__run_ = return;
                        }
                    }
                }
            }
        } else {
            Motion.x = -139 + 8;
            if (0 /* sensing_distanceto */ < 8) {
                cycle_key_choices(__controls__move_, 1);
                __controls__move_ = return;
            } else {
                Motion.y += -30;
                if (0 /* sensing_distanceto */ < 8) {
                    cycle_key_choices(__controls__look_, 1);
                    __controls__look_ = return;
