    public void Events.keyPressed(k) { // at -1884,56 // hook: when [e] key pressed
        if (keymap options.get(__controls__trigger_) == "E") {
            Control.broadcastAndWait("trigger");
            Control.waitUntil(!Sensing.keyPressed("e"));
        }
    }

    private void add_tag(type, x, y, z, nx, ny, nz, range, id, text, sfx) { // at 3614,118 // proccode add tag %s at %s %s %s dir %s %s %s range %s id %s text %s sfx %s
        if (type == "") {
            tags.add("text");
        } else {
            tags.add(type);
        }
        tags.add("" + x);
        tags.add("" + y);
        tags.add("" + z);
        if ("" == join(join(nx, ny), nz)) {
            tags.add("" + 0);
            tags.add("" + 0);
            tags.add("" + 1);
        } else {
            tags.add("" + nx);
            tags.add("" + ny);
            tags.add("" + nz);
        }
        if (range == "") {
            tags.add("" + 2);
        } else {
            tags.add("" + range);
        }
        tags.add(id);
        tags.add(text);
        tags.add(sfx);
    }

    public void Events.keyPressed(k) { // at -1884,353 // hook: when [space] key pressed
        if (keymap options.get(__controls__trigger_) == "Space") {
            Control.broadcastAndWait("trigger");
            Control.waitUntil(!Sensing.keyPressed("space"));
        }
    }

    public void trigger() { // at -1888,647 // hook: broadcast trigger
        if (viewed_document != "") {
            if (!(viewed_document == "comms" || viewed_document == "time warp to night")) {
                viewed_document = "";
            }
        } elif (targeted_tag != "") {
            if (tags.get(targeted_tag + 1) == "function") {
                Sound.playSound(tags.get(targeted_tag + 11));
                Control.broadcastAndWait("function");
            } elif (tags.get(targeted_tag + 1) == "document") {
                cam_vx = 0;
                cam_vy = 0;
                viewed_document = tags.get(targeted_tag + 9);
                Sound.playSound(tags.get(targeted_tag + 11));
                Control.broadcastAndWait("view document");
            }
            Control.broadcast("load tags");
        }
    }

    private void project(x, y, z) { // at 3498,1555
        temp1 = x - cam_x;
        temp2 = y - cam_y;
        vert_x = temp1 * Operators.math("cos", cam_rot_z) - temp2 * Operators.math("sin", cam_rot_z);
        vert_y = temp1 * Operators.math("sin", cam_rot_z) + temp2 * Operators.math("cos", cam_rot_z);
        temp1 = vert_y;
        temp2 = z - cam_z;
        vert_y = temp2 * Operators.math("sin", cam_rot_x) + temp1 * Operators.math("cos", cam_rot_x);
        vert_z = 0 - (temp2 * Operators.math("cos", cam_rot_x) - temp1 * Operators.math("sin", cam_rot_x));
        vert_x = f * vert_x / vert_z;
        vert_y = f * vert_y / vert_z;
    }

    private void draw_tag_icon_at(x, y, type, func) { // at 2721,1558 // proccode draw tag icon at %s %s type %s function %s // warp
        if (tag_style == 2 || tag_style == 3) {
            if (func == "text") {
                Pen.setPenColor("#00b2ff");
            } elif (func == "document") {
                Pen.setPenColor("#f600e1");
            } elif (func == "function") {
                Pen.setPenColor("#f6d500");
            } else {
                Pen.setPenColor("#00ff08");
            }
            if (tag_style == 2) {
                Motion.setXY(x, y);
                Pen.setPenSize(16);
                if (type == "ghost") {
                    Pen.setPenColorParamTo("", 50);
                } else {
                    Pen.setPenColorParamTo("", 0);
                    Pen.penDown();
                    Pen.penUp();
                }
                Pen.penDown();
                Pen.penUp();
            } elif (type == "ghost") {
                Pen.setPenSize(4);
                Motion.setXY(x - 9, y);
                Pen.penDown();
                Motion.x = x + 9;
                Pen.penUp();
                Motion.setXY(x, y - 9);
                Pen.penDown();
                Motion.y = y + 9;
                Pen.penUp();
            } else {
                Pen.setPenColorParamTo("", 0);
                Pen.setPenSize(4);
                Motion.setXY(x - 8, y);
                Pen.penDown();
                Motion.x = x + 8;
                Pen.penUp();
                Motion.setXY(x, y - 8);
                Pen.penDown();
                Motion.y = y + 8;
                Pen.penUp();
            }
        } else {
            Pen.setPenColor("#ffffff");
            Pen.setPenColorParamTo("", 70);
            if (type == "ghost") {
                Pen.setPenSize(4);
                Motion.setXY(x - 15, y - "");
                Pen.penDown();
                Motion.setXY(x - "", y - 15);
                Motion.setXY(x + 15, y - "");
                Motion.setXY(x - "", y + 15);
                Motion.setXY(x - 15, y - "");
                Pen.penUp();
            } else {
                Pen.setPenColorParamTo("", 0);
                Pen.setPenSize(3);
                Motion.setXY(x - 5, y - "");
                Pen.penDown();
                Motion.setXY(x - "", y - 5);
                Motion.setXY(x + 5, y - "");
                Motion.setXY(x - "", y + 5);
                Motion.setXY(x - 5, y - "");
                Pen.penUp();
            }
        }
    }

    private void render_spacecraft_marker() { // at 4742,2250 // proccode render spacecraft marker // warp
        project(spacecraft_x, spacecraft_y, spacecraft_z);
        if (vert_z > 0.2) {
            if (vert_z > 120) {
                if ("landing" == game states values.get(game states.indexOf("spaceship phase"))) {
                    on_screen_tag_x = 15 + 240 * vert_x;
                    on_screen_tag_y = -2 + 240 * vert_y;
                    on_screen_tag_txt = "spacecraft";
                    Pen.setPenColor("#00ff08");
                    Pen.setPenColorParamTo("", 50);
                    Pen.setPenSize(2);
                    Motion.setXY(240 * vert_x - 8, 240 * vert_y - "");
                    Pen.penDown();
                    Motion.setXY(240 * vert_x - "", 240 * vert_y - 8);
                    Motion.setXY(240 * vert_x + 8, 240 * vert_y - "");
                    Motion.setXY(240 * vert_x - "", 240 * vert_y + 8);
                    Motion.setXY(240 * vert_x - 8, 240 * vert_y - "");
                    Pen.penUp();
                }
            }
        }
    }

    private void render_debug_tags() { // at 3665,2355 // proccode render debug tags // warp
        i = 0;
        repeat (tags.length() / 11) {
            project(tags.get(i + 2), tags.get(i + 3), tags.get(i + 4));
            if (vert_z > 0.2) {
                Motion.setXY(240 * vert_x, 240 * vert_y);
                Pen.setPenSize(6);
                if (tags.get(i + 1) == "text") {
                    Pen.setPenColor("#f600d9");
                } elif (tags.get(i + 1) == "document") {
                    Pen.setPenColor("#1cf600");
                } elif (tags.get(i + 1) == "function") {
                    Pen.setPenColor("#f6d500");
                } else {
                    Pen.setPenColor("#a9a9a9");
                    Pen.setPenSize(10);
                }
                Pen.penDown();
                Pen.penUp();
            }
            i += 11;
        }
    }

