    public void draw_text() { // at -409,-416 // hook: broadcast draw text
        if (viewed_document == "") {
            Pen.setPenColor("#b7b7b7");
            if (show_FPS_ == 1) {
                if (region != "end") {
                    plain_text___at(-230, 160, 1, join("FPS:  ", FPS));
                }
            }
            if (show_timer_ == 1) {
                if (completion_time == "") {
                    if (timer == "") {
                        display_timer = "waiting to start...";
                    } else {
                        display_timer = timer * target_dt;
                        sec = Operators.math("floor", display_timer % 60);
                        if (Operators.length(sec) == 1) {
                            sec = join(0, sec);
                        }
                        display_timer = f"{Operators.math("floor", display_timer / 60)}:{sec}.{Operators.math("floor", 100 * display_timer % 100)}";
                    }
                    plain_text___at(-230, 150, 1, f"Ticks:  {timer}~Time:  {display_timer}");
                }
            }
            if (__dev == 1) {
                plain_text___at(-230, -100, 1, region);
                plain_text___at(-230, -110, 1, f"cam xyz:  {Operators.round(100 * cam_x) / 100}, {Operators.round(100 * cam_y) / 100}, {Operators.round(100 * cam_z) / 100}");
                plain_text___at(-230, -120, 1, join(join(join("rot xz:  ", Operators.round(cam_rot_x)), ", "), Operators.round(cam_rot_z)));
                plain_text___at(-230, -130, 1, join(join(cam_mode, ", "), render_mode));
            }
            display_messages();
        }
        Pen.setPenColor("#e2e2e2");
        if (viewed_document == "") {
            plain_text___at(0 /* sensing_of */, 0 /* sensing_of */, 1, 0 /* sensing_of */);
        } elif (key_validity_ == 1) {
            if (!(viewed_document == "comms" || viewed_document == "time warp to night")) {
                Pen.setPenColor("#ffe900");
                plain_text___at(-230, -170, 1, join(join("[ ", keymap options.get(__controls__trigger_)), " ] to close"));
                plain_text___at(210, 160, 1, "( X )");
            }
        } else {
            Pen.setPenColor("#ff4747");
            plain_text___at(-160, -155, 1, "Invalid control combination");
        }
        end();
        Looks.switchCostume("icon");
    }

    private void plain_text___at(x, y, size, text) { // at 2319,-167 // proccode plain text | at %s %s size %s text %s // warp
        Pen.setPenSize(size);
        x_offset = Operators.math("floor", x);
        y_offset = Operators.math("floor", y);
        for (txt_i=1, txt_i<=Operators.length(text), txt_i++) {
            Looks.switchCostume(Operators.letterOf(txt_i, text));
            if (Looks.costumeName() == "~") {
                x_offset = Operators.math("floor", x);
                y_offset += size * -10;
            } else {
                font_char_index = PTE_font_1.get(Looks.costumeNumber() + 6);
                Looks.switchCostume("large");
                font_i = 3 + font_char_index;
                repeat (PTE_font_1.get(5 + font_char_index)) {
                    font_i += 4;
                    Motion.setXY(x_offset + size * PTE_font_1.get(font_i + 1), y_offset + size * PTE_font_1.get(font_i + 2));
                    Pen.penDown();
                    repeat (PTE_font_1.get(font_i)) {
                        font_i += 2;
                        Motion.setXY(x_offset + size * PTE_font_1.get(font_i + 1), y_offset + size * PTE_font_1.get(font_i + 2));
                    }
                    Pen.penUp();
                }
                x_offset += size * (2 + PTE_font_1.get(2 + font_char_index));
            }
        }
    }

    private void change_game_state(name, value) { // at 2950,-150 // proccode change game state %s by %s
        game states values.set(game states.indexOf(name), value + game states values.get(game states.indexOf(name)));
    }

    public void reset_all() { // at -886,-51 // hook: broadcast reset all
        messages.clear();
    }

    private void set_game_state(name, value) { // at 2954,57 // proccode set game state %s to %s
        game states values.set(game states.indexOf(name), value);
    }

    public void __initalise() { // at -888,133 // hook: broadcast ! initalise
        Looks.hide();
        tp_regions.clear();
        tp_regions.add("pod");
        tp_regions.add("start_off");
        tp_regions.add("surface");
        tp_regions.add("facility");
        tp_regions.add("drill");
        tp_regions.add("base");
        tp_regions.add("landing_pad");
        tp_regions.add("cb");
    }

    private void display_messages() { // at 1424,440 // proccode display messages // warp
        Pen.setPenColor("#ffffff");
        i = 1;
        repeat (messages.length() / 2) {
            if (messages.get(i + 1) < 0) {
                messages.delete(i);
                messages.delete(i);
            } else {
                messages.set(i + 1, messages.get(i + 1) - dt);
                plain_text___at(-230, 120 - 5 * i, 1, messages.get(i));
                i += 2;
            }
        }
    }

    private void __(comment) { // at 1032,553 // proccode // %s
    }

    public void render_document_text() { // at 811,1149 // hook: broadcast render document text
        if (viewed_document != "") {
            if (viewed_document == "view welcome message") {
                Pen.setPenColor("#00ff77");
                plain_text___at(-160, 130, 1, "Welcome.~~You are currently situated in a pod.~~Use this opportunity to configure settings and get used~to the controls before the game is started.~~Please note that TurboWarp (link in the instructions) is~almost certainly required to play this game due to how slow~it is on Scratch.");
                Pen.setPenColor("#ffe283");
                plain_text___at(-160, 10, 1, "Firstly, choose your controls (click the arrows to cycle):");
                Pen.setPenColor("#ffffff");
                plain_text___at(-110, -20, 1, f"MOVE:  {keymap options.get(__controls__move_)}~~~LOOK:  {keymap options.get(__controls__look_)}~~~TRIGGER:  {keymap options.get(__controls__trigger_)}~~~RUN:  {keymap options.get(__controls__run_)}");
                plain_text___at(-150, -140, 1, join("Look Sensitivity:  ", Operators.round(look_sensitivity * 100) / 100));
            } elif (viewed_document == "load textures") {
                Pen.setPenColor("#00fff2");
                plain_text___at(-68, 115, 1, "Select texture resolution...");
                Pen.setPenColor("#ffffff");
                plain_text___at(-75, 90, 1, "Low-res textures~(fast to load)");
                if (block("argument_reporter_boolean", "VALUE", "is TurboWarp?")) {
                    plain_text___at(-75, -15, 1, "Full-res textures~(requires 1 minute to load)");
                } else {
                    plain_text___at(-75, -15, 1, "Full-res textures~(TURBOWARP ONLY)");
                }
                plain_text___at(-75, -130, 1, "Custom textures~(copy-paste texture data)~Get the official textures at~awesome-llama.github.io/tex");
            } elif (viewed_document == "custom textures") {
                Pen.setPenColor("#ffffff");
                plain_text___at(-220, 150, 1, "Go to this website:~~awesome-llama.github.io/tex~~There's also a link in the project description.~~Once you have the texture, paste it in the text box at the bottom of the screen.");
            } elif (viewed_document == "view stasis logs") {
                Pen.setPenColor("#ffa8f3");
                plain_text___at(-160, 80, 1, "ERROR 4A:~Critical stasis failure... repair required.~Refer to maintenance handbook for more information.");
                plain_text___at(-160, 15, 1, "Recorded stasis duration: 2829 sols (56580.3 standard hours).");
                plain_text___at(-160, -30, 1, "Global notices:~~* Facility in low-power mode. Essential lighting and systems~available only. Restore power via electrics room.~~* All operations ceased planet-wide. Details available on ~operations room of floor 2, outpost main complex building.");
            } elif (viewed_document == "view overall stasis info") {
                Pen.setPenColor("#997dff");
                plain_text___at(-170, 90, 1, "CHAMBER STATUS:~~* 01: Nominal. Uptime: 56580.1~* 02: Nominal. Uptime: 56580.2~* 03: FAILURE~* 04: Nominal. Uptime: 56580.1~* 05: Nominal. Uptime: 56581.1~* 06: Nominal. Uptime: 56580.3~* 07: Nominal. Uptime: 56580.2~* 08: Nominal. Uptime: 56580.3~* 09: Nominal. Uptime: 56580.5~* 10: Nominal. Uptime: 56580.8~~Viewing pg. 1/2");
            } elif (viewed_document == "food storage notice") {
                Pen.setPenColor("#ffcf7d");
                plain_text___at(-110, 50, 1, "FOOD STORAGE~~Stocks at critical levels.~Resupply needed.~~No supplies available on-site.");
            } elif (viewed_document == "outpost status") {
                Pen.setPenColor("#ffffff");
                plain_text___at(-90, 100, 1, "Current outpost status:");
                Pen.setPenColor("#e8d1ff");
                plain_text___at(-200, 60, 1, "Facility in low-power mode. All operations ceased planet-wide.~~Last atmosphere measurement: 56,600 standard hours ago.~Reported atmosphere conditions: Poor~* Visibility below 500m at altitudes up to 10km.~* High wind gusts.~* High temperature.~* Toxic gases detected.~~No spacecraft or aircraft transfers to be made due to high risk.~Limit exposure to atmosphere.~All crews not evacuated are to remain indoors.~~~Global notice: Due to lack of supplies, all crews are instructed to enter ~stasis until condtions improve. Wait for rescue. Emergency communications~must be made via VLM.");
            } elif (viewed_document == "view outpost map") {
                Pen.setPenColor("#ffffff");
                plain_text___at(-191, 119, 1, "MAP");
                Pen.setPenColor("#7dd9ff");
                plain_text___at(-51, 74, 1, "OUTPOST");
                plain_text___at(23, -86, 1, "VLM");
                plain_text___at(-195, 0, 1, "DRILL SITES~(WEST)");
                plain_text___at(145, 0, 1, "DRILL SITES~(EAST)");
            } elif (viewed_document == "VLM info") {
                Pen.setPenColor("#2dc3ff");
                plain_text___at(-190, 80, 1, "VLM (Very Large Mast)~~The main communications system for all~installations within 300km.~~Additionally provides communication ~off-planet.~~Consists of a 2.6km tall superstructure~topped by a spire/antenna making a~total height of 3.5km. Three sets of three~guy wires hold the structure upright.~~The enclosed core holds service~elevators and all wires and piping needed~for operation.");
            } elif (viewed_document == "stairs passcode panel") {
                Pen.setPenColor("#754900");
                plain_text___at(-25, 65, 1, "Passcode:");
                Pen.setPenColor("#ffa100");
                plain_text___at(-25, 40, 2, passcode_panel);
            } elif (viewed_document == "service1 lift operation plate") {
                Pen.setPenColor("#000000");
                plain_text___at(-140, 58, 1, "STARTUP INSTRUCTIONS~~~~1. set power to OFF or STANDBY~~2. switch operation to NEUTRAL~~3. switch power to ON~~4. switch operation to ON (will trigger audible tone)~~5. ensure door is closed before using elevator");
            } elif (viewed_document == "comms") {
                __("comms gets a custom document implementation because of animations and ui interactivity");
                comms_text();
            } elif (viewed_document == "time warp to night") {
                comms_timer += 0 - dt;
                if (comms_timer < 0) {
                    comms_timer = 0;
                    set_game_state("night time", 1);
                    viewed_document = "";
                    cam_x = 60.4;
                    cam_y = -3761.5;
                    cam_rot_x = 87;
                    cam_rot_z = 314;
                }
                Pen.setPenColor("#e2e2e2");
                plain_text___at(-100, 0, 2, join("Hours until rescue: ", Operators.round(comms_timer)));
            } elif (viewed_document == "bonus content") {
                bonus_content();
            }
        }
    }

    private void end() { // at 3063,1810
        if (region == "end") {
            Pen.setPenColor("#ffffff");
            plain_text___at(-180, 15, 1, "You have completed the game!");
            if (show_timer_ == 1) {
                display_timer = completion_time * target_dt;
                sec = Operators.math("floor", display_timer % 60);
                if (Operators.length(sec) == 1) {
                    sec = join(0, sec);
                }
                display_timer = f"{Operators.math("floor", display_timer / 60)}:{sec}.{Operators.math("floor", 100 * display_timer % 100)}";
                plain_text___at(-180, 0, 1, f"Completion time: {display_timer}  ({completion_time} ticks)");
            }
            plain_text___at(-180, -15, 1, "To restart the game, click the green flag.");
            Looks.switchCostume("icon");
            reset_game_ = 1;
            bonus_content_ = 1;
            Control.broadcast("show end screen");
        } elif (region == "landing_pad_night") {
            temp2 = game states values.get(game states.indexOf("spaceship time"));
            if (temp2 > 45) {
                if (temp2 < 48) {
                    plain_text___at(-20, -100, 1, "THE MAST");
                } elif (temp2 < 52) {
                    plain_text___at(-60, -100, 1, "created by awesome-llama");
                }
            }
        }
    }

    public void stage_clicked() { // at -1268,2213 // hook: broadcast stage clicked
        if (comms_mouse_hover == "") {
            return;
        }
        if (viewed_document == "comms") {
            if (comms_mouse_hover == "exit") {
                viewed_document = "";
                cam_vx = 0;
                cam_vy = 0;
                if (game states values.get(game states.indexOf("distress signal sent"))) {
                    if (!game states values.get(game states.indexOf("night time"))) {
                        comms_timer = 8;
                        viewed_document = "time warp to night";
                        Control.broadcast("show black overlay");
                    }
                }
            } elif (comms_mouse_hover == "init") {
                comms_timer = 0;
                comms_phase = "init";
            } elif (comms_mouse_hover == "menu") {
                comms_phase = "menu";
            } elif (comms_mouse_hover == "info") {
                comms_phase = "info";
            } elif (comms_mouse_hover == "reconnect") {
                comms_timer = 0;
                comms_phase = "reconnect";
            } elif (comms_mouse_hover == "distress signal") {
                comms_timer = 0;
                if (game states values.get(game states.indexOf("distress signal sent"))) {
                    comms_phase = "spaceship";
                } else {
                    comms_phase = "distress signal";
                }
            } elif (comms_mouse_hover == "close distress") {
                set_game_state("distress signal sent", 1);
                comms_phase = "menu";
            }
            Sound.volume = 100;
            Sound.playSound("click high");
        } elif (viewed_document == "bonus content") {
            if (tp_regions.contains(comms_mouse_hover)) {
                region = comms_mouse_hover;
                viewed_document = "";
                cam_vx = 0;
                cam_vy = 0;
                if (comms_mouse_hover == "pod" || comms_mouse_hover == "cb") {
                    cam_x = 0;
                    cam_y = 0;
                    cam_z = 1.65;
                } elif (comms_mouse_hover == "start_off") {
                    cam_x = -7.25;
                    cam_y = -1.31;
                    cam_z = -13.35;
                } elif (comms_mouse_hover == "surface") {
                    cam_x = -20;
                    cam_y = 27.75;
                    cam_z = 11.65;
                } elif (comms_mouse_hover == "facility") {
                    cam_x = 22;
                    cam_y = 57;
                    cam_z = 3.65;
                } elif (comms_mouse_hover == "drill") {
                    cam_x = 17.31;
                    cam_y = -215.3;
                    cam_z = -0.24;
                } elif (comms_mouse_hover == "base") {
                    cam_x = 49;
                    cam_y = -3758.13;
                    cam_z = 4.65;
                } elif (comms_mouse_hover == "landing_pad") {
                    cam_x = 43;
                    cam_y = -3749;
                    cam_z = 2550.65;
                }
                Control.broadcast("LOAD REGION");
            } elif (comms_mouse_hover == "set dev mode") {
                __dev = Operators.round(__dev != 1);
            } elif (comms_mouse_hover == "set cam mode") {
                if (cam_mode == "walk") {
                    cam_mode = "free";
                } else {
                    cam_mode = "walk";
                }
            } elif (comms_mouse_hover == "set render mode") {
                if (render_mode == "normal") {
                    render_mode = "hologram";
                } elif (render_mode == "hologram") {
                    render_mode = "points";
                } else {
                    render_mode = "normal";
                }
            } elif (comms_mouse_hover == "commands") {
                Control.broadcast("open commands");
            }
            Sound.volume = 100;
