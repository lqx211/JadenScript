    private void comms_text() { // at -384,2220 // proccode comms text // warp
        comms_mouse_hover = "";
        comms_timer += dt;
        Pen.setPenColor("#8bf9ff");
        if (comms_phase == "") {
            __("default ready for input");
            plain_text___at(-83, 20, 1, "COMMUNICATION CONTROL TERMINAL");
            plain_text___at(-40, -20, 1, "initialise system");
            Pen.setPenColor("#009dff");
            draw_rect(-40 - 12, -20 - 8, 104, 20, 2, "init");
        } elif (comms_phase == "init") {
            plain_text___at(-160, 70, 1, "initialising...");
            Pen.setPenColor("#ffb5b5");
            if (comms_timer > 0.3) {
                plain_text___at(-160, 50, 1, "standby power available");
            }
            if (comms_timer > 0.8) {
                plain_text___at(-160, 40, 1, "no faults detected");
            }
            if (comms_timer > 1) {
                plain_text___at(-160, 30, 1, "connecting high voltage supply...");
            }
            if (comms_timer > 3) {
                plain_text___at(-160, 20, 1, "no faults detected in power distribution system");
            }
            if (comms_timer > 5) {
                plain_text___at(-160, 10, 1, "full power available");
            }
            if (comms_timer > 5.5) {
                plain_text___at(-160, 0, 1, "antenna module self-test in progress...");
            }
            if (comms_timer > 7) {
                plain_text___at(-160, -10, 1, "antenna modules online (12/12)");
            }
            if (comms_timer > 7.2) {
                plain_text___at(-160, -20, 1, "acquiring connection with communication satellite...");
            }
            if (comms_timer > 10) {
                plain_text___at(-160, -30, 1, "connection failed, retrying...");
            }
            if (comms_timer > 15) {
                plain_text___at(-160, -40, 1, "connection failed, retrying...");
            }
            if (comms_timer > 20) {
                plain_text___at(-160, -50, 1, "connection failed, limited communication available");
            }
            if (comms_timer > 21.9) {
                plain_text___at(-160, -60, 1, "starting UI...");
            }
            if (comms_timer > 22) {
                comms_phase = "menu";
            }
        } elif (comms_phase == "menu") {
            plain_text___at(-160, 70, 1, "off-planet communication control terminal");
            plain_text___at(-140, 10, 1, "view system info");
            if (game states values.get(game states.indexOf("distress signal sent"))) {
                plain_text___at(-140, -20, 1, "view distress signal");
            } else {
                plain_text___at(-140, -20, 1, "send distress signal");
            }
            plain_text___at(-140, -50, 1, "exit");
            draw_rect(-160, 10 - 8, 180, 20, 2, "info");
            draw_rect(-160, -20 - 8, 180, 20, 2, "distress signal");
            draw_rect(-160, -50 - 8, 180, 20, 2, "exit");
        } elif (comms_phase == "info") {
            plain_text___at(-160, 40, 1, "VLM001OPC~~Main communication terminal");
            if (game states values.get(game states.indexOf("night time"))) {
                plain_text___at(-160, 10, 1, "Lighting ON");
                prng(91.7, 92.357, 1);
            } else {
                plain_text___at(-160, 10, 1, "Lighting OFF");
                prng(12, 12.345, 1);
            }
            plain_text___at(-160, 0, 1, "Limited communication");
            plain_text___at(-160, -20, 1, join("Power consumption: ", join(Operators.round(100 * return) / 100, " kW")));
            plain_text___at(-160, -30, 1, "Standby power available");
            plain_text___at(-140, 70, 1, "menu");
            draw_rect(-160, 70 - 8, 62, 20, 2, "menu");
        } elif (comms_phase == "reconnect") {
            plain_text___at(-140, 70, 1, "cancel");
            draw_rect(-160, 70 - 8, 70, 20, 2, "menu");
        } elif (comms_phase == "distress signal") {
            if (comms_timer > 0.25) {
                plain_text___at(-160, 50, 1, "> requesting rescue from VLM service landing pad 2550");
            }
            if (comms_timer > 0.5) {
                plain_text___at(-160, 40, 1, "> 1 person, uninjured");
            }
            if (comms_timer > 0.75) {
                plain_text___at(-160, 30, 1, "> additional details: none");
            }
            if (comms_timer > 3) {
                plain_text___at(-160, 10, 1, "message broadcasted");
            }
            if (comms_timer > 7) {
                plain_text___at(-160, -10, 1, "received by star system network");
            }
            if (comms_timer > 7.3) {
                plain_text___at(-160, -20, 1, "relaying to nearest crew capable of assistance");
            }
            if (comms_timer > 14) {
                plain_text___at(-160, -40, 1, "request accepted by 1 spacecraft (vessel \"BRANTA-17\")~~ESTIMATED TIME OF ARRIVAL: 8 standard hours");
            }
            if (comms_timer > 21) {
                comms_phase = "spaceship";
            }
        } elif (comms_phase == "spaceship") {
            if (game states values.get(game states.indexOf("night time"))) {
                plain_text___at(-190, 80, 1, "Spacecraft \"BRANTA-17\" scheduled to arrive now.");
                plain_text___at(-190, 50, 1, "Be present at the landing pad in preparation for landing.~Do not enter landing pad during landing sequence.");
            } else {
                plain_text___at(-190, 80, 1, "Rescue preparations (details automatically sent)");
                plain_text___at(-190, 50, 1, "BRANTA-17~~Length: 17.5 metres~Width: 14 metres~Height: 5.5 metres~Mass: 38 tonnes~~VTOL capable. Ensure that the landing site is clear of debris~and lighting is provided if possible.~~FWD loading ramp available below cockpit.");
            }
            plain_text___at(-170, -80, 1, "close");
            draw_rect(-190, -80 - 8, 64, 20, 2, "close distress");
        }
    }

    private void prng(min, max, f) { // at 2137,4980 // proccode prng %s %s freq %s
        return = min + (max - min) * (0.5 * (1 + Operators.math("sin", 654321 * Operators.math("floor", f * 86400 * (Sensing.daysSince2000() % 0.01)))));
    }

    private void draw_rect(x, y, width, height, chamfer, click_id) { // at 2194,5373 // proccode draw rect %s %s %s %s chamfer %s click id %s // warp
        if (Sensing.mouseX() > x - 2 && Sensing.mouseX() < x + 2 + width && (Sensing.mouseY() > y - 2 && Sensing.mouseY() < y + 2 + height)) {
            Pen.setPenColor("#ffffff");
            Pen.setPenSize(2);
            comms_mouse_hover = click_id;
        } else {
            Pen.setPenColor("#8bf9ff");
            Pen.setPenSize(1);
        }
        Motion.setXY(x + chamfer, y);
        Pen.penDown();
        Motion.x = x + width - chamfer;
        Motion.setXY(x + width, y + chamfer);
        Motion.y = y + height - chamfer;
        Motion.setXY(x + width - chamfer, y + height);
        Motion.x = x + chamfer;
        Motion.setXY(x, y + height - chamfer);
        Motion.y = y + chamfer;
        Motion.setXY(x + chamfer, y);
        Pen.penUp();
    }

    private void bonus_content() { // at 1248,6531 // proccode bonus content // warp
        Pen.setPenColor("#06b7ff");
        plain_text___at(-190, 120, 1, "BONUS CONTENT~Press [B] at any time to open this menu.");
        Pen.setPenColor("#85dcff");
        plain_text___at(-190, 80, 1, "Teleport to:");
        plain_text___at(-180, 60, 1, "region_pod~~region_start_off~~region_surface~~region_facility~~region_drill~~region_base~~region_landing_pad~~region_cb");
        plain_text___at(0, 80, 1, "Settings:");
        plain_text___at(0, 65, 1, "Please note the following are used~by the developer only and may~cause glitches.");
        plain_text___at(10, 20, 1, join(join(join("dev mode", " ("), __dev), ")"));
        plain_text___at(10, 0, 1, join(join(join("cam mode", " ("), cam_mode), ")"));
        plain_text___at(10, -20, 1, join(join(join("render mode", " ("), render_mode), ")"));
        plain_text___at(10, -60, 1, "enter command");
        __("RECTANGLES:");
        temp1 = 0;
        repeat (tp_regions.length()) {
            draw_rect(-190, 60 - 20 * temp1 - 6, 130, 16, 3, tp_regions.get(temp1 + 1));
            temp1 += 1;
        }
        draw_rect(0, 20 - 6, 180, 16, 3, "set dev mode");
        draw_rect(0, 0 - 6, 180, 16, 3, "set cam mode");
        draw_rect(0, -20 - 6, 180, 16, 3, "set render mode");
        draw_rect(0, -60 - 6, 180, 16, 3, "commands");
    }

}

