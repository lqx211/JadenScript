    }

    private void rotate_camera(speed, x, z) { // at 4240,114 // proccode rotate camera %s elev/azi %s %s
        cam_rot_x += dt * speed * x;
        cam_rot_z += dt * speed * z;
    }

    private void check_reload() { // at 915,136 // proccode check reload
        if (viewed_document == "view welcome message") {
            if (block("argument_reporter_boolean", "VALUE", "is TurboWarp?")) {
                DISPLAY__Resolution = 3;
            } else {
                __("scratch gets a lower resolution so the game doesn't freeze immediately");
                DISPLAY__Resolution = 12;
            }
            region = "pod";
            Control.broadcast("LOAD REGION");
        } elif (!(limits.get(1) == 1 / "" && limits.get(2) == -1 / "")) {
            __("scratch saves can't store infinity (json limitation) but the bounding boxes need this to work");
            __("the region is reloaded if there is a data issue");
            Control.broadcast("LOAD REGION");
        }
    }

    public void Events.keyPressed(k) { // at 2460,178 // hook: when [b] key pressed
        if (bonus_content_ == 1) {
            if (viewed_document == "bonus content") {
                viewed_document = "";
            } else {
                viewed_document = "bonus content";
            }
        }
    }

    public void stage_clicked() { // at 1063,983 // hook: broadcast stage clicked
        if (scanning_in_progress_ == 1) {
            return;
        }
        if (viewed_document == "") {
            if (keymap options.get(__controls__look_) == "Click and Drag") {
                last_mouse_x = Sensing.mouseX();
                last_mouse_y = Sensing.mouseY();
                last_cam_rot_z = cam_rot_z;
                last_cam_rot_x = cam_rot_x;
                while (!(!Sensing.mouseDown() || viewed_document != "")) {
                    cam_rot_z = (last_cam_rot_z + look_sensitivity * 0.6 * (Sensing.mouseX() - last_mouse_x)) % 360;
                    cam_rot_x = last_cam_rot_x + look_sensitivity * 0.6 * (Sensing.mouseY() - last_mouse_y);
                    if (cam_rot_x > 175) {
                        cam_rot_x = 175;
                    } elif (cam_rot_x < 5) {
                        cam_rot_x = 5;
                    }
                }
            }
        } else {
            if (viewed_document == "view welcome message") {
                key_change();
                check_key_validity();
                if (Operators.math("abs", Sensing.mouseY() + 136) < 10) {
                    while (!(!Sensing.mouseDown() || viewed_document == "")) {
                        look_sensitivity = 0.25 + 3.75 * (Sensing.mouseX() / 150);
                        if (look_sensitivity < 0.25) {
                            look_sensitivity = 0.25;
                        } elif (look_sensitivity > 4) {
                            look_sensitivity = 4;
                        }
                    }
                }
            } elif (viewed_document == "load textures") {
                if ("half" == 0 /* sensing_of */) {
                    Control.broadcastAndWait("load half-res textures");
                } elif ("full" == 0 /* sensing_of */) {
                    Control.broadcastAndWait("scan full-res textures");
                } elif ("custom" == 0 /* sensing_of */) {
                    viewed_document = "custom textures";
                    Control.broadcast("custom texture loader");
                }
            }
            if (key_validity_ == 1) {
                Motion.setXY(220, 160);
                if (0 /* sensing_distanceto */ < 20) {
                    if (!(viewed_document == "comms" || viewed_document == "time warp to night")) {
                        viewed_document = "";
                    }
                }
                Motion.setXY(0, 0);
            }
        }
    }

    public void Events.keyPressed(k) { // at 682,1204 // hook: when [f] key pressed
        if (__dev == 1) {
            if (cam_mode == "walk") {
                cam_mode = "free";
                viewed_document = "";
            } else {
                cam_mode = "walk";
                Control.broadcast("load tags");
            }
        }
    }

    private void cycle_key_choices(current, dir) { // at 1976,2745 // proccode cycle key choices %s %s // warp
        if (dir > 0) {
            i = current + 1;
            if ("#" == keymap options.get(i)) {
                while (!("#" == keymap options.get(i - 1))) {
                    i -= 1;
                }
            }
        } else {
            i = current - 1;
            if ("#" == keymap options.get(i)) {
                while (!("#" == keymap options.get(i + 1))) {
                    i += 1;
                }
            }
        }
        return = i;
    }

    private void key_change() { // at 2030,3726 // proccode key change
        Motion.y = -16;
        if (Sensing.mouseX() < -139) {
            Motion.x = -139 - 8;
            if (0 /* sensing_distanceto */ < 8) {
                cycle_key_choices(__controls__move_, -1);
