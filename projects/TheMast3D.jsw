    private void physics_step_with_dt(dt, repeat_) { // at 702,-130 // proccode physics step with dt %s repeat %s // warp
        repeat (repeat_) {
            __("vel");
            cam_vx += dt * movement_speed * (Operators.math("cos", cam_rot_z) * vec_x + Operators.math("sin", cam_rot_z) * vec_y);
            cam_vy += dt * movement_speed * (Operators.math("cos", cam_rot_z) * vec_y - Operators.math("sin", cam_rot_z) * vec_x);
            cam_vx = cam_vx * 0.95;
            cam_vy = cam_vy * 0.95;
            speed = Operators.math("sqrt", cam_vx * cam_vx + cam_vy * cam_vy);
            __("normal movement");
            start_x = cam_x;
            start_y = cam_y;
            cam_x += dt * cam_vx;
            cam_y += dt * cam_vy;
            get_floor_height(cam_x, cam_y, cam_z - eye_height);
            if (Operators.math("abs", cam_z - eye_height - closest_tri_z) < 2.00) {
