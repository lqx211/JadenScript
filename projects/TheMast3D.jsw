                last_tri_index = i;
                if (Operators.math("abs", z - tri_z) < Operators.math("abs", z - closest_tri_z)) {
                    closest_tri_z = tri_z;
                    if (Operators.math("abs", z - closest_tri_z) < max_vertical_displacement) {
                        __("stop early only if tri z is close enough to camera");
