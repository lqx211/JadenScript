class music { // Sprite: music (0,0) size=100 direction=90 show=0 costume=0 volume=100 layer=17 rotation=all draggable=0
    import "assets/5467c9b2be09628ef84ff1ac8e4785b1.svg" as icon; // costume centerx=13.912109375 centery=15.981249999999989 res=1
    import "assets/176cb1ba0132af28af8c3652e9bc998e.mp3" as "jnj no shelter"; // sound rate=44100 samples=4954624
    import "assets/092be4ca733b806a14d22f9d02597bf6.mp3" as "65dos - feathers"; // sound rate=44100 samples=2530304
    import "assets/3f2f191d0857a05f737eb7f15ee9da1a.mp3" as "infra radio 1"; // sound rate=44100 samples=5099305
    import "assets/ebde4c59c93e8b9665d85923aed2dd38.mp3" as "The Proper People - Ganymede"; // sound rate=44100 samples=7296546
    import "assets/f73f78e7404581ecc175fd563da1d6d5.mp3" as "Luminist - Woodland Shadows"; // sound rate=44100 samples=5027400
    private clone_ID = "";
    private current_audio_target = 100;

    public void __initalise() { // at 340,555 // hook: broadcast ! initalise
        Control.broadcast("start music");
    }

    public void start_game() { // at 787,563 // hook: broadcast start game
        game states values.set(game states.indexOf("play surface"), 1);
        // unsupported stop: other scripts in sprite
        Control.broadcast("start music");
    }

    public void start_music() { // at 334,723 // hook: broadcast start music
        while (1) {
            if (region == "pod") {
                Control.wait(3);
                current_audio_target = 100;
                Sound.playSoundUntilDone("jnj no shelter");
            } elif (region == "surface") {
                if (game states values.get(game states.indexOf("play surface"))) {
                    game states values.set(game states.indexOf("play surface"), 0);
                    current_audio_target = 40;
                    Sound.playSoundUntilDone("65dos - feathers");
                }
            } elif (region == "storage") {
                if (game states values.get(game states.indexOf("play woodland shadows"))) {
                    game states values.set(game states.indexOf("play woodland shadows"), 0);
                    current_audio_target = 15;
                    Sound.playSoundUntilDone("Luminist - Woodland Shadows");
                }
            } elif (region == "drill") {
                if (game states values.get(game states.indexOf("play ganymede"))) {
                    game states values.set(game states.indexOf("play ganymede"), 0);
                    current_audio_target = 20;
                    Control.wait(3);
                    Sound.playSoundUntilDone("The Proper People - Ganymede");
                }
            }
        }
    }

    public void end_cutscene_start() { // at 790,795 // hook: broadcast end cutscene start
        // unsupported stop: other scripts in sprite
        current_audio_target = 40;
        Sound.playSound("infra radio 1");
    }

    public void sfx_volume() { // at 1314,821 // hook: broadcast sfx volume
        if (scanning_in_progress_ == 0) {
            Sound.volume = current_audio_target;
        } else {
            Sound.volume = 0;
        }
    }

    loose { // at 107,927
        // procedures_call
                log("play no shelter");
    }

    loose { // at 1097,952
        // procedures_call
                log("play radio");
    }

    loose { // at 128,1212
        // procedures_call
                log("play feathers");
    }

    loose { // at 84,1540
        // procedures_call
                log("play woodland shadows");
    }

    loose { // at 86,1894
        // procedures_call
                log("play ganymede");
    }

}

class cmd { // Sprite: cmd (0,0) size=100 direction=90 show=0 costume=0 volume=100 layer=8 rotation=all draggable=0
    import "assets/66d99df05ba82a1c6a717402b1f11ff2.svg" as icon; // costume centerx=13.98046875 centery=15.981249999999989 res=1
    import "assets/96d7bebb945a8dfa027befa47a34112d.svg" as dev; // costume centerx=100.31363889467443 centery=11.102831613057987 res=1
    private str = "";
    private i = 6;
    private command_name = "reset";
    private temp = "1";
    private cmd_string = "reset";
    private trim_prefixed_padding_ = "0";
    private inside_quotes_ = "0";
    private command = [];
    private all_commands_split = ["reset"];

    public void Events.keyPressed(k) { // at -500,147 // hook: when [/] key pressed
        Control.broadcastAndWait("open commands");
    }

    public void __initalise() { // at -52,165 // hook: broadcast ! initalise
        Looks.hide();
        Looks.switchCostume("icon");
    }

    private void __(comment) { // at 2054,165 // proccode // %s
    }

    private void __set_cam_rot(elev, azi) { // at 1703,170 // proccode 📷 set cam rot %s %s
        cam_rot_x = elev;
        cam_rot_z = azi;
    }

    private void __set_cam_pos(x, y, z) { // at 1239,172 // proccode 📷 set cam pos %s %s %s
        cam_x = x;
        cam_y = y;
        cam_z = z;
    }

    public void open_commands() { // at -503,310 // hook: broadcast open commands
        Looks.hide();
        Looks.switchCostume("icon");
        Sensing.ask("(DEV TOOLS) enter command:");
        if (Sensing.answer() != "") {
            split_command_string_into_commands(Sensing.answer());
            for (i=1, i<=all_commands_split.length(), i++) {
                if (Operators.letterOf(1, all_commands_split.get(i)) != "#") {
                    evaluate_command(all_commands_split.get(i));
                }
            }
        }
    }

    private void print(text, duration) { // at 1770,456
        messages.add(text);
        if (duration == "") {
            messages.add(3);
        } else {
            messages.add(duration);
        }
    }

    private void evaluate_command(command) { // at -508,986 // proccode evaluate command %s
        if (command == "") {
            return;
        }
        decode_command(command);
        command_name = command.get(1);
        command.delete(1);
        if (command_name == "dev") {
            __dev = command.get(1);
            print(join("dev ", __dev), 3);
        } elif (__dev == 1) {
            if (command_name == "reset") {
                reset_game_ = 0;
                Control.broadcast("reset all");
                Control.stopAll();
            } elif (command_name == "reload") {
                Control.broadcast("LOAD REGION");
            } elif (command_name == "load") {
                region = command.get(1);
                Control.broadcast("LOAD REGION");
            } elif (command_name == "rs") {
                Control.broadcast("reset game states");
                Control.broadcast("load tags");
            } elif (command_name == "res") {
                DISPLAY__Resolution = command.get(1);
            } elif (command_name == "rm") {
                if (command.get(1) == "") {
                    render_mode = "normal";
                } else {
                    render_mode = command.get(1);
                }
            } elif (command_name == "cm") {
                cam_mode = command.get(1);
            } elif (command_name == "tp") {
                if (command.get(1) == "mast") {
                    __set_cam_pos(43, -3749, 2550.65);
                } else {
                    __set_cam_pos(command.get(1), command.get(2), command.get(3));
                }
            } elif (command_name == "start") {
                Control.broadcast("start game");
            } elif (command_name == "rth") {
                region = "pod";
                Control.broadcast("LOAD REGION");
                __set_cam_pos(0, -0.05, 1.7);
                __set_cam_rot(85, 0);
            } elif (command_name == "lt") {
                if (command.get(1) == "low") {
                    Control.broadcast("load half-res textures");
                } else {
                    Control.broadcast("scan full-res textures");
                }
                print("load textures", "");
            } elif (command_name == "doc") {
                viewed_document = command.get(1);
            } elif (command_name == "gs") {
                if (game states.contains(command.get(1))) {
                    game states values.set(game states.indexOf(command.get(1)), command.get(2));
                    print(join(join(command.get(1), "="), command.get(2)), 3);
                } else {
                    print(join(join("\"", command.get(1)), "\" not in game states"), 3);
                }
            } elif (command_name == "texture") {
                Sensing.ask("paste texture data here!");
                if (Sensing.answer() != "") {
                    Control.broadcast("load texture from text box");
                }
            } elif (command_name == "bonus") {
                if (command.get(1) == "") {
                    bonus_content_ = 1;
                    print("bonus unlocked", 3);
                } else {
                    bonus_content_ = Operators.round(command.get(1));
                    print(join("set bonus ", bonus_content_), 3);
                }
                Control.broadcast("load tags");
            } elif (command_name == "help") {
                messages.clear();
                print("**See inside the project for the full list (cmd sprite)**", 10);
                print("---", 10);
                print("`dev [0 | 1]`... Set dev mode", 10);
                print("`res [resolution: num]`... Set resolution", 10);
                print("`tp [x: num] [y: num] [z: num]`... Teleport", 10);
                print("`load [name: str]`... Load region", 10);
                print("`reload`... Reload region", 10);
                print("`rm [mode: str]`... Set the render mode", 10);
                print("`cm [mode: str]`... Set the camera mode", 10);
                print("`gs [key: str] [val: any]`... Set game state", 10);
                print("`rth`... Return to home (pod)", 10);
                print("`texture`... Open the custom texture loader", 10);
                print("`reset`... Reset EVERYTHING", 10);
            } elif (command_name == "print") {
                print(command.get(1), command.get(2));
            }
        } else {
            Looks.show();
            Looks.switchCostume("dev");
            Control.wait(1.5);
            Looks.hide();
            Looks.switchCostume("icon");
        }
    }

    private void split_command_string_into_commands(cmd_string) { // at 1325,1152 // proccode split command string into commands %s // warp
        __("split multiple lines of commands into a list");
        cmd_string = cmd_string;
        all_commands_split.clear();
        trim_prefixed_padding_ = 1;
        str = "";
        i = 1;
        while (!(i > Operators.length(cmd_string))) {
            if (trim_prefixed_padding_ == 1) {
                __("ignore preceding spaces and slashes");
                while (Operators.contains(" /", Operators.letterOf(i, cmd_string))) {
                    i += 1;
                }
                trim_prefixed_padding_ = 0;
            }
            if (Operators.letterOf(i, cmd_string) == "\\") {
                str = join(str, Operators.letterOf(i + 1, cmd_string));
                i += 2;
            } else {
                if (Operators.letterOf(i, cmd_string) == ";") {
                    all_commands_split.add(str);
                    str = "";
                    trim_prefixed_padding_ = 1;
                } else {
                    str = join(str, Operators.letterOf(i, cmd_string));
                }
                i += 1;
            }
        }
        if (str != "") {
            all_commands_split.add(str);
            str = "";
        }
    }

    private void decode_command(str_arg) { // at 2024,1152 // proccode decode command %s // warp
        __("split a single command into its components");
        cmd_string = str_arg;
        command.clear();
        inside_quotes_ = 0;
        str = "";
        i = 1;
        while (!(i > Operators.length(cmd_string))) {
            if (Operators.letterOf(i, cmd_string) == "\\") {
                __("escaped, always read next value as text");
                str = join(str, Operators.letterOf(i + 1, cmd_string));
                i += 2;
            } elif (Operators.letterOf(i, cmd_string) == "\"") {
                inside_quotes_ = 1 - inside_quotes_;
                i += 1;
            } else {
                if (Operators.letterOf(i, cmd_string) == " " && inside_quotes_ == 0) {
                    command.add(str);
                    str = "";
                } else {
                    str = join(str, Operators.letterOf(i, cmd_string));
                }
                i += 1;
            }
        }
        command.add(str);
        str = "";
    }

}
