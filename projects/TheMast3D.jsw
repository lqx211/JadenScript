    private void split_line(line, delimiter) { // at 3354,-26 // proccode split line %s with delimiter %s // warp
        split_line.clear();
        substr = "";
        for (char_i=1, char_i<=Operators.length(line), char_i++) {
            if (Operators.letterOf(char_i, line) == delimiter) {
                split_line.add(substr);
                substr = "";
            } else {
                substr = join(substr, Operators.letterOf(char_i, line));
            }
        }
        split_line.add(substr);
    }

