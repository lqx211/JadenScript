    public void __initalise() { // at -301,176 // hook: broadcast ! initalise
        Looks.hide();
        if (attempt_game_state_name != "") {
            set_game_state(attempt_game_state_name, attempt_game_state_old_value);
            attempt_game_state_name = "";
            Control.broadcast("load tags");
            Control.broadcast("show black overlay");
        }
    }

    private void new_game_state(name, value) { // at 1119,192 // proccode new game state %s %s
        if (name == "") {
            warn("game state has no name");
        } else {
            game states.add(name);
            game states values.add(value);
        }
    }

    private void add_msg(txt, duration, replace) { // at 1588,259 // proccode add msg %s %s replace? %s
        if (replace == 1) {
            messages.clear();
        }
        messages.add(txt);
        if (duration == "") {
            messages.add(5);
        } else {
            messages.add(duration);
        }
    }

    public void function() { // at -964,341 // hook: broadcast function
        tag_id = tags.get(0 /* sensing_of */ + 9);
        if (Operators.letterOf(1, tag_id) == "#") {
            game_state_assignment_tag(tag_id);
        } else {
            instant_functions();
            if (tag_id == "generator on") {
                ATTEMPT_set_game_state("generator on", 1);
                Control.broadcast("load tags");
                Control.broadcast("start generator");
                Control.wait(5);
                ATTEMPT_commit_state();
                region = "start_on";
                Control.broadcastAndWait("LOAD REGION");
            } elif (tag_id == "exit start") {
                ATTEMPT_set_game_state("stasis lift open", 0);
                Control.broadcast("load tags");
                Control.wait(2.5);
                Sound.playSound("elevator 1 cc0");
                Control.wait(10);
                ATTEMPT_commit_state();
                region = "surface";
                cam_z = 11.7;
                Control.broadcast("show black overlay");
                Control.broadcastAndWait("LOAD REGION");
            } elif (tag_id == "enter walkways") {
                Control.broadcast("load tags");
                Control.wait(0.5);
                region = "walkways";
                cam_y = 41.8;
                Control.broadcast("show black overlay");
                Control.broadcastAndWait("LOAD REGION");
            } elif (tag_id == "enter surface") {
                Control.wait(0.5);
                region = "surface";
                cam_y = 39;
                Control.broadcast("show black overlay");
                Control.broadcastAndWait("LOAD REGION");
            } elif (tag_id == "train1") {
                ATTEMPT_set_game_state("constrain camera train1", 1);
                Control.broadcast("load tags");
                Control.broadcast("start train1");
                Control.wait(3);
                ATTEMPT_commit_state();
                set_game_state("train1", 1);
            } elif (tag_id == "open track door") {
                set_game_state("track door open", 1);
                Control.broadcast("start large door");
            } elif (tag_id == "train2") {
                ATTEMPT_set_game_state("constrain camera train2", 1);
                Control.broadcast("load tags");
                Control.broadcast("start train2");
                Control.wait(5);
                ATTEMPT_commit_state();
                set_game_state("train2", 1);
            } elif (tag_id == "unlock base lift") {
                set_game_state("base lift unlocked", 1);
                Control.broadcast("start base lift");
            } elif (tag_id == "enter service1") {
                ATTEMPT_set_game_state("base lift open", 0);
                Control.broadcast("load tags");
                Control.wait(3);
                Sound.playSoundUntilDone("elevator 2 cc0");
                ATTEMPT_commit_state();
                region = "service1";
                cam_z = 623.7;
                Control.broadcast("show black overlay");
                Control.broadcastAndWait("LOAD REGION");
            } elif (tag_id == "service3 lift to landing pad") {
                ATTEMPT_set_game_state("service3 lift door open", 0);
                Control.broadcast("load tags");
                Control.wait(0.1);
                Control.broadcast("service3 lift stop wind sounds");
                Control.wait(2.9);
                Sound.playSoundUntilDone("elevator 2 cc0");
                ATTEMPT_commit_state();
                region = "landing_pad";
                cam_z = 2549.65;
                Control.broadcast("show black overlay");
                Control.broadcastAndWait("LOAD REGION");
            } elif (tag_id == "comms screen") {
                viewed_document = "comms";
            } elif (region == "service1") {
                service1_puzzles();
            } else {
                pod_tags();
            }
        }
    }

    public void reset_all() { // at 324,449 // hook: broadcast reset all
