    private void draw_progress_bar(current, total) { // at 6976,-72 // proccode draw progress bar %s / %s
        Pen.setPenColor("#ffffff");
        Pen.setPenSize(10);
        Motion.setXY(-240, -180);
        Pen.penDown();
        Motion.x += 480 * (current / total);
        Pen.penUp();
    }

