    private void ATTEMPT_commit_state() { // at 1777,933 // proccode ATTEMPT commit state
        attempt_game_state_name = "";
        attempt_game_state_old_value = "";
    }

    private void game_state_assignment_tag(tag) { // at -1581,936 // proccode game state assignment tag %s // warp
        __("this tag is a game state assignment");
        __("sfx can be played from the tag sprite");
        state_name = "";
        i = 2;
        while (!(Operators.letterOf(i, tag) == "=")) {
            state_name = join(state_name, Operators.letterOf(i, tag));
            i += 1;
        }
        i += 1;
        state_value = "";
        while (!(i > Operators.length(tag))) {
            state_value = join(state_value, Operators.letterOf(i, tag));
            i += 1;
        }
        __("now set state");
        set_game_state(state_name, state_value);
    }

    private void ATTEMPT_set_game_state(name, value) { // at 1122,1048 // proccode ATTEMPT set game state %s to %s
        attempt_game_state_name = name;
        attempt_game_state_old_value = game states values.get(game states.indexOf(name));
        game states values.set(game states.indexOf(name), value);
        if (__dev == 1) {
            log(join(join(join("ATTEMPT game state ", name), " set to "), value));
        }
    }

    private void set_service1_lift_state() { // at 2464,1875 // proccode set service1 lift state
        if ("disabled" == game states values.get(game states.indexOf("service1 lift state"))) {
            if ("on" != game states values.get(game states.indexOf("service1 power")) && "neutral" == game states values.get(game states.indexOf("service1 operation"))) {
                set_game_state("service1 lift state", "startup");
                Sound.playSound("elec connect");
            } elif ("disabled" != game states values.get(game states.indexOf("service1 lift state"))) {
                set_game_state("service1 lift state", "disabled");
                Sound.playSound("elec disconnect");
            }
        } elif ("startup" == game states values.get(game states.indexOf("service1 lift state"))) {
            if ("on" == game states values.get(game states.indexOf("service1 power")) && "neutral" == game states values.get(game states.indexOf("service1 operation"))) {
                set_game_state("service1 lift state", "powered");
                Sound.playSound("elec connect");
            } elif ("standby" != game states values.get(game states.indexOf("service1 power"))) {
                set_game_state("service1 lift state", "disabled");
                Sound.playSound("elec disconnect");
            }
        } elif ("powered" == game states values.get(game states.indexOf("service1 lift state"))) {
            if ("on" == game states values.get(game states.indexOf("service1 operation"))) {
                set_game_state("service1 lift state", "enabled");
                Sound.playSound("elec connect");
                Sound.playSound("sine tone");
            } else {
                set_game_state("service1 lift state", "disabled");
                Sound.playSound("elec disconnect");
            }
        } elif (!("on" == game states values.get(game states.indexOf("service1 power")) && "on" == game states values.get(game states.indexOf("service1 operation")))) {
            set_game_state("service1 lift state", "disabled");
            Sound.playSound("elec disconnect");
        }
    }

    private void service1_puzzles() { // at 1402,1927 // proccode service1 puzzles
        if (tag_id == "service1 lift") {
            set_game_state("service1 lift", 1);
            Sound.playSound("elevator long");
        } elif (tag_id == "service1 operation") {
            if ("off" == game states values.get(game states.indexOf("service1 operation"))) {
                set_game_state("service1 operation", "neutral");
            } elif ("neutral" == game states values.get(game states.indexOf("service1 operation"))) {
                set_game_state("service1 operation", "on");
            } else {
                set_game_state("service1 operation", "off");
            }
            set_service1_lift_state();
        } elif (tag_id == "service1 power") {
            if ("off" == game states values.get(game states.indexOf("service1 power"))) {
                set_game_state("service1 power", "standby");
            } elif ("standby" == game states values.get(game states.indexOf("service1 power"))) {
                set_game_state("service1 power", "on");
            } else {
                set_game_state("service1 power", "off");
            }
            set_service1_lift_state();
        }
    }

    private void pod_tags() { // at 1257,3485 // proccode pod tags
        if (tag_id == "debug start") {
            region = "start_off";
            Control.broadcast("LOAD REGION");
            cam_x = -7.3;
            cam_y = -1.3;
            cam_z = -13.3;
            set_game_state("play wake up animation", "");
        } elif (tag_id == "debug reset") {
            Control.broadcast("reset all");
            Control.stopAll();
        } elif (tag_id == "res increase") {
            if (DISPLAY__Resolution < 12) {
                DISPLAY__Resolution += 1;
                add_msg(join("resolution = ", DISPLAY__Resolution), 2, 1);
            }
        } elif (tag_id == "res decrease") {
            if (DISPLAY__Resolution > 1) {
                DISPLAY__Resolution -= 1;
                add_msg(join("resolution = ", DISPLAY__Resolution), 2, 1);
            }
        } elif (tag_id == "toggle FPS") {
            show_FPS_ = 1 - show_FPS_;
        } elif (tag_id == "toggle speedrun") {
            show_timer_ = 1 - show_timer_;
            timer = "";
        } elif (tag_id == "tag style") {
            tag_style += 1;
            if (tag_style > 3) {
                tag_style = 1;
            }
        } elif (tag_id == "load half res textures") {
            Control.broadcastAndWait("load half-res textures");
        } elif (tag_id == "load full res textures") {
            Control.broadcastAndWait("scan full-res textures");
        }
    }

}

