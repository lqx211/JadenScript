    }

    public void movement() { // at -839,16 // hook: broadcast movement
        if (cam_mode == "walk") {
            dt_deviation += dt;
            if (dt_deviation > target_dt) {
                repeat = Operators.math("floor", dt_deviation / target_dt);
                dt_deviation += 0 - repeat * target_dt;
                if (repeat > 20) {
                    repeat = 20;
                    log("lag prevention: repeat > 20");
                }
                if (timer != "") {
                    timer += repeat;
                }
            }
            if (viewed_document == "") {
                debug_total_checks = 0;
                controls();
                physics_step_with_dt(target_dt, repeat);
            }
        } else {
            last_tri_index = 0;
        }
    }

