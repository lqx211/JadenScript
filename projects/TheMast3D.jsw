    public void update_camera_data() { // at 3146,-313 // hook: broadcast update camera data
        if (viewed_document != "") {
            last_x = Sensing.mouseX();
            return;
        }
        if (Sensing.keyPressed("c") && __dev == 1) {
            __("debug zoom");
            FOV = target_FOV * 0.5;
        } else {
            FOV = target_FOV;
        }
        if (render_mode == "top down vz" || (render_mode == "top down fl" || render_mode == "boundary")) {
            __("2D movement (DOES NOT FOLLOW KEYBINDS)");
            if (Sensing.keyPressed("shift")) {
                movement_speed = 15;
            } else {
                movement_speed = 5;
            }
            move_camera(movement_speed, Sensing.keyPressed("d") - Sensing.keyPressed("a"), Sensing.keyPressed("w") - Sensing.keyPressed("s"), "");
        } else {
            if (cam_mode == "free") {
                __("free cam movement (DOES NOT FOLLOW KEYBINDS)");
                if (Sensing.keyPressed("shift")) {
                    movement_speed = 15;
                    if (Sensing.keyPressed("space")) {
                        movement_speed = 400;
                    }
                } else {
                    movement_speed = 5;
                    if (Sensing.keyPressed("x")) {
                        movement_speed = 0.5;
                    }
                }
                cam_vx = 0;
                cam_vy = 0;
                move_camera(movement_speed, Operators.math("cos", cam_rot_z) * (Sensing.keyPressed("d") - Sensing.keyPressed("a")) + Operators.math("sin", cam_rot_z) * (Sensing.keyPressed("w") - Sensing.keyPressed("s")), Operators.math("cos", cam_rot_z) * (Sensing.keyPressed("w") - Sensing.keyPressed("s")) - Operators.math("sin", cam_rot_z) * (Sensing.keyPressed("d") - Sensing.keyPressed("a")), Sensing.keyPressed("e") - Sensing.keyPressed("q"));
            }
            __("look (normal)");
            if (keymap options.get(__controls__look_) == "Arrow Keys") {
                rotate_camera(look_sensitivity * 120, Sensing.keyPressed("up arrow") - Sensing.keyPressed("down arrow"), Sensing.keyPressed("right arrow") - Sensing.keyPressed("left arrow"));
            } elif (keymap options.get(__controls__look_) == "WASD") {
                rotate_camera(look_sensitivity * 120, Sensing.keyPressed("w") - Sensing.keyPressed("s"), Sensing.keyPressed("d") - Sensing.keyPressed("a"));
            } elif (keymap options.get(__controls__look_) == "Pointerlock (requires turbowarp extension)") {
                rotate_camera(look_sensitivity * 6, Sensing.mouseY(), Sensing.mouseX());
            } elif (keymap options.get(__controls__look_) == "Mouse Position") {
                if (Operators.math("abs", Sensing.mouseY()) < 180) {
                    cam_rot_z += dt * 60 * (0.5 * (Sensing.mouseX() - last_x));
                    if (Sensing.mouseX() > 160) {
                        cam_rot_z += dt * (look_sensitivity * 40);
                    } elif (Sensing.mouseX() < -160) {
                        cam_rot_z += dt * (look_sensitivity * -40);
                    }
                    cam_rot_x = 90 + Sensing.mouseY() / 180 * (175 - 90);
                    last_x = Sensing.mouseX();
                }
            }
            cam_rot_z = cam_rot_z % 360;
            if (cam_rot_x > 175) {
                cam_rot_x = 175;
            } elif (cam_rot_x < 5) {
                cam_rot_x = 5;
            }
        }
    }

